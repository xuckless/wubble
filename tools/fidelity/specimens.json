    "touch": { "url": "/wubble/pages/_harness.html?page=touch", "viewport": [1360, 3600], "ready": ".tp-grid", "frozen": false, "gl": "gpu", "stage": ".tp-spec:has({root}) .tp-stage", "after": 600 },
    "settings": { "url": "/wubble/", "gl": "swiftshader", "settle": 100, "stage": ".wb-main", "after": 600, "steps": [{ "key": ",", "ctrl": true }, { "until": ".st-main" }, { "advance": 1500 }] },
    "shell": { "url": "/wubble/", "gl": "swiftshader", "stage": ".wb-window", "after": 600 }
  },

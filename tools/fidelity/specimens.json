        { "state": "empty" }, { "state": "hover", "steps": [{ "hover": "{root}" }] },
        { "state": "focused", "steps": [{ "click": "{root} input" }, { "advance": 400 }, { "hover": ".st-nav" }] },
        { "state": "query", "steps": [{ "click": "{root} input" }, { "type": "tab" }, { "advance": 600 }, { "hover": ".st-nav" }] },
        { "state": "clear-hover", "steps": [{ "click": "{root} input" }, { "type": "tab" }, { "advance": 600 }, { "hover": "{root} .st-clear" }] }
      ],
      "sequences": [
        { "name": "focus", "steps": [{ "click": "{root} input" }], "frames": 36, "track": ["capsule", "clear"] },
        { "name": "type", "steps": [{ "click": "{root} input" }, { "advance": 400 }, { "type": "tab" }], "frames": 48, "track": ["capsule", "clear"] }
      ]
    },
    {
      "control": "kbd", "group": "Kbd", "page": "settings", "root": ".st-fold.open > .st-fold-in > .st-row .st-keys", "source": "settings.tsx#st-keys",
      "before": [{ "click": ".st-search input" }, { "type": "keyboard shortcut" }, { "advance": 600 }, { "eval": "document.activeElement.blur()" }, { "hover": ".st-nav" }],
      "elements": { "keys": "{root}", "combo": "{root} > .st-combo:nth-of-type(1)", "key1": "{root} kbd" },
      "states": [{ "state": "rest" }]
    },
    {
      "control": "scroller", "group": "Scroller", "page": "settings", "root": ".wb-main .wb-thumb", "stage": ".wb-main", "pad": 12, "source": "browser/scroller.tsx#wb-thumb-on",
      "elements": { "thumb": "{root}" },
      "states": [
        { "state": "hidden" },
        { "state": "shown", "steps": [{ "wheel": { "over": ".wb-main", "y": 300 } }, { "advance": 300 }], "after": 0 },
        { "state": "hover", "steps": [{ "wheel": { "over": ".wb-main", "y": 300 } }, { "advance": 300 }, { "hover": "{root}" }, { "advance": 300 }], "after": 0 },
        { "state": "dragging", "steps": [{ "wheel": { "over": ".wb-main", "y": 300 } }, { "advance": 300 }, { "drag": { "from": "{root}", "by": [0, 60], "hold": true, "steps": 8 } }, { "advance": 200 }], "after": 0 }
      ],
      "sequences": [
        { "name": "show-fade", "steps": [{ "wheel": { "over": ".wb-main", "y": 300 } }], "clip": [".wb-main .wb-thumb"], "pad": 40, "frames": 150, "track": ["thumb"] }
      ]
    },
    {
      "control": "seam-pill", "group": "Seam and Pill", "page": "shell", "root": ".wb-window > .wb-pill:not(.wb-src-pill)", "clip": [".wb-window > .wb-grab:not(.wb-src-grab)"], "pad": 16, "source": "browser/chrome.tsx#class=\"wb-pill\"",
      "elements": { "pill": "{root}", "dot": "{root} > i", "grab": ".wb-window > .wb-grab:not(.wb-src-grab)" },
      "states": [
        { "state": "rest" }, { "state": "hover", "steps": [{ "hover": ".wb-window > .wb-grab:not(.wb-src-grab)" }] },
        { "state": "held", "steps": [{ "press": ".wb-window > .wb-grab:not(.wb-src-grab)" }] },
        { "state": "focus", "steps": [{ "focus": ".wb-window > .wb-grab:not(.wb-src-grab)" }] }
      ],
      "sequences": [
        { "name": "grab", "steps": [{ "press": ".wb-window > .wb-grab:not(.wb-src-grab)" }], "frames": 48, "track": ["pill", "dot"] }
      ]
    },
    {
      "control": "tooltip", "group": "Tooltip", "page": "touch", "root": ".tp-dock", "stage": ".tp-stage-dock", "clip": [".tp-tip-pos"], "source": "touch-dock",
      "elements": { "dock": "{root}", "pos": "{root} > .tp-tip-pos", "tip": "{root} .tp-tip", "btn1": "{root} > button:nth-of-type(1)", "btn4": "{root} > button:nth-of-type(4)", "btn6": "{root} > button:nth-of-type(6)" },
      "states": [
        { "state": "hidden" },
        { "state": "over-1", "steps": [{ "hover": "{root} > button:nth-of-type(1)" }, { "advance": 800 }] },
        { "state": "over-4", "steps": [{ "hover": "{root} > button:nth-of-type(4)" }, { "advance": 800 }] },
        { "state": "over-destructive", "steps": [{ "hover": "{root} > button:nth-of-type(6)" }, { "advance": 800 }] }
      ],
      "sequences": [
        { "name": "appear", "steps": [{ "hover": "{root} > button:nth-of-type(1)" }], "frames": 72, "track": ["pos", "tip", "btn1"] },
        { "name": "glide", "steps": [{ "hover": "{root} > button:nth-of-type(1)" }, { "advance": 800 }, { "hover": "{root} > button:nth-of-type(4)" }], "frames": 48, "track": ["pos", "tip", "btn1", "btn4"] }
      ]
    }
  ]
}

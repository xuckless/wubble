{
  "about": "Scenes of the design-fidelity harness (tools/fidelity/README.md). A scene is a web page state (url, steps on the fixed clock) shot at `frame`; `wubble` names the gallery scene (gallery_smoke.rs SCENES) it is scored against. Each crop is a rect relative to the frame: `web` is a selector measured on the web side; a `direct` crop uses the same rect on wubble's window (geometry parity is the point), a `derived` crop names wubble's own rect (`wubble`: [x, y, w, h], logical px at the web window's size) and is compared top-left aligned at the common size (a wubble-only surface against the design part it derives from); a scene without `wubble` is a web-only reference (kit specimens) shot for the lanes and the owner.",
  "viewport": [1360, 880],
  "viewportByDpr": { "2": [1280, 760] },
  "frame": ".wb-window",
  "settle": 2000,
  "after": 600,
  "frozen": true,
  "scenes": [
    {
      "name": "sidebar-extended", "url": "/wubble/", "wubble": "sidebar-extended",
      "crops": [
        { "name": "window" },
        { "name": "sidebar", "web": ".wb-side" },
        { "name": "side-top", "web": ".wb-side-top" },
        { "name": "address", "web": ".wb-address" },
        { "name": "favs", "web": ".wb-favs" },
        { "name": "space-name", "web": ".wb-space-name" },
        { "name": "tab-selected", "web": ".wb-tab-on" },
        { "name": "new-tab", "web": ".wb-newtab" },
        { "name": "side-bottom", "web": ".wb-side-bottom" }
      ]
    },
    {
      "name": "sidebar-rail", "url": "/wubble/", "wubble": "sidebar-rail",
      "steps": [{ "drag": { "from": ".wb-grab", "by": [-200, 0] } }, { "advance": 1500 }],
      "crops": [{ "name": "window" }, { "name": "sidebar", "web": ".wb-side" }]
    },
    {
      "name": "sidebar-hidden", "url": "/wubble/", "wubble": "sidebar-hidden",

      "crops": [{ "name": "window" }, { "name": "command-bar", "web": ".wb-cmd" }]
    },
    {
      "name": "settings", "url": "/wubble/", "wubble": "settings",
      "steps": [{ "key": ",", "ctrl": true }, { "until": ".st-main" }, { "advance": 1500 }],
      "crops": [{ "name": "window" }, { "name": "page", "web": ".wb-main" }, { "name": "nav", "web": ".st-nav" }]
    },
    {
      "name": "settings-2", "url": "/wubble/", "wubble": "settings-2",

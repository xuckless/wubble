      "crops": [{ "name": "window" }]
    },
    {
      "name": "tab-row-hover", "url": "/wubble/", "wubble": "tab-row-hover",
      "steps": [{ "hover": ".wb-tab ~ .wb-tab" }],
      "crops": [{ "name": "tab-row", "web": ".wb-tab ~ .wb-tab" }, { "name": "sidebar", "web": ".wb-side" }]
    },
    {
      "name": "new-tab-hover", "url": "/wubble/", "wubble": "new-tab-hover",
      "steps": [{ "hover": ".wb-newtab" }],
      "crops": [{ "name": "new-tab", "web": ".wb-newtab" }]
    },
    {
      "name": "command-bar-open", "url": "/wubble/", "wubble": "command-bar-open", "frames": 48,
      "steps": [{ "key": "t", "ctrl": true }],
      "crops": [{ "name": "window" }]
    },
    {
      "name": "command-bar", "url": "/wubble/", "wubble": "command-bar",
      "steps": [{ "key": "t", "ctrl": true }],
      "crops": [{ "name": "window" }, { "name": "command-bar", "web": ".wb-cmd" }]
    },
    {
      "name": "command-bar-results", "url": "/wubble/", "wubble": "command-bar-results",

+  // No groups and no splits.
+  if ((query.group_id && *query.group_id != -1) ||
+      (query.split_view_id && *query.split_view_id != -1)) {
+    return false;
+  }
+  ExtensionTabUtil::ScrubTabBehavior scrub_tab_behavior =
+      ExtensionTabUtil::GetScrubTabBehavior(extension, context, web_contents);
+  if (query.title && !query.title->empty() &&
+      (scrub_tab_behavior.committed_info == ExtensionTabUtil::kScrubTabFully ||
+       !base::MatchPattern(web_contents->GetTitle(),

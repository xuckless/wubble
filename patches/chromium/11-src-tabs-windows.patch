+      !MatchesBool(query.audible, tab.audible.value_or(false)) ||
+      !MatchesBool(query.frozen, tab.frozen) ||
+      !MatchesBool(query.discarded, tab.discarded) ||
+      !MatchesBool(query.auto_discardable, tab.auto_discardable) ||
+      !MatchesBool(query.muted, web_contents->IsAudioMuted())) {
+    return false;

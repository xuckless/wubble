+// Ported from AppWindowController: one wubble window as seen from one
+// profile (extensions only operate on windows of their own profile).
+class WubbleWindowController : public WindowController {
+ public:
+  static std::unique_ptr<WubbleWindowController> Create(int window_id,
+                                                        SessionID session,
+                                                        Profile* profile) {
+    auto base_window = std::make_unique<WubbleBaseWindow>(window_id);
+    return base::WrapUnique(new WubbleWindowController(
+        window_id, session, std::move(base_window), profile));
+  }
+
+  WubbleWindowController(const WubbleWindowController&) = delete;
+  WubbleWindowController& operator=(const WubbleWindowController&) = delete;
+
+  ~WubbleWindowController() override {
+    extensions::WindowControllerList::GetInstance()->RemoveExtensionWindow(
+        this);
+  }
+
+  int wubble_window() const { return window_id_; }
+
+  // extensions::WindowController:
+  int GetWindowId() const override { return session_.id(); }
+  std::string GetWindowTypeText() const override;
+  void SetFullscreenMode(bool is_fullscreen,
+                         const GURL& extension_url) const override {}
+  BrowserWindowInterface* GetBrowser() const override { return nullptr; }
+  content::WebContents* GetActiveTab() const override;
+  int GetTabCount() const override {
+    return static_cast<int>(TabsOf(this).size());
+  }
+  content::WebContents* GetWebContentsAt(int i) const override {
+    auto tabs = TabsOf(this);
+    return i >= 0 && i < static_cast<int>(tabs.size()) ? tabs[i] : nullptr;
+  }
+  bool IsVisibleToTabsAPIForExtension(
+      const extensions::Extension* extension,
+      bool allow_dev_tools_windows) const override {
+    return !extension || !extension->is_platform_app();
+  }
+  base::DictValue CreateWindowValueForExtension(
+      const extensions::Extension* extension,
+      PopulateTabBehavior populate_tab_behavior,
+      extensions::mojom::ContextType context) const override;
+  base::ListValue CreateTabList(
+      const extensions::Extension* extension,
+      extensions::mojom::ContextType context) const override;
+  bool OpenOptionsPage(const extensions::Extension* extension,
+                       const GURL& url,
+                       bool open_in_tab) override {
+    return OpenTab(profile(), url, GetWindowId(), /*active=*/true,
+                   base::DoNothing());
+  }
+
+ private:
+  WubbleWindowController(int window_id,
+                         SessionID session,
+                         std::unique_ptr<WubbleBaseWindow> base_window,
+                         Profile* profile)
+      : WindowController(base_window.get(), profile),
+        window_id_(window_id),
+        session_(session),
+        base_window_(std::move(base_window)) {
+    extensions::WindowControllerList::GetInstance()->AddExtensionWindow(this);
+  }
+
+  const int window_id_;
+  const SessionID session_;
+  std::unique_ptr<WubbleBaseWindow> base_window_;
+};

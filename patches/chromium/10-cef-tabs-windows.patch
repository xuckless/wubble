+// Ported from BrowserExtensionWindowController::CreateWindowValueForExtension.
+base::DictValue WubbleWindowController::CreateWindowValueForExtension(
+    const extensions::Extension* extension,
+    PopulateTabBehavior populate_tab_behavior,
+    extensions::mojom::ContextType context) const {
+  base::DictValue dict;
+  dict.Set(extension_misc::kId, GetWindowId());
+  dict.Set("type", GetWindowTypeText());
+  dict.Set("focused", window()->IsActive());
+  dict.Set("incognito", profile()->IsOffTheRecord());
+  dict.Set("alwaysOnTop", false);
+  dict.Set("state", "normal");
+  const gfx::Rect bounds = window()->GetBounds();
+  dict.Set("left", bounds.x());
+  dict.Set("top", bounds.y());
+  dict.Set("width", bounds.width());
+  dict.Set("height", bounds.height());
+  if (populate_tab_behavior == kPopulateTabs) {
+    dict.Set(extensions::ExtensionTabUtil::kTabsKey,
+             CreateTabList(extension, context));
+  }
+  return dict;
+}
+
+base::ListValue WubbleWindowController::CreateTabList(
+    const extensions::Extension* extension,
+    extensions::mojom::ContextType context) const {
+  base::ListValue list;
+  for (content::WebContents* contents : TabsOf(this)) {
+    auto scrub = extensions::ExtensionTabUtil::GetScrubTabBehavior(
+        extension, context, contents);
+    list.Append(extensions::ExtensionTabUtil::CreateTabObject(
+                    contents, scrub, extension)
+                    .ToValue());
+  }
+  return list;
+}
+
+// The C table.
+
+void SetDelegate(const cef_wubble_ext_delegate_t* delegate) {
+  registry().SetDelegate(delegate);
+}
+
+void SetState(const cef_wubble_ext_window_t* windows,
+              size_t window_count,
+              const cef_wubble_ext_tab_t* tabs,
+              size_t tab_count) {
+  std::vector<WindowState> w;
+  for (size_t i = 0; i < window_count; ++i) {
+    w.push_back({windows[i].window_id, windows[i].focused != 0,
+                 windows[i].type == 1,
+                 gfx::Rect(windows[i].x, windows[i].y, windows[i].width,
+                           windows[i].height)});
+  }
+  std::vector<TabState> t;
+  for (size_t i = 0; i < tab_count; ++i) {
+    t.push_back({tabs[i].browser_id, tabs[i].window_id, tabs[i].index,
+                 tabs[i].active != 0, tabs[i].pinned != 0});
+  }
+  registry().SetState(std::move(w), std::move(t));
+}
+
+void FreeString(char* string) {
+  free(string);
+}
+
+const cef_wubble_ext_t kTable = {
+    sizeof(cef_wubble_ext_t),
+    CEF_WUBBLE_EXT_VERSION,
+    SetDelegate,
+    SetState,
+    impl::TabOpened,
+    impl::ActionClick,
+    impl::ActionState,
+    FreeString,
+    impl::FreeAction,
+};
+
+}  // namespace
+
+namespace impl {
+
+const cef_wubble_ext_delegate_t* Delegate() {
+  return registry().delegate();
+}
+
+content::WebContents* ContentsOf(int browser_id) {
+  if (browser_id <= 0) {
+    return nullptr;
+  }
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  return browser && browser->IsAlloyStyle() ? browser->GetWebContents()
+                                            : nullptr;
+}
+
+int BrowserIdOf(content::WebContents* contents) {
+  auto browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  if (!browser || !browser->IsAlloyStyle() ||
+      browser->GetWebContents() != contents) {
+    return 0;
+  }
+  return browser->GetIdentifier();
+}
+
+int WubbleWindowOf(int window_id) {
+  return registry().WubbleWindowOf(window_id);
+}
+
+char* CopyString(const std::string& value) {
+  char* out = static_cast<char*>(malloc(value.size() + 1));
+  memcpy(out, value.c_str(), value.size() + 1);
+  return out;
+}
+
+}  // namespace impl
+
+bool IsActive() {
+  return registry().delegate() != nullptr;
+}
+
+void FillTab(content::WebContents* contents, extensions::api::tabs::Tab* tab) {
+  const TabState* state = registry().TabOf(contents);
+  if (!state) {
+    return;
+  }
+  tab->index = state->index;
+  tab->active = state->active;
+  tab->selected = state->active;
+  tab->highlighted = state->active;
+  tab->pinned = state->pinned;
+}
+
+WindowController* CurrentWindow(Profile* profile) {
+  auto windows = Windows(profile);
+  return windows.empty() ? nullptr : windows.front();
+}
+
+std::vector<WindowController*> Windows(Profile* profile) {
+  return registry().Controllers(profile);
+}
+
+bool IsWubbleWindow(const WindowController* controller) {
+  return controller && registry().Owns(controller);
+}
+
+std::vector<content::WebContents*> TabsOf(const WindowController* controller) {
+  if (!IsWubbleWindow(controller)) {
+    return {};
+  }
+  auto* wubble = static_cast<const WubbleWindowController*>(controller);
+  return registry().TabsIn(wubble->wubble_window(), wubble->profile(),
+                           /*active_only=*/false);
+}
+
+bool CloseTab(content::WebContents* contents) {
+  const cef_wubble_ext_delegate_t* delegate = impl::Delegate();
+  int id = impl::BrowserIdOf(contents);
+  if (!delegate || !id) {
+    return false;
+  }
+  delegate->close_tab(delegate->ctx, id);
+  return true;
+}
+
+bool ActivateTab(content::WebContents* contents) {
+  const cef_wubble_ext_delegate_t* delegate = impl::Delegate();
+  int id = impl::BrowserIdOf(contents);
+  if (!delegate || !id) {
+    return false;
+  }
+  delegate->activate_tab(delegate->ctx, id);
+  return true;
+}
+
+void OnTabsEventRouterCreated(extensions::TabsEventRouter* router,
+                              Profile* profile) {
+  registry().RouterCreated(router, profile);
+}
+
+}  // namespace wubble
+}  // namespace cef
+
+extern "C" CEF_EXPORT const cef_wubble_ext_t* cef_wubble_ext_v1(void) {
+  return &cef::wubble::kTable;
+}
diff --git a/libcef/browser/chrome/extensions/wubble_ext.h b/libcef/browser/chrome/extensions/wubble_ext.h
new file mode 100644
index 000000000..8f8e60fe6
--- /dev/null
+++ b/libcef/browser/chrome/extensions/wubble_ext.h
@@ -0,0 +1,86 @@
+// wubble change: wubble's tabs and windows as Chromium's extension model.
+//
+// wubble (the embedder) owns its tabs and windows; each tab is an Alloy style
+// windowless browser, which Chromium's chrome.tabs/chrome.windows code does
+// not see (it walks Browser windows and their tab strips only). wubble pushes
+// a projection of its model through the C table in wubble_ext_capi.h; this
+// registry turns it into one extensions::WindowController per (wubble window,
+// loaded profile), gives each tab its window's id (SessionTabHelper) and its
+// index/active/pinned (ExtensionTabUtil::CreateTabObject calls FillTab), and
+// dispatches the tab events through TabsEventRouter. Changes extensions ask
+// for (open, close, activate a tab) go back to wubble through its delegate.
+// Without a delegate (wubble not running the APIs) every hook is a no-op.
+// UI thread only. See wubble's patches/README.md.
+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_H_
+#define CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_H_
+#pragma once
+
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+
+class GURL;
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace extensions {
+class TabsEventRouter;
+class WindowController;
+namespace api::tabs {
+struct Tab;
+}  // namespace api::tabs
+}  // namespace extensions
+
+namespace cef::wubble {
+
+// wubble set its delegate: the hooks below are live.
+bool IsActive();
+
+// Fills index, active, selected, highlighted and pinned of |tab| when
+// |contents| is a wubble tab; else leaves it as it is.
+void FillTab(content::WebContents* contents, extensions::api::tabs::Tab* tab);
+
+// The focused wubble window's controller for |profile|, else the most
+// recently focused one, else null.
+extensions::WindowController* CurrentWindow(Profile* profile);
+
+// Every wubble window's controller for |profile|, most recently focused first.
+std::vector<extensions::WindowController*> Windows(Profile* profile);
+
+// |controller| is one of wubble's.
+bool IsWubbleWindow(const extensions::WindowController* controller);
+
+// The wubble tabs of |controller|'s window and profile, by index.
+std::vector<content::WebContents*> TabsOf(
+    const extensions::WindowController* controller);
+
+// Asks wubble to close / activate |contents|. False when it is not a wubble
+// tab or there is no delegate (nothing was asked).
+bool CloseTab(content::WebContents* contents);
+bool ActivateTab(content::WebContents* contents);
+
+// Asks wubble to open |url| as a tab of |profile| in the window with the
+// extension id |window_id| (-1: the current one). |callback| gets whether
+// wubble opened it and the new tab's contents (null when refused, when wubble
+// went away, or for a tab on a page wubble draws itself). False (and
+// |callback| dropped) when there is no delegate.
+using OpenedCallback =
+    base::OnceCallback<void(bool opened, content::WebContents* contents)>;
+bool OpenTab(Profile* profile,
+             const GURL& url,
+             int window_id,
+             bool active,
+             OpenedCallback callback);
+
+// Called by TabsEventRouterPlatformDelegate's constructor: registers the
+// wubble tabs of |profile| with the new |router| (no onCreated).
+void OnTabsEventRouterCreated(extensions::TabsEventRouter* router,
+                              Profile* profile);
+
+}  // namespace cef::wubble
+
+#endif  // CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_H_
diff --git a/libcef/browser/chrome/extensions/wubble_ext_capi.h b/libcef/browser/chrome/extensions/wubble_ext_capi.h
new file mode 100644
index 000000000..70a36f148
--- /dev/null
+++ b/libcef/browser/chrome/extensions/wubble_ext_capi.h
@@ -0,0 +1,106 @@
+// wubble change: the plain C table wubble (the embedder) looks up at run time
+// to host the chrome.tabs, chrome.windows and chrome.action APIs on its own
+// tabs and windows. Not a translated CEF API: one exported cef_* function
+// (libcef.lst exports every cef_* symbol), mirrored by
+// crates/wubble-engine/src/ext_api.rs. A stock CEF has no such symbol and
+// wubble keeps its behaviour without the APIs. Every entry runs on the CEF UI
+// thread; delegate callbacks are made from it and must not re-enter the table.
+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_CAPI_H_
+#define CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_CAPI_H_
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "include/internal/cef_export.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CEF_WUBBLE_EXT_VERSION 1
+
+// One wubble window. |type|: 0 normal, 1 popup.
+typedef struct _cef_wubble_ext_window_t {
+  int window_id;
+  int focused;
+  int type;
+  int x;
+  int y;
+  int width;
+  int height;
+} cef_wubble_ext_window_t;
+
+// One wubble tab with a live browser, by CefBrowser identifier.
+typedef struct _cef_wubble_ext_tab_t {
+  int browser_id;
+  int window_id;
+  int index;
+  int active;
+  int pinned;
+} cef_wubble_ext_tab_t;
+
+// What CEF asks of wubble. Copied by set_delegate; |ctx| is passed back.
+typedef struct _cef_wubble_ext_delegate_t {
+  void* ctx;
+  // Open |url| as a tab of the profile at |profile_path| in |window_id| (-1:
+  // the current window); answer with tab_opened(|request_id|, ...).
+  void (*open_tab)(void* ctx,
+                   int request_id,
+                   const char* profile_path,
+                   const char* url,
+                   int window_id,
+                   int active);
+  void (*close_tab)(void* ctx, int browser_id);
+  void (*activate_tab)(void* ctx, int browser_id);
+  // The action of |extension_id| changed (badge, title, icon, popup, ...).
+  void (*action_changed)(void* ctx, const char* extension_id);
+} cef_wubble_ext_delegate_t;
+
+// An action's state for one tab. Strings are UTF-8; freed with free_action.
+typedef struct _cef_wubble_ext_action_t {
+  char* title;
+  char* badge;
+  uint32_t badge_bg;  // ARGB
+  uint32_t badge_fg;  // ARGB
+  int enabled;
+  char* popup_url;  // empty: no popup
+  uint8_t* icon_png;  // the icon set by the extension, if any
+  size_t icon_png_len;
+  char* icon_path;  // the manifest's default icon file, if any
+} cef_wubble_ext_action_t;
+
+typedef struct _cef_wubble_ext_t {
+  size_t size;  // sizeof(cef_wubble_ext_t)
+  int version;  // CEF_WUBBLE_EXT_VERSION
+  // NULL clears it (and fails every pending open request).
+  void (*set_delegate)(const cef_wubble_ext_delegate_t* delegate);
+  // The whole projection of wubble's windows and tabs; CEF diffs it.
+  void (*set_state)(const cef_wubble_ext_window_t* windows,
+                    size_t window_count,
+                    const cef_wubble_ext_tab_t* tabs,
+                    size_t tab_count);
+  // Answers open_tab; |browser_id| 0: refused, -1: opened on a page wubble
+  // draws itself (no browser, so no tab object).
+  void (*tab_opened)(int request_id, int browser_id);
+  // Runs the action as a click on the tab: 0 nothing ran, 1 ran (onClicked or
+  // blocked scripts), 2 it has a popup (*popup_url set; free_string it).
+  int (*action_click)(const char* extension_id,
+                      int browser_id,
+                      char** popup_url);
+  // 1 and |out| filled when the extension has an action, else 0.
+  int (*action_state)(const char* extension_id,
+                      int browser_id,
+                      cef_wubble_ext_action_t* out);
+  void (*free_string)(char* string);
+  void (*free_action)(cef_wubble_ext_action_t* action);
+} cef_wubble_ext_t;
+
+CEF_EXPORT const cef_wubble_ext_t* cef_wubble_ext_v1(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_CAPI_H_
diff --git a/libcef/browser/chrome/extensions/wubble_ext_impl.h b/libcef/browser/chrome/extensions/wubble_ext_impl.h
new file mode 100644
index 000000000..7b31dbe6c
--- /dev/null
+++ b/libcef/browser/chrome/extensions/wubble_ext_impl.h
@@ -0,0 +1,52 @@
+// wubble change: what the files of the wubble extension module share
+// (wubble_ext.cc: the C table and the registry; wubble_ext_open.cc: tabs
+// opened for extensions; wubble_ext_action.cc: chrome.action). UI thread only.
+
+#ifndef CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_IMPL_H_
+#define CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_IMPL_H_
+#pragma once
+
+#include <string>
+
+#include "cef/libcef/browser/chrome/extensions/wubble_ext_capi.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace cef::wubble::impl {
+
+// wubble's delegate, or null.
+const cef_wubble_ext_delegate_t* Delegate();
+
+// The main contents of the Alloy style browser |browser_id|, or null.
+content::WebContents* ContentsOf(int browser_id);
+
+// The Alloy style browser identifier of |contents| (its main contents), or 0.
+int BrowserIdOf(content::WebContents* contents);
+
+// The wubble window id of the extension window id |window_id|, or -1.
+int WubbleWindowOf(int window_id);
+
+// A malloc'd copy for the C side (free_string / free_action).
+char* CopyString(const std::string& value);
+
+// wubble_ext_open.cc.
+void TabOpened(int request_id, int browser_id);
+void FailPendingOpens();
+
+// wubble_ext_action.cc.
+int ActionClick(const char* extension_id, int browser_id, char** popup_url);
+int ActionState(const char* extension_id,
+                int browser_id,
+                cef_wubble_ext_action_t* out);
+void FreeAction(cef_wubble_ext_action_t* action);
+// Watches |profile|'s action changes for the delegate, until Unwatch.
+void WatchActions(Profile* profile);
+void UnwatchActions(Profile* profile);
+
+}  // namespace cef::wubble::impl
+
+#endif  // CEF_LIBCEF_BROWSER_CHROME_EXTENSIONS_WUBBLE_EXT_IMPL_H_

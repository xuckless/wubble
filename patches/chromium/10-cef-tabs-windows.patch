+struct WindowState {
+  int id = 0;
+  bool focused = false;
+  bool popup = false;
+  gfx::Rect bounds;
+};
+
+struct TabState {
+  int browser_id = 0;
+  int window = 0;
+  int index = 0;
+  bool active = false;
+  bool pinned = false;
+};
+
+Profile* ProfileOf(content::WebContents* contents) {
+  return Profile::FromBrowserContext(contents->GetBrowserContext());
+}

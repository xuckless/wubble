+// Sends onRemoved for a tab whose contents goes before wubble drops it.
+class TabWatch : public content::WebContentsObserver {
+ public:
+  TabWatch(content::WebContents* contents, int browser_id)
+      : WebContentsObserver(contents), browser_id_(browser_id) {}
+  void WebContentsDestroyed() override;
+
+ private:
+  const int browser_id_;
+};
+
+class Registry : public ProfileObserver {
+ public:
+  Registry() = default;
+  Registry(const Registry&) = delete;
+  Registry& operator=(const Registry&) = delete;
+
+  const cef_wubble_ext_delegate_t* delegate() const {
+    return delegate_ ? &*delegate_ : nullptr;
+  }
+
+  void SetDelegate(const cef_wubble_ext_delegate_t* delegate) {
+    if (delegate) {
+      delegate_ = *delegate;
+      return;
+    }
+    delegate_.reset();
+    impl::FailPendingOpens();
+    SetState({}, {});
+  }
+
+  const WindowState* Window(int id) const {
+    for (const auto& window : windows_) {
+      if (window.id == id) {
+        return &window;
+      }
+    }
+    return nullptr;
+  }
+
+  int WubbleWindowOf(int session_id) const {
+    for (const auto& [id, session] : sessions_) {
+      if (session.id() == session_id) {
+        return id;
+      }
+    }
+    return -1;
+  }
+
+  const TabState* TabOf(content::WebContents* contents) const {
+    int id = impl::BrowserIdOf(contents);
+    auto it = tabs_.find(id);
+    return id && it != tabs_.end() ? &it->second : nullptr;
+  }
+
+  // |window|'s tabs of |profile| by index.
+  std::vector<content::WebContents*> TabsIn(int window, Profile* profile,
+                                            bool active_only) const {
+    std::vector<std::pair<int, content::WebContents*>> found;
+    for (const auto& [id, tab] : tabs_) {
+      if (tab.window != window || (active_only && !tab.active)) {
+        continue;
+      }
+      content::WebContents* contents = impl::ContentsOf(id);
+      if (contents && ProfileOf(contents) == profile) {
+        found.emplace_back(tab.index, contents);
+      }
+    }
+    std::sort(found.begin(), found.end());
+    std::vector<content::WebContents*> out;
+    for (auto& [index, contents] : found) {
+      out.push_back(contents);
+    }
+    return out;
+  }
+
+  // Most recently focused first.
+  std::vector<WindowController*> Controllers(Profile* profile) const {
+    std::vector<WindowController*> out;
+    auto entry = profiles_.find(profile);
+    if (entry == profiles_.end()) {
+      return out;
+    }
+    for (auto it = windows_.rbegin(); it != windows_.rend(); ++it) {
+      auto controller = entry->second.find(it->id);
+      if (controller != entry->second.end()) {
+        out.push_back(controller->second.get());
+      }
+    }
+    return out;
+  }
+
+  bool Owns(const WindowController* controller) const {
+    for (const auto& [profile, controllers] : profiles_) {
+      for (const auto& [id, owned] : controllers) {
+        if (owned.get() == controller) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  void SetState(std::vector<WindowState> windows, std::vector<TabState> tabs) {
+    int old_focused = FocusedWindow();
+    windows_ = std::move(windows);
+    std::map<int, SessionID> sessions;
+    for (const auto& window : windows_) {
+      auto it = sessions_.find(window.id);
+      sessions.emplace(window.id,
+                       it != sessions_.end() ? it->second : SessionID::NewUnique());
+    }
+    sessions_ = std::move(sessions);
+    SyncControllers();
+
+    std::map<int, TabState> old_tabs = std::move(tabs_);
+    tabs_.clear();
+    for (const auto& tab : tabs) {
+      if (impl::ContentsOf(tab.browser_id) && sessions_.count(tab.window)) {
+        tabs_[tab.browser_id] = tab;
+      }
+    }
+
+    // Gone tabs first, so a window's new active tab is announced after them.
+    for (const auto& [id, tab] : old_tabs) {
+      if (tabs_.count(id)) {
+        continue;
+      }
+      watches_.erase(id);
+      if (content::WebContents* contents = impl::ContentsOf(id)) {
+        if (auto* router = RouterFor(ProfileOf(contents))) {
+          WubbleTabsAccess::Removed(router, contents);
+        }
+        SetWindowId(contents, SessionID::InvalidValue());
+      }
+    }
+    for (const auto& [id, tab] : tabs_) {
+      content::WebContents* contents = impl::ContentsOf(id);
+      SetWindowId(contents, sessions_.at(tab.window));
+      auto* router = RouterFor(ProfileOf(contents));
+      auto old = old_tabs.find(id);
+      if (old == old_tabs.end()) {
+        watches_[id] = std::make_unique<TabWatch>(contents, id);
+        if (router) {
+          WubbleTabsAccess::Created(router, contents, tab.index, tab.active);
+          // A tab inserted active is also activated (TabStripModel's
+          // ActiveTabChanged after the insertion).
+          if (tab.active) {
+            WubbleTabsAccess::Activated(router, contents);
+          }
+        }
+      } else if (router && tab.active &&
+                 (!old->second.active || old->second.window != tab.window)) {
+        WubbleTabsAccess::Activated(router, contents);
+      }
+    }
+
+    int focused = FocusedWindow();
+    if (focused != old_focused && focused != -1) {
+      for (auto& [profile, controllers] : profiles_) {
+        auto it = controllers.find(focused);
+        if (it != controllers.end()) {
+          it->second->NotifyWindowFocusChanged(true);
+        }
+      }
+    }
+  }
+
+  // The contents of a listed tab is being destroyed.
+  void ContentsGone(int browser_id, content::WebContents* contents) {
+    tabs_.erase(browser_id);
+    Profile* profile = ProfileOf(contents);
+    if (profiles_.count(profile)) {
+      if (auto* router = RouterFor(profile)) {
+        WubbleTabsAccess::Removed(router, contents);
+      }
+    }
+    watches_.erase(browser_id);  // Deletes the caller.
+  }
+
+  void RouterCreated(extensions::TabsEventRouter* router, Profile* profile) {
+    for (const auto& [id, tab] : tabs_) {
+      content::WebContents* contents = impl::ContentsOf(id);
+      if (contents && ProfileOf(contents) == profile) {
+        WubbleTabsAccess::Track(router, contents, tab.index);
+      }
+    }
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    profile_observations_.RemoveObservation(profile);
+    profiles_.erase(profile);
+    impl::UnwatchActions(profile);
+    for (auto it = tabs_.begin(); it != tabs_.end();) {
+      content::WebContents* contents = impl::ContentsOf(it->first);
+      if (!contents || ProfileOf(contents) == profile) {
+        watches_.erase(it->first);
+        it = tabs_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+
+ private:
+  using ControllerMap =
+      std::map<int, std::unique_ptr<WubbleWindowController>>;
+
+  int FocusedWindow() const {
+    for (const auto& window : windows_) {
+      if (window.focused) {
+        return window.id;
+      }
+    }
+    return -1;
+  }
+
+  static void SetWindowId(content::WebContents* contents, SessionID id) {
+    if (auto* helper = sessions::SessionTabHelper::FromWebContents(contents)) {
+      if (helper->window_id() != id) {
+        helper->SetWindowID(id);
+      }
+    }
+  }
+
+  // One controller per (listed window, loaded regular profile).
+  void SyncControllers() {
+    std::vector<Profile*> loaded;
+    if (windows_.size() && g_browser_process &&
+        g_browser_process->profile_manager()) {
+      loaded = g_browser_process->profile_manager()->GetLoadedProfiles();
+    }
+    for (auto it = profiles_.begin(); it != profiles_.end();) {
+      if (std::find(loaded.begin(), loaded.end(), it->first) == loaded.end()) {
+        profile_observations_.RemoveObservation(it->first);
+        impl::UnwatchActions(it->first);
+        it = profiles_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    for (Profile* profile : loaded) {
+      if (profile->IsOffTheRecord()) {
+        continue;
+      }
+      if (!profiles_.count(profile)) {
+        profile_observations_.AddObservation(profile);
+        impl::WatchActions(profile);
+      }
+      ControllerMap& controllers = profiles_[profile];
+      for (auto it = controllers.begin(); it != controllers.end();) {
+        it = sessions_.count(it->first) ? std::next(it) : controllers.erase(it);
+      }
+      for (const auto& window : windows_) {
+        if (!controllers.count(window.id)) {
+          controllers[window.id] = WubbleWindowController::Create(
+              window.id, sessions_.at(window.id), profile);
+        }
+      }
+    }
+  }
+
+  std::optional<cef_wubble_ext_delegate_t> delegate_;
+  // As wubble listed them: least recently focused first.
+  std::vector<WindowState> windows_;
+  // wubble window id -> its extension window id, while it is listed.
+  std::map<int, SessionID> sessions_;
+  // By browser identifier; only tabs whose contents exists.
+  std::map<int, TabState> tabs_;
+  std::map<int, std::unique_ptr<TabWatch>> watches_;
+  std::map<Profile*, ControllerMap> profiles_;
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver>
+      profile_observations_{this};
+};
+
+Registry& registry() {
+  static base::NoDestructor<Registry> instance;
+  return *instance;
+}
+
+void TabWatch::WebContentsDestroyed() {
+  registry().ContentsGone(browser_id_, web_contents());
+}
+
+bool WubbleBaseWindow::IsActive() const {
+  const WindowState* window = registry().Window(window_id_);
+  return window && window->focused;
+}
+
+gfx::Rect WubbleBaseWindow::GetBounds() const {
+  const WindowState* window = registry().Window(window_id_);
+  return window ? window->bounds : gfx::Rect();
+}
+
+std::string WubbleWindowController::GetWindowTypeText() const {
+  const WindowState* window = registry().Window(window_id_);
+  return extensions::api::tabs::ToString(
+      window && window->popup ? extensions::api::tabs::WindowType::kPopup
+                              : extensions::api::tabs::WindowType::kNormal);
+}
+
+content::WebContents* WubbleWindowController::GetActiveTab() const {
+  auto active = registry().TabsIn(window_id_, profile(), /*active_only=*/true);
+  return active.empty() ? nullptr : active.front();
+}

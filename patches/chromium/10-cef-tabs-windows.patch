+// Reaches TabsEventRouter's private dispatch (it names this class a friend),
+// the way Chromium's own tab strip observers do through TabListInterface.
+class WubbleTabsAccess {
+ public:
+  static void Track(extensions::TabsEventRouter* router,
+                    content::WebContents* contents,
+                    int index) {
+    if (!router->GetTabEntry(*contents)) {
+      router->RegisterForTabNotifications(*contents, index);
+    }
+  }
+
+  static void Created(extensions::TabsEventRouter* router,
+                      content::WebContents* contents,
+                      int index,
+                      bool active) {
+    Track(router, contents, index);
+    router->DispatchTabCreatedEvent(contents, active);
+  }
+
+  // TabsEventRouter::DispatchTabRemovedEvent, but tolerating a tab that its
+  // own TabEntry already unregistered (when the contents is being destroyed).
+  static void Removed(extensions::TabsEventRouter* router,
+                      content::WebContents* contents) {
+    base::ListValue args;
+    args.Append(extensions::ExtensionTabUtil::GetTabId(contents));
+    base::DictValue object_args;
+    object_args.Set(extensions::tabs_constants::kWindowIdKey,
+                    extensions::ExtensionTabUtil::GetWindowIdOfTab(contents));
+    object_args.Set(extensions::tabs_constants::kIsWindowClosingKey, false);
+    args.Append(std::move(object_args));
+    Profile* profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    router->DispatchEvent(profile, extensions::events::TABS_ON_REMOVED,
+                          extensions::api::tabs::OnRemoved::kEventName,
+                          std::move(args),
+                          extensions::EventRouter::UserGestureState::kUnknown);
+    router->UnregisterForTabNotifications(*contents,
+                                          /*expect_registered=*/false);
+  }
+
+  // Ported from TabsEventRouter::OnActiveTabChanged, which takes a
+  // TabListInterface wubble's windows do not have.
+  static void Activated(extensions::TabsEventRouter* router,
+                        content::WebContents* contents) {
+    base::ListValue args;
+    int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+    args.Append(tab_id);
+
+    base::DictValue object_args;
+    object_args.Set(extensions::tabs_constants::kWindowIdKey,
+                    extensions::ExtensionTabUtil::GetWindowIdOfTab(contents));
+    args.Append(object_args.Clone());
+
+    Profile* profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    router->DispatchEvent(
+        profile, extensions::events::TABS_ON_SELECTION_CHANGED,
+        extensions::api::tabs::OnSelectionChanged::kEventName, args.Clone(),
+        extensions::EventRouter::UserGestureState::kUnknown);
+    router->DispatchEvent(
+        profile, extensions::events::TABS_ON_ACTIVE_CHANGED,
+        extensions::api::tabs::OnActiveChanged::kEventName, std::move(args),
+        extensions::EventRouter::UserGestureState::kUnknown);
+
+    base::ListValue on_activated_args;
+    object_args.Set("tabId", tab_id);
+    on_activated_args.Append(std::move(object_args));
+    router->DispatchEvent(
+        profile, extensions::events::TABS_ON_ACTIVATED,
+        extensions::api::tabs::OnActivated::kEventName,
+        std::move(on_activated_args),
+        extensions::EventRouter::UserGestureState::kUnknown);
+  }
+};

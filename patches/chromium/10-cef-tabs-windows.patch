+// The router dispatching |profile|'s tab events, once an extension listens.
+extensions::TabsEventRouter* RouterFor(Profile* profile) {
+  auto* api = extensions::TabsWindowsAPI::Get(profile);
+  return api ? api->tabs_event_router() : nullptr;
+}

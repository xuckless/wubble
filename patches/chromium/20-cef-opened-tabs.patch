diff --git a/libcef/browser/chrome/extensions/wubble_ext_open.cc b/libcef/browser/chrome/extensions/wubble_ext_open.cc
new file mode 100644
index 000000000..09054fe47
--- /dev/null
+++ b/libcef/browser/chrome/extensions/wubble_ext_open.cc
@@ -0,0 +1,72 @@
+// wubble change: tabs extensions open (tabs.create, runtime.openOptionsPage,
+// clients.openWindow) are opened by wubble, which decides where they go, and
+// answered with the new tab's contents (see wubble_ext.h).
+
+#include <map>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "cef/libcef/browser/chrome/extensions/wubble_ext.h"
+#include "cef/libcef/browser/chrome/extensions/wubble_ext_impl.h"
+#include "chrome/browser/profiles/profile.h"
+#include "url/gurl.h"
+
+namespace cef::wubble {
+
+namespace {
+
+struct Pending {
+  int next = 1;
+  std::map<int, OpenedCallback> callbacks;
+};
+
+Pending& pending() {
+  static base::NoDestructor<Pending> instance;
+  return *instance;
+}
+
+}  // namespace
+
+bool OpenTab(Profile* profile,
+             const GURL& url,
+             int window_id,
+             bool active,
+             OpenedCallback callback) {
+  const cef_wubble_ext_delegate_t* delegate = impl::Delegate();
+  if (!delegate || !profile) {
+    return false;
+  }
+  int request = pending().next++;
+  pending().callbacks.emplace(request, std::move(callback));
+  int wubble_window = window_id < 0 ? -1 : impl::WubbleWindowOf(window_id);
+  delegate->open_tab(delegate->ctx, request,
+                     profile->GetOriginalProfile()->GetPath().AsUTF8Unsafe().c_str(),
+                     url.spec().c_str(), wubble_window, active ? 1 : 0);
+  return true;
+}
+
+namespace impl {
+
+void TabOpened(int request_id, int browser_id) {
+  auto it = pending().callbacks.find(request_id);
+  if (it == pending().callbacks.end()) {
+    return;
+  }
+  OpenedCallback callback = std::move(it->second);
+  pending().callbacks.erase(it);
+  std::move(callback).Run(ContentsOf(browser_id));
+}
+
+void FailPendingOpens() {
+  auto callbacks = std::move(pending().callbacks);
+  pending().callbacks.clear();
+  for (auto& [request, callback] : callbacks) {
+    std::move(callback).Run(nullptr);
+  }
+}
+
+}  // namespace impl
+
+}  // namespace cef::wubble

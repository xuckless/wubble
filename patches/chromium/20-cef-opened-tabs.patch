+void ChromeContentBrowserClientCef::OpenURL(
+    content::SiteInstance* site_instance,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::WebContents*)> callback) {
+  if (cef::wubble::IsActive()) {

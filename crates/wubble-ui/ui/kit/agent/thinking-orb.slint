// design: ../ultra-reactivate/vendor/thinking-orbs/ThinkingOrb.tsx:44-171, ../ultra-reactivate/vendor/thinking-orbs/types.ts:31-67 @598f814
// The thinking orb (Ultra Reactivate's `ThinkingOrb`, the owner's library; engine from
// Libraries.dev, MIT): a dotted 3D sphere in one of nine states. The geometry is
// wubble_core::orb (a line-for-line port), the pixels wubble-gfx's orb painter, which draws each
// frame into this orb's own texture at this element's physical size; this element only shows
// it, 1:1, so a moving orb never adds items to the shell and a still one is one image.
// Its frames come from the host while the orb's life (wubble_core::orb::Life) says it moves; at
// rest the image stays and nothing is drawn. Like the web's `<canvas role="img">`, it is an image
// named by its state's label ("Working…").
// Sizes: the design's three tuned sizes (64 chat avatar, 32 compact, 20 inline). `size` shows a
// tuned design at another side (an icon at 16, an empty state at 160): the same frame, scaled,
// as the web's canvas under a CSS transform would be (docs/fidelity/derived-review.md).

import { OrbGen } from "../gen/literals.slint";

/// The design's tuned sizes (types.ts `OrbSize`).
export enum OrbTuned { s64, s32, s20 }

export component ThinkingOrb inherits Rectangle {
    // the frame, drawn by the host into this orb's texture
    in property <image> frame;
    // the state's label (ThinkingOrb.tsx `LABELS`)
    in property <string> label;
    in property <OrbTuned> tuned: OrbTuned.s64;
    // the side shown: the tuned size unless a caller scales the design
    in property <length> size: root.tuned == OrbTuned.s64 ? OrbGen.size-64 : root.tuned == OrbTuned.s32 ? OrbGen.size-32 : OrbGen.size-20;
    width: root.size;
    height: root.size;
    accessible-role: image;
    accessible-label: root.label;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: fill;
        accessible-role: none;
    }
}

// design: core/wubble.css:15-44, browser/layer.ts:1-47 @598f814
// Moved from components.slint (a copy of the design repo's `src/wubble/slint/components.slint`
// @ 6c840da, with the marked `wubble change`s); the fallback material is 598f814's frost.

import { Radius, Glass, GlassTierStyle } from "../gen/tokens.slint";
import { Film } from "../motion/film.slint";
import { GlassTier, GlassItem, GlassLayer } from "../../components/model.slint";
import { Shell } from "../derived.slint";

// @source slint-glass-panel
// Glass approximated in Slint (the Flat quality tier, and wherever the scene glass is not under
// the item): the frost tier's fill, shadow, rims and top light. Slint has no backdrop-filter here,
// so there is no blur or refraction: put the wgpu glass quad (render.rs, same rect, radius and
// tier) underneath and this panel's fill is skipped with `over-wgpu: true`.
// The film rim (touch only) is the kit's Film (motion/film.slint).
// wubble change: with `over-wgpu` the panel reports its rectangle, radius, tier and touch state
// as data (`item`, through GlassLayer.report), which the host hands to the scene's `set_glass`
// each frame it changed; nothing calls into the scene per widget.
export component GlassPanel inherits Rectangle {
    in property <GlassTier> tier: GlassTier.regular;   // wubble change: the enum, not 0 / 1 / 2
    in property <length> radius: Radius.lg;
    // wubble change: the touch state, split for the scene; `film` follows it.
    in property <bool> hover: false;
    in property <bool> pressed: false;
    in property <bool> focused: false;
    in property <bool> film: root.hover || root.pressed || root.focused;   // touched: hover / press / drag / focus
    in property <color> tint: transparent;   // the Space colour at 10% on sidebar glass
    // wubble change: the overlay layer the scene draws this panel's glass in, above the page
    // (GlassOver; 0 under the page). An overlay is on the scene whenever the scene draws overlays.
    in property <int> over-layer: 0;
    in property <bool> over-wgpu: root.over-layer > 0 && GlassLayer.over-on;     // the wgpu glass pass draws the material underneath
    in property <bool> over-content: false;  // over live web content: thick uses Shell.thick-unblurred-fill
    // wubble change: the scene's glass, as data. `key` orders the scene's list (GlassKeys);
    // `present` is the panel's own say whether it shows.
    in property <int> key: -1;
    in property <bool> present: true;
    // The press scale, about the centre. A property of its own (callers animate it): Slint
    // reads an unbound transform-scale as 0. `absolute-position` maps the origin through the
    // transform (scaled origin), but `width` and `height` stay unscaled. `item` reads the
    // transform-scale itself, so an overlay that animates it directly (its entrance) is followed.
    in property <float> scale: 1;
    transform-scale: root.scale;
    // wubble change: the window x range a clipping parent shows (the sidebar clips its
    // contents); the scene's glass is cut to it, so it never shows where Slint clips the panel.
    in property <length> clip-start: -Shell.no-clip;
    in property <length> clip-end: Shell.no-clip;
    out property <GlassItem> item: {
        key: root.key,
        x: max(root.absolute-position.x, root.clip-start),
        y: root.absolute-position.y,
        width: max(0px, root.width * root.transform-scale - max(0px, root.clip-start - root.absolute-position.x) - max(0px, root.absolute-position.x + root.width * root.transform-scale - root.clip-end)),
        height: root.height * root.transform-scale,
        radius: root.radius * root.transform-scale,
        tier: root.tier,
        pressed: root.pressed,
        hover: root.hover,
        focus: root.focused,
        tint: root.tint,
        present: root.over-wgpu && root.present && root.visible && root.opacity > 0 && min(root.absolute-position.x + root.width * root.transform-scale, root.clip-end) > max(root.absolute-position.x, root.clip-start) && root.height > 0,
        layer: root.over-layer,
        alpha: root.opacity,
    };
    property <int> generation: GlassLayer.generation;
    init => {
        GlassLayer.report(root.item);
    }
    changed item => {
        GlassLayer.report(root.item);
    }
    changed generation => {
        GlassLayer.report(root.item);
    }

    property <GlassTierStyle> t: root.tier == GlassTier.thin ? Glass.thin : root.tier == GlassTier.regular ? Glass.regular : Glass.thick;

    // The fallback material, 598f814's coloured frost without the backdrop filter (the scene's
    // glass pass draws that): `.wb-thin/.wb-regular/.wb-thick` fill and outer shadow, the two
    // inset rims (`inset 0 0 0 1px` all round, `inset 0 1px 0` on top) and `.wb-glass::after`'s
    // top light (white 3.5 % to 0 at half height).
    // Slint limit (kit-plan section 6, L2-2): Slint scales a drop shadow by its own fill's alpha,
    // so this outer shadow is fainter than the CSS one over a translucent fill.
    border-radius: root.radius;
    background: root.over-wgpu ? transparent : root.over-content && root.tier == GlassTier.thick ? Shell.thick-unblurred-fill : root.t.fill;   // wubble change: Shell.thick-unblurred-fill over content until the scene blurs the page (owner decision 3)
    drop-shadow-offset-y: root.over-wgpu ? 0px : root.t.shadow-y;
    drop-shadow-blur: root.over-wgpu ? 0px : root.t.shadow-blur;
    drop-shadow-color: root.over-wgpu ? transparent : root.t.shadow-color;

    // tint at 10%
    Rectangle {
        border-radius: root.radius;
        background: root.tint.transparentize(0.9);
        visible: !root.over-wgpu && root.tint.alpha > 0;
    }

    // top light (.wb-glass::after)
    Rectangle {
        y: 0;
        height: parent.height * Glass.top-light-stop;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        background: @linear-gradient(180deg, Glass.top-light 0%, transparent 100%);
        visible: !root.over-wgpu;
    }

    // inset 0 0 0 1px rim-all
    Rectangle {
        border-radius: root.radius;
        inner-shadow-spread: Shell.px;
        inner-shadow-color: root.t.rim-all;
        visible: !root.over-wgpu;
    }
    // inset 0 1px 0 rim-top
    Rectangle {
        border-radius: root.radius;
        inner-shadow-offset-y: Shell.px;
        inner-shadow-color: root.t.rim-top;
        visible: !root.over-wgpu;
    }

    // film rim, only on touch. wubble change: the scene draws its own (uFilm) over wgpu.
    Film {
        radius: root.radius;
        on: root.film;
        visible: !root.over-wgpu;
    }

    @children
}

// derived: ElasticSlider compact (controls/slider.slint, .tp-sl / .st-slider) laid across a strip, SponsorBlock marks on its rail (.tp-sl-rail geometry)
// The video's scrubber (wubble-only.md §27 "Scrubber: the ElasticSlider"): the kit slider in its
// settings size, stretched to the room the strip leaves it, its 44 px track centred on the strip
// and the strip's height clipping what lies above the track (the value label: the strip has no
// room for it; the held bubble rises into the clip too). The played part is the slider's value
// (0 to 1000, the progress); a press or a drag seeks to where it lands (`seek(fraction)`), each
// value the knob passes while held, as the design reports live. The SponsorBlock segments lie
// in their own colours under the rail (its white .12 over them), so the played fill and the knob
// cover them.
// derived (docs/fidelity/derived-review.md "Overlays B"): the clip of the label row, the marks
// (the design's rail has one fill: a new variant, wubble-only.md "new primitives").

import { SettingsCss, TouchCss } from "../../gen/css.slint";
import { ElasticSlider } from "../../controls/slider.slint";
import { VideoMark } from "../../../components/model.slint";

export component BScrubber inherits Rectangle {
    // 0..1 played
    in property <float> progress;
    in property <[VideoMark]> marks;
    in property <string> label: "Seek";
    callback seek(float);

    property <float> scale: 1000;
    // the slider's track inside it: the slider's height less the track is the label row above
    property <length> track-top: slider.preferred-height - TouchCss.tp-sl--height;

    // as high as the strip makes it: the slider's taller box is clipped, never asked for; the
    // settings row's slider width when the strip has room, less when it has not
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: SettingsCss.st-slider-tp-sl-wrap--width;

    // the knob's half reaches past both ends (the slider's own travel): the clip is the strip's
    // height only
    property <length> overhang: TouchCss.tp-sl-knob--width / 2;
    Rectangle {
        x: -root.overhang;
        width: root.width + 2 * root.overhang;
        clip: true;
        for mark in root.marks: Rectangle {
            x: root.overhang + mark.from * root.width;
            width: max(TouchCss.tp-sl-rail--height / 4, (mark.to - mark.from) * root.width);
            y: (root.height - self.height) / 2;
            height: TouchCss.tp-sl-rail--height;
            background: mark.colour;
        }
        slider := ElasticSlider {
            compact: true;
            label: root.label;
            min: 0;
            max: root.scale;
            step: 1;
            value: root.progress * root.scale;
            x: root.overhang;
            width: root.width;
            y: (root.height - TouchCss.tp-sl--height) / 2 - root.track-top;
            edited(v) => {
                root.seek(v / root.scale);
            }
        }
    }
}

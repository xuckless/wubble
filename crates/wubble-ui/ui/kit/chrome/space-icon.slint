// design: slint/space-icons.json:1-6, browser/icons.tsx:31-41 @598f814
// Moved from components.slint (a copy of the design repo's `src/wubble/slint/components.slint`
// @ 6c840da, with the marked `wubble change`s), unchanged.

import { Palette, Motion } from "../../tokens.slint";
import { SpaceIcons } from "../gen/icons.slint";

export component SpaceIcon inherits Path {
    // "personal" | "work" | "study"
    in property <string> kind: "personal";
    in property <color> tint: Palette.ink;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.kind == "work" ? SpaceIcons.work : root.kind == "study" ? SpaceIcons.study : SpaceIcons.personal;
    fill: transparent;
    stroke: root.tint;
    // Slint strokes in logical px, not viewbox units: keep the icon at 24px (or scale this too).
    stroke-width: 1.7px;
    stroke-line-cap: round;
    animate stroke { duration: 150ms; easing: Motion.easeOut; }
}

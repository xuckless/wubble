// derived: `.wb-tab-x` (browser/browser.css:75-78: a 22 tile, radius 7, white 10 % on its own hover, the glyph in mist then ink) + Icon(controls/icon.slint, the generated `zap` glyph) + Palette sky / coral
// The mark of an agent session, wubble-only (docs/fidelity/derived-review.md, Agent sessions):
// on each tab row the session drives and on the Space header of its Space. The design has no
// agent; this is the tab row's close tile in the position of the speaker, the bolt in the sky
// at rest (the accent every "something is running" mark in the design takes) and in coral on its
// own hover, where a click stops every agent session (`stopped`: the command is Stop All Agents). A
// button "Stop all agents" to assistive tech, so the stop is never mouse-only. The steady glow the research note asks for waits for
// the owner (a new primitive).

import { Palette } from "../gen/tokens.slint";
import { BrowserCss } from "../gen/css.slint";
import { Shell } from "../derived.slint";
import { Icon, Glyph } from "../controls/icon.slint";
import { Calm } from "../motion/calm.slint";

export component AgentMark inherits Rectangle {
    callback stopped();
    // the slot keeps the row's height, the tile in it is the 22 square
    width: Shell.speaker;
    accessible-role: AccessibleRole.button;
    accessible-label: "Stop all agents";
    accessible-description: "An agent drives this";
    accessible-action-default => {
        root.stopped();
    }
    tile := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Shell.speaker;
        height: Shell.speaker;
        border-radius: Shell.tab-close-radius;
        background: touch.has-hover ? BrowserCss.wb-tab-x-hover--background : transparent;
        animate background { duration: Calm.ms(BrowserCss.wb-tab-x--transition-background-color-duration); easing: ease; }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Shell.tab-close-icon;
            path: Glyph.zap;
            tint: touch.has-hover ? Palette.coral : Palette.sky;
            animate tint { duration: Calm.ms(BrowserCss.wb-tab-x--transition-background-color-duration); easing: ease; }
        }
    }
    touch := TouchArea {
        clicked => {
            root.stopped();
        }
    }
}

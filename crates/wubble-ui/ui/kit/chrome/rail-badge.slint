// derived: window-lights.slint (the close light: a round `.wb-light`, white .18, a coloured light with its dark glyph on hover), tab-row.slint (`.wb-tab-x`: the glyph in its hover ink, to read on the small badge, fading in over .15 s and growing from .8 over .2 s ease-out while the row is hovered)
// A round badge on a tab icon's corner, on the sidebar's rail and on the extended row's favicon.
// The close badge (owner, 2026-11-19: "on these icons I'd like to see a (x) mark that closes the
// tab … on the top left corner") is the window's close light at its own size, centred on the
// tab icon's top-left corner; it shows while the row or the badge is hovered, as the full row's
// close button does. The sound badge (top-right: mutes, unmutes) is the same circle with its own
// glyph and hover light, always shown: `shown` is what fades and grows the circle. The agent
// badge (bottom-right) is the same circle as an indicator only (`inert`: no pointer input, no
// hover light, a press falls through to the row). Recorded in docs/fidelity/derived-review.md.

import { BrowserCss } from "../gen/css.slint";
import { Shell } from "../derived.slint";
import { Icon, Glyph } from "../controls/icon.slint";
import { Calm } from "../motion/calm.slint";

export component RailBadge inherits Rectangle {
    in property <bool> shown;
    in property <string> icon-path: Glyph.close;
    in property <string> label: "Close tab";
    // the light the circle takes on its own hover: the window's close (coral) by default
    in property <color> light: BrowserCss.wb-lights-hover-wb-light-nth-child-1--background;
    // an indicator: takes no pointer input and is no button to assistive tech (the button is the
    // touch area)
    in property <bool> inert: false;
    callback clicked();
    in-out property <bool> hovered;

    width: BrowserCss.wb-light--width;
    height: BrowserCss.wb-light--height;

    Rectangle {
        border-radius: self.width * BrowserCss.wb-light--border-radius;
        background: root.hovered ? root.light : BrowserCss.wb-light--background;
        animate background {
            duration: Calm.ms(BrowserCss.wb-light--transition-background-color-duration);
            easing: ease;
        }
        opacity: root.shown ? BrowserCss.wb-tab-hover-wb-tab-x--opacity : BrowserCss.wb-tab-x--opacity;
        animate opacity {
            duration: Calm.ms(BrowserCss.wb-tab-x--transition-opacity-duration);
            easing: ease;
        }
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.shown ? BrowserCss.wb-tab-hover-wb-tab-x--scale : BrowserCss.wb-tab-x--scale;
        animate transform-scale {
            duration: Calm.ms(BrowserCss.wb-tab-x--transition-scale-duration);
            easing: BrowserCss.wb-tab-x--transition-scale-easing;
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Shell.light-glyph;
            weight: Shell.light-stroke;
            path: root.icon-path;
            tint: root.hovered ? BrowserCss.wb-lights-hover-wb-light--color : BrowserCss.wb-tab-x-hover--color;
            animate tint {
                duration: Calm.ms(BrowserCss.wb-light--transition-color-duration);
                easing: ease;
            }
        }
    }
    if !root.inert: TouchArea {
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        accessible-action-default => {
            root.clicked();
        }
        enabled: root.shown;
        mouse-cursor: pointer;
        changed has-hover => {
            root.hovered = self.has-hover;
        }
        clicked => {
            root.clicked();
        }
    }
}

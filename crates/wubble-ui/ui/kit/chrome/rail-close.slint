// derived: window-lights.slint (the close light: a round `.wb-light`, white .18, coral with its dark glyph on hover), tab-row.slint (`.wb-tab-x`: the close glyph (in its hover ink, to read on the small badge), fading in over .15 s and growing from .8 over .2 s ease-out while the row is hovered)
// The close badge of a tab on the sidebar's rail (owner, 2026-11-19: "on these icons I'd like
// to see a (x) mark that closes the tab … on the top left corner"): the window's close light at
// its own size, centred on the tab icon's top-left corner; it shows while the row or the badge
// is hovered, as the full row's close button does. Recorded in
// notes/fidelity/derived-review.md.

import { BrowserCss } from "../gen/css.slint";
import { Shell } from "../derived.slint";
import { Icon, Glyph } from "../controls/icon.slint";
import { Calm } from "../motion/calm.slint";

export component RailClose inherits Rectangle {
    in property <bool> shown;
    callback clicked();
    out property <bool> hovered: ta.has-hover;

    width: BrowserCss.wb-light--width;
    height: BrowserCss.wb-light--height;
    accessible-role: AccessibleRole.button;
    accessible-label: "Close tab";
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: self.width * BrowserCss.wb-light--border-radius;
        background: ta.has-hover ? BrowserCss.wb-lights-hover-wb-light-nth-child-1--background : BrowserCss.wb-light--background;
        animate background {
            duration: Calm.ms(BrowserCss.wb-light--transition-background-color-duration);
            easing: ease;
        }
        opacity: root.shown ? BrowserCss.wb-tab-hover-wb-tab-x--opacity : BrowserCss.wb-tab-x--opacity;
        animate opacity {
            duration: Calm.ms(BrowserCss.wb-tab-x--transition-opacity-duration);
            easing: ease;
        }
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.shown ? BrowserCss.wb-tab-hover-wb-tab-x--scale : BrowserCss.wb-tab-x--scale;
        animate transform-scale {
            duration: Calm.ms(BrowserCss.wb-tab-x--transition-scale-duration);
            easing: BrowserCss.wb-tab-x--transition-scale-easing;
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Shell.light-glyph;
            weight: Shell.light-stroke;
            path: Glyph.close;
            tint: ta.has-hover ? BrowserCss.wb-lights-hover-wb-light--color : BrowserCss.wb-tab-x-hover--color;
            animate tint {
                duration: Calm.ms(BrowserCss.wb-light--transition-color-duration);
                easing: ease;
            }
        }
    }
    ta := TouchArea {
        enabled: root.shown;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

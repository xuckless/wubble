// design: browser/chrome.tsx:294-300, browser/browser.css:85-89 @598f814
// The sidebar's footer (`.wb-side-bottom`): the Space switcher, then the icon buttons pushed to
// the far end (`.wb-spaces + .wb-ib { margin-left: auto }`), each `.wb-ib` 36 x 36, radius 12,
// side by side; on the rail a column 10 apart (`.wb-side-bottom-rail`). The design's buttons are
// Source and Settings; wubble adds its downloads list first while there are downloads
// (derived: docs/fidelity/derived-review.md).
// wubble (owner, 2026-11-19): the switcher is the current Space's tile and the "^" that opens
// the Spaces popup (kit SpaceCurrent, SpacesButton; every Space is switched to through the
// popup). The Source button is gone: developer tools stay in the page's menu ("Inspect"), their
// shortcut and the command bar. Its place, before downloads, is the extensions button (the
// puzzle piece, shown once an extension is installed; derived-review.md "Extensions popover").

import { BrowserCss } from "../gen/css.slint";
import { IconButton } from "../controls/icon-button.slint";
import { Glyph } from "../controls/icon.slint";
import { SpaceCurrent } from "space-switcher.slint";
import { SpacesButton } from "spaces-button.slint";
import { SpaceItem } from "../../components/model.slint";

export component SideBottom inherits Rectangle {
    in property <[SpaceItem]> spaces;
    // the window's Space's row in `spaces`, -1 for none
    in property <int> active: -1;
    in property <bool> vertical: false;
    in property <bool> has-downloads: false;
    // an extension is installed: the extensions button shows, first of the buttons
    in property <bool> has-extensions: false;
    // the extensions popover (or an action's popup) is open
    in property <bool> extensions-open: false;
    // the Spaces popup is open
    in property <bool> spaces-open: false;
    callback spaces-requested();
    callback downloads-requested();
    callback extensions-requested();
    callback settings-requested();

    property <length> ib: BrowserCss.wb-side-bottom-gt-wb-ib--width;
    property <length> gap: BrowserCss.wb-side-bottom-rail--gap;
    // the tile pitch (`.wb-space` and `.wb-spaces` gap)
    property <length> pitch: BrowserCss.wb-space--width + BrowserCss.wb-spaces--gap;
    // the switcher: the current Space's tile and the "^"
    property <length> spaces-span: root.pitch + BrowserCss.wb-space--width;
    property <int> buttons: (root.has-extensions ? 1 : 0) + (root.has-downloads ? 1 : 0) + 1;
    // the buttons' places, in order: the row from the far end, the column under the switcher
    function place(k: int) -> length {
        return root.vertical ? root.spaces-span + root.gap + k * (root.ib + root.gap) : root.width - (root.buttons - k) * root.ib;
    }
    // where the parts fall, in window px (the alignment the tests pin, the popovers' anchors)
    out property <length> spaces-x: current.absolute-position.x;
    out property <length> spaces-y: current.absolute-position.y;
    out property <length> switcher-w: root.vertical ? current.width : root.spaces-span;
    out property <length> switcher-h: root.vertical ? root.spaces-span : current.height;
    out property <length> more-x: more.absolute-position.x;
    out property <length> more-y: more.absolute-position.y;
    out property <length> more-w: more.width;
    out property <length> extensions-x: extensions.absolute-position.x;
    out property <length> extensions-y: extensions.absolute-position.y;
    out property <length> extensions-w: extensions.width;
    out property <length> downloads-x: downloads.absolute-position.x;
    out property <length> downloads-y: downloads.absolute-position.y;
    out property <length> downloads-w: downloads.width;
    out property <length> settings-x: settings.absolute-position.x;
    out property <length> settings-w: settings.width;
    height: root.vertical ? root.spaces-span + root.buttons * (root.ib + root.gap) : BrowserCss.wb-space--height;

    // a click on the current Space opens the popup too (it switches nothing)
    current := SpaceCurrent {
        x: root.vertical ? (root.width - self.width) / 2 : 0px;
        y: 0px;
        known: root.active >= 0 && root.active < root.spaces.length;
        space: self.known ? root.spaces[root.active] : { };
        expanded: root.spaces-open;
        clicked => {
            root.spaces-requested();
        }
    }
    more := SpacesButton {
        x: root.vertical ? (root.width - self.width) / 2 : root.pitch;
        y: root.vertical ? root.pitch : 0px;
        open: root.spaces-open;
        clicked => {
            root.spaces-requested();
        }
    }
    // wubble: the extensions button, first of the buttons (owner, 2026-11-19)
    extensions := IconButton {
        visible: root.has-extensions;
        width: root.ib;
        height: BrowserCss.wb-side-bottom-gt-wb-ib--height;
        border-radius: BrowserCss.wb-side-bottom-gt-wb-ib--border-radius;
        x: root.vertical ? (root.width - self.width) / 2 : root.place(0);
        y: root.vertical ? root.place(0) : 0px;
        icon-path: Glyph.puzzle;
        label: "Extensions";
        on: root.extensions-open;
        clicked => {
            root.extensions-requested();
        }
    }
    // wubble: the downloads list (the design has no downloads)
    downloads := IconButton {
        visible: root.has-downloads;
        width: root.ib;
        height: BrowserCss.wb-side-bottom-gt-wb-ib--height;
        border-radius: BrowserCss.wb-side-bottom-gt-wb-ib--border-radius;
        x: root.vertical ? (root.width - self.width) / 2 : root.place(root.has-extensions ? 1 : 0);
        y: root.vertical ? root.place(root.has-extensions ? 1 : 0) : 0px;
        icon-path: Glyph.download;
        tip-action: "open-downloads";
        label: "Downloads";
        clicked => {
            root.downloads-requested();
        }
    }
    // Settings, always at the far end
    settings := IconButton {
        width: root.ib;
        height: BrowserCss.wb-side-bottom-gt-wb-ib--height;
        border-radius: BrowserCss.wb-side-bottom-gt-wb-ib--border-radius;
        x: root.vertical ? (root.width - self.width) / 2 : root.place(root.buttons - 1);
        y: root.vertical ? root.place(root.buttons - 1) : 0px;
        icon-path: Glyph.settings;
        tip-action: "open-settings";
        label: "Settings";
        clicked => {
            root.settings-requested();
        }
    }
}

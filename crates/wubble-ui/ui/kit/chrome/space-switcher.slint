// design: browser/tabs.tsx:138-174, browser/chrome.tsx:285-287, browser/browser.css:57-58, browser/browser.css:92-96, core/wubble.css:59-69 @598f814
// The Space switcher's tile (`SpaceSwitcher`, `.wb-spaces`): the drawn icon (17, stroke 1.7) on a
// 36 x 36 tile, in ink, as the web renders it: `.wb-space`'s haze (0,1,0) loses to `.wb button
// { color: inherit }` (0,1,1), so a tile takes `.wb`'s ink at rest and when active (`.wb-space-on`
// loses too), and `.wb-space:hover` (0,2,0) is ink as well (the colour transition .2 s stays); no
// press; a click wobbles the tile (`wb-wob-a/b`). Under it the capsule (`.wb-spaces-ind`: 36 x 36,
// radius 12, the active Space's colour at .2, the colour moving over .4 s ease-in-out).
// wubble (owner, 2026-11-19: "no per-Space icons any more: all switching through the popup"):
// only the current Space's tile shows, so the capsule rests under it and never travels; the
// colour still moves when the Space changes. A click opens the Spaces popup (kit SpacesMenu)
// as the "^" beside it does. Recorded in docs/fidelity/derived-review.md.
// The Space's name over the tabs (`.wb-space-name`): 18 high, padding 2 10 0, 12 / 500 mist,
// entering with the Overlap (`wb-in`) when the Space changes.

import { BrowserCss, WubbleCss } from "../gen/css.slint";
import { Role } from "../gen/text.slint";
import { Shell } from "../derived.slint";
import { KitText } from "../text.slint";
import { Icon, Glyph } from "../controls/icon.slint";
import { Wobble } from "../motion/wobble.slint";
import { Entering } from "../motion/overlap.slint";
import { Calm } from "../motion/calm.slint";
import { FocusRing, FocusKeys } from "../../components/focus-ring.slint";
import { SpaceItem } from "../../components/model.slint";
import { AgentMark } from "agent-mark.slint";

export global SpaceTint {
    // computed: `.wb-space:hover` (0,2,0) when hovered, else `.wb button`'s inherited `.wb` ink
    public pure function of(hover: bool, on: bool) -> color {
        return hover ? BrowserCss.wb-space-hover--color : WubbleCss.wb--color;
    }
}

export component SpaceCurrent inherits Rectangle {
    // the window's Space; `known` false: none yet (no tile, no capsule colour)
    in property <SpaceItem> space;
    in property <bool> known;
    // the popup it opens is open
    in property <bool> expanded;
    callback clicked();
    // tabs.tsx SpaceSwitcher: each click wobbles the tile once more
    property <bool> hit: false;
    width: BrowserCss.wb-space--width;
    height: BrowserCss.wb-space--height;
    accessible-role: AccessibleRole.button;
    accessible-label: root.space.name;
    accessible-description: "Current Space";
    accessible-expanded: root.expanded;
    accessible-action-default => {
        root.clicked();
    }
    // `.wb-spaces-ind`, at rest under the one tile
    Rectangle {
        width: BrowserCss.wb-spaces-ind--width;
        height: BrowserCss.wb-spaces-ind--height;
        border-radius: BrowserCss.wb-spaces-ind--border-radius;
        background: root.known ? root.space.tint : transparent;
        opacity: BrowserCss.wb-spaces-ind--opacity;
        animate background {
            duration: Calm.ms(BrowserCss.wb-spaces-ind--transition-background-color-duration);
            easing: BrowserCss.wb-spaces-ind--transition-background-color-easing;
        }
    }
    keys := FocusKeys {
        activate => {
            root.hit = !root.hit;
            root.clicked();
        }
    }
    ta := TouchArea {
        clicked => {
            root.hit = !root.hit;
            root.clicked();
        }
    }
    Wobble {
        width: parent.width;
        height: parent.height;
        hit: root.hit;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Shell.space-glyph;
            path: Glyph.space(root.space.icon);
            visible: root.known;
            tint: SpaceTint.of(ta.has-hover, true);
            animate tint {
                duration: Calm.ms(BrowserCss.wb-space--transition-color-duration);
                easing: ease;
            }
        }
    }
    FocusRing {
        shown: keys.has-focus;
        radius: BrowserCss.wb-spaces-ind--border-radius;
    }
}

// `.wb-space-name`: the active Space's name, entering with `wb-in` (`enter` 0 to 1).
export component SpaceName inherits Rectangle {
    in property <string> text;
    in property <float> enter: 1;
    // wubble: an agent session's Space: the mark at the end of the header (kit AgentMark).
    in property <bool> agent;
    callback agent-stop();
    height: BrowserCss.wb-space-name--height;
    Entering {
        e: root.enter;
        KitText {
            x: BrowserCss.wb-space-name--padding-left;
            y: BrowserCss.wb-space-name--padding-top;
            width: parent.width - BrowserCss.wb-space-name--padding-left - BrowserCss.wb-space-name--padding-right;
            height: parent.height - BrowserCss.wb-space-name--padding-top;
            role: Role.wb-space-name;
            text: root.text;
            color: BrowserCss.wb-space-name--color;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.agent: AgentMark {
            x: parent.width - self.width - BrowserCss.wb-space-name--padding-right;
            y: (parent.height - self.height) / 2;
            stopped => {
                root.agent-stop();
            }
        }
    }
}

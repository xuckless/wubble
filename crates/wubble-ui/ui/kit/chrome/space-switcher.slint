// design: browser/tabs.tsx:138-174, browser/chrome.tsx:285-287, browser/browser.css:57-58, browser/browser.css:92-96, core/wubble.css:59-69 @598f814
// The Space switcher (`SpaceSwitcher`, `.wb-spaces`): the drawn icons (17, stroke 1.7) 36 x 36
// tiles 2 apart, in a row or a column (`.wb-spaces-v`); each icon in ink, as the web renders it:
// `.wb-space`'s haze (0,1,0) loses to `.wb button { color: inherit }` (0,1,1), so a tile takes
// `.wb`'s ink at rest and when active (`.wb-space-on` loses too), and `.wb-space:hover` (0,2,0)
// is ink as well (the colour transition .2 s stays); no press; a click wobbles the tile
// (`wb-wob-a/b`). Under them the capsule (`.wb-spaces-ind`: 36 x 36, radius 12, the active
// Space's colour at .2, the colour moving over .4 s ease-in-out) follows the active one and
// stretches between them: the follow spring and the stretch are Rust's (wubble_core::tabs
// `SpaceSwitcher`), written in as `offset`, `stretch` and `origin`.
// The Space's name over the tabs (`.wb-space-name`): 18 high, padding 2 10 0, 12 / 500 mist,
// entering with the Overlap (`wb-in`) when the Space changes.

import { BrowserCss, WubbleCss } from "../gen/css.slint";
import { Role } from "../gen/text.slint";
import { Shell } from "../derived.slint";
import { KitText } from "../text.slint";
import { Icon, Glyph } from "../controls/icon.slint";
import { Wobble } from "../motion/wobble.slint";
import { Entering } from "../motion/overlap.slint";
import { Calm } from "../motion/calm.slint";
import { SpaceItem } from "../../components/model.slint";

export global SpaceTint {
    // computed: `.wb-space:hover` (0,2,0) when hovered, else `.wb button`'s inherited `.wb` ink
    public pure function of(hover: bool, on: bool) -> color {
        return hover ? BrowserCss.wb-space-hover--color : WubbleCss.wb--color;
    }
}

export component SpaceSwitcher inherits Rectangle {
    in property <[SpaceItem]> spaces;
    // the active Space's row in `spaces`, -1 for none
    in property <int> active: -1;
    in property <bool> vertical: false;
    // the capsule: offset along the switcher (the follow spring times the pitch), its stretch
    // and the stretch's origin along it (wubble_core::tabs::SpaceSwitcher)
    in property <length> offset: 0px;
    in property <float> stretch: 1;
    in property <float> origin: 0.3;
    callback picked(int);
    out property <length> pitch: BrowserCss.wb-space--width + BrowserCss.wb-spaces--gap;
    out property <length> span: max(0px, root.spaces.length * root.pitch - BrowserCss.wb-spaces--gap);
    width: root.vertical ? BrowserCss.wb-space--width : root.span;
    height: root.vertical ? root.span : BrowserCss.wb-space--height;
    accessible-role: AccessibleRole.tab-list;
    accessible-label: "Spaces";

    // `.wb-spaces-ind`: along the axis stretched about `origin`, across it squashed
    property <length> along: BrowserCss.wb-spaces-ind--width * root.stretch;
    property <length> across: BrowserCss.wb-spaces-ind--width / Math.sqrt(root.stretch);
    property <length> at: root.offset + (BrowserCss.wb-spaces-ind--width - self.along) * root.origin;
    Rectangle {
        x: root.vertical ? (BrowserCss.wb-spaces-ind--width - root.across) / 2 : root.at;
        y: root.vertical ? root.at : (BrowserCss.wb-spaces-ind--height - root.across) / 2;
        width: root.vertical ? root.across : root.along;
        height: root.vertical ? root.along : root.across;
        border-radius: BrowserCss.wb-spaces-ind--border-radius;
        background: root.active >= 0 && root.active < root.spaces.length ? root.spaces[root.active].tint : transparent;
        opacity: BrowserCss.wb-spaces-ind--opacity;
        animate background {
            duration: Calm.ms(BrowserCss.wb-spaces-ind--transition-background-color-duration);
            easing: BrowserCss.wb-spaces-ind--transition-background-color-easing;
        }
    }

    for space[i] in root.spaces: tile := Rectangle {
        // tabs.tsx SpaceSwitcher: each click wobbles the tile once more
        property <bool> hit: false;
        property <bool> on: i == root.active;
        x: root.vertical ? 0px : i * root.pitch;
        y: root.vertical ? i * root.pitch : 0px;
        width: BrowserCss.wb-space--width;
        height: BrowserCss.wb-space--height;
        accessible-role: AccessibleRole.tab;
        accessible-label: space.name;
        accessible-item-selectable: true;
        accessible-item-selected: tile.on;
        accessible-action-default => {
            root.picked(space.id);
        }
        ta := TouchArea {
            clicked => {
                tile.hit = !tile.hit;
                root.picked(space.id);
            }
        }
        Wobble {
            width: parent.width;
            height: parent.height;
            hit: tile.hit;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: Shell.space-glyph;
                path: Glyph.space(space.icon);
                tint: SpaceTint.of(ta.has-hover, tile.on);
                animate tint {
                    duration: Calm.ms(BrowserCss.wb-space--transition-color-duration);
                    easing: ease;
                }
            }
        }
    }
}

// `.wb-space-name`: the active Space's name, entering with `wb-in` (`enter` 0 to 1).
export component SpaceName inherits Rectangle {
    in property <string> text;
    in property <float> enter: 1;
    height: BrowserCss.wb-space-name--height;
    Entering {
        e: root.enter;
        KitText {
            x: BrowserCss.wb-space-name--padding-left;
            y: BrowserCss.wb-space-name--padding-top;
            width: parent.width - BrowserCss.wb-space-name--padding-left - BrowserCss.wb-space-name--padding-right;
            height: parent.height - BrowserCss.wb-space-name--padding-top;
            role: Role.wb-space-name;
            text: root.text;
            color: BrowserCss.wb-space-name--color;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// design: pages/start.tsx:16-55, pages/start.css:1-32 @598f814
// The start page's front (wubble://start, the new-tab page): the heading, the search capsule and
// the site tiles over the living bubble. The bubble, its minis and the liquid are the scene's
// (wubble_core::start::Living drives them, the scene's bubble and pop passes draw them): this
// page is transparent so they show through, and the `wb-start` ground is the scene's. The stage
// (the web's canvas) is the TouchArea under the front: presses the front's widgets leave reach
// it, as `.wb-start-front { pointer-events: none }` lets them through to the canvas; its cursor
// is the canvas's (`pointer`, `grabbing` while the body is held: core/living.ts:29, 58, 64).
//
// The search capsule is the page's address field (owner, 2026-11-19: "for start page the center
// address bar should be the only driver"): the kit SearchCapsule at `.wb-start-search`'s geometry
// (54 high, radius 27, padding 20, gap 12, min(520, 100%), its `<kbd>` shortcut while empty),
// a real input where the web's is a button opening the bar. The command bar lives here while
// the start page shows (wubble_core::chrome::Placement::InPage): what is typed goes to the same
// query and suggestions as the overlay bar's, and the results drop beneath the capsule in the
// kit CommandPanel and CommandList (the bar's thick glass and rows), `TouchMenu.gap` under it as
// a menu hangs under its trigger (derived: docs/fidelity/derived-review.md). Up / Down move the
// selection, Enter picks it, Escape clears the text and then lets go of the keys.
// Slots, each behind ONE component boundary with the design's geometry, filled by the lanes
// that own the looks:
// - SLOT site tile (L3 Button look): `StartTile`, PressableButton's .97 press; the design's icon
//   hover 1.08 (.45 s spring) and active (1.1, .88) at .12 s are not drawn yet.
// Entrances: OverlapLayer with the design's delays and durations (start.css `wb-in`: heading
// 40 ms / .4 s, search 80 ms / .4 s, tile i 120 + 30 i ms / .36 s), blur included (OverlapLook).

import { Palette, TouchMenu } from "../gen/tokens.slint";
import { StartCss, BrowserCss } from "../gen/css.slint";
import { StartGen } from "../gen/literals.slint";
import { Role } from "../gen/text.slint";
import { KitText } from "../text.slint";
import { Shell } from "../derived.slint";
import { GlassPanel } from "../material/glass.slint";
import { PressableButton } from "../controls/button.slint";
import { OverlapLayer } from "../motion/overlap.slint";
import { SearchCapsule } from "../controls/search-capsule.slint";
import { CommandPanel, CommandList } from "../chrome/command-list.slint";
import { CommandBarState, CommandResult, GlassTier } from "../../components/model.slint";

// A site on the start page: the shell's own favourites (wubble's data and wording).
export struct StartSite {
    title: string,
    url: string,
    favicon: image,
}

// The host's side of the start page (wubble host/start.rs): what it shows, and the stage's
// pointer and the front's intents back. One page shows at a time, so one bridge per window.
export global StartBridge {
    in property <[StartSite]> sites;
    in property <string> shortcut;
    // the body is held: the stage's cursor
    in property <bool> grabbing;
    // the search capsule's centre, window coordinates (where the start smoke clicks)
    in-out property <length> search-x;
    in-out property <length> search-y;
    // the capsule has the keys (what the start smoke checks)
    in-out property <bool> search-focused;
    // the driver's FocusInput and RestoreFocus for the bar in the page: each bump takes the keys
    // (text selected) or lets them go
    in-out property <int> focus-serial;
    in-out property <int> release-serial;
    callback site-activated(string);
    // page-local logical px
    callback stage-down(length, length);
    callback stage-move(length, length);
    callback stage-up();
    callback stage-leave();
}

// SLOT site tile (L3 Button look): one `wb-start-site` button, its icon and its name.
component StartTile inherits PressableButton {
    in property <StartSite> site;
    padding-x: 0px;
    background: transparent;
    label: root.site.title;
    VerticalLayout {
        spacing: StartCss.wb-start-site--gap;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            GlassPanel {
                width: StartCss.wb-start-site-icon--width;
                height: StartCss.wb-start-site-icon--height;
                tier: GlassTier.thin;
                radius: self.width * StartCss.wb-start-site-icon--border-radius;
                hover: root.hovered;
                pressed: root.pressed;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: StartGen.favicon;
                    height: StartGen.favicon;
                    source: root.site.favicon;
                }
            }
        }
        KitText {
            role: Role.wb-start-site;
            text: root.site.title;
            horizontal-alignment: center;
            overflow: elide;
            color: root.hovered ? StartCss.wb-start-site-hover--color : StartCss.wb-start-site--color;
        }
    }
}

export component StartPage inherits Rectangle {
    in property <[StartSite]> sites;
    // the page's own copy (pages/start.tsx)
    in property <string> heading: "Let's Wubble";
    in property <string> placeholder: "Search or type an address";
    // the focus-address shortcut as the shell's key table writes it
    in property <string> shortcut;
    // false while the page is covered: the parts leave, and enter again staggered
    in property <bool> shown: true;
    // the body is held (the stage's cursor)
    in property <bool> grabbing;
    callback site-activated(string);
    // the capsule's centre in window coordinates
    out property <length> search-x: search.absolute-position.x + search.width / 2;
    out property <length> search-y: search.absolute-position.y + search.height / 2;
    out property <bool> search-focused: search.focused;
    // The command bar in the page (wubble_core::chrome::Placement::InPage): its state (closed
    // unless the bar is here), the query (the bar's own), its rows; the driver's effects come
    // as serials (FocusInput, RestoreFocus).
    in property <CommandBarState> state: CommandBarState.closed;
    in-out property <string> query <=> search.text;
    in property <[CommandResult]> results;
    in property <int> focus-serial;
    in property <int> release-serial;
    changed focus-serial => {
        list.selected = 0;
        search.take-focus-all();
    }
    changed release-serial => {
        search.drop-focus();
    }
    callback query-changed(string);
    callback result-chosen(int);
    // the capsule took or lost the keys
    callback focus-changed(bool);
    out property <bool> results-shown: root.state == CommandBarState.open && root.query != "";
    out property <int> shown-rows: list.count;
    // the stage's pointer, page-local logical px
    callback stage-down(length, length);
    callback stage-move(length, length);
    callback stage-up();
    callback stage-leave();

    // @media (max-height: 560px): higher up, tighter, no tiles
    property <bool> compact: root.height <= StartGen.compact-max;
    property <length> pad-x: StartCss.wb-start-front--padding-left;
    property <length> inner: root.width - root.pad-x - StartCss.wb-start-front--padding-right;
    property <length> gap: root.compact ? StartCss.max-height-560px-wb-start-front--gap : StartCss.wb-start-front--gap;
    property <length> search-width: min(StartGen.search-max-width, root.inner);
    // flex-wrap: as many tiles per row as fit, rows centred
    property <length> tile: StartCss.wb-start-site--width;
    property <length> col-gap: StartCss.wb-start-sites--gap-column;
    property <int> per-row: max(1, floor((root.inner + root.col-gap) / (root.tile + root.col-gap)));
    property <length> tile-height: StartCss.wb-start-site-icon--height + StartCss.wb-start-site--gap + Role.wb-start-site.size * Role.wb-start-site.line-height;

    background: transparent;

    // the stage: the web's canvas under the front (`.wb-start-stage`, inset 0)
    stage := TouchArea {
        mouse-cursor: root.grabbing ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                // a press on the stage takes the keys from the capsule, as the web's canvas would
                search.drop-focus();
                root.stage-down(self.mouse-x, self.mouse-y);
            } else if e.kind == PointerEventKind.move {
                root.stage-move(self.mouse-x, self.mouse-y);
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) || e.kind == PointerEventKind.cancel {
                // `pointerup` and `pointercancel` (living.ts onUp)
                root.stage-up();
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.stage-leave();
            }
        }
    }

    front := VerticalLayout {
        x: root.pad-x;
        // the capsule's centre at Shell.start-search-at of the page (owner override); the compact
        // page keeps the design's top
        y: root.compact ? root.height * StartCss.max-height-560px-wb-start-front--top : root.height * Shell.start-search-at - StartCss.wb-start-search--height / 2 - root.gap - h1.preferred-height;
        width: root.inner;
        height: self.preferred-height;
        spacing: root.gap;
        alignment: start;

        OverlapLayer {
            shown: root.shown;
            delay: StartCss.wb-start-h1--animation-delay;
            duration: StartCss.wb-start-h1--animation-duration;
            height: h1.preferred-height;
            // `<h1 class="wb-display">`
            h1 := KitText {
                role: Role.display;
                width: parent.width;
                text: root.heading;
                horizontal-alignment: center;
                color: Palette.ink;
                // clamp(30px, 4vw, 44px)
                font-size: clamp(root.width * StartGen.heading-vw / 100, StartCss.wb-start-h1--font-size-min, StartCss.wb-start-h1--font-size-max);
            }
        }

        OverlapLayer {
            shown: root.shown;
            delay: StartCss.wb-start-search--animation-delay;
            duration: StartCss.wb-start-search--animation-duration;
            height: StartCss.wb-start-search--height;
            search := SearchCapsule {
                x: (parent.width - root.search-width) / 2;
                width: root.search-width;
                height: parent.height;
                placeholder: root.placeholder;
                radius: StartCss.wb-start-search--border-radius;
                pad-left: StartCss.wb-start-search--padding-left;
                pad-right: StartCss.wb-start-search--padding-right;
                gap: StartCss.wb-start-search--gap;
                icon-size: StartGen.search-icon;
                icon-ink: StartCss.wb-start-search--color;
                role: Role.wb-start-search;
                ink: StartCss.wb-start-search-hover--color;
                placeholder-ink: StartCss.wb-start-search--color;
                // `<kbd class="wb-mono">`
                hint: root.shortcut;
                hint-role: {
                    family: Role.wb-mono.family,
                    size: StartCss.wb-start-search-kbd--font-size,
                    weight: Role.wb-mono.weight,
                    line-height: Role.wb-mono.line-height,
                };
                hint-ink: StartCss.wb-start-search-kbd--color;
                steps: true;
                edited(text) => {
                    // `useEffect(() => setSel(0), [q])`
                    list.selected = 0;
                    root.query-changed(text);
                }
                accepted => {
                    if root.results-shown {
                        list.choose-current();
                    }
                }
                step(d) => {
                    list.step(d);
                }
                escaped => {
                    search.drop-focus();
                }
                focus-changed(on) => {
                    root.focus-changed(on);
                }
            }
        }

        sites := Rectangle {
            visible: !root.compact;
            property <int> rows: ceil(root.sites.length / root.per-row);
            height: root.compact ? 0px : StartCss.wb-start-sites--margin-top + self.rows * root.tile-height + max(0, self.rows - 1) * StartCss.wb-start-sites--gap-row;
            for site[i] in root.sites: OverlapLayer {
                property <int> at-row: floor(i / root.per-row);
                property <int> at-col: mod(i, root.per-row);
                property <int> in-row: min(root.per-row, root.sites.length - self.at-row * root.per-row);
                property <length> row-width: self.in-row * root.tile + (self.in-row - 1) * root.col-gap;
                shown: root.shown;
                // `animationDelay: 120 + i * 30 ms` over start.css's .36 s
                delay: StartGen.site-delay + StartGen.site-stagger * i;
                duration: StartCss.wb-start-site--animation-duration;
                x: (sites.width - self.row-width) / 2 + self.at-col * (root.tile + root.col-gap);
                y: StartCss.wb-start-sites--margin-top + self.at-row * (root.tile-height + StartCss.wb-start-sites--gap-row);
                width: root.tile;
                height: root.tile-height;
                StartTile {
                    site: site;
                    clicked => {
                        root.site-activated(site.url);
                    }
                }
            }
        }
    }

    // The bar's results under the capsule: its thick glass and rows (kit CommandPanel and
    // CommandList), as wide as the capsule, `TouchMenu.gap` below it, growing from its centre.
    results := CommandPanel {
        property <length> top: search.absolute-position.y - root.absolute-position.y + search.height + TouchMenu.gap;
        open: root.results-shown;
        visible: root.results-shown || self.opacity > 0;
        over-content: true;
        x: search.absolute-position.x - root.absolute-position.x;
        y: self.top;
        width: search.width;
        height: BrowserCss.wb-cmd--padding-top + list.height + BrowserCss.wb-cmd--padding-bottom;
        grow-from: { x: self.width / 2, y: -TouchMenu.gap - search.height / 2 };
        VerticalLayout {
            padding-top: BrowserCss.wb-cmd--padding-top;
            padding-left: BrowserCss.wb-cmd--padding-left;
            padding-right: BrowserCss.wb-cmd--padding-right;
            padding-bottom: BrowserCss.wb-cmd--padding-bottom;
            alignment: start;
            list := CommandList {
                results: root.results;
                shown: root.results-shown;
                chosen(i) => {
                    root.result-chosen(i);
                }
            }
        }
    }
}

// design: pages/start.tsx:16-55, pages/start.css:1-32 @598f814
// The start page's front (wubble://start, the new-tab page): the heading, the search capsule and
// the site tiles over the living bubble. The bubble, its minis and the liquid are the scene's
// (wubble_core::start::Living drives them, the scene's bubble and pop passes draw them): this
// page is transparent so they show through, and the `wb-start` ground is the scene's.
//
// Slots (marked `SLOT` below), filled by the lanes that own the parts:
// - SLOT search capsule (L3 SearchCapsule): a GlassPanel + PressableButton stand-in with the
//   design's geometry; the kit capsule replaces the whole `search` element.
// - SLOT site tile (L3 Button look): PressableButton's .97 press; the design's icon hover 1.08
//   (.45 s spring) and active (1.1, .88) squash are not drawn yet.
// - SLOT entrances (L2 OverlapLayer `delay` + `duration`): OverlapLayer staggers by
//   `Motion.overlapStagger * index` over 240 ms. The design's delays are 40 / 80 / 120 + 30 i ms
//   over .4 / .4 / .36 s (wb-in, with a 4 px blur Slint cannot draw). The tiles land exactly
//   (index = 120 / 30 + i); the heading (30 ms) and search (90 ms) are the nearest steps.
// - SLOT icon by name (L8): the legacy `Icon` with `IconPaths.search`.

import { Palette, Fonts, Type } from "../gen/tokens.slint";
import { StartCss } from "../gen/css.slint";
import { StartGen } from "../gen/literals.slint";
import { GlassPanel } from "../material/glass.slint";
import { PressableButton } from "../controls/button.slint";
import { OverlapLayer } from "../motion/overlap.slint";
import { Icon, IconPaths } from "../../components/icon.slint";
import { GlassTier } from "../../components/model.slint";

// A site on the start page: the shell's own favourites / top sites (wubble's data and wording).
export struct StartSite {
    title: string,
    url: string,
    favicon: image,
}

export component StartPage inherits Rectangle {
    in property <[StartSite]> sites;
    // the page's own copy (pages/start.tsx)
    in property <string> heading: "Where to next?";
    in property <string> placeholder: "Search or type an address";
    // the focus-address shortcut as the shell's key table writes it
    in property <string> shortcut;
    // false while the page is covered: the parts leave, and enter again staggered
    in property <bool> shown: true;
    // the capsule's centre in window coordinates (the command bar grows from it)
    callback search-clicked(length, length);
    callback site-activated(int);

    // @media (max-height: 560px): higher up, tighter, no tiles
    property <bool> compact: root.height < StartGen.compact-below;
    property <length> pad-x: StartCss.wb-start-front--padding-left;
    property <length> inner: root.width - root.pad-x - StartCss.wb-start-front--padding-right;
    property <length> gap: root.compact ? StartCss.max-height-560px-wb-start-front--gap : StartCss.wb-start-front--gap;
    property <length> search-width: min(StartGen.search-max-width, root.inner);
    // flex-wrap: as many tiles per row as fit, rows centred
    property <length> tile: StartCss.wb-start-site--width;
    property <length> col-gap: StartCss.wb-start-sites--gap-column;
    property <int> per-row: max(1, floor((root.inner + root.col-gap) / (root.tile + root.col-gap)));
    property <length> tile-height: StartCss.wb-start-site-icon--height + StartCss.wb-start-site--gap + Type.label.size * Type.label.line-height;

    background: transparent;

    front := VerticalLayout {
        x: root.pad-x;
        y: root.height * (root.compact ? StartCss.max-height-560px-wb-start-front--top : StartCss.wb-start-front--top);
        width: root.inner;
        height: self.preferred-height;
        spacing: root.gap;
        alignment: start;

        OverlapLayer {
            shown: root.shown;
            index: 1;
            height: h1.preferred-height;
            h1 := Text {
                width: parent.width;
                text: root.heading;
                horizontal-alignment: center;
                color: Palette.ink;
                font-family: Fonts.display;
                font-weight: Type.display.weight;
                // clamp(30px, 4vw, 44px)
                font-size: clamp(root.width * StartGen.heading-vw / 100, StartCss.wb-start-h1--font-size-min, StartCss.wb-start-h1--font-size-max);
            }
        }

        // SLOT search capsule (L3)
        OverlapLayer {
            shown: root.shown;
            index: 3;
            height: StartCss.wb-start-search--height;
            search := PressableButton {
                x: (parent.width - root.search-width) / 2;
                width: root.search-width;
                height: parent.height;
                padding-x: 0px;
                border-radius: StartCss.wb-start-search--border-radius;
                background: transparent;
                label: root.placeholder;
                clicked => {
                    root.search-clicked(self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height / 2);
                }
                Rectangle {
                    min-width: root.search-width;
                    GlassPanel {
                        tier: GlassTier.thin;
                        radius: StartCss.wb-start-search--border-radius;
                        hover: search.hovered;
                        pressed: search.pressed;
                        focused: search.keyboard-focused;
                    }
                    HorizontalLayout {
                        padding-left: StartCss.wb-start-search--padding-left;
                        padding-right: StartCss.wb-start-search--padding-right;
                        spacing: StartCss.wb-start-search--gap;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            path: IconPaths.search;
                            size: StartGen.search-icon;
                            tint: search.hovered ? StartCss.wb-start-search-hover--color : StartCss.wb-start-search--color;
                        }
                        Text {
                            horizontal-stretch: StartCss.wb-start-search-span--flex;
                            vertical-alignment: center;
                            text: root.placeholder;
                            color: search.hovered ? StartCss.wb-start-search-hover--color : StartCss.wb-start-search--color;
                            font-family: Fonts.ui;
                            font-size: StartCss.wb-start-search--font-size;
                        }
                        Text {
                            vertical-alignment: center;
                            text: root.shortcut;
                            color: StartCss.wb-start-search-kbd--color;
                            font-family: Fonts.mono;
                            font-size: StartCss.wb-start-search-kbd--font-size;
                        }
                    }
                }
            }
        }

        sites := Rectangle {
            visible: !root.compact;
            property <int> rows: ceil(root.sites.length / root.per-row);
            height: root.compact ? 0px : StartCss.wb-start-sites--margin-top + self.rows * root.tile-height + max(0, self.rows - 1) * StartCss.wb-start-sites--gap-row;
            for site[i] in root.sites: OverlapLayer {
                property <int> at-row: floor(i / root.per-row);
                property <int> at-col: mod(i, root.per-row);
                property <int> in-row: min(root.per-row, root.sites.length - self.at-row * root.per-row);
                property <length> row-width: self.in-row * root.tile + (self.in-row - 1) * root.col-gap;
                shown: root.shown;
                // the tiles' delay is 120 + 30 i ms: OverlapLayer's 30 ms steps land on it exactly
                index: round(StartGen.site-delay / StartGen.site-stagger) + i;
                x: (sites.width - self.row-width) / 2 + self.at-col * (root.tile + root.col-gap);
                y: StartCss.wb-start-sites--margin-top + self.at-row * (root.tile-height + StartCss.wb-start-sites--gap-row);
                width: root.tile;
                height: root.tile-height;
                // SLOT site tile (L3)
                tile := PressableButton {
                    padding-x: 0px;
                    background: transparent;
                    label: site.title;
                    clicked => {
                        root.site-activated(i);
                    }
                    VerticalLayout {
                        spacing: StartCss.wb-start-site--gap;
                        alignment: start;
                        HorizontalLayout {
                            alignment: center;
                            GlassPanel {
                                width: StartCss.wb-start-site-icon--width;
                                height: StartCss.wb-start-site-icon--height;
                                tier: GlassTier.thin;
                                radius: self.width * StartCss.wb-start-site-icon--border-radius;
                                hover: tile.hovered;
                                pressed: tile.pressed;
                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: StartGen.favicon;
                                    height: StartGen.favicon;
                                    source: site.favicon;
                                }
                            }
                        }
                        Text {
                            text: site.title;
                            horizontal-alignment: center;
                            overflow: elide;
                            color: tile.hovered ? StartCss.wb-start-site-hover--color : StartCss.wb-start-site--color;
                            font-family: Fonts.ui;
                            font-size: StartCss.wb-start-site--font-size;
                        }
                    }
                }
            }
        }
    }
}

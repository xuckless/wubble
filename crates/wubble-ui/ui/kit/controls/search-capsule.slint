// design: pages/settings.tsx:558-566, pages/settings.css:12-20 @598f814
// The search capsule (`.st-search`): thin glass (`wb-thin wb-film`), 40 high, radius 20, padding
// 0 6 0 14, gap 8, a 16 px mist search icon, the 14 px input (placeholder haze); the film ring is
// on (`wb-on`) while it has the focus or a query. The clear button (`.st-clear`, 28, radius 14,
// white .10, a 14 px ink close) shows only with a query: in from .8, clear and blurred 3 px
// (opacity and blur .2 s, scale .24 s, ease-out), out over .15 s ease-in; hidden it takes no
// pointer and no focus. Escape with a query clears it and is consumed (else `escaped()` and the
// key goes on to the sheet or page around it); the clear button clears and gives the focus back to the input.
// wubble: the geometry, type and inks are properties (the settings page's by default) so the
// start page's capsule (`.wb-start-search`: 54 high, radius 27, padding 0 20, gap 12, an 18 px
// icon, 15 px, mist; its `<kbd>` hint while empty) is this same field; Up / Down are `step`
// for a list under it (derived: notes/fidelity/derived-review.md).

import { Palette, TouchMenu } from "../gen/tokens.slint";
import { SettingsCss } from "../gen/css.slint";
import { Role, TextRole } from "../gen/text.slint";
import { Shell } from "../derived.slint";
import { KitText } from "../text.slint";
import { GlassPanel } from "../material/glass.slint";
import { Tween } from "../motion/tween.slint";
import { Press } from "../motion/press.slint";
import { OverlapLook } from "../motion/overlap.slint";
import { Icon, Glyph } from "icon.slint";
import { GlassTier } from "../../components/model.slint";
import { FocusKeys } from "../../components/focus-ring.slint";

export component SearchCapsule inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    // the geometry, type and inks (`.st-search` unless told otherwise)
    in property <length> radius: SettingsCss.st-search--border-radius;
    in property <length> pad-left: SettingsCss.st-search--padding-left;
    in property <length> pad-right: SettingsCss.st-search--padding-right;
    in property <length> gap: SettingsCss.st-search--gap;
    in property <length> icon-size: TouchMenu.search-icon;
    in property <color> icon-ink: SettingsCss.st-search--color;
    in property <TextRole> role: Role.st-search-input;
    in property <color> ink: SettingsCss.st-search-input--color;
    in property <color> placeholder-ink: SettingsCss.st-search-input-placeholder--color;
    // a hint after the field while it is empty (the start page's `<kbd>` shortcut)
    in property <string> hint;
    in property <TextRole> hint-role: Role.wb-mono;
    in property <color> hint-ink: SettingsCss.st-search-input-placeholder--color;
    callback edited(string);
    // Up (-1) / Down (+1), for a list under the field; not taken unless `steps` is on
    in property <bool> steps: false;
    callback step(int);
    callback focus-changed(bool);
    callback accepted(string);
    // Escape in an empty field: a sheet or page around it may close.
    callback escaped();
    out property <bool> focused: input.has-focus;
    // the ring (`wb-on`) and the clear button's state
    out property <bool> ring: input.has-focus || root.text != "";
    out property <bool> clear-shown: root.text != "";
    // the clear button's look (curve tests)
    out property <float> clear-opacity: clear.e;
    out property <float> clear-scale: clear-body.zoom;
    out property <length> clear-blur: clear.blur;
    public function take-focus() {
        input.focus();
    }
    // the keys come here with the text selected (the address field's focus)
    public function take-focus-all() {
        input.focus();
        input.select-all();
    }
    public function drop-focus() {
        input.clear-focus();
    }
    function clear-query() {
        input.text = "";
        root.edited("");
    }

    height: SettingsCss.st-search--height;

    GlassPanel {
        tier: GlassTier.thin;
        radius: root.radius;
        film: root.ring;
        // `cursor: text`: a press anywhere on the capsule focuses the input
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                input.focus();
            }
        }
        HorizontalLayout {
            padding-left: root.pad-left;
            // the empty clear slot still takes a gap: the padding gives it back
            padding-right: root.hint != "" && input.text == "" ? max(0px, root.pad-right - root.gap) : root.pad-right;
            spacing: root.gap;
            VerticalLayout {
                alignment: center;
                Icon {
                    size: root.icon-size;
                    path: Glyph.search;
                    tint: root.icon-ink;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                KitText {
                    width: parent.width;
                    height: parent.height;
                    role: root.role;
                    text: root.placeholder;
                    visible: input.text == "";
                    color: root.placeholder-ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                input := TextInput {
                    width: parent.width;
                    height: parent.height;
                    font-family: root.role.family;
                    font-size: root.role.size;
                    font-weight: root.role.weight;
                    color: root.ink;
                    selection-background-color: Shell.selection-fill;
                    selection-foreground-color: Shell.selection-ink;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-label: root.placeholder;
                    edited => {
                        root.edited(self.text);
                    }
                    accepted => {
                        root.accepted(self.text);
                    }
                    changed has-focus => {
                        root.focus-changed(self.has-focus);
                    }
                    key-pressed(event) => {
                        if root.steps && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                            root.step(event.text == Key.UpArrow ? -1 : 1);
                            return accept;
                        }
                        if event.text == Key.Escape {
                            if self.text != "" {
                                root.clear-query();
                                return accept;
                            }
                            // the web handles Escape only with a query: it goes on to
                            // the sheet or page around the field
                            root.escaped();
                            return reject;
                        }
                        return reject;
                    }
                }
            }
            // the hint, while the field is empty
            if root.hint != "" && input.text == "": KitText {
                role: root.hint-role;
                text: root.hint;
                color: root.hint-ink;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    // the hint takes the clear button's place while the field is empty
                    width: root.hint != "" && input.text == "" ? 0px : SettingsCss.wb-st-clear--width;
                    height: SettingsCss.wb-st-clear--height;
                    // opacity and blur on one curve, the scale on its own (CSS: three transitions)
                    fade := Tween {
                        on: root.clear-shown;
                        in-ms: SettingsCss.wb-st-clear-on--transition-opacity-duration;
                        out-ms: SettingsCss.wb-st-clear--transition-opacity-duration;
                        in-easing: SettingsCss.wb-st-clear-on--transition-opacity-easing;
                        out-easing: SettingsCss.wb-st-clear--transition-opacity-easing;
                    }
                    grow := Tween {
                        on: root.clear-shown;
                        in-ms: SettingsCss.wb-st-clear-on--transition-scale-duration;
                        out-ms: SettingsCss.wb-st-clear--transition-scale-duration;
                        in-easing: SettingsCss.wb-st-clear-on--transition-scale-easing;
                        out-easing: SettingsCss.wb-st-clear--transition-scale-easing;
                    }
                    press := Press {
                        pressed: hit.pressed;
                    }
                    visible: fade.t > 0;
                    clear := OverlapLook {
                        e: fade.t;
                        entering: root.clear-shown;
                        shift-in: 0px;
                        shift-out: 0px;
                        scale-from: 1;
                        blur-from: SettingsCss.wb-st-clear--filter-blur;
                        clear-body := OverlapLook {
                            e: grow.t;
                            fade: 1;
                            shift-in: 0px;
                            shift-out: 0px;
                            scale-from: SettingsCss.wb-st-clear--scale;
                            blur-from: 0px;
                            Rectangle {
                                border-radius: SettingsCss.wb-st-clear--border-radius;
                                background: SettingsCss.wb-st-clear--background;
                                transform-scale: press.scale;
                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: TouchMenu.clear-icon;
                                    path: Glyph.close;
                                    tint: SettingsCss.wb-st-clear--color;
                                }
                            }
                        }
                    }
                    hit := TouchArea {
                        enabled: root.clear-shown;
                        clicked => {
                            root.clear-query();
                            input.focus();
                        }
                    }
                    keys := FocusKeys {
                        enabled: root.clear-shown;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Clear search";
                        activate => {
                            root.clear-query();
                            input.focus();
                        }
                    }
                }
            }
        }
    }
}

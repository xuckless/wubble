// design: browser/scroller.tsx:1-181, browser/browser.css:126-130 @598f814
// Moved from components.slint (a copy of the design repo's `src/wubble/slint/components.slint`
// @ 6c840da, with the marked `wubble change`s); the thumb is the web's `.wb-thumb` (controls kit
// B): 6 px at right 3 (9 under the pointer, width .15 s), ink .38, in .12 s ease-out, out .3 s
// ease-in.

import { Calm } from "../motion/calm.slint";
import { BrowserCss } from "../gen/css.slint";

// `.wb-thumb`: the overlay scroll thumb at `top`, `height` long, showing while `shown`; it widens
// under the pointer, leftwards from its right edge (`right: 3px`). Its drag goes to the caller.
export component Thumb inherits Rectangle {
    in property <length> top;
    in property <length> length;
    in property <bool> shown;
    // the specimen's forced hover (kit/specimen/slide.slint)
    in property <bool> preview-hover;
    callback down(length);
    callback move(length);
    callback up();
    out property <bool> hovered: ta.has-hover || root.preview-hover;
    // what the curve tests read
    out property <float> shown-opacity: bar.opacity;
    out property <length> shown-width: root.w;
    property <length> w: root.hovered ? BrowserCss.wb-thumb-hover--width : BrowserCss.wb-thumb--width;
    animate w {
        duration: Calm.ms(BrowserCss.wb-thumb--transition-width-duration);
        easing: BrowserCss.wb-thumb--transition-width-easing;
    }
    // the parent's full size; the bar is placed inside
    bar := Rectangle {
        x: root.width - BrowserCss.wb-thumb--right - root.w;
        y: root.top;
        width: root.w;
        height: root.length;
        border-radius: BrowserCss.wb-thumb--border-radius;
        background: BrowserCss.wb-thumb--background;
        opacity: root.shown ? BrowserCss.wb-thumb-on--opacity : 0;
        animate opacity {
            duration: Calm.ms(root.shown ? BrowserCss.wb-thumb-on--transition-opacity-duration : BrowserCss.wb-thumb--transition-opacity-duration);
            easing: root.shown ? BrowserCss.wb-thumb-on--transition-opacity-easing : BrowserCss.wb-thumb--transition-opacity-easing;
        }
        ta := TouchArea {
            enabled: root.shown;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.down(self.absolute-position.y + self.mouse-y); }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.up(); }
            }
            moved => { if (self.pressed) { root.move(self.absolute-position.y + self.mouse-y); } }
        }
    }
}

// @source slint-scroller
// A scroll view on Wubble physics (scroller.rs) instead of Flickable's: wheel, keys and touch go
// to Rust, and Rust writes back the content offset (rubber-banded past the ends) and the thumb,
// which squashes at the ends like the content. Slint's wheel delta is positive when scrolling
// toward the top on most backends, the opposite of the web's deltaY, so it's negated here.
export component WubbleScroller inherits Rectangle {
    in property <length> content-y;      // ScrollRender.shown
    in property <length> thumb-top;
    in property <length> thumb-height;
    in property <bool> thumb-visible;
    out property <length> viewport-height: self.height;
    out property <length> content-height: content.preferred-height;
    callback wheel(length);              // web-style deltaY in px
    // wubble change: both parts of every scroll, web sign, for the Space swipe (which needs the
    // vertical travel to tell a swipe from a list scroll's drift)
    callback wheel-xy(length, length);
    callback touch-down(length);
    callback touch-move(length);
    callback touch-up();
    callback thumb-down(length);
    callback thumb-move(length);
    callback thumb-up();

    clip: true;
    TouchArea {
        scroll-event(e) => {
            root.wheel(-e.delta-y);
            root.wheel-xy(-e.delta-x, -e.delta-y);
            accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.touch-down(self.mouse-y); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.touch-up(); }
        }
        moved => { if (self.pressed) { root.touch-move(self.mouse-y); } }
    }
    content := VerticalLayout {
        y: -root.content-y;
        width: root.width;
        height: self.preferred-height;
        @children
    }
    Thumb {
        width: root.width;
        height: root.height;
        top: root.thumb-top;
        length: root.thumb-height;
        shown: root.thumb-visible;
        down(y) => { root.thumb-down(y); }
        move(y) => { root.thumb-move(y); }
        up => { root.thumb-up(); }
    }
}

// design: core/wubble.css:46-49, browser/browser.css:34-38 @598f814
// Moved from components.slint (a copy of the design repo's `src/wubble/slint/components.slint`
// @ 6c840da, with the marked `wubble change`s), unchanged.

import { Palette, Space, Chrome, Fonts, Type, Motion, Radius, Keyframes } from "../gen/tokens.slint";
import { Shell } from "../derived.slint";
import { Keys } from "../motion/keys.slint";
import { Press } from "../motion/press.slint";
import { WubbleCss, TouchCss } from "../gen/css.slint";
import { FocusRing, FocusKeys } from "../../components/focus-ring.slint";
import { Calm } from "../motion/calm.slint";
import { KitText } from "../text.slint";
import { Role } from "../gen/text.slint";

// @source slint-pressable
// Press: scale to 0.97 over 120 ms ease-out, back over 200 ms ease-out (wubble.css .wb-press).
// Never used where physics owns the transform (the tab indicator, the bubble).
export component PressableButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // wubble change: the side padding, so an icon-only button (.wb-ib, 30 square) fits
    in property <length> padding-x: Space.s3;
    callback clicked();
    // wubble change: a right-button release on the button, for a second choice on one control.
    callback secondary-clicked();
    out property <bool> pressed: touch.pressed;
    out property <bool> hovered: touch.has-hover;
    // wubble change: what a screen reader calls the button when it has no text (an icon).
    in property <string> label;
    // wubble change: Tab reaches the button (Space or Enter clicks it), with the design's ring.
    out property <bool> keyboard-focused: keys.has-focus;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    min-height: Chrome.controls;
    border-radius: Radius.sm;
    background: touch.has-hover ? Palette.shell : transparent;
    animate background { duration: Calm.ms(WubbleCss.wb-press--transition-background-color-duration); easing: ease; }

    transform-origin: { x: self.width / 2, y: self.height / 2 };
    // wubble change: the release squash (touch.css `tp-bq-a`, the squash token at a third, keys.slint) times the
    // press, on one transform.
    press := Press {
        pressed: touch.pressed;
    }
    transform-scale-x: press.scale * sq.sx;
    transform-scale-y: press.scale * sq.sy;
    sq := Keys {
        keys: Keyframes.button-squash;
        length: TouchCss.tp-btn-body-sq-a--animation-duration;
    }
    changed pressed => {
        if !self.pressed {
            sq.hit = !sq.hit;
        }
    }

    keys := FocusKeys {
        enabled: root.enabled;
        activate => { root.clicked(); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.secondary-clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        spacing: Space.s2;
        alignment: center;
        @children
        if root.text != "": KitText {
            role: Role.label;
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? Palette.ink : Palette.haze;
        }
    }
    // wubble change: the keyboard focus ring
    FocusRing {
        shown: keys.has-focus;
        radius: root.border-radius;
    }
}

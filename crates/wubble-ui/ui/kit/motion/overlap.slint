// design: core/wubble.css:51-58 @598f814
// Overlap (`wb-in` / `wb-out`): old and new share the screen. The incoming layer comes from 7 px
// below at .98 and clear, blurred 4 px, into place over 240 ms ease-out; the outgoing one goes
// 5 px up to .98 and clear, blurring, over 190 ms ease-in-out. Rows enter 30 ms apart (`index`).
// A re-entry starts from 7 px below, as the web restarts `wb-in` (the port re-entered from -5).
// The blur is a transparent backdrop-blur rectangle over the content inside the layer: while
// the layer's opacity is below 1 Skia blurs only the layer's own pixels (Slint's
// builtin_elements.rs `backdrop-blur`); it is gone at rest. Skia only: other renderers fade and
// shift without the blur.

import { Motion } from "../gen/tokens.slint";
import { WubbleCss } from "../gen/css.slint";
import { Tween } from "tween.slint";

// The layer's look at eased progress `e` (1 = in place) heading in (`entering`) or out.
component OverlapLook inherits Rectangle {
    in property <float> e: 1;
    in property <bool> entering: true;
    opacity: root.e;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    // from (`wb-in`) or to (`wb-out`) keyframe: shift and scale
    property <length> shift: root.entering ? WubbleCss.wb-in-k-from--transform-translatey : WubbleCss.wb-out-k-to--transform-translatey;
    property <float> scale: root.entering ? WubbleCss.wb-in-k-from--transform-scale : WubbleCss.wb-out-k-to--transform-scale;
    transform-scale: 1 - (1 - root.scale) * (1 - root.e);
    Rectangle {
        y: root.shift * (1 - root.e);
        @children
    }
    Rectangle {
        backdrop-blur: Motion.overlap-blur * (1 - root.e);
        visible: root.e > 0 && root.e < 1;
    }
}

// For flips of a bool: `shown` in, not shown out.
export component OverlapLayer inherits Rectangle {
    in property <bool> shown: true;
    in property <int> index: 0;
    tw := Tween {
        on: root.shown;
        in-ms: Motion.overlap-in;
        out-ms: Motion.overlap-out;
        in-easing: Motion.ease-out;
        out-easing: Motion.ease-in-out;
        delay: root.shown ? Motion.overlap-stagger * root.index : 0ms;
    }
    OverlapLook {
        e: tw.t;
        entering: root.shown;
        @children
    }
}

// For arrivals a Rust driver times: `e` is the eased progress, 0..1
// (wubble_core::motion::overlap_in).
export component Entering inherits Rectangle {
    in property <float> e: 1;
    OverlapLook {
        e: root.e;
        @children
    }
}

// design: core/wubble.css:51-58 @598f814
// Overlap (`wb-in` / `wb-out`): old and new share the screen. The incoming layer comes from 7 px
// below at .98 and clear, blurred 4 px, into place over 240 ms ease-out; the outgoing one goes
// 5 px up to .98 and clear, blurring, over 190 ms ease-in-out. Rows enter 30 ms apart (`index`).
// Each flip restarts its keyframes, as the web's `wb-in` / `wb-out` animations do: a re-entry
// mid-exit starts again clear and 7 px below, an exit mid-entry from in place (Replay).
// The blur is a transparent backdrop-blur rectangle over the content inside the layer: while
// the layer's opacity is below 1 Skia blurs only the layer's own pixels (Slint's
// builtin_elements.rs `backdrop-blur`); it is gone at rest. Skia only: other renderers fade and
// shift without the blur.

import { Motion } from "../gen/tokens.slint";
import { WubbleCss } from "../gen/css.slint";
import { Replay } from "tween.slint";

// The layer's look at eased progress `e` (1 = in place) heading in (`entering`) or out: from
// `shift-in` below or to `shift-out`, at `scale-from`, blurred. Overlap's values by default;
// Crossfade passes the Swap's.
export component OverlapLook inherits Rectangle {
    in property <float> e: 1;
    in property <bool> entering: true;
    // from (`wb-in`) or to (`wb-out`) keyframe: shift and scale
    in property <length> shift-in: WubbleCss.wb-in-k-from--transform-translatey;
    in property <length> shift-out: WubbleCss.wb-out-k-to--transform-translatey;
    in property <float> scale-from: WubbleCss.wb-in-k-from--transform-scale;
    opacity: root.e;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    property <length> shift: root.entering ? root.shift-in : root.shift-out;
    // the look at `e`, also read by the curve tests
    out property <length> offset: root.shift * (1 - root.e);
    out property <float> zoom: 1 - (1 - root.scale-from) * (1 - root.e);
    out property <length> blur: Motion.overlap-blur * (1 - root.e);
    transform-scale: root.zoom;
    Rectangle {
        y: root.offset;
        @children
    }
    Rectangle {
        backdrop-blur: root.blur;
        visible: root.e > 0 && root.e < 1;
    }
}

// For flips of a bool: `shown` in, not shown out.
export component OverlapLayer inherits Rectangle {
    in property <bool> shown: true;
    in property <int> index: 0;
    rp := Replay {
        on: root.shown;
        in-ms: Motion.overlap-in;
        out-ms: Motion.overlap-out;
        in-easing: Motion.ease-out;
        out-easing: Motion.ease-in-out;
        delay: Motion.overlap-stagger * root.index;
    }
    out property <float> progress: look.e;
    out property <length> offset: look.offset;
    out property <float> zoom: look.zoom;
    out property <length> blur: look.blur;
    look := OverlapLook {
        e: root.shown ? rp.run : 1 - rp.run;
        entering: root.shown;
        @children
    }
}

// For arrivals a Rust driver times: `e` is the eased progress, 0..1
// (wubble_core::motion::overlap_in).
export component Entering inherits Rectangle {
    in property <float> e: 1;
    OverlapLook {
        e: root.e;
        @children
    }
}

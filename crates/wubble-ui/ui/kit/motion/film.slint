// design: core/wubble.css:33-44 @598f814
// Film rim (`.wb-film::before`): a 1.5 px soap-film ring, only on touch (hover, press, drag,
// focus), opacity .8 in 200 ms / 0 in 150 ms on the ease-out curve; never at rest.
// The ring is the design's conic gradient from 210deg (the `--wb-film-a` initial value):
// sky, lilac, blush, mint, sky at 90deg steps, written from 0deg (blush at 30, mint at 120, sky
// at 210, lilac at 300; 0/360 is two thirds of the way from lilac to blush). Slint limit
// (kit-plan section 6, L2-3): no `from` angle and no animatable stop order, so the 4 s swirl
// (`wb-film-swirl`) is not run; the ring holds its starting angle.

import { Glass } from "../gen/tokens.slint";
import { WubbleCss } from "../gen/css.slint";
import { Tween } from "tween.slint";

export component Film inherits Rectangle {
    in property <length> radius;
    in property <bool> on;
    property <color> sky: WubbleCss.wb-film-before--background-stop-1-color;
    property <color> lilac: WubbleCss.wb-film-before--background-stop-2-color;
    property <color> blush: WubbleCss.wb-film-before--background-stop-3-color;
    property <color> mint: WubbleCss.wb-film-before--background-stop-4-color;
    property <color> wrap: root.lilac.mix(root.blush, 1 / 3);
    border-radius: root.radius;
    border-width: Glass.film-width;
    border-color: @conic-gradient(root.wrap 0deg, root.blush 30deg, root.mint 120deg, root.sky 210deg, root.lilac 300deg, root.wrap 360deg);
    opacity: Glass.film-opacity * tw.t;
    visible: tw.t > 0;
    tw := Tween {
        on: root.on;
        in-ms: Glass.film-in;
        out-ms: Glass.film-out;
    }
}

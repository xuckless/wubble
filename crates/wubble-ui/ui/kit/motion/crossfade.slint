// design: pages/touch-kit.tsx:70-110, pages/touch.css:27-36 @598f814
// Crossfade (the touch kit's `Swap`): when the label changes, the old one leaves 7 px up at .98,
// blurring, over 190 ms ease-in-out while the new one arrives from 7 px below over 240 ms
// ease-out; both share the box. Built for text labels, the design's use. `along-x` is the
// `.tp-sw-x` variant (touch.css:31-32: in from 8 px right, out 8 px left, no scale; the dock
// tooltip's label); the up/down variants (`.tp-sw-up/down`) are not built until a surface needs
// them.

import { TouchCss } from "../gen/css.slint";
import { TextRole, Role } from "../gen/text.slint";
import { KitText } from "../text.slint";
import { Tween } from "tween.slint";
import { OverlapLook } from "overlap.slint";
import { Icon } from "../controls/icon.slint";

// One item of a Swap, any content: in while `shown`, out otherwise (`.tp-sw-i`, `data-s`).
export component SwapItem inherits OverlapLook {
    in property <bool> shown;
    e: tw.t;
    entering: root.shown;
    shift-in: root.along-x ? TouchCss.tp-sw-x-gt-tp-sw-i-data-s-pre--transform-translatex : TouchCss.tp-sw-i-data-s-pre--transform-translatey;
    shift-out: root.along-x ? TouchCss.tp-sw-x-gt-tp-sw-i-data-s-out--transform-translatex : TouchCss.tp-sw-i-data-s-out--transform-translatey;
    // `.tp-sw-x` replaces the whole transform: a shift, no scale
    scale-from: root.along-x ? 1 : TouchCss.tp-sw-i-data-s-pre--transform-scale;
    tw := Tween {
        on: root.shown;
        in-ms: TouchCss.tp-sw-i--transition-opacity-duration;
        out-ms: TouchCss.tp-sw-i-data-s-out--transition-duration;
        in-easing: TouchCss.tp-sw-i--transition-opacity-easing;
        out-easing: TouchCss.tp-sw-i-data-s-out--transition-timing-function;
    }
    @children
}

component SwapLayer inherits SwapItem {
    in property <string> text;
    in property <TextRole> role;
    in property <color> ink;
    in property <TextHorizontalAlignment> align;
    // the label fills the box (the trigger's label sits left, `align` places it)
    KitText {
        width: parent.width;
        height: parent.height;
        role: root.role;
        text: root.text;
        color: root.ink;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CrossfadeText inherits Rectangle {
    clip: true;
    in property <string> text;
    in property <TextRole> role: Role.body;
    in property <color> ink;
    in property <TextHorizontalAlignment> align: left;
    // `.tp-sw-x`: the labels shift across, not down
    in property <bool> along-x: false;
    // which layer holds the current text; the other leaves with the previous one
    property <bool> front: true;
    property <string> a;
    property <string> b;
    init => {
        root.a = root.text;
    }
    // the arriving layer's progress and the leaving one's
    out property <float> e: root.front ? la.e : lb.e;
    out property <float> leaving: root.front ? lb.e : la.e;
    changed text => {
        if root.front {
            root.b = root.text;
        } else {
            root.a = root.text;
        }
        root.front = !root.front;
    }
    la := SwapLayer { shown: root.front; text: root.a; role: root.role; ink: root.ink; align: root.align; along-x: root.along-x; }
    lb := SwapLayer { shown: !root.front; text: root.b; role: root.role; ink: root.ink; align: root.align; along-x: root.along-x; }
}

// wubble (derived: SwapItem and the kit Icon, docs/fidelity/derived-review.md): the Swap for an
// icon, as CrossfadeText's for a label; the reload button's Reload and Stop.
export component CrossfadeIcon inherits Rectangle {
    in property <string> path;
    in property <color> tint;
    // which layer holds the current icon; the other leaves with the previous one
    property <bool> front: true;
    property <string> a;
    property <string> b;
    init => {
        root.a = root.path;
    }
    changed path => {
        if root.front {
            root.b = root.path;
        } else {
            root.a = root.path;
        }
        root.front = !root.front;
    }
    width: ia.width;
    height: ia.height;
    SwapItem {
        shown: root.front;
        ia := Icon {
            path: root.a;
            tint: root.tint;
        }
    }
    SwapItem {
        shown: !root.front;
        Icon {
            path: root.b;
            tint: root.tint;
        }
    }
}

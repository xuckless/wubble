import { Colors, Motion, Radius, Sizes } from "../tokens.slint";
import { SpaceItem } from "model.slint";

export component SpaceDot inherits Rectangle {
    in property <SpaceItem> item;
    in property <bool> active: false;
    callback activated();

    width: Sizes.space-dot;
    height: Sizes.space-dot;
    border-radius: Radius.pill;
    border-width: Sizes.ring-width;
    border-color: transparent;
    animate border-color { duration: Motion.fast; }

    states [
        active when root.active: {
            border-color: Colors.ink;
        }
        hover when ta.has-hover: {
            border-color: Colors.mist;
        }
    ]

    Rectangle {
        x: Sizes.space-dot-inset;
        y: Sizes.space-dot-inset;
        width: parent.width - Sizes.space-dot-inset - Sizes.space-dot-inset;
        height: parent.height - Sizes.space-dot-inset - Sizes.space-dot-inset;
        border-radius: Radius.pill;
        background: root.item.tint;
    }

    ta := TouchArea {
        clicked => {
            root.activated();
        }
    }
}

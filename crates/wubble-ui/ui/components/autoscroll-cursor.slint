// Middle-click autoscroll's pointer (wubble_core::autoscroll), drawn by the shell while the
// system pointer is hidden over the page: the film ring where autoscroll began, and at the
// pointer a dot while the page holds still or an arrow toward the scroll, stretched along its
// length with the speed and thinned across to keep its area (the design's stretch spring and
// `squash_of`, stepped in Rust). The design has no autoscroll (wubble-only.md §23): its parts
// are kit/overlay/b/b-autoscroll.slint. Positions are in the parent's coordinates; it takes no
// input.

import { Shell } from "../kit/derived.slint";
import { BAutoscrollRing, BAutoscrollDot, BAutoscrollArrow } from "../kit/overlay/b/b-autoscroll.slint";

export component AutoscrollCursor inherits Rectangle {
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> pointer-x;
    in property <length> pointer-y;
    in property <bool> moving;
    // clockwise from pointing down
    in property <angle> heading;
    // along the arrow: 1 at rest, up to 1.35 at full speed; across: 1/sqrt(stretch)
    in property <float> stretch: 1;
    in property <float> squash: 1;

    property <length> arrow-length: Shell.autoscroll-arrow-length * root.stretch;
    property <length> arrow-width: Shell.autoscroll-arrow-width * root.squash;

    // where autoscroll began
    BAutoscrollRing {
        x: root.anchor-x - self.width / 2;
        y: root.anchor-y - self.height / 2;
    }

    if !root.moving: BAutoscrollDot {
        x: root.pointer-x - self.width / 2;
        y: root.pointer-y - self.height / 2;
    }

    // The chevron pointing down from the pointer's spot, turned toward the scroll.
    if root.moving: Rectangle {
        x: root.pointer-x - self.width / 2;
        y: root.pointer-y - self.height / 2;
        width: max(root.arrow-length, root.arrow-width) * 2;
        height: self.width;
        transform-rotation: root.heading;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        arrow := BAutoscrollArrow {
            x: (parent.width - root.arrow-width) / 2;
            y: parent.height / 2 - root.arrow-length / 2;
            width: root.arrow-width;
            height: root.arrow-length;
        }
    }
}

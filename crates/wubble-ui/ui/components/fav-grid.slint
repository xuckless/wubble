// Pinned tabs as the favourites grid. Written for wubble from the design repo's web chrome
// (src/wubble/browser/browser.css `.wb-favs`, `.wb-fav`, `.wb-favs-rail`, and chrome.tsx `Fav`,
// xuckless/the-wallpaper-project @ 6c840da): the Slint port has no favourites. Four columns 8
// apart, 44 high, thin glass radius 12 with the film rim on hover; on the rail one 40 px column,
// 6 apart. The icon grows to 1.1 on hover on the spring ease. The active tab's tile takes the
// selected fill.

import { Palette, Chrome, Spacing, Glass, Motion } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel } from "../components.slint";
import { GlassTier, GlassKeys, TabItem } from "model.slint";
import { Icon, IconPaths } from "icon.slint";

export component FavGrid inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <int> active-tab-id: -1;
    in property <bool> compact: false;
    // The scene draws the tiles' glass.
    in property <bool> over-wgpu: false;
    callback activated(int);

    property <int> cols: root.compact ? 1 : Shell.fav-columns;
    property <length> gap: root.compact ? Shell.rail-gap : Spacing.s2;
    property <length> tile-w: root.compact ? Shell.rail-item : (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: root.compact ? Shell.rail-item : Chrome.favourite;
    property <int> rows: ceil(root.tabs.length / root.cols);

    height: max(0px, root.rows * (root.tile-h + root.gap) - root.gap);

    for tab[i] in root.tabs: GlassPanel {
        x: root.compact ? (root.width - root.tile-w) / 2 : mod(i, root.cols) * (root.tile-w + root.gap);
        y: floor(i / root.cols) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
        key: GlassKeys.favourites + tab.id;
        over-wgpu: root.over-wgpu;
        tier: GlassTier.thin;
        radius: Shell.control-radius;
        hover: ta.has-hover;
        pressed: ta.pressed;
        background: tab.id == root.active-tab-id ? Shell.selected-fill : root.over-wgpu ? transparent : Glass.thin.fill;
        animate background {
            duration: Motion.pressRelease;
            easing: Motion.easeOut;
        }
        scale: ta.pressed ? Motion.pressScale : 1;
        animate scale {
            duration: ta.pressed ? Motion.pressMs : Motion.pressRelease;
            easing: Motion.easeOut;
        }

        ta := TouchArea {
            clicked => {
                root.activated(tab.id);
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Shell.fav-icon;
            height: Shell.fav-icon;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: ta.has-hover ? Shell.fav-hover-scale : 1;
            animate transform-scale {
                duration: Shell.fav-hover-ms;
                easing: Motion.easeSpring;
            }
            if tab.favicon.width > 0: Image {
                source: tab.favicon;
                width: parent.width;
                height: parent.height;
            }
            if tab.favicon.width == 0: Icon {
                path: IconPaths.globe;
                size: Shell.fav-icon;
                tint: tab.id == root.active-tab-id ? Palette.ink : Palette.mist;
            }
        }
    }
}

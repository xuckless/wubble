import { BPipCard } from "../kit/overlay/b/b-pip-card.slint";

// What a Main window shows for its tab while the tab plays in the picture-in-picture window: a
// centred column ("Playing in picture-in-picture", the tab's title, Back to tab) on the page's
// ground. The design has no picture-in-picture (wubble-only.md §21): the error page's column
// (kit/overlay/b/b-pip-card.slint). Intents only: `command("return", 0)`.
export component PipCard inherits BPipCard {
    callback command(string, float);
    line: "Playing in picture-in-picture";
    action: "Back to tab";
    acted => {
        root.command("return", 0);
    }
}

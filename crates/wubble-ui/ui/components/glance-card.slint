import { Palette, Radius, Space, Fonts, Type, Motion } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { GlassPanel } from "../kit/material/glass.slint";
import { GlanceView, GlassTier } from "model.slint";
import { SheetButton } from "sheet-button.slint";
import { IconButton } from "nav-buttons.slint";
import { IconPaths } from "icon.slint";
import { Calm } from "../kit/motion/calm.slint";

// The peek (Shift+click on a link): the page in a card on thick glass over the page it was
// opened from, a scrim under it; a header with its title, "Open as tab", "Open in split" and
// close. The host lays the page out (`Host::glance_rect`) and hands its frame here; pointer
// events on it go back as the page's own (`pane` = its tab). Esc or a click on the scrim closes
// it. It drops in as the dropdowns do (.95, 220 ms) and leaves with its view (the latch every
// sheet uses). Written new: the design bucket has no peek; looks are the sheets'.
export component GlanceCard inherits Rectangle {
    in property <GlanceView> glance;
    in property <MouseCursor> cursor;
    callback closed();
    callback to-tab();
    callback to-split();
    callback pointer-moved(int, length, length);
    callback pointer-left(int, length, length);
    callback pointer-pressed(int, PointerEventButton, length, length);
    callback pointer-released(int, PointerEventButton, length, length);
    callback pointer-cancelled(int);
    callback scrolled(int, length, length, length, length);

    property <bool> open: root.glance.open;
    // What the card shows: the open peek, kept while it leaves.
    property <GlanceView> held;
    changed glance => {
        if root.glance.open {
            root.held = root.glance;
        }
    }
    property <GlanceView> g: root.open ? root.glance : root.held;

    visible: root.open || card.opacity > 0;

    // the scrim: a click on it closes the peek
    Rectangle {
        background: Shell.scrim;
        opacity: root.open ? 1 : 0;
        animate opacity {
            duration: Calm.ms(root.open ? Motion.dropdown-in : Motion.dropdown-out);
            easing: root.open ? Motion.ease-out : Motion.ease-in-out;
        }
        TouchArea {
            enabled: root.open;
            clicked => {
                root.closed();
            }
            scroll-event(e) => {
                accept
            }
        }
    }

    card := GlassPanel {
        x: root.g.x - Space.s2;
        y: root.g.card-y;
        width: root.g.width + 2 * Space.s2;
        height: root.g.y + root.g.height + Space.s2 - root.g.card-y;
        tier: GlassTier.thick;
        radius: Radius.lg;
        over-content: true;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.open ? 1 : Motion.dropdown-from;
        opacity: root.open ? 1 : 0;
        animate transform-scale, opacity {
            duration: Calm.ms(root.open ? Motion.dropdown-in : Motion.dropdown-out);
            easing: root.open ? Motion.ease-out : Motion.ease-in-out;
        }
        TouchArea {
            enabled: root.open;
        }

        HorizontalLayout {
            x: Space.s2;
            y: 0px;
            width: root.g.width;
            height: root.g.y - root.g.card-y;
            spacing: Space.s2;
            alignment: stretch;
            Text {
                horizontal-stretch: 1;
                text: root.g.title;
                vertical-alignment: center;
                overflow: elide;
                color: Palette.ink;
                font-family: Fonts.ui;
                font-size: Type.body.size;
                font-weight: Type.label.weight;
            }
            VerticalLayout {
                alignment: center;
                SheetButton {
                    text: "Open in split";
                    clicked => {
                        if root.open {
                            root.to-split();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                SheetButton {
                    text: "Open as tab";
                    primary: true;
                    clicked => {
                        if root.open {
                            root.to-tab();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon-path: IconPaths.close;
                    clicked => {
                        if root.open {
                            root.closed();
                        }
                    }
                }
            }
        }

        page := Rectangle {
            x: Space.s2;
            y: root.g.y - root.g.card-y;
            width: root.g.width;
            height: root.g.height;
            border-radius: Radius.md;
            clip: true;
            background: Palette.web;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.g.frame;
                source-clip-width: root.g.clip-width;
                source-clip-height: root.g.clip-height;
                image-fit: fill;
            }
            TouchArea {
                enabled: root.open;
                mouse-cursor: root.cursor;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.pointer-pressed(root.g.id, event.button, self.mouse-x, self.mouse-y);
                    } else if event.kind == PointerEventKind.up {
                        root.pointer-released(root.g.id, event.button, self.mouse-x, self.mouse-y);
                    } else if event.kind == PointerEventKind.move {
                        root.pointer-moved(root.g.id, self.mouse-x, self.mouse-y);
                    } else {
                        root.pointer-cancelled(root.g.id);
                    }
                }
                scroll-event(event) => {
                    root.scrolled(root.g.id, self.mouse-x, self.mouse-y, event.delta-x, event.delta-y);
                    accept
                }
                changed has-hover => {
                    if !self.has-hover {
                        root.pointer-left(root.g.id, self.mouse-x, self.mouse-y);
                    }
                }
            }
        }
    }
}

import { GlassKeys, GlassOver } from "model.slint";
import { AGlanceCard } from "../kit/overlay/a/a-glance-card.slint";

// The peek (Shift+click on a link): the page in a card on thick glass over the page it was
// opened from, a scrim under it; a header with its title, "Open as tab", "Open in split" and
// close. Derived from the kit (docs/fidelity/wubble-only.md; the design bucket has no peek): the
// Glance card (kit/overlay/a/a-glance-card.slint). The host lays the page out
// (`Host::glance_rect`) and hands its frame here; pointer events on it go back as the page's own
// (`pane` = its tab). Esc or a click on the scrim closes it. Its interface is the kit body's:
// `glance`, `cursor`, `closed()`, `to-tab()`, `to-split()` and the page's pointer callbacks.
export component GlanceCard inherits AGlanceCard {
    // the scene draws its glass above the page (GlassPanel `over-layer`)
    key: GlassKeys.glance;
    layer: GlassOver.card;
}

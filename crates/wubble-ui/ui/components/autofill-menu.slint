import { Shell } from "../kit/derived.slint";
import { GlassKeys } from "model.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { AMenuPopover } from "../kit/overlay/a/a-menu-list.slint";
import { APrompt } from "../kit/overlay/a/a-prompt.slint";

// Password autofill (wubble host/autofill.rs): the key chip a sign-in form shows, its menu of
// saved logins (and "Suggest a strong password" on a sign-up form), and the save / update prompt
// after a sign-in. Derived from the kit (docs/fidelity/wubble-only.md): the chip is a kit
// IconButton, lit while its menu is open; the menu is the touch menu's rows on the Popover
// (kit/overlay/a/a-menu-list.slint); the prompt is the Prompt (kit/overlay/a/a-prompt.slint):
// Never (ghost, coral), Not now (ghost), Save or Update (primary). Placed by the parent at the
// content area's top left. Never modal and never focused: no keystroke meant for the page can pick a login
// or answer the prompt (keyjacking). Intents only; the host fills and saves.
// The save prompt's buttons (host/autofill.rs `autofill_answer`).
export enum AutofillAnswer { save, never, not-now }

export struct AutofillView {
    chip: bool,
    menu-open: bool,
    rows: [string],
    // The save prompt shows; its title, detail and button ("Save" / "Update").
    prompt: bool,
    title: string,
    detail: string,
    accept: string,
}

export component AutofillMenu inherits Rectangle {
    in property <AutofillView> view;
    // -1: open the menu, -2: close it, i >= 0: row i was clicked.
    callback menu(int);
    callback answer(AutofillAnswer);

    property <bool> prompting: root.view.prompt;
    property <bool> leaving: !root.prompting && prompt.mounted;

    width: Shell.prompt-width;
    height: root.prompting || root.leaving ? prompt.height : chip.height + (root.view.menu-open ? Shell.prompt-gap + list.height : 0px);
    visible: root.view.chip || root.prompting || root.leaving;

    chip := IconButton {
        x: 0px;
        y: 0px;
        // the prompt takes the chip's place
        visible: root.view.chip && !root.prompting && !root.leaving;
        icon-path: Glyph.key;
        label: "Passwords";
        on: root.view.menu-open;
        clicked => {
            root.menu(root.view.menu-open ? -2 : -1);
        }
    }

    list := AMenuPopover {
        x: 0px;
        y: chip.height + Shell.prompt-gap;
        visible: root.view.chip && self.mounted;
        open: root.view.menu-open;
        key: GlassKeys.autofill-menu;
        rows: root.view.rows;
        icon: Glyph.key;
        label: "Saved passwords";
        picked(i) => {
            if root.view.menu-open {
                root.menu(i);
            }
        }
    }

    // The host keeps the prompt's text while it leaves.
    prompt := APrompt {
        width: root.width;
        open: root.prompting;
        key: GlassKeys.autofill-prompt;
        title: root.view.title;
        detail: root.view.detail;
        ghost-a: "Never";
        danger: true;
        ghost-b: "Not now";
        primary: root.view.accept;
        answered(i) => {
            root.answer(i == 0 ? AutofillAnswer.never : i == 1 ? AutofillAnswer.not-now : AutofillAnswer.save);
        }
    }
}

import { Palette, Motion, Space, Fonts, Type } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { GlassPanel } from "../kit/material/glass.slint";
import { OverlapLayer } from "../kit/motion/overlap.slint";
import { GlassTier } from "model.slint";
import { SheetButton } from "sheet-button.slint";
import { IconButton } from "nav-buttons.slint";
import { Calm } from "../kit/motion/calm.slint";
import { Glyph } from "../kit/controls/icon.slint";

// Password autofill (wubble host/autofill.rs): the key chip a sign-in form shows, its menu of
// saved logins (and "Suggest a strong password" on a sign-up form), and the save / update prompt
// after a sign-in. Written from scratch: the design repo has no password UI. The menu's rows are
// the context menu's (context-menu.slint: Ultra Reactivate `.ur-o-surface`, rows 40 high,
// radius 9, staggered in), the prompt is the permission prompt's (permission-prompt.slint: thick
// glass, radius 14, 42-high buttons, drop-in at .95 over 200 ms from its top left). Placed by the
// parent under the address pill. Never modal and never focused: no keystroke meant for the page
// can pick a login or answer the prompt (keyjacking). Intents only; the host fills and saves.
// The save prompt's buttons (host/autofill.rs `autofill_answer`).
export enum AutofillAnswer { save, never, not-now }

export struct AutofillView {
    chip: bool,
    menu-open: bool,
    rows: [string],
    // The save prompt shows; its title, detail and button ("Save" / "Update").
    prompt: bool,
    title: string,
    detail: string,
    accept: string,
}

export component AutofillMenu inherits Rectangle {
    in property <AutofillView> view;
    // -1: open the menu, -2: close it, i >= 0: row i was clicked.
    callback menu(int);
    callback answer(AutofillAnswer);

    // The host keeps the prompt's text while it leaves.
    property <bool> prompting: root.view.prompt;
    property <bool> leaving: !root.prompting && prompt-panel.opacity > 0;

    width: Shell.prompt-width;
    height: root.prompting || root.leaving ? prompt.preferred-height : chip.height + (root.view.menu-open ? Shell.prompt-gap + list.preferred-height : 0px);
    visible: root.view.chip || root.prompting || root.leaving;

    chip := IconButton {
        x: 0px;
        y: 0px;
        visible: root.view.chip;
        icon-path: Glyph.key;
        label: "Passwords";
        clicked => {
            root.menu(root.view.menu-open ? -2 : -1);
        }
    }

    menu-panel := GlassPanel {
        x: 0px;
        y: chip.height + Shell.prompt-gap;
        width: Shell.menu-width;
        height: list.preferred-height;
        visible: root.view.chip;
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.view.menu-open ? 1 : Motion.dropdown-from;
        opacity: root.view.menu-open ? 1 : 0;
        animate transform-scale, opacity {
            duration: Calm.ms(root.view.menu-open ? Motion.dropdown-in : Motion.dropdown-out);
            easing: root.view.menu-open ? Motion.ease-out : Motion.ease-in-out;
        }
        TouchArea {
            enabled: root.view.menu-open;
        }

        list := VerticalLayout {
            padding: Shell.menu-pad;
            for row[i] in root.view.rows: OverlapLayer {
                shown: root.view.menu-open;
                index: i;
                height: Shell.menu-row;
                Rectangle {
                    border-radius: Shell.menu-row-radius;
                    background: row-touch.has-hover ? Shell.command-selected : transparent;
                    animate background {
                        duration: Calm.ms(Shell.menu-hover-ms);
                        easing: Motion.ease-out;
                    }
                    row-touch := TouchArea {
                        enabled: root.view.menu-open;
                        clicked => {
                            root.menu(i);
                        }
                    }
                    Text {
                        x: Shell.menu-row-pad;
                        width: parent.width - 2 * Shell.menu-row-pad;
                        height: parent.height;
                        text: row;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.ink;
                        font-family: Fonts.ui;
                        font-size: Type.body.size;
                    }
                }
            }
        }
    }

    prompt-panel := GlassPanel {
        width: root.width;
        height: prompt.preferred-height;
        visible: root.prompting || self.opacity > 0;
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.prompting ? 1 : Motion.dropdown-from;
        opacity: root.prompting ? 1 : 0;
        animate transform-scale, opacity {
            duration: Calm.ms(root.prompting ? Motion.dropdown-in : Motion.dropdown-out);
            easing: root.prompting ? Motion.ease-out : Motion.ease-in-out;
        }
        TouchArea {
            enabled: root.prompting;
        }

        prompt := VerticalLayout {
            padding: Space.s4;
            spacing: Space.s2;
            Text {
                text: root.view.title;
                color: Palette.ink;
                font-family: Fonts.ui;
                font-size: Type.heading.size;
                font-weight: Type.heading.weight;
                overflow: elide;
            }
            Text {
                text: root.view.detail;
                color: Palette.mist;
                font-family: Fonts.ui;
                font-size: Type.body.size;
                wrap: word-wrap;
            }
            Rectangle {
                height: Space.s1;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Space.s2;
                SheetButton {
                    text: "Never";
                    clicked => {
                        if root.prompting {
                            root.answer(AutofillAnswer.never);
                        }
                    }
                }
                SheetButton {
                    text: "Not now";
                    clicked => {
                        if root.prompting {
                            root.answer(AutofillAnswer.not-now);
                        }
                    }
                }
                SheetButton {
                    text: root.view.accept;
                    primary: true;
                    clicked => {
                        if root.prompting {
                            root.answer(AutofillAnswer.save);
                        }
                    }
                }
            }
        }
    }
}

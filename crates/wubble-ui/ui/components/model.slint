// Slint has only i32 integers, so ids are int here; the wiring layer converts from core ids.
// The port's `TabItem` (design repo src/wubble/slint/components.slint, @source slint-tab-row)
// plus `id`. `favicon` is the site's real favicon, never a letter tile; an empty image shows the
// neutral globe glyph.
export struct TabItem {
    id: int,
    title: string,
    url: string,
    favicon: image,
    // wubble: the page plays sound (the engine's audible probe) / the tab is muted.
    audible: bool,
    muted: bool,
    // wubble: a pane of the Space's split (the design's tab-row split glyph).
    in-split: bool,
    // wubble: requests the blocker stopped on this tab's page.
    blocked: int,
    // wubble: 0 a tab, 1 a folder's header (a negative id; `title` is its name, `count` its tabs,
    // `collapsed` whether they are folded away). `depth` 1: a tab inside a folder.
    kind: int,
    depth: int,
    count: int,
    collapsed: bool,
    // wubble: an agent session's tab (an MCP session drives it); the row shows the mark.
    agent: bool,
}

// The border beam this frame (wubble_core::beam::Shape): head and tail length as fractions of
// the perimeter (clockwise from the top centre), strength 0..1 (0: nothing drawn), sheen hue.
export struct BeamShape {
    head: float,
    length: float,
    strength: float,
    hue: float,
}

// A tab row on its way out (wubble_core::tabs::Leaving): what it showed, where it was, and how
// far it has gone (0..1).
export struct LeavingRow {
    tab: TabItem,
    y: length,
    e: float,
}

export struct SpaceItem {
    id: int,
    name: string,
    tint: color,
    // "personal" | "work" | "study" (wubble_core::space::SpaceIcon)
    icon: string,
    // wubble: an agent session's Space (`SpaceName` shows the mark).
    agent: bool,
}

// One line of the sidebar's Spaces popup (wubble_core::spacemenu: its groups' rows, a rule
// between two groups). `id` is the Space's.
export struct SpacesMenuRow {
    rule: bool,
    id: int,
    name: string,
    tint: color,
    // "personal" | "work" | "study" (wubble_core::space::SpaceIcon)
    icon: string,
    current: bool,
}

// A built-in page Settings links to (wubble_core::pages::PAGE_LINKS): its title, address (which
// names its icon, kit `Glyph.page`), one-line note and the id of the action that opens it.
export struct PageLinkItem {
    title: string,
    url: string,
    note: string,
    action: string,
}

// The Spaces popup's geometry in window px, for a dragged tab's drop targets
// (wubble_core::spacemenu::Geometry, tabdrag::Rects).
export struct SpacesMenuGeometry {
    shown: bool,
    // the switcher (the "^" and the current Space's tile)
    switcher-x: length,
    switcher-y: length,
    switcher-w: length,
    switcher-h: length,
    // the panel
    panel-x: length,
    panel-y: length,
    panel-w: length,
    panel-h: length,
    // the rows' column, the scrolled list and its lines, the sticky row
    rows-x: length,
    rows-w: length,
    list-top: length,
    list-h: length,
    scroll: length,
    line: length,
    rule: length,
    sticky-top: length,
}

export enum CommandKind {
    open-tab,
    history,
    bookmark,
    search,
    action,
}

export struct CommandResult {
    kind: CommandKind,
    title: string,
    subtitle: string,
    shortcut: string,
    // wubble: the site's favicon (history rows); an empty image shows the kind's glyph.
    icon: image,
}

// The command bar's life (mirrors wubble_core::chrome::CommandBar; the driver writes it).
export enum CommandBarState {
    closed,
    open,
    closing,
}

// Where the command bar's field is (mirrors wubble_core::chrome::Placement; the driver writes
// it): the overlay panel, or the start page's capsule.
export enum CommandPlacement {
    overlay,
    in-page,
}

// What the command bar opens for (mirrors wubble_core::chrome::CommandMode).
export enum CommandMode {
    here,
    new,
    split,
}

// Mirrors wubble_core::seam::SidebarMode; the seam (Rust) owns it.
// F6's regions (mirrors wubble_core::region::Region; mapped in crates/wubble/src/host.rs).
export enum FocusRegion {
    address,
    sidebar,
    page,
}

export enum SidebarMode {
    extended,
    rail,
    hidden,
}

// Mirrors wubble_gfx::scene::Tier (checked in crates/wubble/src/backdrop.rs, test
// slint_glass_tier_mirrors_the_scene).
export enum GlassTier {
    thin,
    regular,
    thick,
}

// One glass panel for the wgpu scene (wubble_gfx::scene::GlassRect): where it is in the window
// (logical px, after its press scale), its corners, tier and touch state. Every GlassPanel
// reports its own through GlassLayer.report; one with `present: false` adds nothing.
export struct GlassItem {
    key: int,
    x: length,
    y: length,
    width: length,
    height: length,
    radius: length,
    tier: GlassTier,
    pressed: bool,
    hover: bool,
    focus: bool,
    // wubble: mixed into the glass at 10%, transparent for none (the window's Space colour)
    tint: color,
    present: bool,
    // The overlay layer it is drawn in, above the page (GlassOver); 0 under the page.
    layer: int,
    // The panel's own opacity (its entrance fade).
    alpha: float,
}

// The scene's glass layer. The host sets `scene-active` once, from its explicit choice of
// glass (wubble backdrop.rs `Glass`); the driver bumps `generation` every frame and the panels
// that report in answer are the scene's list (wubble-ui glass.rs): destroyed ones drop out.
export global GlassLayer {
    in-out property <bool> scene-active: false;
    // The scene draws the overlays' glass above the page (app.slint sets it: the scene is on
    // and no page fills the window). Off, the overlays draw their own Slint glass.
    in-out property <bool> over-on: false;
    in-out property <int> generation: 0;
    callback report(GlassItem);
}

// Each panel's place in the scene's list, back to front (one table, read by Rust too).
export global GlassKeys {
    out property <int> sidebar: 0;
    out property <int> address: 1;
    // plus the tab id
    out property <int> favourites: 100;
    // The overlays, above everything under the page, each layer back to front (app.slint's
    // order). Past any favourite's key.
    out property <int> overlays: 1000000;
    out property <int> video-strip: 1000010;
    out property <int> video-tab: 1000011;
    out property <int> video-speeds: 1000012;
    out property <int> pip-strip: 1000013;
    out property <int> find: 1000020;
    out property <int> preview: 1000030;
    out property <int> reader: 1000040;
    out property <int> shot: 1000050;
    out property <int> boost: 1000060;
    out property <int> toast: 1000070;
    out property <int> error: 1000080;
    out property <int> bookmark-sheet: 1000090;
    out property <int> print-sheet: 1000091;
    out property <int> agent-sheet: 1000092;
    out property <int> glance: 1000100;
    out property <int> dialog: 1000110;
    out property <int> command-bar: 1000120;
    out property <int> peek: 1000200;
    out property <int> permission: 1000300;
    out property <int> autofill-menu: 1000310;
    out property <int> autofill-prompt: 1000311;
    out property <int> downloads: 1000320;
    out property <int> spaces: 1000325;
    out property <int> menu: 1000330;
}

// The images the scene draws overlay glass in, above the page (wubble_gfx::scene::OverLayer):
// `GlassItem.layer`. Each is an `Image` at the place in app.slint of the overlays it serves.
export global GlassOver {
    // in the page card, over the pages: bars, sheets, the command bar, video controls
    out property <int> card: 1;
    // under the peeking sidebar's content
    out property <int> peek: 2;
    // over the whole window: menus, popovers, prompts
    out property <int> top: 3;
}

// The eight resize zones of the window frame (design desktop.tsx `edgeDown`); Rust maps each to
// the compositor's resize direction.
export enum WindowEdge {
    n,
    s,
    e,
    w,
    ne,
    nw,
    se,
    sw,
}

// A point in window coordinates (Slint has no point type).
export struct Origin {
    x: length,
    y: length,
}

// ── The page's own UI (wubble surface.rs, menu.rs): the visible tab's surfaces, written by the
// host after every change (one writer); the components only read them and report intents.

// One context-menu row; `separator` rows are dividers. `icon` names an `Glyph` glyph (empty:
// none), `shortcut` is the key that does the same (empty: none), `danger` rows close something
// and draw in coral (the design's `MENU_ROWS`, pages/touch.tsx).
export struct MenuEntry {
    label: string,
    enabled: bool,
    separator: bool,
    icon: string,
    shortcut: string,
    danger: bool,
}

// A context menu (the page's or a tab row's): where the pointer was, in window coordinates,
// and its rows.
export struct MenuView {
    open: bool,
    x: length,
    y: length,
    entries: [MenuEntry],
    // some row has an icon: the rows without one keep the icon's column, so labels line up
    icons: bool,
}

// A JS dialog or the HTTP sign-in as a sheet. `cancel` empty: no cancel button (an alert).
// `secret`: a second, masked field (the sign-in's password; `input` is then the user name).
// `serial` changes for every new dialog, so the sheet resets its fields.
export struct DialogView {
    open: bool,
    title: string,
    message: string,
    accept: string,
    cancel: string,
    prompt: bool,
    secret: bool,
    input: string,
    serial: int,
}

// The permission prompt under the address pill: "<site> wants to", one line per kind. `serial`
// changes for every new request, so the prompt resets its "remember" toggle.
export struct PermissionView {
    open: bool,
    title: string,
    lines: [string],
    // The remember toggle's words and the two buttons' (an external link's prompt says
    // "Always for <site> and <scheme> links", Cancel and Open).
    remember: string,
    allow: string,
    block: string,
    serial: int,
}

// The error panel over the page (wubble page_error.rs): a failed load, a refused certificate or
// a crashed page. `secondary` empty: no second button. `cert`: the certificate panel.
export struct ErrorView {
    open: bool,
    title: string,
    summary: string,
    detail: string,
    primary: string,
    secondary: string,
    cert: bool,
}

// `wubble_core::download::DownloadState`, one to one; the row derives its buttons from it.
export enum DownloadStatus {
    running,
    paused,
    interrupted,
    complete,
    cancelled,
    failed,
}

// One row of the downloads popover (wubble host/downloads.rs). `progress` 0 to 1, below 0 when
// the size is unknown.
export struct DownloadItem {
    id: int,
    name: string,
    detail: string,
    progress: float,
    status: DownloadStatus,
}

export enum DownloadAction {
    pause,
    resume,
    cancel,
    retry,
    remove,
    reveal,
    open,
}

// The find bar. `focus-serial` changes when the bar should take the keyboard (Mod+F).
export struct FindView {
    open: bool,
    query: string,
    counter: string,
    // the search is over and found nothing
    none: bool,
    focus-serial: int,
}

// The page's popup widget (`<select>` list, date picker, autofill) in window coordinates.
export struct PopupView {
    shown: bool,
    // Where the layer is drawn: window coordinates, kept inside the window.
    x: length,
    y: length,
    width: length,
    height: length,
    // The engine's own top left of the popup, relative to the web view: CEF hit-tests the popup
    // there, so pointer input maps back through it even when the layer was moved to fit.
    origin-x: length,
    origin-y: length,
}

// Where the sidebar's parts sit, in window coordinates (the alignment the tests pin). Each pair is
// a part's left and right edge: the visible box (what the glass under it covers; its contents are
// clipped to it) and the box the contents are laid out in, the window lights (and their top), the
// header's buttons, the address pill (and its vertical middle, and the centre of its glyph), the
// tab rows, the new-tab row, the Space tiles and the downloads button (and its top).
export struct SideEdges {
    start: length,
    end: length,
    content-end: length,
    lights: length,
    lights-end: length,
    lights-y: length,
    nav: length,
    nav-end: length,
    pill: length,
    pill-end: length,
    pill-y: length,
    glyph-x: length,
    glyph-y: length,
    rows: length,
    rows-end: length,
    new-tab: length,
    new-tab-end: length,
    spaces: length,
    spaces-end: length,
    downloads: length,
    downloads-end: length,
    downloads-y: length,
    // wubble: the footer's settings button
    settings: length,
    settings-end: length,
}

// ── The settings page (wubble_core::pages::settings_page), generated from the settings table:
// one row per setting, its control picked by the setting's kind (`pages::control_for`).
export enum SettingControl {
    toggle,
    segmented,
    stepper,
    slider,
    list,
    map,
    text,
}

// One removable entry of a list: its line, and the key removing it names.
export struct EntryItem {
    // the whole row as one line (a screen reader's)
    label: string,
    // what removing or editing it names
    key: string,
    // one per column of its list editor (kit/controls/list-editor.slint)
    cells: [string],
    // a leading icon (a glyph path) in `tint` (transparent: the menu row's icon mist); the
    // swatch column's dot in `tint`
    icon: string,
    tint: color,
}

// One filter list of the settings page's "Filter lists" section. `key` names a custom list
// (its URL) for removing it; `id` a catalog list for switching it. `note`: licence, rules, age.
export struct FilterListItem {
    id: string,
    title: string,
    note: string,
    enabled: bool,
    custom: bool,
    key: string,
}

// One row of the flat list the page shows; `section` names the section the row opens (empty
// for the rest of it), `first` / `last` round the section's card.
export struct SettingItem {
    section: string,
    // the section's place among the page's sections (the nav's row)
    section-index: int,
    first: bool,
    last: bool,
    key: string,
    label: string,
    control: SettingControl,
    // the storage text
    value: string,
    // toggle
    on: bool,
    // stepper and slider
    number: float,
    min: float,
    max: float,
    // segmented: the stored words, their labels, the chosen one (-1: none yet)
    words: [string],
    labels: [string],
    selected: int,
    // list and map: the entries, their list editor's column titles, and the host's answer to
    // the last draft submitted to this row (a new serial each time; `note` empty: taken)
    entries: [EntryItem],
    columns: [string],
    answer: int,
    note: string,
    changed: bool,
    restart: bool,
    // a choice the design picks from a Select (the search engine): its labels as menu rows;
    // empty for the segmented ones
    options: [MenuEntry],
}

// One action of the keybinding editor (`keys::binding_rows`).
export struct BindingItem {
    // the `Action`'s id
    action: string,
    label: string,
    chord: string,
    // the chord's keys, one key cap each ("Ctrl", "K")
    keys: [string],
    changed: bool,
}

// The editor's chord capture (`keys::Capture`): idle, armed for `action`, or asking whether to
// take `chord` from `other`.
export struct CaptureView {
    action: string,
    armed: bool,
    conflict: bool,
    chord: string,
    other: string,
}

export struct SpaceSetting {
    id: int,
    name: string,
    tint: color,
    // "personal" | "work" | "study" (SpaceIcon)
    icon: string,
    // the colour's swatch name ("Sky"; empty for another colour) and the Space's tab count
    colour: string,
    tabs: int,
}

// The settings page's Updates group (wubble_core::update::view): the switch, the version, what
// the updater is doing, and which button shows.
export struct UpdatesView {
    on: bool,
    version: string,
    status: string,
    can-check: bool,
    ready: bool,
    // updates come from elsewhere (a package, a development build): no switch, no button
    inert: bool,
}

export struct AboutView {
    version: string,
    cef: string,
    chromium: string,
    licence: string,
    notices: string,
}

// ── The native pages (wubble_core::pages). One page shows at a time, in the tab on its url.
export enum InternalPageKind {
    none,
    settings,
    history,
    bookmarks,
    downloads,
    passwords,
    archive,
    tasks,
    // wubble://agent: the agent activity log
    agent-log,
    // the new-tab page (wubble://start)
    start,
}

// The tab hover preview card (`PreviewCard`): what it says and where its row is (window px).
export struct PreviewView {
    shown: bool,
    title: string,
    address: string,
    thumb: image,
    y: length,
}

// The window's one tooltip (tooltip.slint): a page's `title` or a shell button's name and
// shortcut, hung from (anchor-x, anchor-y) in window px; `centered`: anchor-x is its centre.
// `anchor-top`: the top of what it hangs from (the button's top, the pointer), which it sits
// above when there is no room below. `jump`: the first one appears in place, later ones glide.
export struct TipView {
    shown: bool,
    text: string,
    shortcut: string,
    anchor-x: length,
    anchor-y: length,
    anchor-top: length,
    centered: bool,
    jump: bool,
}

// One row of the Task manager (wubble_core::tasks::TaskRow): a tab (`tab` >= 0) or another
// of wubble's processes (`tab` -1). Text is formatted by the host.
export struct TaskItem {
    tab: int,
    // 0: no process (a discarded tab, an internal page).
    pid: int,
    title: string,
    state: string,
    memory: string,
    cpu: string,
    busy: string,
    never-sleep: bool,
    can-discard: bool,
    can-end: bool,
}

export enum TaskAction {
    end,
    discard,
    never-sleep,
}

// One line of the history page: a day header (`header`, `label`) or a visit.
export struct HistoryLineItem {
    header: bool,
    // The visit's or archived tab's id (rows are deleted by address in history, by id in the archive).
    key: int,
    label: string,
    title: string,
    url: string,
    favicon: image,
}

// One visible line of the bookmark tree (or a search hit: `path` names its folder).
export struct BookmarkLineItem {
    id: int,
    depth: int,
    title: string,
    url: string,
    path: string,
    favicon: image,
    is-folder: bool,
    expanded: bool,
}

// One entry of the bookmark sheet's folder picker; `id` -1 is the top level.
export struct FolderChoiceItem {
    id: int,
    label: string,
    depth: int,
}

// The print sheet (`wubble_core::print::Sheet`).
export struct PrintSheetView {
    open: bool,
    // Rendering or sending: the buttons wait.
    busy: bool,
    // Changes with each opening: the pages field restarts from `pages`.
    serial: int,
    // Why the last try failed, or a bad page range; empty when all is well.
    error: string,
    // "Save as PDF", then the printers.
    destinations: [string],
    destination: int,
    pages: string,
    landscape: bool,
    // Letter, A4, Legal.
    paper: int,
    // Default, None, Minimum.
    margins: int,
    scale: int,
    background: bool,
    copies: int,
}

// An agent session's approval sheet (`wubble_core::agent::SheetText`): who asks and for what.
export struct AgentSheetView {
    open: bool,
    // Changes with each sheet: the window choice restarts from `headless`.
    serial: int,
    // The calling program's name.
    client: string,
    // The secrets it asks for, by name (never a value).
    secrets: [string],
    // The sites it limits itself to; none: any site.
    sites: [string],
    // The client asks to run without showing its window.
    headless: bool,
}

// One line of the agent activity log page (`wubble_core::agent::log::Row`).
export struct AgentLogItem {
    title: string,
    note: string,
    failed: bool,
}

// What the bookmark sheet asks (Ctrl+D, rename, move, new folder).
export struct BookmarkSheetView {
    open: bool,
    // Changes with each opening: the sheet restarts from `name` and `folder`.
    serial: int,
    title: string,
    accept: string,
    show-name: bool,
    name: string,
    show-folders: bool,
    // The folder id to start on (-1: the top level).
    folder: int,
    // The page is already bookmarked: offer removing it.
    can-remove: bool,
}

// One saved login. `revealed` is the password while the user asked to see it (empty otherwise).
export struct LoginItem {
    id: string,
    site: string,
    username: string,
    revealed: string,
    has-revealed: bool,
}

export enum VaultState {
    locked,
    unlocked,
    unavailable,
    unreadable,
}

export struct PasswordsView {
    state: VaultState,
    title: string,
    body: string,
    // The last import's report, or an error to show under the buttons.
    notice: string,
}

// ── Pages for screen readers (wubble-ax `PageTree::flatten`, host `ax.rs`).

// What a page item is (wubble_ax::Kind, mapped once in the host's `ax.rs`).
export enum AxKind { heading, link, button, text-field, check-box, radio-button, image, text }

// One item of the visible page for assistive technology, in reading order. `x`..`h`: its
// rectangle in the content area, logical px.
export struct AxItemView {
    id: int,
    kind: AxKind,
    label: string,
    value: string,
    level: int,
    checked: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

// ── Video controls (wubble_core::video), drawn over the visible page's main video.

// A SponsorBlock segment on the progress bar, as fractions of the video.
export struct VideoMark {
    from: float,
    to: float,
    colour: color,
}

// The strip's save button (wubble_core::video::Save): none, or the media downloader's state for
// the page.
export enum VideoSave { absent, offered, saving, saved, failed }

// The controls of the visible page's video. `x`..`h`: the video's rectangle in the content
// area, logical px. `rate`: the speed shown ("1.5×"); `rate-index`: its row in the speed menu.
export struct VideoView {
    // the strip shows; `collapsed`: only its tab at the page's right edge shows
    open: bool,
    collapsed: bool,
    // the page pane's right and bottom edges, in the same coordinates as `x` and `y`
    pane-right: length,
    pane-bottom: length,
    x: length,
    y: length,
    w: length,
    h: length,
    paused: bool,
    looped: bool,
    muted: bool,
    progress: float,
    rate: string,
    rate-index: int,
    speeds: bool,
    can-pip: bool,
    save: VideoSave,
    // while saving: 0..1, below 0 while the size is unknown
    save-fraction: float,
    // its accessible label (wubble_core::video::Save::label)
    save-label: string,
    marks: [VideoMark],
}

// ── The Boost editor (wubble_core::boost) docked beside the page. `serial` changes when the
// host replaces the texts (a new Boost, a zapped element), so the fields reload them; typing
// does not change it.
export struct BoostView {
    open: bool,
    serial: int,
    is-new: bool,
    name: string,
    site: string,
    css: string,
    js: string,
    // 0: document start, 1: when the document is parsed.
    at: int,
    tint-on: bool,
    tint: color,
    strength: float,
    font: string,
    enabled: bool,
    zapping: bool,
    // Why the site pattern is refused, or empty.
    error: string,
}

// The window's peek (glance-card.slint): its page's last frame and where the host lays the page
// out in the content area (`card-y` is the card's top, over the header).
export struct GlanceView {
    open: bool,
    id: int,
    title: string,
    frame: image,
    clip-width: int,
    clip-height: int,
    x: length,
    card-y: length,
    y: length,
    width: length,
    height: length,
}

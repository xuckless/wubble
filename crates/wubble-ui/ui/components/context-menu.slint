import { PointMenu } from "../kit/controls/menu.slint";

// The page's context menu (and the tab row's and site menus, through the host's MenuView): the
// kit's menu at a point (kit/controls/menu.slint `PointMenu`: the design's `.tp-menu`). Fills its
// parent (the window) so a click anywhere outside the panel dismisses it. Same API as before:
// `open`, `anchor-x`, `anchor-y`, `entries`, `chosen(int)`, `dismissed()`, `take-focus()`,
// `panel-x`.
export component ContextMenu inherits PointMenu { }

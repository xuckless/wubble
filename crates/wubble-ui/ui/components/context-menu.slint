import { Palette, Motion, Space, Fonts, Type } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { GlassPanel } from "../kit/material/glass.slint";
import { OverlapLayer } from "../kit/motion/overlap.slint";
import { GlassTier, MenuEntry, GlassKeys, GlassOver } from "model.slint";
import { Icon, Glyph } from "../kit/controls/icon.slint";
import { Calm } from "../kit/motion/calm.slint";

// The page's context menu; fills its parent (the window) so a click anywhere outside the panel
// dismisses it (and is consumed, as Chromium's menu consumes it). Written from scratch: the
// design repo has no menu. Looks and timings are Ultra Reactivate's `.ur-o-surface`
// (src/ultra-reactivate/overlays.css, the owner's library): 220 wide, padding 6, radius 14,
// rows 40 high with radius 9, entering at .95 over 200 ms ease-out from the pointer, rows
// staggered 30 ms. On thick glass over content (GlassPanel), as the command bar.
// Keys: Up/Down move, Enter/Space choose, Escape dismisses. `chosen` and `dismissed` are
// intents; the host answers the engine and closes it.
export component ContextMenu inherits Rectangle {
    in property <bool> open;
    // Where the pointer was, in this element's coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <[MenuEntry]> entries;
    // What the panel shows: the last open menu's, kept while it leaves (the host clears the
    // menu as it closes it).
    property <[MenuEntry]> rows;
    property <length> at-x;
    property <length> at-y;
    changed open => {
        root.latch();
    }
    changed entries => {
        root.latch();
    }
    function latch() {
        if root.open {
            root.rows = root.entries;
            root.at-x = root.anchor-x;
            root.at-y = root.anchor-y;
        }
    }
    callback chosen(int);
    callback dismissed();
    // The panel's left edge, after flipping and clamping.
    out property <length> panel-x: panel.x;

    property <int> count: root.rows.length;
    // Keyboard highlight; -1 for none (the pointer highlights by hover).
    property <int> current: -1;

    public function take-focus() {
        root.current = -1;
        keys.focus();
    }

    // The next row from `from` by `delta`, wrapping and stepping over a divider (dividers are
    // never adjacent, first or last); -1 when empty. Disabled rows can be highlighted, but
    // choosing one does nothing (menu.rs).
    function step(from: int, delta: int) -> int {
        if root.count == 0 {
            return -1;
        }
        let i = mod(from + delta + root.count, root.count);
        return root.rows[i].separator ? mod(i + delta + root.count, root.count) : i;
    }

    // Opens to the right of and below the pointer; flips where it would leave the parent, then
    // clamps into it (8 px from the edges).
    pure function place(anchor: length, size: length, limit: length) -> length {
        let flipped = anchor + size > limit - Space.s2 ? anchor - size : anchor;
        return max(Space.s2, min(flipped, limit - size - Space.s2));
    }

    // The exit is seen (Overlap: the old state shares the screen while it leaves): drawn until
    // the panel has faded, on what it showed; only the open menu takes the pointer.
    visible: root.open || panel.opacity > 0;

    // The scrim: transparent, catches the outside click.
    TouchArea {
        enabled: root.open;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        scroll-event(e) => {
            root.dismissed();
            accept
        }
    }

    // Keys only; no area, so it never takes the pointer from the scrim.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.current = root.step(root.current < 0 ? -1 : root.current, 1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.current = root.step(root.current < 0 ? root.count : root.current, -1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") && root.current >= 0 {
                root.chosen(root.current);
                return accept;
            }
            return accept;
        }
    }

    panel := GlassPanel {
        // the scene draws its glass above the page (GlassPanel `over-layer`)
        key: GlassKeys.menu;
        over-layer: GlassOver.top;
        width: Shell.menu-width;
        height: list.preferred-height;
        x: root.place(root.at-x, self.width, root.width);
        y: root.place(root.at-y, self.height, root.height);
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        transform-origin: {
            x: max(0px, min(self.width, root.at-x - self.x)),
            y: max(0px, min(self.height, root.at-y - self.y)),
        };
        transform-scale: root.open ? 1 : Motion.dropdown-from;
        opacity: root.open ? 1 : 0;
        animate transform-scale, opacity {
            duration: Calm.ms(root.open ? Motion.dropdown-in : Motion.dropdown-out);
            easing: root.open ? Motion.ease-out : Motion.ease-in-out;
        }
        // Swallow clicks between rows so they do not reach the scrim.
        TouchArea { }

        // Slint 1.19 has no menu roles: a list of items, the keyboard highlight selected.
        accessible-role: AccessibleRole.list;
        accessible-label: "Menu";
        list := VerticalLayout {
            padding: Shell.menu-pad;
            // The rows enter on the Overlap stagger (OverlapLayer, the design repo's port).
            for entry[i] in root.rows: OverlapLayer {
                shown: root.open;
                index: i;
                height: entry.separator ? Shell.menu-separator : Shell.menu-row;
                if entry.separator: Rectangle {
                    x: Shell.menu-row-pad;
                    width: parent.width - 2 * Shell.menu-row-pad;
                    height: Shell.menu-rule;
                    background: Palette.rim;
                }
                if !entry.separator: Rectangle {
                    // Icon, label, shortcut; a danger row in coral with a coral highlight
                    // (the design's `.tp-mrow.danger`, `.tp-menu-hl.danger`: coral at .12).
                    property <bool> lit: entry.enabled && (row-touch.has-hover || i == root.current);
                    property <length> lead: entry.icon != "" ? Shell.menu-row-pad + Shell.icon + Space.s2 : Shell.menu-row-pad;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: entry.label;
                    accessible-enabled: entry.enabled;
                    accessible-item-index: i;
                    accessible-item-count: root.count;
                    accessible-item-selected: i == root.current;
                    accessible-action-default => {
                        if entry.enabled && root.open {
                            root.chosen(i);
                        }
                    }
                    border-radius: Shell.menu-row-radius;
                    background: !self.lit ? transparent : entry.danger ? Palette.coral.with-alpha(0.12) : Shell.command-selected;
                    animate background {
                        duration: Calm.ms(Shell.menu-hover-ms);
                        easing: Motion.ease-out;
                    }
                    row-touch := TouchArea {
                        enabled: entry.enabled && root.open;
                        clicked => {
                            root.chosen(i);
                        }
                    }
                    if entry.icon != "": Icon {
                        x: Shell.menu-row-pad;
                        y: (parent.height - self.height) / 2;
                        path: Glyph.named(entry.icon);
                        tint: entry.danger ? Palette.coral : entry.enabled ? Palette.mist : Palette.haze;
                    }
                    shortcut := Text {
                        x: parent.width - Shell.menu-row-pad - self.width;
                        height: parent.height;
                        text: entry.shortcut;
                        vertical-alignment: center;
                        color: Palette.haze;
                        font-family: Fonts.mono;
                        font-size: Type.label.size;
                    }
                    Text {
                        x: parent.lead;
                        width: shortcut.x - parent.lead - (entry.shortcut != "" ? Space.s2 : 0px);
                        height: parent.height;
                        text: entry.label;
                        vertical-alignment: center;
                        overflow: elide;
                        color: !entry.enabled ? Palette.haze : entry.danger ? Palette.coral : Palette.ink;
                        font-family: Fonts.ui;
                        font-size: Type.body.size;
                    }
                }
            }
        }
    }
}

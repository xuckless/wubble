import { Palette, Motion, Fonts } from "../tokens.slint";
import { Shell } from "../kit/derived.slint";

// The shell's buttons report their hover here: (Action id, where the tooltip hangs in window
// px: the button's centre x, top y and bottom y, on). One global, so any button reaches the host
// without a callback through every parent.
export global Tips {
    callback hover(string, length, length, length, bool);
}

// One tooltip for the window: a page's `title` near the pointer and the shell's icon buttons'
// names and shortcuts. Written from scratch: the design repo has no Slint tooltip; the look,
// numbers and motion are its dock tooltip (src/wubble/pages/touch.tsx `DOCK`, touch.css
// `.tp-tip`, the owner's own code): ink on abyss, 30 high, 0 11 px padding, radius 10, 12.5 px
// at 600; it rises 4 px from .95 into place (.16 s / .2 s ease-out, out over .13 s / .16 s
// ease-in). The first one appears in place (`jump`); while warm, the next glides and resizes
// to its new place over 260 ms on the in-out curve. The design crossfades the label with a
// blur; Slint cannot blur text, so the label changes in place. When it shows is the host's
// (`wubble_core::hovercard::TOOLTIP`: 280 ms intent, 520 ms warm). Pointer events pass through.
export component Tooltip inherits Rectangle {
    in property <bool> shown;
    in property <string> text;
    // A shell button's shortcut, drawn dimmer after the name; empty for a page's tooltip.
    in property <string> shortcut;
    // Window px: where it hangs from. `centered`: `anchor-x` is its centre and `anchor-y` the
    // bottom of a button, which it hangs `tip-gap` below; else its top left (by the pointer).
    // Without room below it sits `tip-gap` above `anchor-top` (the button's top, the pointer),
    // as Chromium's tooltips flip.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-top;
    in property <bool> centered;
    in property <bool> jump;
    // The window's size, to keep it inside.
    in property <length> bounds-width;
    in property <length> bounds-height;

    property <length> want-x: root.centered ? root.anchor-x - self.width / 2 : root.anchor-x;
    property <length> below-y: root.anchor-y + (root.centered ? Shell.tip-gap : 0px);
    property <length> above-y: root.anchor-top - Shell.tip-gap - self.height;
    property <bool> fits-below: root.below-y + self.height + Shell.tip-edge <= root.bounds-height;
    width: row.preferred-width;
    height: Shell.tip-height;
    x: max(Shell.tip-edge, min(self.want-x, root.bounds-width - self.width - Shell.tip-edge));
    y: root.fits-below ? root.below-y : max(Shell.tip-edge, root.above-y);
    animate x, y, width {
        duration: root.jump ? 0ms : Shell.tip-glide;
        easing: Motion.easeInOut;
    }

    tip := Rectangle {
        border-radius: Shell.tip-radius;
        background: Palette.ink;
        clip: true;
        opacity: root.shown ? 1 : 0;
        transform-origin: { x: self.width / 2, y: self.height };
        transform-scale: root.shown ? 1 : Motion.dropdownFrom;
        y: root.shown ? 0px : Shell.tip-rise;
        animate opacity {
            duration: root.shown ? Shell.tip-fade-in : Shell.tip-fade-out;
            easing: root.shown ? Motion.easeOut : Motion.easeIn;
        }
        animate transform-scale, y {
            duration: root.shown ? Shell.tip-rise-in : Shell.tip-rise-out;
            easing: root.shown ? Motion.easeOut : Motion.easeIn;
        }
        row := HorizontalLayout {
            padding-left: Shell.tip-pad;
            padding-right: Shell.tip-pad;
            spacing: Shell.tip-pad / 1.5;
            alignment: center;
            Text {
                text: root.text;
                color: Palette.abyss;
                font-family: Fonts.ui;
                font-size: Shell.tip-text;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.shortcut != "": Text {
                text: root.shortcut;
                color: Palette.haze;
                font-family: Fonts.ui;
                font-size: Shell.tip-text;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

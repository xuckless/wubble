import { Space } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { BoostView, GlassKeys, GlassOver } from "model.slint";
import { Button, ButtonKind } from "../kit/controls/button.slint";
import { HoldButton } from "../kit/controls/hold-button.slint";
import { Toggle, ToggleSize } from "../kit/controls/toggle.slint";
import { Segmented } from "../kit/controls/segmented.slint";
import { Swatches } from "../kit/controls/swatches.slint";
import { ElasticSlider } from "../kit/controls/slider.slint";
import { BField, BGroup } from "../kit/overlay/b/b-field.slint";
import { BCard, BRow, BNote } from "../kit/overlay/b/b-sheet-parts.slint";
import { BSidePanel, BCode, BoostTints } from "../kit/overlay/b/b-panel.slint";

// The Boost editor (wubble_core::boost), docked at the page's right edge: the site pattern, CSS
// and a script (monospace), when the script runs, a tint and its strength, a font, on/off, and
// the element zapper. The design has no editor (wubble-only.md §29): the panel is the Source
// panel (kit/overlay/b/b-panel.slint) holding a settings card (on, runs), the sheet fields, code
// areas, a Tint toggle row over Swatches and an ElasticSlider for the tint, Delete as a HoldButton (destructive means
// hold) and Done as `pri`; the site error is a coral note. CSS applies to the page as it is
// typed; a script on Done (the page reloads).
// Intents only: `text-edited(field, text)` for name, site, css, js, font; `number(field, value)`
// for at and strength; `tint(colour)`; `act(name)` for enabled, zap, done, delete, close.
export component BoostPanel inherits Rectangle {
    in property <BoostView> view;
    // The tint swatches (wubble's own palette: the Space colours).
    in property <[color]> swatches: BoostTints.colours;
    callback text-edited(string, string);
    callback number(string, float);
    callback tint(color);
    callback act(string);

    width: Shell.boost-panel-width;
    visible: panel.visible;

    // The texts reload only when the host replaced them.
    property <int> loaded: -1;
    property <string> name;
    property <string> site;
    property <string> css;
    property <string> js;
    property <string> font;
    changed view => {
        if root.loaded != root.view.serial {
            root.loaded = root.view.serial;
            root.name = root.view.name;
            root.site = root.view.site;
            root.css = root.view.css;
            root.js = root.view.js;
            root.font = root.view.font;
        }
    }
    // the controls that take registry slots are built while it shows and as it leaves
    property <bool> built: root.view.open || panel.progress > 0;

    panel := BSidePanel {
        key: GlassKeys.boost;
        layer: GlassOver.card;
        shown: root.view.open;
        title: root.view.is-new ? "New Boost" : "Boost";
        closed => {
            root.act("close");
        }
        if root.built: BCard {
            BRow {
                title: "On";
                Toggle {
                    size: ToggleSize.sm;
                    label: "On";
                    on: root.view.enabled;
                    toggled => {
                        root.act("enabled");
                    }
                }
            }
            BRow {
                title: "Script runs";
                Segmented {
                    compact: true;
                    label: "Script runs";
                    labels: ["At start", "When ready"];
                    selected: root.view.at;
                    chosen(i) => {
                        root.number("at", i);
                    }
                }
            }
        }
        BGroup {
            label: "Name";
            BField {
                text <=> root.name;
                placeholder: "Name";
                edited(t) => {
                    root.text-edited("name", t);
                }
                escaped => {
                    root.act("close");
                }
            }
        }
        BGroup {
            label: "Sites";
            BField {
                text <=> root.site;
                placeholder: "example.com";
                label: "Sites";
                edited(t) => {
                    root.text-edited("site", t);
                }
                escaped => {
                    root.act("close");
                }
            }
            BNote {
                text: root.view.error != "" ? root.view.error : "example.com, *.example.com, https://example.com/docs/*";
                danger: root.view.error != "";
            }
        }
        BGroup {
            label: "CSS";
            BCode {
                text <=> root.css;
                label: "Boost CSS";
                placeholder: "body { font-size: 18px }";
                edited(t) => {
                    root.text-edited("css", t);
                }
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    kind: ButtonKind.glass;
                    text: root.view.zapping ? "Click an element\u{2026}" : "Zap an element";
                    clicked => {
                        root.act("zap");
                    }
                }
            }
        }
        BGroup {
            label: "Script (runs with the page's rights)";
            BCode {
                text <=> root.js;
                label: "Boost script";
                placeholder: "document.title = 'boosted'";
                edited(t) => {
                    root.text-edited("js", t);
                }
            }
        }
        // The tint: a Toggle row (as in settings) is its on and off, and the Swatches and the
        // strength show only while it is on (the Swatches have no "none": their ring would stay
        // on a colour that is not applied). Off and on again both ask for the shown colour: the
        // host takes the chosen swatch again as no tint, and a new one as that tint.
        if root.built: BCard {
            BRow {
                title: "Tint";
                Toggle {
                    size: ToggleSize.sm;
                    label: "Tint";
                    on: root.view.tint-on;
                    toggled => {
                        root.tint(root.view.tint);
                    }
                }
            }
        }
        if root.built && root.view.tint-on: BGroup {
            Swatches {
                label: "Tint colour";
                colours: root.swatches;
                names: BoostTints.names;
                value: root.view.tint;
                chosen(c) => {
                    root.tint(c);
                }
            }
            ElasticSlider {
                compact: true;
                label: "Strength";
                unit: "%";
                // off is the toggle's: a strength of 0 would read as off and take the slider
                // away under the pointer
                min: 1;
                max: 100;
                value: root.view.strength;
                edited(v) => {
                    root.number("strength", v);
                }
            }
        }
        BGroup {
            label: "Font";
            BField {
                text <=> root.font;
                placeholder: "Geist, serif, ...";
                label: "Font";
                edited(t) => {
                    root.text-edited("font", t);
                }
                escaped => {
                    root.act("close");
                }
            }
        }
        if root.built: HorizontalLayout {
            alignment: end;
            spacing: Space.s2;
            if !root.view.is-new: HoldButton {
                text: "Delete";
                done-text: "Deleted";
                done => {
                    root.act("delete");
                }
            }
            Button {
                kind: ButtonKind.pri;
                text: "Done";
                clicked => {
                    root.act("done");
                }
            }
        }
    }
}

// The sidebar header's navigation: sidebar, back, forward, reload. From the design repo's
// src/wubble/browser/chrome.tsx (`.wb-nav` in `wb-side-top`) and browser.css `.wb-nav`, `.wb-ib`
// (owner's own code, xuckless/the-wallpaper-project @ 6c840da), kit IconButtons. Intents
// only: each button names a wubble `Action` by its id, which the host runs through `perform`.
// While the page loads, Reload is Stop (Chrome's reload button), its icon crossfading; Glyph has
// no stop glyph, so Stop wears close (docs/fidelity/derived-review.md).

import { Shell } from "../kit/derived.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { IconButton } from "../kit/controls/icon-button.slint";

// .wb-ib: the kit IconButton (kit/controls/icon-button.slint)
export { IconButton }

export component NavButtons inherits HorizontalLayout {
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    // the visible page is loading: Reload is Stop
    in property <bool> loading: false;
    // An `Action` id (wubble-core action.rs): toggle-sidebar, back, forward, reload, stop.
    callback action(string);
    // a right click on a button: its action id and where its menu goes (window coordinates)
    callback menu-requested(string, length, length);
    spacing: Shell.nav-gap;
    // [icon, action id, its spoken name, enabled, whether its icon crossfades]: one table, one
    // button each
    property <[{icon: string, id: string, label: string, enabled: bool, swaps: bool}]> buttons: [
        { icon: Glyph.sidebar, id: "toggle-sidebar", label: "Toggle sidebar", enabled: true, swaps: false },
        { icon: Glyph.back, id: "back", label: "Back", enabled: root.can-go-back, swaps: false },
        { icon: Glyph.forward, id: "forward", label: "Forward", enabled: root.can-go-forward, swaps: false },
        {
            icon: root.loading ? Glyph.close : Glyph.reload,
            id: root.loading ? "stop" : "reload",
            label: root.loading ? "Stop" : "Reload",
            enabled: true,
            swaps: true
        },
    ];
    for b in root.buttons: IconButton {
        icon-path: b.icon;
        tip-action: b.id;
        label: b.label;
        enabled: b.enabled;
        swaps: b.swaps;
        clicked => {
            root.action(b.id);
        }
        secondary-clicked => {
            root.menu-requested(b.id, self.absolute-position.x, self.absolute-position.y + self.height);
        }
    }
}

// The address bar at the top of the sidebar. Written for wubble from the design repo's web
// chrome (src/wubble/browser/browser.css `.wb-address`, `.wb-rail-addr`, and chrome.tsx
// `Address`, xuckless/the-wallpaper-project @ 6c840da): the Slint port has no address bar.
// Thin glass, radius 12, no shadow, the film rim on hover; host in Ink and the rest in Haze,
// Geist Mono 13. On the rail it is a search button (.wb-rail-addr, an icon button).

import { Palette, Chrome, Spacing, Fonts, Type, Motion } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel } from "../components.slint";
import { IconButton } from "nav-buttons.slint";
import { GlassTier, GlassKeys } from "model.slint";
import { Icon, IconPaths } from "icon.slint";
import { GlowRing } from "glow-ring.slint";

export component AddressPill inherits Rectangle {
    in property <string> host;
    in property <string> path;
    in property <bool> compact: false;
    // The scene draws this pill's glass (and its border beam).
    in property <bool> over-wgpu: false;
    // The window x range the sidebar shows: the glass is cut to it (GlassPanel `clip-start`).
    in property <length> glass-clip-start: -Shell.no-clip;
    in property <length> glass-clip-end: Shell.no-clip;
    // A page is loading. The design's border beam (chrome.tsx `Address`) is the scene's
    // (`set_beam` on this pill's glass rect, `lap_beam` when loading starts); this is its Slint
    // fallback (GlowRing), used wherever the scene does not draw this pill (no scene, or the
    // hidden sidebar's peek): the ring, and a sheen that sweeps the pill every 1.5 s, fading
    // over 1.5 s once loading ends.
    in property <bool> loading: false;
    // Beam strength: up in 120 ms, down over 1500 ms; the ring shows it, the sheen its square.
    property <float> strength: root.loading ? 1 : 0;
    animate strength {
        duration: root.loading ? Shell.beam-in : Shell.beam-ms;
        easing: Motion.easeOut;
    }
    // The Slint fallback's strength: nothing where the scene draws the beam.
    property <float> glow: root.over-wgpu ? 0 : root.strength;
    out property <float> sheen: root.glow * root.glow;
    callback activated();
    // wubble: the design's Address has no slot for these, so they sit at the pill's right end.
    // The visible page can be bookmarked (a web page): the star, filled when it is.
    in property <bool> bookmarkable: false;
    in property <bool> bookmarked: false;
    callback bookmark-requested();
    // The blocker's badge: shown when something was blocked or the site is allowed. Its click
    // asks for the blocker menu at the badge (window coordinates).
    in property <bool> blocker-visible: false;
    in property <bool> blocker-allowed: false;
    in property <int> blocked: 0;
    callback blocker-requested(length, length);

    height: Chrome.address;

    // `visible`, not `if`, so the panel's glass item outlives a rail round trip.
    GlassPanel {
        visible: !root.compact;
        key: GlassKeys.address;
        over-wgpu: root.over-wgpu;
        clip-start: root.glass-clip-start;
        clip-end: root.glass-clip-end;
        tier: GlassTier.thin;
        radius: Shell.control-radius;
        hover: ta.has-hover;
        pressed: ta.pressed;
        // useGlass(…, { shadow: 0 })
        drop-shadow-blur: 0px;
        drop-shadow-offset-y: 0px;
        drop-shadow-color: transparent;
        scale: ta.pressed ? Shell.address-press : 1;
        animate scale {
            duration: Shell.address-press-ms;
            easing: Motion.easeOut;
        }

        ta := TouchArea {
            mouse-cursor: text;
            clicked => {
                root.activated();
            }
        }

        GlowRing {
            radius: Shell.control-radius;
            strength: root.glow;
        }

        HorizontalLayout {
            padding-left: Shell.side-grid;
            padding-right: Shell.side-grid;
            spacing: Spacing.s2;
            Rectangle {
                width: Shell.address-icon;
                bubble := Icon {
                    y: (parent.height - self.height) / 2;
                    path: IconPaths.bubble;
                    size: Shell.address-icon;
                    weight: Shell.address-icon-stroke;
                    tint: Palette.mint;
                }
            }
            Text {
                text: root.host;
                color: Palette.ink;
                font-family: Fonts.mono;
                font-size: Type.address.size;
                font-weight: Type.address.weight;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.path;
                horizontal-stretch: 1;
                color: Palette.haze;
                font-family: Fonts.mono;
                font-size: Type.address.size;
                font-weight: Type.address.weight;
                vertical-alignment: center;
                overflow: elide;
            }
            // Above the whole-pill TouchArea, so a click here is not an address click.
            if root.blocker-visible: badge := Rectangle {
                width: badge-row.preferred-width;
                badge-row := HorizontalLayout {
                    spacing: Spacing.s1;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: IconPaths.shield;
                        size: Shell.address-icon;
                        weight: Shell.address-icon-stroke;
                        tint: root.blocker-allowed ? Palette.haze : Palette.mint;
                    }
                    Text {
                        visible: root.blocked > 0;
                        text: root.blocked;
                        color: Palette.mist;
                        font-family: Fonts.mono;
                        font-size: Type.address.size;
                        vertical-alignment: center;
                    }
                }
                badge-area := TouchArea {
                    clicked => {
                        root.blocker-requested(badge.absolute-position.x, badge.absolute-position.y + badge.height);
                    }
                }
            }
            if root.bookmarkable: star := Rectangle {
                width: Shell.address-icon;
                Icon {
                    y: (parent.height - self.height) / 2;
                    path: IconPaths.star;
                    size: Shell.address-icon;
                    weight: Shell.address-icon-stroke;
                    fill: root.bookmarked ? Palette.amber : transparent;
                    tint: root.bookmarked ? Palette.amber : Palette.haze;
                }
                star-area := TouchArea {
                    clicked => {
                        root.bookmark-requested();
                    }
                }
            }
        }
    }

    // .wb-ib.wb-rail-addr: an icon button, 40 x 36, radius 12; the glyph at its centre
    rail := IconButton {
        visible: root.compact;
        x: (parent.width - self.width) / 2;
        width: Shell.rail-item;
        height: Chrome.address;
        border-radius: Shell.control-radius;
        icon-path: IconPaths.search;
        clicked => {
            root.activated();
        }
    }
    // The glyph's centre, in window coordinates (the alignment the tests pin).
    out property <length> glyph-x: root.compact ? rail.glyph-x : bubble.absolute-position.x + bubble.width / 2;
    out property <length> glyph-y: root.compact ? rail.glyph-y : bubble.absolute-position.y + bubble.height / 2;
}

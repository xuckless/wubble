import { Space } from "../kit/gen/tokens.slint";
import { GlassKeys, GlassOver } from "model.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { BDock, BDockLabel } from "../kit/overlay/b/b-dock.slint";
import { BMarquee } from "../kit/overlay/b/b-marquee.slint";

// The screenshot region picker over the page: the page dims, a drag cuts a clear rectangle out
// of the dim with its size beside it, and a toolbar offers the whole visible page or the full
// page instead. The design has no drag-select overlay (wubble-only.md §24): the marquee is the
// scrim cut round the region with the held line and the slider's value bubble
// (kit/overlay/b/b-marquee.slint); the toolbar is the Dock with a hint and IconButtons. The
// rectangle is only drawn here: what the corners mean (order, clamping, the smallest region) is
// the host's (`wubble_core::shot::RectF::from_drag`).
export component ShotOverlay inherits Rectangle {
    in property <bool> active;
    // The page's pane within this area (a split shows several), logical px.
    in property <length> pane-x;
    in property <length> pane-width;
    // A drag from one corner to the other, in this area's coordinates.
    callback picked(length, length, length, length);
    // true: the full page, false: what the view shows.
    callback capture(bool);
    callback cancelled();

    visible: root.active || marquee.fade > 0;
    changed active => {
        if root.active {
            keys.focus();
        }
    }

    property <bool> dragging: area.pressed;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    marquee := BMarquee {
        shown: root.active;
        dragging: root.dragging;
        pane-x: root.pane-x;
        pane-width: root.pane-width;
        x0: area.x + min(area.pressed-x, area.mouse-x);
        y0: min(area.pressed-y, area.mouse-y);
        x1: area.x + max(area.pressed-x, area.mouse-x);
        y1: max(area.pressed-y, area.mouse-y);
    }

    area := TouchArea {
        x: root.pane-x;
        width: root.pane-width;
        enabled: root.active;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.picked(self.x + self.pressed-x, self.pressed-y, self.x + self.mouse-x, self.mouse-y);
            }
        }
    }

    // The toolbar, at the pane's bottom centre; it goes while dragging so it never covers the
    // region being drawn.
    bar := BDock {
        key: GlassKeys.shot;
        layer: GlassOver.card;
        shown: root.active && !root.dragging;
        interactive: root.active && !root.dragging;
        width: self.row-width;
        x: root.pane-x + (root.pane-width - self.width) / 2;
        y: root.height - self.height - Space.s4;
        BDockLabel {
            text: "Drag to capture a region";
        }
        IconButton {
            icon-path: Glyph.eye;
            label: "Visible page";
            clicked => {
                root.capture(false);
            }
        }
        IconButton {
            icon-path: Glyph.expand;
            label: "Full page";
            clicked => {
                root.capture(true);
            }
        }
        IconButton {
            icon-path: Glyph.close;
            label: "Cancel";
            clicked => {
                root.cancelled();
            }
        }
    }
}

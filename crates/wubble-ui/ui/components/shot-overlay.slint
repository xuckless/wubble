import { Palette, Spacing, Fonts, Type, Motion } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel } from "../components.slint";
import { GlassTier } from "model.slint";
import { SheetButton } from "sheet-button.slint";

// The screenshot region picker over the page: the page dims, a drag cuts a clear rectangle out
// of the dim with its size beside it, and a toolbar offers the whole visible page or the full
// page instead. Written from scratch: the design repo has no drag-select overlay. Its pieces are
// the house's: the toolbar is the find bar's thick glass over content with the sheets' buttons,
// the cut-out's rim the ink hairline. The rectangle is only drawn here: what the corners mean
// (order, clamping, the smallest region) is the host's (`wubble_core::shot::RectF::from_drag`).
export component ShotOverlay inherits Rectangle {
    in property <bool> active;
    // The page's pane within this area (a split shows several), logical px.
    in property <length> pane-x;
    in property <length> pane-width;
    // A drag from one corner to the other, in this area's coordinates.
    callback picked(length, length, length, length);
    // true: the full page, false: what the view shows.
    callback capture(bool);
    callback cancelled();

    visible: root.active;
    changed active => {
        if root.active {
            keys.focus();
        }
    }

    property <bool> dragging: area.pressed;
    property <length> x0: area.x + min(area.pressed-x, area.mouse-x);
    property <length> y0: min(area.pressed-y, area.mouse-y);
    property <length> x1: area.x + max(area.pressed-x, area.mouse-x);
    property <length> y1: max(area.pressed-y, area.mouse-y);
    property <brush> dim: Palette.abyss.with-alpha(Shell.shot-dim);

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    // The dim: the whole pane at rest, around the cut-out while dragging.
    Rectangle {
        x: root.pane-x;
        width: root.pane-width;
        visible: !root.dragging;
        background: root.dim;
    }
    if root.dragging: Rectangle {
        Rectangle {
            x: root.pane-x;
            width: root.pane-width;
            height: root.y0;
            y: 0;
            background: root.dim;
        }
        Rectangle {
            x: root.pane-x;
            width: root.pane-width;
            y: root.y1;
            height: max(0px, parent.height - root.y1);
            background: root.dim;
        }
        Rectangle {
            x: root.pane-x;
            width: max(0px, root.x0 - root.pane-x);
            y: root.y0;
            height: root.y1 - root.y0;
            background: root.dim;
        }
        Rectangle {
            x: root.x1;
            width: max(0px, root.pane-x + root.pane-width - root.x1);
            y: root.y0;
            height: root.y1 - root.y0;
            background: root.dim;
        }
        Rectangle {
            x: root.x0;
            y: root.y0;
            width: root.x1 - root.x0;
            height: root.y1 - root.y0;
            border-width: Shell.px;
            border-color: Palette.ink;
        }
        Text {
            x: root.x0;
            y: root.y1 + Spacing.s1;
            text: round((root.x1 - root.x0) / Shell.px) + " × " + round((root.y1 - root.y0) / Shell.px);
            color: Palette.ink;
            font-family: Fonts.mono;
            font-size: Type.label.size;
        }
    }

    area := TouchArea {
        x: root.pane-x;
        width: root.pane-width;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.picked(self.x + self.pressed-x, self.pressed-y, self.x + self.mouse-x, self.mouse-y);
            }
        }
    }

    // The toolbar, at the pane's bottom centre; hidden while dragging so it never covers the
    // region being drawn.
    bar := GlassPanel {
        visible: !root.dragging;
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        width: row.preferred-width;
        height: Shell.find-height;
        x: root.pane-x + (root.pane-width - self.width) / 2;
        y: root.height - self.height - Spacing.s4;
        TouchArea { }
        row := HorizontalLayout {
            padding-left: Spacing.s3;
            padding-right: Spacing.s1;
            spacing: Spacing.s1;
            Text {
                text: "Drag to capture a region";
                vertical-alignment: center;
                color: Palette.mist;
                font-family: Fonts.ui;
                font-size: Type.label.size;
            }
            SheetButton {
                text: "Visible page";
                clicked => {
                    root.capture(false);
                }
            }
            SheetButton {
                text: "Full page";
                clicked => {
                    root.capture(true);
                }
            }
            SheetButton {
                text: "Cancel";
                clicked => {
                    root.cancelled();
                }
            }
        }
    }
}

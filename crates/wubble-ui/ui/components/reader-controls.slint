import { GlassKeys, GlassOver } from "model.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { Segmented } from "../kit/controls/segmented.slint";
import { BDock, BDockValue } from "../kit/overlay/b/b-dock.slint";

// Reader mode's typography: text size, column width, font and theme, live, and a way out.
// The design has no reader (wubble-only.md §25): the strip is the touch Dock
// (kit/overlay/b/b-dock.slint), the size minus and plus `.wb-ib`s around the value in the number
// role, column, font and theme the settings row's Segmented (`.st-seg`; the themes stay words:
// their colours are the reader's own, not the design's). Each choice writes its setting
// (`reader.*`): a size, or the index of a choice's word (the words are the settings table's);
// the values shown are the settings'. A size outside the setting's range is refused by the
// store, so its bounds live only in the table. It comes and goes as Overlap.
export component ReaderControls inherits Rectangle {
    in property <bool> open;
    in property <int> size;
    // Indexes into the words of `wubble_core::reader` (width, font, theme).
    in property <int> column;
    in property <int> font;
    in property <int> theme;
    callback setting(string, int);
    callback closed();

    // built while it shows and as it leaves (its controls take registry slots when built)
    property <bool> built: root.open || dock.progress > 0;

    width: dock.row-width;
    height: dock.height;

    dock := BDock {
        key: GlassKeys.reader;
        layer: GlassOver.card;
        shown: root.open;
        interactive: root.open;
        width: parent.width;
        if root.built: IconButton {
            // centred in the row the Segmented controls make taller
            y: (parent.height - self.height) / 2;
            icon-path: Glyph.minus;
            label: "Smaller text";
            clicked => {
                root.setting("reader.size", root.size - 1);
            }
        }
        if root.built: BDockValue {
            value: root.size;
        }
        if root.built: IconButton {
            // centred in the row the Segmented controls make taller
            y: (parent.height - self.height) / 2;
            icon-path: Glyph.plus;
            label: "Larger text";
            clicked => {
                root.setting("reader.size", root.size + 1);
            }
        }
        if root.built: Segmented {
            compact: true;
            label: "Column";
            labels: ["Narrow", "Medium", "Wide"];
            selected: root.column;
            chosen(i) => {
                root.setting("reader.width", i);
            }
        }
        if root.built: Segmented {
            compact: true;
            label: "Font";
            labels: ["Serif", "Sans"];
            selected: root.font;
            chosen(i) => {
                root.setting("reader.font", i);
            }
        }
        if root.built: Segmented {
            compact: true;
            label: "Theme";
            labels: ["Dark", "Light", "Sepia"];
            selected: root.theme;
            chosen(i) => {
                root.setting("reader.theme", i);
            }
        }
        if root.built: IconButton {
            // centred in the row the Segmented controls make taller
            y: (parent.height - self.height) / 2;
            icon-path: Glyph.close;
            label: "Close reader";
            clicked => {
                root.closed();
            }
        }
    }
}

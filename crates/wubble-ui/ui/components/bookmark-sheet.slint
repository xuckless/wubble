import { SheetFrame } from "sheet-frame.slint";
import { BookmarkSheetView, FolderChoiceItem } from "model.slint";
import { BField, BGroup } from "../kit/overlay/b/b-field.slint";
import { BChoiceList, BChoiceRow, BDangerButton } from "../kit/overlay/b/b-sheet-parts.slint";

// The bookmark sheet: Ctrl+D (name and folder, Remove when the page is already bookmarked), and
// the bookmarks page's rename, move and new folder (each shows only the fields it needs). On the
// SheetFrame chrome; `answered` is the intent: (accept, remove, name, folder id, -1 = top level).
// The design has no sheet with fields (wubble-only.md §14): the name is the derived sheet field,
// the folders a flat chooser of the Select's rows with the tree indent, Remove the ghost Button
// in coral (kit/overlay/b). Each part is built only when the sheet has it.
export component BookmarkSheet inherits SheetFrame {
    in property <BookmarkSheetView> sheet;
    in property <[FolderChoiceItem]> folders;
    callback answered(bool, bool, string, int);

    property <int> folder: -1;
    property <string> typed;
    property <int> want-name;

    open: root.sheet.open;
    title: root.sheet.title;
    accept-text: root.sheet.accept;
    cancel-text: "Cancel";
    accepted => {
        root.answered(true, false, root.typed, root.folder);
    }
    cancelled => {
        root.answered(false, false, "", -1);
    }

    public function focus-sheet() {
        if root.sheet.show-name {
            root.want-name += 1;
        } else {
            root.take-focus();
        }
    }

    // Each opening restarts from the sheet's own name and folder.
    property <int> serial: root.sheet.serial;
    changed serial => {
        root.typed = root.sheet.name;
        root.folder = root.sheet.folder;
        if root.sheet.open {
            root.focus-sheet();
        }
    }

    if root.sheet.show-name: name := BField {
        text <=> root.typed;
        placeholder: "Name";
        property <int> want: root.want-name;
        init => {
            if root.sheet.open {
                self.take-focus();
            }
        }
        changed want => {
            self.take-focus();
        }
        accepted(t) => {
            root.answered(true, false, t, root.folder);
        }
        escaped => {
            root.answered(false, false, "", -1);
        }
    }
    if root.sheet.show-folders: BGroup {
        label: "Folder";
        list := BChoiceList {
            for choice[i] in root.folders: BChoiceRow {
                label: choice.label;
                depth: choice.depth;
                checked: choice.id == root.folder;
                hovered(on) => {
                    list.hover(i, on);
                }
                picked => {
                    root.folder = choice.id;
                }
            }
        }
    }
    if root.sheet.can-remove: HorizontalLayout {
        alignment: start;
        BDangerButton {
            text: "Remove bookmark";
            clicked => {
                root.answered(false, true, "", -1);
            }
        }
    }
}

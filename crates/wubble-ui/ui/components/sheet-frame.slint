import { Palette, Motion, Spacing, Fonts } from "../tokens.slint";
import { Shell } from "../kit/derived.slint";
import { GlassPanel } from "../kit/material/glass.slint";
import { SheetButton } from "sheet-button.slint";
import { GlassTier } from "model.slint";

// The chrome every sheet shares (JS dialog, sign-in, and the pages' clear / bookmark / password
// sheets): a scrim that blocks the page under it, thick glass anchored to the top of the content
// area, a title, a message, the sheet's own fields in `@children`, and right-aligned buttons.
// Looks and timings are Ultra Reactivate's `.ur-o-dialog` (src/ultra-reactivate/overlays.css, the
// owner's library): min(380, width - 32) wide, padding 26, radius 20, title 19 / 560, body 14.5
// muted, actions right-aligned 8 apart; it grows in over 300 ms. Enter accepts, Escape cancels:
// `accepted` and `cancelled` are intents, the owner acts. Written from scratch: the design repo
// has no dialog.
export component SheetFrame inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    in property <string> accept-text: "OK";
    // Empty: no cancel button.
    in property <string> cancel-text;
    callback accepted();
    callback cancelled();

    // Takes the keyboard for Enter and Escape (a sheet with a field focuses the field instead).
    public function take-focus() {
        keys.focus();
    }

    // The exit is seen (Overlap: the old sheet shares the screen while it leaves): drawn until
    // the panel has faded; the sheet owning it keeps its view (a latch) and only the open sheet
    // answers (permission-prompt.slint's rule).
    visible: root.open || panel.opacity > 0;

    // The scrim: the page under it gets no pointer events while the sheet waits.
    TouchArea {
        enabled: root.open;
        scroll-event(e) => {
            root.open ? accept : reject
        }
    }
    Rectangle {
        background: Shell.scrim;
        opacity: root.open ? 1 : 0;
        animate opacity {
            duration: root.open ? Shell.sheet-in : Motion.dropdownOut;
            easing: root.open ? Motion.easeOut : Motion.easeInOut;
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if !root.open {
                return reject;
            }
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if event.text == Key.Return {
                root.accepted();
                return accept;
            }
            return reject;
        }
    }

    panel := GlassPanel {
        width: min(Shell.sheet-width, root.width - 2 * Shell.sheet-margin);
        height: body.preferred-height;
        x: (root.width - self.width) / 2;
        y: Shell.command-bar-top;
        tier: GlassTier.thick;
        radius: Shell.sheet-radius;
        over-content: true;
        transform-origin: { x: self.width / 2, y: 0px };
        transform-scale: root.open ? 1 : Shell.sheet-from;
        opacity: root.open ? 1 : 0;
        animate transform-scale, opacity {
            duration: root.open ? Shell.sheet-in : Motion.dropdownOut;
            easing: root.open ? Motion.easeOut : Motion.easeInOut;
        }
        TouchArea {
            enabled: root.open;
        }

        body := VerticalLayout {
            padding: Shell.sheet-pad;
            spacing: Spacing.s2;
            Text {
                text: root.title;
                color: Palette.ink;
                font-family: Fonts.ui;
                font-size: Shell.sheet-title;
                font-weight: Shell.sheet-title-weight;
                overflow: elide;
            }
            Text {
                text: root.message;
                visible: self.text != "";
                color: Palette.mist;
                font-family: Fonts.ui;
                font-size: Shell.sheet-body;
                wrap: word-wrap;
            }
            @children
            // .ur-o-dialog p: 22 below the message.
            Rectangle {
                height: Spacing.s3;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Spacing.s2;
                if root.cancel-text != "": SheetButton {
                    text: root.cancel-text;
                    clicked => {
                        if root.open {
                            root.cancelled();
                        }
                    }
                }
                SheetButton {
                    text: root.accept-text;
                    primary: true;
                    clicked => {
                        if root.open {
                            root.accepted();
                        }
                    }
                }
            }
        }
    }
}

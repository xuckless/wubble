// The native pages beside settings (wubble://history, archive, bookmarks, downloads, passwords,
// tasks): each a function of the model its host fills (wubble_core::pages view-models), laid out
// from the kit's list-page parts (ui/kit/pages: PageFrame, ListCard, ListRow, the table cells;
// derived from the settings page, docs/fidelity/wubble-only.md section 32). Every change is an
// intent through a callback; the host acts and redraws. Compose only: the kit draws.

import { Shell } from "../kit/derived.slint";
import { HistoryLineItem, BookmarkLineItem, DownloadItem, DownloadAction, LoginItem, PasswordsView, VaultState, TaskItem, TaskAction, AgentLogItem } from "model.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { Button, PressableButton, ButtonKind } from "../kit/controls/button.slint";
import { Toggle, ToggleSize } from "../kit/controls/toggle.slint";
import { Segmented } from "../kit/controls/segmented.slint";
import { Sheet } from "../kit/controls/sheet.slint";
import { PageFrame } from "../kit/pages/page-frame.slint";
import { ListCard, ListGroup, ListEmpty, ListToolbar, ListNote, ListFoot } from "../kit/pages/list-card.slint";
import { ListRow, RowAction, RowTextAction, RowChevron } from "../kit/pages/list-row.slint";
import { ListField } from "../kit/pages/list-field.slint";
import { KeyedHoldButton, KeyedConfirmButton } from "../kit/pages/row-keyed.slint";
import { TableHead, TableCell, TableSlot, TableHeadLine } from "../kit/pages/list-table.slint";
import { DownloadRow } from "download-row.slint";

// ───────────────────────────────────────────────────────────────────────────── history

// The history page, and the archive page (the same list of dated rows, deleted by `key`).
export component HistoryPage inherits Rectangle {
    in property <bool> open;
    in property <string> title: "History";
    in property <string> placeholder: "Search history";
    in property <string> empty-text: "No history yet";
    in property <string> empty-search-text: "No visits match";
    // Offers "Clear browsing data".
    in property <bool> clearable: true;
    // Day headers and visits, newest first.
    in property <[HistoryLineItem]> lines;
    // A search is running: the empty note says no match.
    in property <bool> searching;
    in property <bool> has-more;
    callback query-changed(string);
    // (address, the row's key: the visit's or archived tab's id)
    callback opened(string, int);
    callback opened-new-tab(string, int);
    callback deleted(string, int);
    callback more();
    // The range's index in `ranges`.
    callback cleared(int);

    property <[string]> ranges: ["Last hour", "Last 24 hours", "All time"];
    property <bool> clearing: false;
    property <int> range: 0;

    public function take-focus() {
        frame.take-focus();
    }

    frame := PageFrame {
        open: root.open;
        title: root.title;
        placeholder: root.placeholder;
        query-changed(q) => {
            root.query-changed(q);
        }

        ListToolbar {
            if root.clearable: Button {
                kind: ButtonKind.ghost;
                text: "Clear browsing data";
                clicked => {
                    root.range = 0;
                    root.clearing = true;
                    sheet.take-focus();
                }
            }
        }
        if root.lines.length == 0: ListEmpty {
            text: root.searching ? root.empty-search-text : root.empty-text;
        }
        for line[i] in root.lines: VerticalLayout {
            if line.header: ListGroup {
                text: line.label;
            }
            if !line.header: ListCard {
                first: i == 0 || root.lines[i - 1].header;
                last: i == root.lines.length - 1 || root.lines[i + 1].header;
                visit := ListRow {
                    title: line.title;
                    note: line.url;
                    mono-note: true;
                    favicon: line.favicon;
                    shown: root.open;
                    index: i;
                    opened => {
                        root.opened(line.url, line.key);
                    }
                    opened-new-tab => {
                        root.opened-new-tab(line.url, line.key);
                    }
                    RowAction {
                        icon-path: Glyph.trash;
                        label: "Delete";
                        danger: true;
                        reveal: visit.reveal;
                        clicked => {
                            root.deleted(line.url, line.key);
                        }
                    }
                }
            }
        }
        if root.has-more: ListFoot {
            Button {
                kind: ButtonKind.ghost;
                text: "Show more";
                clicked => {
                    root.more();
                }
            }
        }
    }

    sheet := Sheet {
        open: root.clearing;
        title: "Clear browsing data";
        message: "Forgets the visits in the range. Bookmarks and downloads stay.";
        accept-text: "Clear";
        cancel-text: "Cancel";
        accepted => {
            root.clearing = false;
            root.cleared(root.range);
        }
        cancelled => {
            root.clearing = false;
        }
        Segmented {
            compact: true;
            labels: root.ranges;
            selected: root.range;
            chosen(i) => {
                root.range = i;
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────── bookmarks

export component BookmarksPage inherits PageFrame {
    // The tree's visible lines, or the matching links while searching.
    in property <[BookmarkLineItem]> lines;
    in property <bool> searching;
    callback opened(string);
    callback opened-new-tab(string);
    // A folder's chevron: expand or collapse.
    callback toggled(int);
    callback rename-requested(int);
    callback move-requested(int);
    callback deleted(int);
    callback folder-requested();

    title: "Bookmarks";
    placeholder: "Search bookmarks";

    ListToolbar {
        Button {
            kind: ButtonKind.ghost;
            text: "New folder";
            clicked => {
                root.folder-requested();
            }
        }
    }
    if root.lines.length == 0: ListEmpty {
        text: root.searching ? "No bookmarks match" : "No bookmarks yet. Press Ctrl+D on a page to add one.";
    }
    if root.lines.length > 0: ListCard {
        for line[i] in root.lines: bookmark-row := ListRow {
            title: line.title;
            note: line.is-folder ? "" : line.path != "" ? line.path : line.url;
            mono-note: line.path == "";
            favicon: line.favicon;
            icon-path: line.is-folder ? Glyph.folder : Glyph.globe;
            indent: line.depth * Shell.page-indent;
            shown: root.open;
            index: i;
            accessible-expandable: line.is-folder;
            accessible-expanded: line.expanded;
            opened => {
                if line.is-folder {
                    root.toggled(line.id);
                } else {
                    root.opened(line.url);
                }
            }
            opened-new-tab => {
                if !line.is-folder {
                    root.opened-new-tab(line.url);
                }
            }
            RowTextAction {
                text: "Rename";
                reveal: bookmark-row.reveal;
                clicked => {
                    root.rename-requested(line.id);
                }
            }
            if !line.is-folder: RowTextAction {
                text: "Move";
                reveal: bookmark-row.reveal;
                clicked => {
                    root.move-requested(line.id);
                }
            }
            RowAction {
                icon-path: Glyph.trash;
                label: "Delete";
                danger: true;
                reveal: bookmark-row.reveal;
                clicked => {
                    root.deleted(line.id);
                }
            }
            if line.is-folder: RowChevron {
                open: line.expanded;
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────── downloads

export component DownloadsPage inherits PageFrame {
    // The host's one downloads model, the popover's too.
    in property <[DownloadItem]> items;
    callback action(int, DownloadAction);
    callback clear-finished();

    title: "Downloads";
    searchable: false;

    ListToolbar {
        Button {
            kind: ButtonKind.ghost;
            text: "Clear finished";
            clicked => {
                root.clear-finished();
            }
        }
    }
    if root.items.length == 0: ListEmpty {
        text: "No downloads";
    }
    if root.items.length > 0: ListCard {
        for item[i] in root.items: DownloadRow {
            item: item;
            pitch: 0px;
            shown: root.open;
            index: i;
            action(id, a) => {
                root.action(id, a);
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────── passwords

export component PasswordsPage inherits Rectangle {
    in property <bool> open;
    in property <PasswordsView> view;
    // Nothing while locked: the host sends no rows.
    in property <[LoginItem]> logins;
    callback query-changed(string);
    callback unlock();
    callback reveal(string);
    callback hide();
    callback copy(string);
    callback deleted(string);
    callback added(string, string, string);
    // a saved login changed by hand: (id, site, username, password; empty keeps the password)
    callback edited(string, string, string, string);
    callback import-requested();

    property <bool> adding: false;
    // the login the sheet edits; empty: it adds one
    property <string> editing;

    public function take-focus() {
        frame.take-focus();
    }

    function close-sheet() {
        site.text = "";
        username.text = "";
        password.text = "";
        root.editing = "";
        root.adding = false;
    }

    function save() {
        if root.editing != "" && site.text != "" {
            root.edited(root.editing, site.text, username.text, password.text);
            root.close-sheet();
        } else if site.text != "" && password.text != "" {
            root.added(site.text, username.text, password.text);
            root.close-sheet();
        }
    }

    function edit(login: LoginItem) {
        root.editing = login.id;
        site.text = login.origin;
        username.text = login.username;
        password.text = "";
        root.adding = true;
        password.take-focus();
    }

    frame := PageFrame {
        open: root.open;
        title: "Passwords";
        placeholder: "Search passwords";
        query-changed(q) => {
            root.query-changed(q);
        }

        ListToolbar { }
        // the vault: its state, what it means, and what can be done
        ListCard {
            ListRow {
                title: root.view.title;
                icon-path: root.view.state == VaultState.locked ? Glyph.lock : Glyph.key;
                tappable: false;
                shown: root.open;
                if root.view.state == VaultState.locked: VerticalLayout {
                    alignment: center;
                    Button {
                        kind: ButtonKind.pri;
                        text: "Unlock";
                        clicked => {
                            root.unlock();
                        }
                    }
                }
                // nothing can be saved without the keyring: the unlock is the retry
                if root.view.state == VaultState.unavailable: VerticalLayout {
                    alignment: center;
                    Button {
                        kind: ButtonKind.pri;
                        text: "Try again";
                        clicked => {
                            root.unlock();
                        }
                    }
                }
                if root.view.state != VaultState.locked && root.view.state != VaultState.unavailable: VerticalLayout {
                    alignment: center;
                    Button {
                        kind: ButtonKind.ghost;
                        text: "Add";
                        clicked => {
                            root.adding = true;
                            site.take-focus();
                        }
                    }
                }
                if root.view.state != VaultState.locked && root.view.state != VaultState.unavailable: VerticalLayout {
                    alignment: center;
                    Button {
                        kind: ButtonKind.ghost;
                        text: "Import CSV";
                        clicked => {
                            root.import-requested();
                        }
                    }
                }
            }
            if root.view.body != "": ListNote {
                text: root.view.body;
            }
            if root.view.notice != "": ListNote {
                text: root.view.notice;
            }
        }
        if root.view.state == VaultState.unlocked && root.logins.length == 0: ListEmpty {
            text: "No saved passwords";
        }
        if root.logins.length > 0: ListToolbar { }
        if root.logins.length > 0: ListCard {
            for login[i] in root.logins: login-row := ListRow {
                title: login.site;
                note: login.has-revealed ? login.revealed : login.username;
                mono-note: login.has-revealed;
                icon-path: Glyph.key;
                tappable: false;
                shown: root.open;
                index: i + 1;
                RowTextAction {
                    text: "Edit";
                    reveal: login-row.reveal;
                    clicked => {
                        root.edit(login);
                    }
                }
                RowAction {
                    icon-path: Glyph.eye;
                    label: login.has-revealed ? "Hide" : "Show";
                    always: true;
                    clicked => {
                        if login.has-revealed {
                            root.hide();
                        } else {
                            root.reveal(login.id);
                        }
                    }
                }
                KeyedConfirmButton {
                    key: login.id;
                    compact: true;
                    idle-text: "Copy";
                    done-text: "Copied";
                    run => {
                        root.copy(login.id);
                    }
                }
                KeyedHoldButton {
                    key: login.id;
                    compact: true;
                    text: "Delete";
                    done-text: "Deleted";
                    done => {
                        root.deleted(login.id);
                    }
                }
            }
        }
    }

    Sheet {
        open: root.adding;
        title: root.editing != "" ? "Edit password" : "Add a password";
        accept-text: "Save";
        cancel-text: "Cancel";
        accepted => {
            root.save();
        }
        cancelled => {
            root.close-sheet();
        }
        site := ListField {
            placeholder: "Site, e.g. https://example.com";
            accepted => {
                root.save();
            }
            escaped => {
                root.close-sheet();
            }
        }
        username := ListField {
            placeholder: "Username";
            accepted => {
                root.save();
            }
            escaped => {
                root.close-sheet();
            }
        }
        password := ListField {
            placeholder: root.editing != "" ? "New password (empty keeps it)" : "Password";
            secret: true;
            accepted => {
                root.save();
            }
            escaped => {
                root.close-sheet();
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────── task manager

// wubble://tasks: tabs and processes with memory, CPU, state and why a tab stays awake, as a
// table of rows (kit TableHead / TableCell) in the settings grid's width.
export component TasksPage inherits PageFrame {
    in property <[TaskItem]> items;
    in property <string> total;
    callback action(int, int, TaskAction);

    title: "Task manager";
    searchable: false;
    column: Shell.settings-max;

    ListToolbar {
        text: root.total;
    }
    TableHeadLine {
        TableHead {
            horizontal-stretch: 1;
            numeric: false;
            text: "Name";
        }
        TableHead {
            width: Shell.task-state;
            text: "State";
        }
        TableHead {
            width: Shell.task-memory;
            text: "Memory";
        }
        TableHead {
            width: Shell.task-cpu;
            text: "CPU";
        }
        TableHead {
            width: Shell.task-sleep;
            numeric: false;
            horizontal-alignment: center;
            text: "Never sleep";
        }
        TableSlot {
            width: Shell.task-discard;
        }
        TableSlot {
            width: Shell.task-discard;
        }
    }
    if root.items.length > 0: ListCard {
        for item[i] in root.items: ListRow {
            title: item.title;
            note: item.busy;
            lead: false;
            tappable: false;
            shown: root.open;
            index: i;
            TableCell {
                width: Shell.task-state;
                text: item.state;
            }
            TableCell {
                width: Shell.task-memory;
                text: item.memory;
                dash-empty: item.tab >= 0;
            }
            TableCell {
                width: Shell.task-cpu;
                text: item.cpu;
                dash-empty: item.tab >= 0;
            }
            // A slot per control whether it shows or not, so the columns line up row to row.
            TableSlot {
                width: Shell.task-sleep;
                if item.tab >= 0: Toggle {
                    size: ToggleSize.sm;
                    on: item.never-sleep;
                    label: "Never sleep";
                    toggled => {
                        root.action(item.tab, item.pid, TaskAction.never-sleep);
                    }
                }
            }
            TableSlot {
                width: Shell.task-discard;
                if item.can-discard: PressableButton {
                    text: "Discard";
                    clicked => {
                        root.action(item.tab, item.pid, TaskAction.discard);
                    }
                }
            }
            TableSlot {
                width: Shell.task-discard;
                if item.can-end: KeyedHoldButton {
                    // End acts on the pid alone (host/tasks.rs task_action)
                    key: item.pid;
                    compact: true;
                    text: "End";
                    done-text: "Ended";
                    done => {
                        root.action(item.tab, item.pid, TaskAction.end);
                    }
                }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────── agent activity

// wubble://agent: what agent sessions did (`wubble_core::agent::log`), newest first, one row a
// call: the tool and the page it touched over the session, its age and how it ended. Read only.
// wubble-only (derived-review.md, Agent sessions): the list page's own parts.
export component AgentLogPage inherits PageFrame {
    in property <[AgentLogItem]> items;

    title: "Agent activity";
    searchable: false;
    column: Shell.settings-max;

    if root.items.length == 0: ListEmpty {
        text: "No agent has used wubble yet. Sessions appear here once you turn agents on in Settings and approve one.";
    }
    if root.items.length > 0: ListCard {
        for item[i] in root.items: ListRow {
            title: item.title;
            note: item.note;
            icon-path: item.failed ? Glyph.close : Glyph.check;
            tappable: false;
            shown: root.open;
            index: i;
        }
    }
}

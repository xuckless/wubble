import { Colors, Motion, Radius, Sizes } from "../tokens.slint";

// Shared hover / press / focus presentation for list rows.
export component RowBase inherits Rectangle {
    in property <bool> active: false;
    out property <bool> hovered: ta.has-hover;
    callback activated();

    height: Sizes.row-height;
    border-radius: Radius.sm;
    background: root.active ? Colors.hover-fill : transparent;
    animate background { duration: Motion.fast; }

    states [
        pressed when ta.pressed: {
            background: Colors.press-fill;
        }
        hover when ta.has-hover: {
            background: Colors.hover-fill;
        }
    ]

    ta := TouchArea {
        clicked => {
            focus.focus();
            root.activated();
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        border-radius: Radius.sm;
        border-width: Sizes.hairline;
        border-color: transparent;
        states [
            focused when focus.has-focus: {
                border-color: Colors.sky;
            }
        ]
        animate border-color { duration: Motion.fast; }
    }

    @children
}

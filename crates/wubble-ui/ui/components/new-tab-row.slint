// The "New tab" row under the tab list. Written for wubble from the design repo's web chrome
// (src/wubble/browser/browser.css `.wb-newtab`, `.wb-newtab-rail`, xuckless/the-wallpaper-project
// @ 6c840da): the Slint port has no new-tab row. It is a tab row's twin: 36 high, the plus on the
// same 24 px grid as the tab icons, hover fill and the 0.97 press of the port's TabRow.

import { Palette, Chrome, Radius, Fonts, Type, Motion } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { Icon, Glyph } from "../kit/controls/icon.slint";
import { FocusRing, FocusKeys } from "focus-ring.slint";
import { Calm } from "../kit/motion/calm.slint";

export component NewTabRow inherits Rectangle {
    in property <bool> compact: false;
    callback activated();
    public function take-focus() {
        keys.focus();
    }

    height: Shell.row;
    accessible-role: AccessibleRole.button;
    accessible-label: "New tab";
    accessible-action-default => {
        root.activated();
    }

    body := Rectangle {
        x: root.compact ? (root.width - self.width) / 2 : 0px;
        width: root.compact ? Shell.rail-item : root.width;
        border-radius: Radius.sm;
        background: ta.has-hover ? Shell.row-hover : transparent;   // .wb-newtab:hover white 4.5 %
        animate background {
            duration: Calm.ms(Motion.press-out);
            easing: Motion.ease-out;
        }
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: ta.pressed ? Motion.press-scale : 1;
        animate transform-scale {
            duration: Calm.ms(ta.pressed ? Motion.press-in : Motion.press-out);
            easing: Motion.ease-out;
        }

        keys := FocusKeys {
            activate => {
                root.activated();
            }
        }
        ta := TouchArea {
            clicked => {
                root.activated();
            }
        }

        HorizontalLayout {
            padding-left: root.compact ? (body.width - Shell.tab-icon) / 2 : Shell.side-grid;
            spacing: Shell.side-grid;
            Rectangle {
                width: Shell.tab-icon;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: Glyph.plus;
                    size: Shell.new-tab-icon;
                    weight: Shell.new-tab-stroke;
                    tint: Palette.ink;   // .wb button: ink (as IconButton)
                }
            }
            if !root.compact: Text {
                text: "New tab";
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Palette.ink;
                font-family: Fonts.ui;
                font-size: Type.body.size;
                font-weight: Type.body.weight;
            }
        }
        FocusRing {
            shown: keys.has-focus;
            radius: body.border-radius;
        }
    }
}

import { Colors, GlassStyle, Radius, Sizes } from "../tokens.slint";
import { GlassTier } from "model.slint";

// Backdrop textures from wubble-gfx (`glass::GlassBackdrop::render`), one
// per tier in use, set by the host every web frame. An empty image (the
// default, and what the host sets at Flat quality) means the flat tier fill.
export global GlassBackdrops {
    in property <image> thin;
    in property <image> regular;
    in property <image> thick;
    // Backdrop pixels per logical pixel: `Backdrops::px_per_frame_px` times
    // the window scale factor (a global cannot read the scale factor).
    in property <float> scale;
    // Where the web frame's top-left sits in the window.
    in property <length> frame-x;
    in property <length> frame-y;

    public pure function image(tier: GlassTier) -> image {
        tier == GlassTier.thin ? root.thin : tier == GlassTier.thick ? root.thick : root.regular
    }

    // A window length measured from the frame origin, in backdrop pixels.
    public pure function to-backdrop(offset: length) -> int {
        round(offset / Sizes.logical-px * root.scale)
    }

    // Whether a panel at window position (x, y) of size (w, h) shows its
    // backdrop: the tier has an image, and the panel is wholly over the web
    // frame (else flat entirely). Compared in lengths, before any rounding.
    public pure function shows(tier: GlassTier, x: length, y: length, w: length, h: length) -> bool {
        root.image(tier).width > 0 && root.scale > 0 && x >= root.frame-x && y >= root.frame-y && x + w <= root.frame-x + root.image(tier).width * Sizes.logical-px / root.scale && y + h <= root.frame-y + root.image(tier).height * Sizes.logical-px / root.scale
    }
}

// Glass, layer by layer (pack Tokens.dc.html): drop shadow, blurred and
// saturated backdrop, tier tint (+ Space colour on Regular), specular, rim,
// optional film rim. Children draw on top.
//
// The shadow is drawn only under a backdrop: femtovg (1.19 itemrenderer.rs
// `draw_box_shadow`) colours the shadow SourceIn over the element's own fill
// and does not cut it out of the panel, so on a translucent flat fill it
// would take the fill's alpha and darken the panel from inside.
export component Glass inherits Rectangle {
    in property <length> radius: Radius.lg;
    in property <GlassTier> tier: GlassTier.regular;
    // The Space colour; mixed in on Regular glass only.
    in property <color> space-tint: transparent;
    // Conic soap-film ring, for hover / press / focus; the caller decides.
    in property <bool> film: false;

    property <bool> backdrop: GlassBackdrops.shows(root.tier, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
    // Panel edges from the frame origin, in backdrop pixels. Widths are end
    // minus start, so the two roundings cannot overrun the image.
    property <int> clip-x: GlassBackdrops.to-backdrop(root.absolute-position.x - GlassBackdrops.frame-x);
    property <int> clip-y: GlassBackdrops.to-backdrop(root.absolute-position.y - GlassBackdrops.frame-y);

    border-radius: root.radius;
    // The flat fill; under a shown backdrop it is drawn above the image instead.
    background: root.backdrop ? transparent : GlassStyle.fill(root.tier);

    if root.backdrop: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        clip: true;
        // Opaque, so the shadow keeps its token alpha; the opaque image hides it.
        background: GlassStyle.shadow-color(root.tier).with-alpha(1);
        drop-shadow-offset-y: GlassStyle.shadow-y(root.tier);
        drop-shadow-blur: GlassStyle.shadow-blur(root.tier);
        drop-shadow-color: GlassStyle.shadow-color(root.tier);
        Image {
            width: 100%;
            height: 100%;
            source: GlassBackdrops.image(root.tier);
            source-clip-x: root.clip-x;
            source-clip-y: root.clip-y;
            source-clip-width: GlassBackdrops.to-backdrop(root.absolute-position.x - GlassBackdrops.frame-x + root.width) - root.clip-x;
            source-clip-height: GlassBackdrops.to-backdrop(root.absolute-position.y - GlassBackdrops.frame-y + root.height) - root.clip-y;
            image-fit: fill;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: GlassStyle.fill(root.tier);
        }
    }
    if root.tier == GlassTier.regular: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: root.space-tint.with-alpha(root.space-tint.alpha / 255 * GlassStyle.space-tint-alpha);
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(180deg, Colors.glass-specular 0%, Colors.glass-specular-end GlassStyle.specular-end);
        // Rim: the hairline ring, brightest at the top (the pack's inset highlight).
        border-width: Sizes.hairline;
        border-color: @linear-gradient(180deg, GlassStyle.highlight(root.tier) 0%, GlassStyle.rim(root.tier) GlassStyle.specular-end);
    }
    if root.film: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: GlassStyle.film-width;
        border-color: @conic-gradient(from GlassStyle.film-from, Colors.sky 0deg, Colors.lilac 90deg, Colors.blush 180deg, Colors.mint 270deg, Colors.sky 360deg);
        opacity: GlassStyle.film-opacity;
    }
    @children
}

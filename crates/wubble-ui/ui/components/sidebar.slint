// The sidebar. Adapted from the port's `Sidebar` (design repo src/wubble/slint/components.slint,
// @source slint-sidebar, xuckless/the-wallpaper-project @ 6c840da): the same Rust-driven tab rows,
// stretching indicator and drawn Space icons. wubble changes: it binds to wubble's models (ids,
// pinned tabs, Spaces), and gains what the port's Sidebar lacks and the web chrome has
// (browser.css, chrome.tsx, tabs.tsx): the address pill, the favourites grid, the Space name,
// the new-tab row, the Space footer and a scrolling tab list. Layout follows browser.css: padding
// 6, 12 between groups, rows on a 40 px pitch.
//
// Everything that moves is driven from Rust (wubble_core::tabs + scroller via wubble_ui::driver):
//   row-y / row-scale  each row's spring (slot·pitch) and drag lift, in list coordinates
//   indicator-*        the Follow spring, its stretch and transform origin
//   scroll-y, thumb-*  the tab list's scroller
// Nothing here tweens a value Rust owns; only hover fades and the 0.97 press use `animate`.

import { Palette, Radius, Space, Chrome, Fonts, Type, Motion, Tsx } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { TabRow } from "../kit/chrome/tab-row.slint";
import { WubbleScroller } from "../kit/controls/scroller.slint";
import { PressableButton } from "../kit/controls/button.slint";
import { Icon, Glyph } from "../kit/controls/icon.slint";
import { TabItem, SpaceItem, Origin, BeamShape, LeavingRow } from "model.slint";
import { AddressPill } from "../kit/chrome/address-pill.slint";
import { Favs } from "../kit/chrome/favs.slint";
import { SpaceName } from "../kit/chrome/space-switcher.slint";
import { SideBottom } from "../kit/chrome/side-bottom.slint";
import { SideMode, SidePad } from "../kit/chrome/sidebar.slint";
import { NewTabRow } from "../kit/chrome/new-tab-row.slint";
import { WindowLights } from "../kit/chrome/window-lights.slint";
import { NavButtons, IconButton } from "nav-buttons.slint";
import { MoveArea } from "window-frame.slint";
import { Wobble } from "../kit/motion/wobble.slint";
import { Raised } from "raised.slint";
import { Entering } from "../kit/motion/overlap.slint";
import { FolderRow } from "folder-row.slint";
import { SideEdges, DropGeometry } from "model.slint";
import { Calm } from "../kit/motion/calm.slint";

// wubble: a section that rides the bowed seam string at its own height, shifted along x, not
// resized (design browser/chrome.tsx: every `[data-ride]` section is translated by the string's
// offset at its centre height). `ride` is the string's offset sampled every `step` of window
// height (wubble_core::bow::EdgeTable), the same table the glass edge and the page edge follow;
// linear between samples, as `EdgeTable::at`.
component Ride inherits Rectangle {
    in property <[length]> ride;
    in property <length> step;
    property <float> u: root.step > 0 ? (root.absolute-position.y + root.height / 2) / root.step : -1;
    property <int> i: Math.max(0, Math.min(root.ride.length - 2, Math.floor(root.u)));
    out property <length> dx: root.ride.length < 2 || root.u < 0 || root.u > root.ride.length - 1 ? 0px : root.ride[root.i] + (root.ride[root.i + 1] - root.ride[root.i]) * (root.u - root.i);
    HorizontalLayout {
        padding-left: root.dx;
        padding-right: -root.dx;
        @children
    }
}

export component Sidebar inherits Rectangle {
    // the seam's edge table and its pitch (app.slint `seam-edge`)
    in property <[length]> ride;
    in property <length> ride-step;
    in property <string> address-host;
    in property <string> address-path;
    in property <bool> address-secure;
    // the favourite under the pointer (a tab id), -1 when none: a press there waves its glass.
    // Favs (inside an `if`) copies its binding here; it is gone with the last pinned tab and
    // leaves its last value behind: masked then.
    property <int> favs-hover: -1;
    out property <int> fav-hover: root.pinned-tabs.length > 0 ? root.favs-hover : -1;
    in property <bool> address-bookmarkable: false;
    in property <bool> address-bookmarked: false;
    in property <bool> address-blocker-visible: false;
    in property <bool> address-blocker-allowed: false;
    in property <int> address-blocked: 0;
    callback address-bookmark-requested();
    callback address-blocker-requested(length, length);
    callback address-context(length, length);
    in property <int> address-popups-blocked: 0;
    callback address-popups-requested(length, length);
    in property <bool> address-media-visible: false;
    callback address-media-requested(length, length);
    in property <bool> address-reader-available: false;
    in property <bool> address-reader-on: false;
    callback address-reader-requested();
    in property <[TabItem]> pinned-tabs;
    in property <[TabItem]> tabs;
    in property <[SpaceItem]> spaces;
    in property <int> active-tab-id: -1;
    in property <int> active-space-id: -1;
    // the indicator's row (TabRows::active); -1 when the active tab is not a row
    in property <int> selected: -1;
    in property <[length]> row-y;
    in property <[float]> row-scale;
    // the row being dragged (TabRows::is_dragging), -1 when none
    in property <int> dragged-row: -1;
    // Up / Down from row `i`: the row to select (wubble_core::tabs::step_focus, the driver)
    pure callback tab-step(int, bool) -> int;
    // the tab Up / Down moved to, until its row takes the focus (TabRow.focus-to)
    property <int> focus-to: -1;
    // each row's entrance, 0..1 (wubble_core::tabs: a new tab, at most four at once)
    in property <[float]> row-enter;
    // the whole list's entrance after a Space switch, 0..1: one opacity layer for the list
    // (TabRows::list_entrance), so a Space of 50 tabs is not 50 Skia layers
    in property <float> list-enter: 1;
    // closed rows on their way out (`wb-tab-out`: 190 ms in-out to clear at 0.94)
    in property <[LeavingRow]> leaving-rows;
    // the Space name's entrance after a Space switch, 0..1
    in property <float> space-enter: 1;
    in property <length> indicator-y: 0px;
    in property <float> indicator-stretch: 1;
    in property <float> indicator-origin: 0.3;
    in property <bool> compact: false;       // the 56px icon rail
    // The width the contents are laid out at (chrome.tsx: the box follows the contents spring, a
    // beat behind the seam). The sidebar itself is as wide as its glass and clips them, as the
    // design's web view covers what reaches past the seam.
    in property <length> content-width: root.width;
    // The wgpu scene draws the glass of the pill and the favourites (and the sidebar's own,
    // in app.slint).
    in property <bool> glass-over-wgpu: false;
    // The look it takes (chrome.tsx `sideMode`): its padding (.wb-side 6, .wb-side-rail 6 0,
    // .wb-side-peek 10 8 10 10).
    in property <SideMode> mode: SideMode.extended;
    // The window can be moved by dragging the sidebar's glass (off in full screen).
    in property <bool> window-movable: true;
    // The address pill's border beam this frame (see AddressPill).
    in property <BeamShape> address-beam;
    out property <float> address-sheen: pill.sheen;
    // Where the command bar grows from when opened from the pill / the new-tab row, in window
    // coordinates (chrome.tsx `openCommand`: left + 40, vertical middle).
    out property <Origin> address-origin: pill.origin;
    // Where the column's edges fall, in window coordinates (the alignment the tests pin).
    out property <SideEdges> edges: {
        start: root.absolute-position.x,
        end: root.absolute-position.x + root.width,
        content-end: root.absolute-position.x + root.content-width,
        lights: lights.absolute-position.x,
        lights-end: lights.absolute-position.x + lights.width,
        lights-y: lights.absolute-position.y,
        nav: nav.absolute-position.x,
        nav-end: nav.absolute-position.x + nav.width,
        pill: pill.absolute-position.x,
        pill-end: pill.absolute-position.x + pill.width,
        pill-y: pill.absolute-position.y + pill.height / 2,
        glyph-x: pill.glyph-x,
        glyph-y: pill.glyph-y,
        rows: rows.absolute-position.x,
        rows-end: rows.absolute-position.x + rows.width,
        new-tab: new-tab.absolute-position.x,
        new-tab-end: new-tab.absolute-position.x + new-tab.width,
        spaces: switcher.spaces-x,
        // the current Space's tile and the "^"
        spaces-end: switcher.spaces-x + switcher.switcher-w,
        downloads: switcher.downloads-x,
        downloads-end: switcher.downloads-x + switcher.downloads-w,
        downloads-y: switcher.downloads-y,
        settings: switcher.settings-x,
        settings-end: switcher.settings-x + switcher.settings-w,
    };
    out property <DropGeometry> drop-geometry: {
        list-x: list.absolute-position.x,
        list-y: list.absolute-position.y,
        list-w: list.width,
        list-h: list.height,
        rows-top: list.absolute-position.y + root.scroll-y,
        pitch: root.pitch,
        row-h: Shell.row,
        line: Shell.drag-zone-border,
        pill-x: pill.absolute-position.x,
        pill-y: pill.absolute-position.y,
        pill-w: pill.width,
        pill-h: pill.height,
        new-tab-x: new-tab.absolute-position.x,
        new-tab-y: new-tab.absolute-position.y,
        new-tab-w: new-tab.width,
        new-tab-h: new-tab.height,
    };
    out property <Origin> new-tab-origin: { x: new-tab.absolute-position.x + Tsx.new-tab-origin-dx, y: new-tab.absolute-position.y + new-tab.height / 2 };
    // The pill's bottom left, in window coordinates: the permission prompt hangs below it.
    out property <Origin> address-below: { x: pill.absolute-position.x, y: pill.absolute-position.y + pill.height };
    // There are downloads to list: the download button shows in the footer.
    in property <bool> has-downloads: false;
    // The footer's extensions button: shown once an extension is installed; on while its
    // popover (or an action's popup) is open.
    in property <bool> has-extensions: false;
    in property <bool> extensions-open: false;
    callback extensions-requested();
    callback downloads-requested();
    // The footer's settings button: opens wubble://settings.
    callback settings-requested();
    // Right of the download button, level with its top, in window coordinates: the popover opens
    // there, beside the sidebar (it keeps itself inside the window, so it rises from the footer).
    out property <Origin> downloads-anchor: { x: switcher.downloads-x + switcher.downloads-w + Shell.prompt-gap, y: switcher.downloads-y };
    // Right of the extensions button, level with its top, in window coordinates: the popover
    // opens there as the downloads one does.
    out property <Origin> extensions-anchor: { x: switcher.extensions-x + switcher.extensions-w + Shell.prompt-gap, y: switcher.extensions-y };
    // the tab list's scroller
    in property <length> scroll-y;
    in property <length> thumb-top;
    in property <length> thumb-height;
    in property <bool> thumb-visible;
    out property <length> scroll-viewport: list.viewport-height;
    out property <length> scroll-content: list.content-height;
    // the window's Space's row in `spaces`, -1 for none
    in property <int> space-index: -1;
    // The Spaces popup (the footer's "^") is open; asked for by its trigger.
    in property <bool> spaces-open: false;
    callback spaces-requested();
    // Where the popup opens, in window coordinates: above the switcher, from its left edge,
    // growing from the "^"'s centre.
    out property <length> spaces-anchor-x: switcher.spaces-x;
    out property <length> spaces-anchor-y: switcher.spaces-y;
    out property <length> spaces-trigger-x: switcher.more-x + switcher.more-w / 2;
    out property <length> spaces-trigger-y: switcher.more-y + switcher.more-w / 2;
    // The switcher's box, in window coordinates: where a dragged tab opens the popup.
    out property <length> spaces-switcher-w: switcher.switcher-w;
    out property <length> spaces-switcher-h: switcher.switcher-h;

    callback tab-press(int, length);
    // tab id, then TabRow `track`'s kind and pointer in window px
    callback tab-track(int, int, length, length);
    callback tab-drag(length);
    callback tab-release(int);
    callback tab-closed(int);        // tab id
    callback tab-mute-toggled(int);  // tab id: the speaker glyph
    callback tab-context(int, length, length);  // tab id, pointer in window px: right click
    callback empty-context(length, length);  // pointer in window px: right click on the glass
    // tab id, whether the pointer is on its row, and the row's top in window px (hover preview)
    callback tab-hovered(int, bool, length);
    callback tab-activated(int);     // tab id: a favourite (rows pick through tab-release)
    // F6 to the sidebar: keyboard focus to the active tab's row (the rows take it), else, when
    // the active tab is no row (a favourite, or none), the new-tab row.
    property <int> focus-serial: 0;
    public function take-focus() {
        if root.selected >= 0 && root.selected < root.tabs.length {
            root.focus-serial += 1;
        } else {
            new-tab.take-focus();
        }
    }
    callback window-close-requested();
    callback window-minimise-requested();
    callback window-toggle-fullscreen-requested();
    callback window-move-requested();
    callback window-maximise-requested();
    // The visible page's history, for the header's back and forward.
    in property <bool> can-go-back: false;
    // the visible page is loading (the reload button is Stop)
    in property <bool> loading: false;
    // a right click on a header button (its action id), the menu at x, y
    callback action-menu(string, length, length);
    in property <bool> can-go-forward: false;
    // A header button: the id of the wubble `Action` it runs.
    callback action(string);
    callback address-activated();
    callback scroll-wheel(length);
    callback space-swipe(length, length);    // scroll deltas (x, y) over the tab list (Space swipe)
    callback scroll-touch-down(length);
    callback scroll-touch-move(length);
    callback scroll-touch-up();
    callback scroll-thumb-down(length);
    callback scroll-thumb-move(length);
    callback scroll-thumb-up();
    // row geometry for Rust: slot i sits at i × pitch
    out property <length> pitch: Shell.row + Chrome.rowGap;
    property <length> list-height: max(0px, root.tabs.length * root.pitch - Chrome.rowGap);

    background: transparent;   // the glass under it is the scene's (app.slint), or none without it

    // The sections ride the bowed string (Ride) and may lean past the sidebar's left edge: the
    // design does not clip the sidebar, only the window does (QA HIGH-10: the pill and rows were
    // cut at the left mid-collapse). Past the seam on the right they are cut, where the page
    // begins.
    Rectangle {
        x: -root.absolute-position.x;
        width: root.absolute-position.x + root.width;
        clip: true;
        Rectangle {
            x: root.absolute-position.x;
            width: root.width;

            // Under everything: the glass the controls do not claim moves the window (the design's
            // `wb-side-top` drag, wider), and a double-click on it maximises.
            MoveArea {
                enabled: root.window-movable;
                begin-move => {
                    root.window-move-requested();
                }
                toggle-maximise => {
                    root.window-maximise-requested();
                }
                context(x, y) => {
                    root.empty-context(x, y);
                }
            }

            VerticalLayout {
                width: root.content-width;
                padding-left: SidePad.left(root.mode);
                padding-right: SidePad.right(root.mode);
                padding-top: SidePad.top(root.mode);
                padding-bottom: SidePad.bottom(root.mode);
                spacing: Space.s3;

                // .wb-side-top: 30 high, lights 10 in (centred on the rail)
                Ride {
                    ride: root.ride;
                    step: root.ride-step;
                    Rectangle {
                        height: Shell.side-top;
                        lights := WindowLights {
                            x: root.compact ? (parent.width - self.width) / 2 : Shell.side-grid;
                            y: (parent.height - self.height) / 2;
                            compact: root.compact;
                            close-requested => {
                                root.window-close-requested();
                            }
                            minimise-requested => {
                                root.window-minimise-requested();
                            }
                            toggle-fullscreen-requested => {
                                root.window-toggle-fullscreen-requested();
                            }
                        }
                        // .wb-nav: right-aligned, pulled 4 px past the padding (.wb-side-top margin-right -4)
                        nav := NavButtons {
                            visible: !root.compact;
                            // its own width: a bare layout would fill the header and spread the buttons
                            width: self.preferred-width;
                            x: parent.width - self.width + Shell.nav-pull;
                            y: 0px;
                            height: parent.height;
                            can-go-back: root.can-go-back;
                            can-go-forward: root.can-go-forward;
                            loading: root.loading;
                            action(id) => {
                                root.action(id);
                            }
                            menu-requested(id, x, y) => {
                                root.action-menu(id, x, y);
                            }
                        }
                    }
                }

                Ride {
                    ride: root.ride;
                    step: root.ride-step;
                    pill := AddressPill {
                        // the ride's row would otherwise hold it at its hidden glass row's width, wider
                        // than the rail
                        min-width: 0px;
                        over-wgpu: root.glass-over-wgpu;
                        glass-clip-end: root.absolute-position.x + root.width;
                        beam: root.address-beam;
                        host: root.address-host;
                        path: root.address-path;
                        secure: root.address-secure;
                        bookmarkable: root.address-bookmarkable;
                        bookmarked: root.address-bookmarked;
                        blocker-visible: root.address-blocker-visible;
                        blocker-allowed: root.address-blocker-allowed;
                        blocked: root.address-blocked;
                        popups-blocked: root.address-popups-blocked;
                        popups-requested(x, y) => {
                            root.address-popups-requested(x, y);
                        }
                        bookmark-requested => {
                            root.address-bookmark-requested();
                        }
                        blocker-requested(x, y) => {
                            root.address-blocker-requested(x, y);
                        }
                        media-visible: root.address-media-visible;
                        media-requested(x, y) => {
                            root.address-media-requested(x, y);
                        }
                        reader-available: root.address-reader-available;
                        reader-on: root.address-reader-on;
                        reader-requested => {
                            root.address-reader-requested();
                        }
                        compact: root.compact;
                        activated => {
                            root.address-activated();
                        }
                        context(x, y) => {
                            root.address-context(x, y);
                        }
                    }
                }

                if root.pinned-tabs.length > 0: Ride {
                    ride: root.ride;
                    step: root.ride-step;
                    Favs {
                        init => {
                            root.favs-hover = self.hovered-id;
                        }
                        changed hovered-id => {
                            root.favs-hover = self.hovered-id;
                        }
                        tabs: root.pinned-tabs;
                        active-tab-id: root.active-tab-id;
                        compact: root.compact;
                        over-wgpu: root.glass-over-wgpu;
                        glass-clip-end: root.absolute-position.x + root.width;
                        activated(id) => {
                            root.tab-activated(id);
                        }
                    }
                }

                // .wb-space-name
                if !root.compact && root.space-index >= 0 && root.space-index < root.spaces.length: Ride {
                    ride: root.ride;
                    step: root.ride-step;
                    // A new Space's name arrives with the Overlap entrance (chrome.tsx keys the span by
                    // the Space: `wb-in`).
                    SpaceName {
                        text: root.spaces[root.space-index].name;
                        enter: root.space-enter;
                        agent: root.spaces[root.space-index].agent;
                        private: root.spaces[root.space-index].private;
                        agent-stop => {
                            root.action("stop-agents");
                        }
                    }
                }

                // .wb-tabs-wrap: the list, then the new-tab row right under it
                Ride {
                    vertical-stretch: 1;
                    ride: root.ride;
                    step: root.ride-step;
                    VerticalLayout {
                        vertical-stretch: 1;
                        spacing: Chrome.rowGap;
                        alignment: start;

                        list := WubbleScroller {
                            // as tall as the rows, less when the sidebar runs out of room (then it scrolls)
                            min-height: 0px;
                            preferred-height: root.list-height;
                            max-height: root.list-height;
                            vertical-stretch: 1;
                            content-y: root.scroll-y;
                            thumb-top: root.thumb-top;
                            thumb-height: root.thumb-height;
                            thumb-visible: root.thumb-visible;
                            wheel(d) => {
                                root.scroll-wheel(d);
                            }
                            wheel-xy(dx, dy) => {
                                root.space-swipe(dx, dy);
                            }
                            touch-down(y) => {
                                root.scroll-touch-down(y);
                            }
                            touch-move(y) => {
                                root.scroll-touch-move(y);
                            }
                            touch-up => {
                                root.scroll-touch-up();
                            }
                            thumb-down(y) => {
                                root.scroll-thumb-down(y);
                            }
                            thumb-move(y) => {
                                root.scroll-thumb-move(y);
                            }
                            thumb-up => {
                                root.scroll-thumb-up();
                            }

                            rows := Rectangle {
                                height: root.list-height;
                                accessible-role: AccessibleRole.tab-list;
                                accessible-label: "Tabs";
                                opacity: root.list-enter;
                                // on the rail rows are 40 wide and centred (.wb-tabs-rail)
                                property <length> row-w: root.compact ? Shell.rail-item : self.width;
                                property <length> row-x: (self.width - self.row-w) / 2;

                                // the indicator: under the rows, stretched along y about `origin`, squashed along x
                                property <length> h: Shell.row * root.indicator-stretch;
                                property <length> w: self.row-w / Math.sqrt(root.indicator-stretch);
                                // .wb-tab-ind: raised, with its top highlight, rim and drop shadow
                                indicator := Raised {
                                    x: (parent.width - parent.w) / 2;
                                    y: root.indicator-y + (Shell.row - parent.h) * root.indicator-origin;
                                    width: parent.w;
                                    height: parent.h;
                                    radius: Radius.sm;
                                    fill: Shell.selected-fill;
                                    highlight: Shell.selected-highlight;
                                    rim: Shell.selected-rim;
                                    shadow-y: Shell.selected-shadow-y;
                                    shadow-blur: Shell.selected-shadow-blur;
                                    shadow: Shell.selected-shadow;
                                    visible: root.selected >= 0 && root.selected < root.tabs.length;
                                }

                                for gone in root.leaving-rows: Rectangle {
                                    x: parent.row-x;
                                    y: gone.y;
                                    width: parent.row-w;
                                    height: Shell.row;
                                    opacity: 1 - gone.e;
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale: 1 - Shell.tab-exit-shrink * gone.e;
                                    if gone.tab.kind == 0: TabRow {
                                        x: root.compact ? 0px : gone.tab.depth * Shell.folder-indent;
                                        width: parent.width - self.x;
                                        tab: gone.tab;
                                        compact: root.compact;
                                    }
                                    if gone.tab.kind == 1: FolderRow {
                                        width: parent.width;
                                        tab: gone.tab;
                                        compact: root.compact;
                                    }
                                }

                                for tab[i] in root.tabs: Rectangle {
                                    // the spring position from Rust; before the first frame, the slot
                                    x: parent.row-x;
                                    y: i < root.row-y.length ? root.row-y[i] : i * root.pitch;
                                    width: parent.row-w;
                                    height: Shell.row;
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale: i < root.row-scale.length ? root.row-scale[i] : 1;
                                    Entering {
                                        property <float> row-e: i < root.row-enter.length ? root.row-enter[i] : 1;
                                        e: self.row-e * root.list-enter;
                                        fade: self.row-e;
                                        width: parent.width;
                                        height: parent.height;
                                        if tab.kind == 1: FolderRow {
                                            width: parent.width;
                                            tab: tab;
                                            compact: root.compact;
                                            press(y) => {
                                                root.tab-press(i, y);
                                            }
                                            release => {
                                                root.tab-release(i);
                                            }
                                            context(x, y) => {
                                                root.tab-context(tab.id, x, y);
                                            }
                                        }
                                        // a tab in a folder sits one step in (none on the rail)
                                        if tab.kind == 0: TabRow {
                                            x: root.compact ? 0px : tab.depth * Shell.folder-indent;
                                            width: parent.width - self.x;
                                            tab: tab;
                                            selected: tab.id == root.active-tab-id;
                                            compact: root.compact;
                                            press(y) => {
                                                root.tab-press(i, y);
                                            }
                                            track(kind, x, y) => {
                                                root.tab-track(tab.id, kind, x, y);
                                            }
                                            drag(y) => {
                                                root.tab-drag(y);
                                            }
                                            release => {
                                                root.tab-release(i);
                                            }
                                            close => {
                                                root.tab-closed(tab.id);
                                            }
                                            mute => {
                                                root.tab-mute-toggled(tab.id);
                                            }
                                            agent-stop => {
                                                root.action("stop-agents");
                                            }
                                            context(x, y) => {
                                                root.tab-context(tab.id, x, y);
                                            }
                                            hovered(on, y) => {
                                                root.tab-hovered(tab.id, on, y);
                                            }
                                            activate => {
                                                root.tab-activated(tab.id);
                                            }
                                            focus-token: root.focus-serial;
                                            dragging: i == root.dragged-row;
                                            focus-to <=> root.focus-to;
                                            step(down) => {
                                                let j = root.tab-step(i, down);
                                                if j != i && j >= 0 && j < root.tabs.length {
                                                    root.focus-to = root.tabs[j].id;
                                                    root.tab-activated(root.tabs[j].id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        new-tab := NewTabRow {
                            compact: root.compact;
                            // Ctrl+T's action: the start page (decisions.md "Start page")
                            activated => {
                                root.action("new-tab");
                            }
                        }
                    }
                }

                // .wb-side-bottom: the current Space, its "^" and the buttons at the far end
                // (kit SideBottom)
                switcher := SideBottom {
                    spaces: root.spaces;
                    active: root.space-index;
                    vertical: root.compact;
                    has-downloads: root.has-downloads;
                    has-extensions: root.has-extensions;
                    extensions-open: root.extensions-open;
                    extensions-requested => {
                        root.extensions-requested();
                    }
                    spaces-open: root.spaces-open;
                    spaces-requested => {
                        root.spaces-requested();
                    }
                    downloads-requested => {
                        root.downloads-requested();
                    }
                    settings-requested => {
                        root.settings-requested();
                    }
                }
            }
        }
    }
}

// A sheet's button (dialog, sign-in, error panel, permission prompt): the kit Button
// (kit/controls/button.slint, the touch kit's `.tp-btn`). `primary`, the default action, is the
// pri button; the others are ghost (derived: docs/fidelity/derived-review.md).
import { Button, ButtonKind } from "../kit/controls/button.slint";

export component SheetButton inherits Button {
    in property <bool> primary;
    kind: self.primary ? ButtonKind.pri : ButtonKind.ghost;
}

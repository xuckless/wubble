import { SheetFrame } from "sheet-frame.slint";
import { DialogView } from "model.slint";
import { BField, BGroup } from "../kit/overlay/b/b-field.slint";

// A JS dialog (alert, confirm, prompt, beforeunload) as a sheet over the page; fills its parent
// (the content area), whose scrim blocks the page, so the dialog is tab-modal: the sidebar and
// other tabs stay usable. The design has no dialog: the chrome is the kit's derived Sheet
// (SheetFrame), the fields the derived sheet field (kit/overlay/b/b-field.slint, wubble-only.md
// §13). `answered` is the intent; the host answers the engine.
// wubble: the same sheet signs in to a site (HTTP auth): `secret` adds a masked password field
// under the user name, both labelled. The fields are built only when the dialog has them (a
// hidden layout child still takes the column's spacing: the gap above the buttons).
export component DialogSheet inherits SheetFrame {
    in property <DialogView> dialog;
    // (accept, the text field, the password field)
    callback answered(bool, string, string);

    open: root.dialog.open;
    title: root.dialog.title;
    message: root.dialog.message;
    accept-text: root.dialog.accept;
    cancel-text: root.dialog.cancel;
    accepted => {
        root.confirm();
    }
    cancelled => {
        root.cancel();
    }

    // the fields' texts (the fields exist only while the dialog has them)
    property <string> typed;
    property <string> password;
    // each bump moves the keyboard to the field (the prompt's, or the password's)
    property <int> want-input;
    property <int> want-password;

    // The prompt's field, else the frame's key scope.
    public function focus-sheet() {
        if root.dialog.prompt {
            root.want-input += 1;
        } else {
            root.take-focus();
        }
    }

    function confirm() {
        root.answered(true, root.dialog.prompt ? root.typed : "", root.dialog.secret ? root.password : "");
        root.password = "";
    }

    function cancel() {
        root.password = "";
        root.answered(false, "", "");
    }

    // A new dialog (here or on the tab switched to) starts from the page's proposed text and
    // takes the keyboard, even when it replaced one still showing.
    property <int> serial: root.dialog.serial;
    changed serial => {
        root.typed = root.dialog.input;
        root.password = "";
        if root.dialog.open {
            root.focus-sheet();
        }
    }

    if root.dialog.prompt: BGroup {
        label: root.dialog.secret ? "Username" : "";
        input := BField {
            text <=> root.typed;
            label: root.dialog.secret ? "Username" : root.dialog.message;
            property <int> want: root.want-input;
            init => {
                if root.dialog.open {
                    self.take-focus();
                    self.select-all();
                }
            }
            changed want => {
                self.take-focus();
                self.select-all();
            }
            accepted => {
                if root.dialog.secret {
                    root.want-password += 1;
                } else {
                    root.confirm();
                }
            }
            escaped => {
                root.cancel();
            }
        }
    }
    if root.dialog.secret: BGroup {
        label: "Password";
        secret-field := BField {
            text <=> root.password;
            label: "Password";
            secret: true;
            property <int> want: root.want-password;
            changed want => {
                self.take-focus();
            }
            accepted => {
                root.confirm();
            }
            escaped => {
                root.cancel();
            }
        }
    }
}

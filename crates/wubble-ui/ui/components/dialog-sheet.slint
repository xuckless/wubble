import { Palette, Spacing, Fonts, Type } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { SheetFrame } from "sheet-frame.slint";
import { DialogView } from "model.slint";

// A JS dialog (alert, confirm, prompt, beforeunload) as a sheet over the page; fills its parent
// (the content area), whose scrim blocks the page, so the dialog is tab-modal: the sidebar and
// other tabs stay usable. Written from scratch: the design repo has no dialog. Looks and timings
// are Ultra Reactivate's `.ur-o-dialog` (src/ultra-reactivate/overlays.css, the owner's
// library): min(380, width - 32) wide, padding 26, radius 20, title 19 / 560, body 14.5 muted,
// actions right-aligned 8 apart, buttons 42 high with radius 11; it grows in over 300 ms. On
// thick glass over content (GlassPanel), anchored to the top of the page like a sheet: the chrome
// is SheetFrame's. `answered` is the intent; the host answers the engine.
// wubble: the same sheet signs in to a site (HTTP auth): `secret` adds a masked password field
// under the user name, both labelled.
export component DialogSheet inherits SheetFrame {
    in property <DialogView> dialog;
    // (accept, the text field, the password field)
    callback answered(bool, string, string);

    // What the sheet shows: the open dialog, kept while it leaves (the host clears its view).
    property <DialogView> held;
    changed dialog => {
        if root.dialog.open {
            root.held = root.dialog;
        }
    }
    property <DialogView> d: root.dialog.open ? root.dialog : root.held;

    open: root.dialog.open;
    title: root.d.title;
    message: root.d.message;
    accept-text: root.d.accept;
    cancel-text: root.d.cancel;
    accepted => {
        root.confirm();
    }
    cancelled => {
        root.cancel();
    }

    // The prompt's field, else the frame's key scope.
    public function focus-sheet() {
        if root.d.prompt {
            input.focus();
            input.select-all();
        } else {
            root.take-focus();
        }
    }

    function confirm() {
        root.answered(true, root.d.prompt ? input.text : "", root.d.secret ? secret-field.text : "");
        secret-field.text = "";
    }

    function cancel() {
        secret-field.text = "";
        root.answered(false, "", "");
    }

    // A new dialog (here or on the tab switched to) starts from the page's proposed text and
    // takes the keyboard, even when it replaced one still showing.
    property <int> serial: root.dialog.serial;
    changed serial => {
        input.text = root.d.input;
        secret-field.text = "";
        if root.dialog.open {
            root.focus-sheet();
        }
    }

    Text {
        visible: root.d.secret;
        height: root.d.secret ? self.preferred-height : 0px;
        text: "Username";
        color: Palette.mist;
        font-family: Fonts.ui;
        font-size: Type.label.size;
        font-weight: Type.label.weight;
    }
    Rectangle {
        visible: root.d.prompt;
        height: root.d.prompt ? Shell.sheet-input : 0px;
        border-radius: Shell.sheet-button-radius;
        background: Palette.shell;
        input := TextInput {
            x: Spacing.s3;
            width: parent.width - 2 * Spacing.s3;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            color: Palette.ink;
            selection-background-color: Shell.selection-fill;
            selection-foreground-color: Shell.selection-ink;
            font-family: Fonts.ui;
            font-size: Type.body.size;
            accepted => {
                if root.d.secret {
                    secret-field.focus();
                } else {
                    root.confirm();
                }
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel();
                    return accept;
                }
                return reject;
            }
        }
    }
    Text {
        visible: root.d.secret;
        height: root.d.secret ? self.preferred-height : 0px;
        text: "Password";
        color: Palette.mist;
        font-family: Fonts.ui;
        font-size: Type.label.size;
        font-weight: Type.label.weight;
    }
    Rectangle {
        visible: root.d.secret;
        height: root.d.secret ? Shell.sheet-input : 0px;
        border-radius: Shell.sheet-button-radius;
        background: Palette.shell;
        secret-field := TextInput {
            x: Spacing.s3;
            width: parent.width - 2 * Spacing.s3;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            input-type: password;
            color: Palette.ink;
            selection-background-color: Shell.selection-fill;
            selection-foreground-color: Shell.selection-ink;
            font-family: Fonts.ui;
            font-size: Type.body.size;
            accepted => {
                root.confirm();
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel();
                    return accept;
                }
                return reject;
            }
        }
    }
}

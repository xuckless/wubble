import { Palette, Motion, Spacing, Fonts, Type, Chrome } from "../tokens.slint";
import { Shell } from "../kit/derived.slint";
import { PressableButton } from "../kit/controls/button.slint";
import { DownloadItem, DownloadAction, DownloadStatus } from "model.slint";
import { Icon, IconPaths } from "icon.slint";

// One download: its glyph, name, second line and progress, and the buttons its state allows
// (pause, resume, cancel, retry, open, show in folder, remove). The one row of the downloads
// popover and of the downloads page, so both read one model and look alike. `action` is the
// intent; the host acts. Written from scratch: the design repo has no downloads list.
export component DownloadRow inherits Rectangle {
    in property <DownloadItem> item;
    callback action(int, DownloadAction);

    // Still has bytes to come (`DownloadState::is_active`).
    property <bool> active: root.item.status == DownloadStatus.running || root.item.status == DownloadStatus.paused || root.item.status == DownloadStatus.interrupted;
    property <bool> done: root.item.status == DownloadStatus.complete;
    border-radius: Shell.menu-row-radius;
    background: row-touch.has-hover ? Shell.command-selected : transparent;
    animate background {
        duration: Shell.menu-hover-ms;
        easing: Motion.easeOut;
    }
    row-touch := TouchArea { }
    HorizontalLayout {
        padding-left: Shell.menu-row-pad;
        padding-right: Spacing.s1;
        spacing: Spacing.s3;
        Rectangle {
            width: Shell.icon;
            Icon {
                y: (parent.height - self.height) / 2;
                path: IconPaths.download;
                tint: done ? Palette.mint : active ? Palette.ink : Palette.haze;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.s1;
            Text {
                text: root.item.name;
                color: Palette.ink;
                font-family: Fonts.ui;
                font-size: Type.body.size;
                overflow: elide;
            }
            Text {
                text: root.item.detail;
                color: Palette.mist;
                font-family: Fonts.ui;
                font-size: Type.label.size;
                overflow: elide;
            }
            // The progress track, while there are bytes to come.
            Rectangle {
                visible: active;
                height: active ? Shell.download-track : 0px;
                border-radius: Shell.download-track / 2;
                background: Palette.rim;
                Rectangle {
                    x: 0px;
                    width: root.item.progress < 0 ? parent.width : parent.width * root.item.progress;
                    border-radius: parent.border-radius;
                    background: Palette.sky;
                    opacity: root.item.progress < 0 ? 0.35 : 1;
                    animate width {
                        duration: Motion.dropdownIn;
                        easing: Motion.easeOut;
                    }
                }
            }
        }
        if root.item.status == DownloadStatus.running: PressableButton {
            text: "Pause";
            clicked => {
                root.action(root.item.id, DownloadAction.pause);
            }
        }
        if root.item.status == DownloadStatus.paused || root.item.status == DownloadStatus.interrupted: PressableButton {
            text: "Resume";
            clicked => {
                root.action(root.item.id, DownloadAction.resume);
            }
        }
        if active: PressableButton {
            text: "Cancel";
            clicked => {
                root.action(root.item.id, DownloadAction.cancel);
            }
        }
        if root.item.status == DownloadStatus.cancelled || root.item.status == DownloadStatus.failed: PressableButton {
            text: "Retry";
            clicked => {
                root.action(root.item.id, DownloadAction.retry);
            }
        }
        if done: PressableButton {
            text: "Open";
            clicked => {
                root.action(root.item.id, DownloadAction.open);
            }
        }
        if done: PressableButton {
            text: "Show";
            clicked => {
                root.action(root.item.id, DownloadAction.reveal);
            }
        }
        if !active: PressableButton {
            width: Chrome.controls;
            label: "Remove from list";
            padding-x: (Chrome.controls - Shell.icon) / 2;
            clicked => {
                root.action(root.item.id, DownloadAction.remove);
            }
            Icon {
                path: IconPaths.close;
            }
        }
    }
}

import { DownloadItem, DownloadAction, DownloadStatus } from "model.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { ListRow, RowAction } from "../kit/pages/list-row.slint";
import { DownloadTint } from "../kit/pages/list-progress.slint";
import { Shell } from "../kit/derived.slint";

// One download: its icon, name, second line and progress, and the buttons its state allows
// (pause, resume, cancel, retry, open, show in folder, remove). The one row of the downloads
// popover and of the downloads page, so both read one model and look alike. `action` is the
// intent; the host acts. A kit list row (ui/kit/pages/list-row.slint) with the progress rail;
// the buttons are its actions, shown on the row's hover.
export component DownloadRow inherits Rectangle {
    in property <DownloadItem> item;
    // the entrance (a list page's row): in when this turns true, `index` on the stagger
    in property <bool> shown: true;
    in property <int> index;
    // the popover places rows `Shell.download-row` apart; the page lays them out at their own
    // height (0)
    in property <length> pitch: Shell.download-row;
    callback action(int, DownloadAction);

    // Still has bytes to come (`DownloadState::is_active`).
    property <bool> active: root.item.status == DownloadStatus.running || root.item.status == DownloadStatus.paused || root.item.status == DownloadStatus.interrupted;
    property <bool> done: root.item.status == DownloadStatus.complete;
    height: row-touch.height;

    row-touch := ListRow {
        title: root.item.name;
        note: root.item.detail;
        icon-path: Glyph.download;
        icon-tint: DownloadTint.of(root.done, root.active);
        tappable: false;
        has-progress: root.active;
        progress: root.item.progress;
        shown: root.shown;
        index: root.index;
        pitch: root.pitch;
        if root.item.status == DownloadStatus.running: RowAction {
            icon-path: Glyph.pause;
            label: "Pause";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.pause);
            }
        }
        if root.item.status == DownloadStatus.paused || root.item.status == DownloadStatus.interrupted: RowAction {
            icon-path: Glyph.play;
            label: "Resume";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.resume);
            }
        }
        if root.active: RowAction {
            icon-path: Glyph.close;
            label: "Cancel";
            danger: true;
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.cancel);
            }
        }
        if root.item.status == DownloadStatus.cancelled || root.item.status == DownloadStatus.failed: RowAction {
            icon-path: Glyph.reload;
            label: "Retry";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.retry);
            }
        }
        if root.done: RowAction {
            icon-path: Glyph.arrow;
            label: "Open";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.open);
            }
        }
        if root.done: RowAction {
            icon-path: Glyph.folder;
            label: "Show in folder";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.reveal);
            }
        }
        if !root.active: RowAction {
            icon-path: Glyph.close;
            label: "Remove from list";
            reveal: row-touch.reveal;
            clicked => {
                root.action(root.item.id, DownloadAction.remove);
            }
        }
    }
}

// The settings page (wubble://settings): native Slint in the content area, generated from the
// one settings table (wubble_core::settings, through pages::settings_page). Each row picks its
// control by `row.control`, and the section list beside the rows comes from the rows' sections,
// so a new setting is a table row and no UI code.
//
// Composition only: the look is the design's settings page (`pages/settings.tsx`,
// `settings.css`), translated in the kit (`kit/settings/*`: frame, title, count, nav and its
// indicator, section head, card, row, lead, reset, empty search) and its controls
// (`kit/controls/*`: Toggle sm, Segmented compact, Select, ElasticSlider compact, Swatches,
// Kbd, Button, IconButton, the derived Field and ListEditor). This file lays them out and binds
// the rows. The other native pages and sheets take their Field, Segmented, Stepper, TextButton,
// Card and SectionHeader from here: thin compositions of the same kit parts.

import { Shell } from "../kit/derived.slint";
import { Mark } from "../kit/chrome/mark.slint";
import { EntryItem, SettingItem, SettingControl, BindingItem, CaptureView, SpaceSetting, AboutView, UpdatesView, FilterListItem, PageLinkItem, ExtensionItem, AgentsView, AgentAppItem } from "model.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Toggle, ToggleSize } from "../kit/controls/toggle.slint";
import { ElasticSlider } from "../kit/controls/slider.slint";
import { Segmented as KitSegmented } from "../kit/controls/segmented.slint";
import { Select } from "../kit/controls/select.slint";
import { Swatches } from "../kit/controls/swatches.slint";
import { Kbd } from "../kit/controls/kbd.slint";
import { Button, ButtonKind } from "../kit/controls/button.slint";
import { Field } from "../kit/controls/field.slint";
import { ListEditor, ListEditorAdds } from "../kit/controls/list-editor.slint";
import { Fold } from "../kit/motion/fold.slint";
import { PageTitle, SearchCount, PageScroller, NavScroller, SettingsLayout } from "../kit/settings/page.slint";
import { NavRow, NavIndicator, NavGroup } from "../kit/settings/nav.slint";
import { SectionHead, SectionHeader, CardSlice, Card, Row, RowText, RowNameText, RowNote, RowControls, NoteTone, Lead, MonoNote, NothingMatches, SpaceColours, PageLinkRow } from "../kit/settings/section.slint";
import { ResetButton } from "../kit/settings/reset.slint";
import { ExtensionsCard } from "extensions-section.slint";
import { AgentsCard } from "agents-section.slint";

export { Field, SectionHeader, Card }

// The settings row's segmented control (`.st-seg`), for every caller.
export component Segmented inherits KitSegmented {
    compact: true;
}

// A quiet text button (`.st-reset`, always on): a toast's action, Remove, Replace.
export component TextButton inherits ResetButton { }

// A number typed in a field: Enter applies it, clamped to the range; an empty or unparsable
// entry is refused (the stored value shows again).
component NumberField inherits Field {
    in property <float> value;
    in property <float> min;
    in property <float> max;
    callback set(float);
    width: Shell.stepper-field;
    numeric: true;
    text: root.value;
    accepted(t) => {
        if t.is-float() {
            root.set(Math.clamp(t.to-float(), root.min, root.max));
        }
        self.text = root.value;
    }
    changed value => {
        self.text = root.value;
    }
}

// A whole number in a range: the row's slider when the range is short, else the number typed
// in a field (wubble's: the design has no stepper; `SettingsLayout`).
export component Stepper inherits HorizontalLayout {
    in property <float> value;
    in property <float> min;
    in property <float> max;
    in property <float> step: 1;
    in property <color> accent: SettingsLayout.accent;
    // the row's name, for a screen reader
    in property <string> label;
    callback set(float);

    alignment: end;
    if root.max - root.min <= SettingsLayout.slider-range: ElasticSlider {
        compact: true;
        label: root.label;
        value: root.value;
        min: root.min;
        max: root.max;
        step: root.step;
        accent: root.accent;
        edited(v) => {
            root.set(v);
        }
    }
    if root.max - root.min > SettingsLayout.slider-range: number := NumberField {
        label: root.label;
        value: root.value;
        min: root.min;
        max: root.max;
        set(v) => {
            root.set(v);
        }
    }
}

// One generated row: the control follows `row.control`. A toggle row is a target as a whole
// (`.st-row.tap`: a click anywhere flips it).
component SettingRow inherits VerticalLayout {
    in property <SettingItem> setting;
    in property <color> accent;
    // the page's view, in window coordinates (where a Select's menu may open)
    in property <length> view-top;
    in property <length> view-bottom;
    callback changed(string, string);
    callback reset(string);
    callback entry-removed(string, string);
    callback entry-added(string, string);

    property <bool> listed: root.setting.control == SettingControl.list || root.setting.control == SettingControl.map;
    padding-bottom: root.listed ? Shell.row-pad-y : 0px;
    Row {
        tap: root.setting.control == SettingControl.toggle;
        tapped => {
            root.changed(root.setting.key, root.setting.on ? "0" : "1");
        }
        RowText {
            title: root.setting.label;
            note: root.setting.restart ? "Applies after a restart" : "";
            tone: NoteTone.restart;
        }
        RowControls {
            if root.setting.changed: ResetButton {
                enter: true;
                clicked => {
                    root.reset(root.setting.key);
                }
            }
            if root.setting.control == SettingControl.toggle: toggle := Toggle {
                size: ToggleSize.sm;
                on: root.setting.on;
                accent: root.accent;
                label: root.setting.label;
                toggled => {
                    root.changed(root.setting.key, root.setting.on ? "0" : "1");
                }
            }
            if root.setting.control == SettingControl.segmented && root.setting.options.length == 0: segmented := Segmented {
                labels: root.setting.labels;
                selected: root.setting.selected;
                label: root.setting.label;
                chosen(i) => {
                    root.changed(root.setting.key, root.setting.words[i]);
                }
            }
            if root.setting.control == SettingControl.segmented && root.setting.options.length > 0: select := Select {
                options: root.setting.options;
                value: root.setting.selected;
                placeholder: root.setting.placeholder;
                label: root.setting.label;
                accent: root.accent;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                picked(i) => {
                    root.changed(root.setting.key, root.setting.words[i]);
                }
            }
            if root.setting.control == SettingControl.stepper: stepper := Stepper {
                label: root.setting.label;
                value: root.setting.number;
                min: root.setting.min;
                max: root.setting.max;
                accent: root.accent;
                set(v) => {
                    root.changed(root.setting.key, Math.round(v));
                }
            }
            // wubble: a one-line text row (a folder path), applied on Enter
            if root.setting.control == SettingControl.text: Field {
                label: root.setting.label;
                width: Shell.slider-width;
                text: root.setting.value;
                placeholder: "Default";
                accepted(t) => {
                    root.changed(root.setting.key, t);
                }
            }
            if root.setting.control == SettingControl.slider: slider := ElasticSlider {
                compact: true;
                value: root.setting.number;
                min: root.setting.min;
                max: root.setting.max;
                step: SettingsLayout.float-step;
                accent: root.accent;
                label: root.setting.label;
                edited(v) => {
                    root.changed(root.setting.key, v);
                }
            }
        }
    }
    // a list or map setting's entries in the list editor: a list adds and edits in place, a
    // map only removes; the host answers each draft (`setting.answer`, `setting.note`)
    if root.listed: HorizontalLayout {
        padding-left: Shell.row-pad-x;
        padding-right: Shell.row-pad-x;
        entries := ListEditor {
            columns: root.setting.columns;
            count: root.setting.entries.length;
            row-at(i) => {
                return root.setting.entries[i];
            }
            adds: root.setting.control == SettingControl.list ? ListEditorAdds.draft : ListEditorAdds.none;
            editable: root.setting.control == SettingControl.list;
            answer: root.setting.answer;
            note: root.setting.note;
            label: root.setting.label;
            removed(k) => {
                root.entry-removed(root.setting.key, k);
            }
            submitted(t) => {
                root.entry-added(root.setting.key, t);
            }
        }
    }
}

// One action's shortcut: click the chord to record a new one; Reset when it was changed.
component BindingRow inherits Row {
    in property <BindingItem> item;
    in property <CaptureView> capture;
    callback record(string);
    callback reset(string);
    callback clear(string);
    callback confirm();
    callback cancel();

    property <bool> armed: root.capture.armed && root.capture.action == root.item.action;
    property <bool> asking: root.capture.conflict && root.capture.action == root.item.action;
    RowText {
        title: root.item.label;
        note: root.asking
            ? (root.capture.other-is-edit
                ? root.capture.chord + " runs " + root.capture.other + " (page editing) now"
                : root.capture.chord + " runs " + root.capture.other + " now")
            : "";
        tone: NoteTone.conflict;
    }
    RowControls {
        if root.asking: Button {
            kind: ButtonKind.ghost;
            text: "Replace";
            clicked => {
                root.confirm();
            }
        }
        if root.armed && root.item.chord != "": Button {
            kind: ButtonKind.ghost;
            text: "Clear";
            clicked => {
                root.clear(root.item.action);
            }
        }
        if root.asking || root.armed: Button {
            kind: ButtonKind.ghost;
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }
        if root.item.changed && !root.armed && !root.asking: ResetButton {
            enter: true;
            clicked => {
                root.reset(root.item.action);
            }
        }
        // the chord's key caps (`.st-combo`); a click records a new one
        chord := Kbd {
            keys: root.armed ? ["Press a shortcut"] : root.item.chord == "" ? ["None"] : root.item.keys;
            accessible-role: AccessibleRole.button;
            accessible-label: root.item.label;
            clickable: true;
            accessible-action-default => {
                root.record(root.item.action);
            }
            clicked => {
                root.record(root.item.action);
            }
        }
    }
}

// A section's start on the page: it reports when its top passes the tracking line (the nav's
// current section is the last one past it) and scrolls the page to itself when picked.
component Section inherits Rectangle {
    in property <int> index;
    in property <bool> start: true;
    // the top in the page's content coordinates, and the page's scroll
    in property <length> top;
    in property <length> scroll;
    in property <int> goto-serial;
    in property <int> goto-index;
    in property <length> below;
    callback passed(int, bool);
    callback jump(length);
    property <bool> past: root.start && root.top <= root.scroll + Shell.settings-spy;
    changed past => {
        root.passed(root.index, self.past);
    }
    changed goto-serial => {
        if root.start && root.goto-index == root.index {
            root.jump(root.top);
        }
    }
    VerticalLayout {
        padding-bottom: root.below;
        @children
    }
}

// A section's icon in the list (settings.tsx SECTIONS), by the section's title.
global SectionIcons {
    public pure function of(title: string) -> string {
        if title == "General" { return Glyph.globe; }
        if title == "Privacy" { return Glyph.shield; }
        if title == "Appearance" { return Glyph.palette; }
        if title == "Performance" { return Glyph.gauge; }
        return Glyph.globe;
    }
}

// The section list and page links shared by the wide pinned column and the narrow stacked header.
component SettingsNavList inherits VerticalLayout {
    in property <bool> open;
    in property <color> accent;
    in property <[SettingItem]> rows;
    in property <[BindingItem]> bindings;
    in property <[PageLinkItem]> pages;
    in property <bool> searching;
    in property <bool> extensions-available;
    in property <int> table;
    in property <int> ext-gap;
    in property <int> about-at;
    in property <int> current;
    in property <length> pitch;
    in property <int> nav-focus-index;
    in property <int> nav-focus-serial;
    callback pick(int);
    callback step-nav(int, bool);
    callback page-requested(string);

    spacing: 0px;
    // .st-nav: the table's sections (one per first row), then the page's own
    nav := Rectangle {
        height: (root.about-at + 1) * root.pitch - Shell.nav-row-gap;
        // made as the page opens (its spring's slot needs the wired `Controls`)
        if root.open: NavIndicator {
            y: 0px;
            index: root.current;
        }
        VerticalLayout {
            alignment: start;
            for row in root.rows: Rectangle {
                height: row.first ? root.pitch : 0px;
                visible: row.first;
                NavRow {
                    y: 0px;
                    title: row.section;
                    icon-path: SectionIcons.of(row.section);
                    on: root.current == row.section-index;
                    accent: root.accent;
                    focus-serial: root.nav-focus-serial;
                    focus-me: root.nav-focus-index == row.section-index;
                    picked => {
                        root.pick(row.section-index);
                    }
                    step(down) => {
                        root.step-nav(row.section-index, down);
                    }
                }
            }
            for extra[i] in [
                { title: "Keyboard shortcuts", icon: Glyph.keyboard, shown: root.bindings.length > 0, gone: false },
                { title: "Spaces", icon: Glyph.stack, shown: !root.searching, gone: false },
                { title: "Sites", icon: Glyph.lock, shown: !root.searching, gone: false },
                { title: "Filter lists", icon: Glyph.shield, shown: !root.searching, gone: false },
                { title: "Extensions", icon: Glyph.puzzle, shown: !root.searching, gone: !root.extensions-available },
                { title: "Agents (MCP)", icon: Glyph.agent, shown: !root.searching, gone: false },
                { title: "Updates", icon: Glyph.download, shown: !root.searching, gone: false },
                { title: "About", icon: Glyph.bubble, shown: !root.searching, gone: false },
            ]: Rectangle {
                // a row after a gone one stands for the section one index lower
                property <int> index: root.table + i - (i > 4 ? root.ext-gap : 0);
                height: extra.gone ? 0 : root.pitch;
                visible: !extra.gone;
                NavRow {
                    y: 0px;
                    title: extra.title;
                    icon-path: extra.icon;
                    enabled: extra.shown;
                    on: root.current == parent.index;
                    accent: root.accent;
                    focus-serial: root.nav-focus-serial;
                    focus-me: !extra.gone && root.nav-focus-index == parent.index;
                    picked => {
                        root.pick(parent.index);
                    }
                    step(down) => {
                        root.step-nav(parent.index, down);
                    }
                }
            }
        }
    }
    // the built-in pages: links out of Settings, each opening its page
    NavGroup {
        text: "Pages";
    }
    for link[j] in root.pages: Rectangle {
        property <int> index: root.about-at + 1 + j;
        height: root.pitch;
        NavRow {
            y: 0px;
            title: link.title;
            icon-path: Glyph.page(link.url);
            leads: true;
            accent: root.accent;
            accessible-role: AccessibleRole.button;
            focus-serial: root.nav-focus-serial;
            focus-me: root.nav-focus-index == parent.index;
            picked => {
                root.page-requested(link.action);
            }
            step(down) => {
                root.step-nav(parent.index, down);
            }
        }
    }
}

// .st-pin: title, search, match count, and the section nav (in its own scroller when wide,
// or flat in the page scroller when narrow).
component SettingsSide inherits VerticalLayout {
    in property <bool> open;
    in property <bool> narrow;
    in property <color> accent;
    in property <[SettingItem]> rows;
    in property <[BindingItem]> bindings;
    in property <[PageLinkItem]> pages;
    in property <bool> searching;
    in property <string> count-text;
    in property <bool> extensions-available;
    in property <int> table;
    in property <int> ext-gap;
    in property <int> about-at;
    in property <int> current;
    in property <length> pitch;
    in property <int> nav-focus-index;
    in property <int> nav-focus-serial;
    in property <int> focus-serial;
    in property <int> nav-reset-serial;
    in property <int> nav-reveal-serial;
    in property <length> nav-reveal-top;
    in-out property <string> query;
    callback search-for(string);
    callback pick(int);
    callback step-nav(int, bool);
    callback page-requested(string);
    callback nav-overflow(length);

    changed focus-serial => {
        search.take-focus();
    }
    public function take-focus() {
        search.take-focus();
    }

    min-width: 0px;
    spacing: 0px;
    alignment: start;
    HorizontalLayout {
        padding-left: Shell.settings-title-in;
        padding-bottom: Shell.settings-title-below;
        PageTitle {
            text: "Settings";
            narrow: root.narrow;
        }
    }
    search := Field {
        capsule: true;
        text <=> root.query;
        placeholder: "Search settings";
        edited(q) => {
            root.search-for(q);
        }
    }
    // .st-count: how many rows the search leaves
    HorizontalLayout {
        padding-top: Shell.count-above;
        padding-bottom: Shell.count-below;
        padding-left: Shell.count-in;
        SearchCount {
            text: root.count-text;
        }
    }
    if !root.narrow: nav-scroll := NavScroller {
        property <int> reset-serial: root.nav-reset-serial;
        property <int> reveal-serial: root.nav-reveal-serial;
        changed reset-serial => {
            self.reset();
        }
        changed reveal-serial => {
            self.reveal(root.nav-reveal-top, Shell.nav-row);
        }
        open: root.open;
        overflow(d) => {
            root.nav-overflow(d);
        }
        SettingsNavList {
            open: root.open;
            accent: root.accent;
            rows: root.rows;
            bindings: root.bindings;
            pages: root.pages;
            searching: root.searching;
            extensions-available: root.extensions-available;
            table: root.table;
            ext-gap: root.ext-gap;
            about-at: root.about-at;
            current: root.current;
            pitch: root.pitch;
            nav-focus-index: root.nav-focus-index;
            nav-focus-serial: root.nav-focus-serial;
            pick(i) => {
                root.pick(i);
            }
            step-nav(i, d) => {
                root.step-nav(i, d);
            }
            page-requested(a) => {
                root.page-requested(a);
            }
        }
    }
}

// The settings page: the pinned column beside the sections (.st-grid).
export component SettingsPage inherits Rectangle {
    in property <bool> open;
    // the Space colour: toggles, the slider's fill, the current section's icon
    in property <color> accent: SettingsLayout.accent;
    // the generated rows, flat: each section's first row names it
    in property <[SettingItem]> rows;
    in property <[BindingItem]> bindings;
    in property <CaptureView> capture;
    in property <[SpaceSetting]> spaces;
    // the Sites lists: each line and what removing it names (a host, a decision's index)
    in property <[EntryItem]> site-zoom;
    in property <[EntryItem]> site-permissions;
    // the Filter lists section: every list, and whether one is rebuilding or downloading
    in property <[FilterListItem]> filter-lists;
    in property <bool> filter-busy;
    // why the Filter lists field's last address was refused, or empty
    in property <string> filter-note;
    // the Extensions section: the installed list, and whether it differs from what this run loaded
    in property <[ExtensionItem]> extensions;
    in property <bool> extensions-restart;
    // the engine has wubble's extension patches (`wubble_engine::ext_api::available`)
    in property <bool> extensions-available: true;
    // the Agents (MCP) group: hosting, and the agent apps found here
    in property <AgentsView> agents;
    in property <[AgentAppItem]> agent-apps;
    in property <AboutView> about;
    in property <UpdatesView> updates;
    // the search box has text: only the matching rows show, the other sections are left out
    in property <bool> searching;
    // The built-in pages it links to (the nav's second group), and those the search names (its
    // redirect rows). Nothing of them is rebuilt here: a link runs the page's own action.
    in property <[PageLinkItem]> pages;
    in property <[PageLinkItem]> page-matches;
    callback page-requested(string);
    callback query-changed(string);
    callback setting-changed(string, string);
    callback setting-reset(string);
    callback entry-removed(string, string);
    callback entry-added(string, string);
    callback binding-record(string);
    callback binding-reset(string);
    callback binding-clear(string);
    callback capture-confirm();
    callback capture-cancel();
    callback space-renamed(int, string);
    callback space-tinted(int, color);
    callback space-icon-chosen(int, string);
    callback site-zoom-removed(string);
    callback site-permission-removed(string);
    callback filter-list-toggled(string, bool);
    callback filter-lists-update();
    callback extension-install-file();
    callback extension-install-folder();
    callback extension-toggled(string, bool);
    callback extension-private-toggled(string, bool);
    callback extension-removed(string);
    callback extension-options(string);
    callback agents-toggled(bool);
    callback agents-copy(string);
    callback agent-app-added(string);
    callback agent-app-removed(string);
    // the Updates group: its switch, "Check now", "Restart to update"
    callback updates-toggled(bool);
    callback updates-check();
    callback updates-restart();

    // The search takes the keys at once, as before the narrow layout: a request through the
    // serial is answered only in a later change-handler pass, after (and over) any other focus
    // change of the same turn. The narrow header is made on demand (`if`), so it is reached
    // through the serial.
    public function take-focus() {
        if root.narrow {
            root.search-focus-serial += 1;
        } else {
            wide-side.take-focus();
        }
    }
    public function scroll-to-top() {
        page.reset();
        root.nav-reset-serial += 1;
        root.tracked = 0;
    }
    // the section list back at its top, the page where it is (the gallery)
    public function nav-to-top() {
        root.nav-reset-serial += 1;
    }
    // `q` typed into the search (the gallery's search scene)
    public function type-query(q: string) {
        root.query = q;
        root.search-for(q);
    }

    visible: root.open;

    // a click on a Space's tile picks the next of the three icons
    pure function next-icon(icon: string) -> string {
        return icon == "personal" ? "work" : icon == "work" ? "study" : "personal";
    }
    property <bool> notices-open: false;
    property <string> query;
    property <bool> narrow: root.width <= SettingsLayout.narrow;

    // .st-grid, centred, at most `settings-max` wide with its padding inside
    property <length> pad-x: max(Shell.settings-pad-min, min(Shell.settings-pad-max, root.width * Shell.settings-pad-share));
    property <length> grid-x: (root.width - min(Shell.settings-max, root.width)) / 2 + root.pad-x;
    property <length> grid-w: min(Shell.settings-max, root.width) - 2 * root.pad-x;
    property <length> main-x: root.grid-x + Shell.settings-side + Shell.settings-gap;
    property <length> main-top: Shell.settings-top + Shell.section-top;
    property <length> content-top: root.narrow ? SettingsLayout.narrow-top : root.main-top;

    // The sections: the table's (`section-index` 0..n), then shortcuts, Spaces, sites, about.
    property <int> table: root.rows.length > 0 ? root.rows[root.rows.length - 1].section-index + 1 : 0;
    property <int> shortcuts: root.table;
    property <int> spaces-at: root.table + 1;
    property <int> sites-at: root.table + 2;
    property <int> lists-at: root.table + 3;
    // without the engine's extension patches the Extensions section and its nav row are gone,
    // and the sections after it move up one
    property <int> ext-gap: root.extensions-available ? 0 : 1;
    property <int> extensions-at: root.table + 4;
    property <int> agents-at: root.table + 5 - root.ext-gap;
    property <int> updates-at: root.table + 6 - root.ext-gap;
    property <int> about-at: root.table + 7 - root.ext-gap;
    property <int> nav-count: root.about-at + 1 + root.pages.length;
    property <int> last: root.searching ? (root.bindings.length > 0 ? root.shortcuts : root.table - 1) : root.about-at;
    property <int> matches: root.rows.length + root.bindings.length;
    // what the search leaves: "N settings", then ", M pages" when it names pages
    property <string> settings-count: root.matches == 1 ? "1 setting" : root.matches + " settings";
    property <string> pages-count: root.page-matches.length == 1 ? "1 page" : root.page-matches.length + " pages";
    property <string> count-text: !root.searching ? "" : root.page-matches.length == 0 ? (root.matches == 0 ? "No matches" : root.settings-count) : root.matches == 0 ? root.pages-count : root.settings-count + ", " + root.pages-count;
    // the section the reader is in: the last one past the tracking line, the last at the end,
    // or the one picked in the list until the page is scrolled by hand
    property <int> tracked: 0;
    property <int> picked: -1;
    property <int> goto-index: -1;
    property <int> goto-serial: 0;
    property <int> nav-focus-index: -1;
    property <int> nav-focus-serial: 0;
    property <int> search-focus-serial: 0;
    property <int> nav-reset-serial: 0;
    property <int> nav-reveal-serial: 0;
    property <length> nav-reveal-top: 0px;
    property <bool> at-end: page.room > 0px && page.scroll >= page.room - Shell.settings-end-slack;
    out property <int> current: root.picked >= 0 ? root.picked : root.at-end ? root.last : root.tracked;
    property <length> pitch: Shell.nav-row + Shell.nav-row-gap;

    // A section's index counts from the table's last section (and Extensions' gap): when the
    // rows come (the page opens before the host fills it) or Extensions comes or goes, the
    // indices move, and one reported or picked before means another section now. Start over.
    property <int> numbering: root.table * 2 + root.ext-gap;
    changed numbering => {
        root.tracked = 0;
        root.picked = -1;
    }
    // the list scrolls the current section's row into view when the section changes
    changed current => {
        if !root.narrow && root.current >= 0 {
            root.nav-reveal-top = root.current * root.pitch;
            root.nav-reveal-serial += 1;
        }
    }
    pure function next-nav(from: int, down: bool) -> int {
        if down {
            if from + 1 < root.table { return from + 1; }
            if from < root.shortcuts && root.bindings.length > 0 { return root.shortcuts; }
            if from < root.spaces-at && !root.searching { return root.spaces-at; }
            if from >= root.spaces-at && from < root.about-at && !root.searching { return from + 1; }
            if from < root.about-at + 1 && root.pages.length > 0 { return root.about-at + 1; }
            if from >= root.about-at + 1 && from + 1 < root.nav-count { return from + 1; }
            return from;
        }
        if from > root.about-at + 1 { return from - 1; }
        if from > root.about-at && !root.searching { return root.about-at; }
        if from > root.spaces-at && from <= root.about-at && !root.searching { return from - 1; }
        if from > root.shortcuts && root.bindings.length > 0 { return root.shortcuts; }
        if from > root.table - 1 && root.table > 0 { return root.table - 1; }
        if from > 0 && from < root.table { return from - 1; }
        return from;
    }
    function step-nav(from: int, down: bool) {
        let next = root.next-nav(from, down);
        if next != from {
            root.nav-focus-index = next;
            root.nav-focus-serial += 1;
            if !root.narrow && next <= root.about-at {
                root.nav-reveal-top = next * root.pitch;
                root.nav-reveal-serial += 1;
            }
        }
    }
    function pick(index: int) {
        root.picked = index;
        root.goto-index = index;
        root.goto-serial += 1;
    }
    function passed(index: int, past: bool) {
        root.tracked = past ? max(root.tracked, index) : max(0, min(root.tracked, index - 1));
    }
    function jump(top: length) {
        page.to(top - Shell.settings-pin);
    }
    function search-for(q: string) {
        page.reset();
        root.tracked = 0;
        root.picked = -1;
        root.query-changed(q);
    }

    page := PageScroller {
        open: root.open;
        wheeled => {
            root.picked = -1;
        }
        HorizontalLayout {
            padding-left: root.narrow ? root.grid-x : root.main-x;
            padding-right: root.width - root.grid-x - root.grid-w;
            padding-top: root.content-top;
            padding-bottom: Shell.settings-bottom;

            VerticalLayout {
                width: root.narrow ? root.grid-w : max(0px, root.grid-w - Shell.settings-side - Shell.settings-gap);
                spacing: 0px;

                if root.narrow: VerticalLayout {
                    min-width: 0px;
                    padding-bottom: SettingsLayout.narrow-main-top;
                    narrow-side := SettingsSide {
                        open: root.open;
                        narrow: true;
                        accent: root.accent;
                        rows: root.rows;
                        bindings: root.bindings;
                        pages: root.pages;
                        searching: root.searching;
                        count-text: root.count-text;
                        extensions-available: root.extensions-available;
                        table: root.table;
                        ext-gap: root.ext-gap;
                        about-at: root.about-at;
                        current: root.current;
                        pitch: root.pitch;
                        nav-focus-index: root.nav-focus-index;
                        nav-focus-serial: root.nav-focus-serial;
                        focus-serial: root.search-focus-serial;
                        nav-reset-serial: root.nav-reset-serial;
                        nav-reveal-serial: root.nav-reveal-serial;
                        nav-reveal-top: root.nav-reveal-top;
                        query <=> root.query;
                        search-for(q) => {
                            root.search-for(q);
                        }
                        pick(i) => {
                            root.pick(i);
                        }
                        step-nav(i, d) => {
                            root.step-nav(i, d);
                        }
                        page-requested(a) => {
                            root.page-requested(a);
                        }
                    }
                }

                // A search's redirect rows: the built-in pages it names, above the settings
                if root.searching && root.page-matches.length > 0: VerticalLayout {
                    padding-bottom: Shell.section-below;
                    SectionHead {
                        text: "Pages";
                    }
                    Card {
                        for link in root.page-matches: PageLinkRow {
                            title: link.title;
                            note: link.note;
                            icon-path: Glyph.page(link.url);
                            accent: root.accent;
                            opened => {
                                root.page-requested(link.action);
                            }
                        }
                    }
                }

                // A flat list (rows keep their instance across a re-render); each section's
                // first row carries its heading, each row draws its slice of the section's card.
                // A row with a Select sits over the rows after it, so its menu hangs over them.
                for row in root.rows: setting-row := Section {
                    index: row.section-index;
                    start: row.first;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: row.last ? Shell.section-below : 0px;
                    z: row.options.length > 0 ? 1 : 0;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    if row.first: SectionHead {
                        text: row.section;
                    }
                    CardSlice {
                        first: row.first;
                        last: row.last;
                        SettingRow {
                            setting: row;
                            accent: root.accent;
                            view-top: page.absolute-position.y;
                            view-bottom: page.absolute-position.y + page.height;
                            changed(k, v) => {
                                root.setting-changed(k, v);
                            }
                            reset(k) => {
                                root.setting-reset(k);
                            }
                            entry-removed(k, e) => {
                                root.entry-removed(k, e);
                            }
                            entry-added(k, e) => {
                                root.entry-added(k, e);
                            }
                        }
                    }
                }

                if root.bindings.length > 0: Section {
                    index: root.shortcuts;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Keyboard shortcuts";
                    }
                    Card {
                        for b in root.bindings: BindingRow {
                            item: b;
                            capture: root.capture;
                            record(a) => {
                                root.binding-record(a);
                            }
                            reset(a) => {
                                root.binding-reset(a);
                            }
                            clear(a) => {
                                root.binding-clear(a);
                            }
                            confirm => {
                                root.capture-confirm();
                            }
                            cancel => {
                                root.capture-cancel();
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.spaces-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Spaces";
                    }
                    spaces-card := Card {
                        // the Space selected in the list (-1: none)
                        property <int> picked: spaces-list.selected < root.spaces.length ? spaces-list.selected : -1;
                        // every Space: "+" adds one ("Space N" in the next swatch) and names it
                        // in place, "−" deletes the selected one with its tabs (asked twice;
                        // the last stays), Enter or a double click renames it
                        HorizontalLayout {
                            padding: Shell.row-pad-x;
                            spaces-list := ListEditor {
                                columns: ["Space", "Colour"];
                                count: root.spaces.length;
                                row-at(i) => {
                                    return {
                                        label: root.spaces[i].name,
                                        key: root.spaces[i].id,
                                        cells: [root.spaces[i].name, root.spaces[i].colour],
                                        icon: Glyph.space(root.spaces[i].tile-icon),
                                        tint: root.spaces[i].tint,
                                    };
                                }
                                leads: true;
                                swatch-column: 1;
                                adds: ListEditorAdds.owner;
                                confirm-remove: true;
                                keep: 1;
                                edit-columns: 1;
                                answers: false;
                                label: "Spaces";
                                placeholders: ["Name"];
                                add-label: "New Space";
                                remove-label: "Delete Space";
                                confirm-note: spaces-card.picked < 0 ? "" : root.spaces[spaces-card.picked].tabs == 0 ? "Press − again to delete " + root.spaces[spaces-card.picked].name : "Press − again to delete " + root.spaces[spaces-card.picked].name + " and close its " + (root.spaces[spaces-card.picked].tabs == 1 ? "tab" : root.spaces[spaces-card.picked].tabs + " tabs");
                                ask-add => {
                                    root.entry-added("spaces", "");
                                }
                                removed(k) => {
                                    root.entry-removed("spaces", k);
                                }
                                edited(k, name) => {
                                    if spaces-card.picked >= 0 && name != "" {
                                        root.space-renamed(root.spaces[spaces-card.picked].id, name);
                                    }
                                }
                            }
                        }
                        // the selected Space: its icon on a tile (a click picks the next icon),
                        // its name (typed, Enter renames), its colours
                        if spaces-card.picked >= 0: Row {
                            Lead {
                                icon-path: Glyph.space(root.spaces[spaces-card.picked].tile-icon);
                                tint: root.spaces[spaces-card.picked].tint;
                                label: root.spaces[spaces-card.picked].name + " icon";
                                clicked => {
                                    root.space-icon-chosen(root.spaces[spaces-card.picked].id, root.next-icon(root.spaces[spaces-card.picked].icon));
                                }
                            }
                            RowNameText {
                                name: root.spaces[spaces-card.picked].name;
                                label: "Space name";
                                note: "Its colour tints the window's glass and the backdrop.";
                                renamed(n) => {
                                    root.space-renamed(root.spaces[spaces-card.picked].id, n);
                                }
                            }
                            RowControls {
                                Swatches {
                                    colours: SpaceColours.all;
                                    value: root.spaces[spaces-card.picked].tint;
                                    label: root.spaces[spaces-card.picked].name + " colour";
                                    chosen(c) => {
                                        root.space-tinted(root.spaces[spaces-card.picked].id, c);
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.sites-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Sites";
                    }
                    Card {
                        Row {
                            RowText {
                                title: "Zoom levels";
                            }
                        }
                        HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            ListEditor {
                                columns: ["Site", "Zoom"];
                                count: root.site-zoom.length;
                                row-at(i) => {
                                    return root.site-zoom[i];
                                }
                                adds: ListEditorAdds.none;
                                editable: false;
                                label: "Zoom levels";
                                empty: "No site has its own zoom";
                                removed(k) => {
                                    root.site-zoom-removed(k);
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Permissions";
                            }
                        }
                        HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            ListEditor {
                                columns: ["Site", "Permission", "Decision"];
                                count: root.site-permissions.length;
                                row-at(i) => {
                                    return root.site-permissions[i];
                                }
                                adds: ListEditorAdds.none;
                                editable: false;
                                label: "Permissions";
                                empty: "No site has a remembered permission";
                                removed(k) => {
                                    root.site-permission-removed(k);
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.lists-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Filter lists";
                    }
                    Card {
                        Row {
                            RowText {
                                title: root.filter-busy ? "Working on the filter lists" : "Update the lists";
                                note: "Downloads every list switched on. Lists are only fetched when you ask or when they are kept up to date.";
                            }
                            RowControls {
                                Button {
                                    text: "Update now";
                                    enabled: !root.filter-busy;
                                    clicked => {
                                        root.filter-lists-update();
                                    }
                                }
                            }
                        }
                        for list in root.filter-lists: Row {
                            tap: !list.custom;
                            tapped => {
                                root.filter-list-toggled(list.id, !list.enabled);
                            }
                            RowText {
                                title: list.title;
                                note: list.note;
                            }
                            RowControls {
                                if list.custom: IconButton {
                                    icon-path: Glyph.close;
                                    label: "Remove";
                                    clicked => {
                                        root.entry-removed("blocker.custom_lists", list.key);
                                    }
                                }
                                if !list.custom: Toggle {
                                    size: ToggleSize.sm;
                                    on: list.enabled;
                                    accent: root.accent;
                                    label: list.title;
                                    toggled => {
                                        root.filter-list-toggled(list.id, !list.enabled);
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-top: Shell.row-pad-y;
                            padding-bottom: Shell.row-pad-y;
                            list-field := Field {
                                placeholder: "Add a list by its https:// address";
                                accepted(t) => {
                                    if t != "" {
                                        // the host answers at once: a refused address stays
                                        // in the field to be fixed, its note below it
                                        root.entry-added("blocker.custom_lists", t);
                                        if root.filter-note == "" {
                                            self.text = "";
                                        }
                                    }
                                }
                            }
                            // why the address still in the field was refused (the list editor's
                            // coral note)
                            Fold {
                                open: root.filter-note != "" && list-field.text != "";
                                content-height: refusal.preferred-height;
                                refusal := RowNote {
                                    text: root.filter-note;
                                    tone: NoteTone.conflict;
                                }
                            }
                        }
                    }
                }

                if !root.searching && root.extensions-available: Section {
                    index: root.extensions-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Extensions";
                    }
                    ExtensionsCard {
                        items: root.extensions;
                        accent: root.accent;
                        restart: root.extensions-restart;
                        install-file => {
                            root.extension-install-file();
                        }
                        install-folder => {
                            root.extension-install-folder();
                        }
                        toggled(id, on) => {
                            root.extension-toggled(id, on);
                        }
                        private-toggled(id, on) => {
                            root.extension-private-toggled(id, on);
                        }
                        removed(id) => {
                            root.extension-removed(id);
                        }
                        options(id) => {
                            root.extension-options(id);
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.agents-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Agents (MCP)";
                    }
                    AgentsCard {
                        view: root.agents;
                        apps: root.agent-apps;
                        accent: root.accent;
                        toggled(on) => {
                            root.agents-toggled(on);
                        }
                        activity => {
                            root.page-requested("open-agent-log");
                        }
                        copy(text) => {
                            root.agents-copy(text);
                        }
                        add(id) => {
                            root.agent-app-added(id);
                        }
                        remove(id) => {
                            root.agent-app-removed(id);
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.updates-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Updates";
                    }
                    Card {
                        if !root.updates.inert: Row {
                            tap: true;
                            tapped => {
                                root.updates-toggled(!root.updates.on);
                            }
                            RowText {
                                title: "Check for updates when wubble opens";
                                note: "Asks GitHub for the newest release; nothing else is sent.";
                            }
                            RowControls {
                                Toggle {
                                    size: ToggleSize.sm;
                                    on: root.updates.on;
                                    accent: root.accent;
                                    label: "Check for updates when wubble opens";
                                    toggled => {
                                        root.updates-toggled(!root.updates.on);
                                    }
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "wubble " + root.updates.version;
                                note: root.updates.status;
                            }
                            RowControls {
                                if root.updates.ready: Button {
                                    text: "Restart to update";
                                    clicked => {
                                        root.updates-restart();
                                    }
                                }
                                if !root.updates.inert && !root.updates.ready: Button {
                                    text: "Check now";
                                    enabled: root.updates.can-check;
                                    clicked => {
                                        root.updates-check();
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.about-at;
                    top: self.y + root.content-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "About";
                    }
                    Card {
                        Row {
                            RowText {
                                title: "wubble " + root.about.version;
                                note: "Chromium " + root.about.chromium + " (CEF " + root.about.cef + ")";
                            }
                            RowControls {
                                Mark {
                                    size: Shell.about-mark;
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Licence";
                                note: root.about.licence;
                            }
                            RowControls {
                                Button {
                                    text: root.notices-open ? "Hide notices" : "Third-party notices";
                                    clicked => {
                                        root.notices-open = !root.notices-open;
                                    }
                                }
                            }
                        }
                        if root.notices-open: HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            MonoNote {
                                text: root.about.notices;
                            }
                        }
                    }
                }

                // `.st-empty`: the search left nothing
                Fold {
                    open: root.searching && root.matches == 0 && root.page-matches.length == 0;
                    content-height: empty.preferred-height;
                    empty := NothingMatches {
                        text: "Nothing matches “" + root.query + "”.";
                        Button {
                            kind: ButtonKind.ghost;
                            text: "Clear search";
                            clicked => {
                                root.query = "";
                                root.search-for("");
                                root.take-focus();
                            }
                        }
                    }
                }
            }
        }
    }

    // .st-pin: the title, the search, the count and the section list, held 24 below the top
    // once the page scrolls; the wheel over the title scrolls the page, over the list the list
    // when it is taller than the window (derived-review.md), else the page.
    // kept while narrow (hidden) so `take-focus` reaches its search in the same turn
    side := TouchArea {
        visible: !root.narrow;
        x: root.grid-x;
        y: max(Shell.settings-pin, Shell.settings-top - page.scroll);
        width: Shell.settings-side;
        height: min(wide-side.preferred-height, root.height - self.y - Shell.settings-pin);
        scroll-event(e) => {
            page.wheel(-e.delta-y);
            accept
        }
        wide-side := SettingsSide {
            open: root.open && !root.narrow;
            narrow: false;
            accent: root.accent;
            rows: root.rows;
            bindings: root.bindings;
            pages: root.pages;
            searching: root.searching;
            count-text: root.count-text;
            extensions-available: root.extensions-available;
            table: root.table;
            ext-gap: root.ext-gap;
            about-at: root.about-at;
            current: root.current;
            pitch: root.pitch;
            nav-focus-index: root.nav-focus-index;
            nav-focus-serial: root.nav-focus-serial;
            focus-serial: root.search-focus-serial;
            nav-reset-serial: root.nav-reset-serial;
            nav-reveal-serial: root.nav-reveal-serial;
            nav-reveal-top: root.nav-reveal-top;
            query <=> root.query;
            search-for(q) => {
                root.search-for(q);
            }
            pick(i) => {
                root.pick(i);
            }
            step-nav(i, d) => {
                root.step-nav(i, d);
            }
            page-requested(a) => {
                root.page-requested(a);
            }
            nav-overflow(d) => {
                page.wheel(d);
            }
        }
    }
}

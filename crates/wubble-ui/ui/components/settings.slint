// The settings page (wubble://settings): native Slint in the content area, generated from the
// one settings table (wubble_core::settings, through pages::settings_page). Each row picks its
// control by `row.control`, and the section list beside the rows comes from the rows' sections,
// so a new setting is a table row and no UI code.
//
// Composition only: the look is the design's settings page (`pages/settings.tsx`,
// `settings.css`), translated in the kit (`kit/settings/*`: frame, title, count, nav and its
// indicator, section head, card, row, lead, reset, empty search) and its controls
// (`kit/controls/*`: Toggle sm, Segmented compact, Select, ElasticSlider compact, Swatches,
// Kbd, Button, IconButton, the derived Field). This file lays them out and binds the rows.
// The other native pages and sheets take their Field, Segmented, Stepper, TextButton, Card,
// SectionHeader, PageFrame and EntryList from here: thin compositions of the same kit parts.

import { Shell } from "../kit/derived.slint";
import { Mark } from "../kit/chrome/mark.slint";
import { EntryItem, SettingItem, SettingControl, BindingItem, CaptureView, SpaceSetting, AboutView, FilterListItem } from "model.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Toggle, ToggleSize } from "../kit/controls/toggle.slint";
import { ElasticSlider } from "../kit/controls/slider.slint";
import { Segmented as KitSegmented } from "../kit/controls/segmented.slint";
import { Select } from "../kit/controls/select.slint";
import { Swatches } from "../kit/controls/swatches.slint";
import { Kbd } from "../kit/controls/kbd.slint";
import { Button, ButtonKind } from "../kit/controls/button.slint";
import { Field } from "../kit/controls/field.slint";
import { Fold } from "../kit/motion/fold.slint";
import { PageTitle, SearchCount, PageScroller, SettingsLayout } from "../kit/settings/page.slint";
import { NavRow, NavIndicator } from "../kit/settings/nav.slint";
import { SectionHead, SectionHeader, CardSlice, Card, Row, RowText, RowNameText, RowNote, RowControls, NoteTone, Lead, MonoNote, NothingMatches, SpaceColours } from "../kit/settings/section.slint";
import { ResetButton } from "../kit/settings/reset.slint";

export { Field, SectionHeader, Card }

// The settings row's segmented control (`.st-seg`), for every caller.
export component Segmented inherits KitSegmented {
    compact: true;
}

// A quiet text button (`.st-reset`, always on): a toast's action, Remove, Replace.
export component TextButton inherits ResetButton { }

// A number typed in a field: Enter applies it, clamped to the range; an empty or unparsable
// entry is refused (the stored value shows again).
component NumberField inherits Field {
    in property <float> value;
    in property <float> min;
    in property <float> max;
    callback set(float);
    width: Shell.stepper-field;
    numeric: true;
    text: root.value;
    accepted(t) => {
        if t.is-float() {
            root.set(Math.clamp(t.to-float(), root.min, root.max));
        }
        self.text = root.value;
    }
    changed value => {
        self.text = root.value;
    }
}

// A whole number in a range: the row's slider when the range is short, else the number typed
// in a field (wubble's: the design has no stepper; `SettingsLayout`).
export component Stepper inherits HorizontalLayout {
    in property <float> value;
    in property <float> min;
    in property <float> max;
    in property <float> step: 1;
    in property <color> accent: SettingsLayout.accent;
    callback set(float);

    alignment: end;
    if root.max - root.min <= SettingsLayout.slider-range: ElasticSlider {
        compact: true;
        value: root.value;
        min: root.min;
        max: root.max;
        step: root.step;
        accent: root.accent;
        edited(v) => {
            root.set(v);
        }
    }
    if root.max - root.min > SettingsLayout.slider-range: number := NumberField {
        value: root.value;
        min: root.min;
        max: root.max;
        set(v) => {
            root.set(v);
        }
    }
}

// Entries of a list or map setting, each removable; `can-add` adds a field for a new one.
export component EntryList inherits VerticalLayout {
    in property <[EntryItem]> entries;
    in property <bool> can-add;
    in property <string> placeholder;
    in property <string> empty: "None";
    callback removed(string);
    callback added(string);

    spacing: SettingsLayout.entry-gap;
    if root.entries.length == 0 && !root.can-add: RowNote {
        text: root.empty;
    }
    for entry in root.entries: HorizontalLayout {
        spacing: SettingsLayout.entry-gap;
        RowNote {
            horizontal-stretch: 1;
            text: entry.label;
            wrap: no-wrap;
            overflow: elide;
        }
        IconButton {
            icon-path: Glyph.close;
            label: "Remove";
            clicked => {
                root.removed(entry.key);
            }
        }
    }
    if root.can-add: Field {
        placeholder: root.placeholder;
        accepted(t) => {
            if t != "" {
                root.added(t);
            }
            self.text = "";
        }
    }
}

// One generated row: the control follows `row.control`. A toggle row is a target as a whole
// (`.st-row.tap`: a click anywhere flips it).
component SettingRow inherits VerticalLayout {
    in property <SettingItem> setting;
    in property <color> accent;
    // the page's view, in window coordinates (where a Select's menu may open)
    in property <length> view-top;
    in property <length> view-bottom;
    callback changed(string, string);
    callback reset(string);
    callback entry-removed(string, string);
    callback entry-added(string, string);

    property <bool> listed: root.setting.control == SettingControl.list || root.setting.control == SettingControl.map;
    padding-bottom: root.listed ? Shell.row-pad-y : 0px;
    Row {
        tap: root.setting.control == SettingControl.toggle;
        tapped => {
            root.changed(root.setting.key, root.setting.on ? "0" : "1");
        }
        RowText {
            title: root.setting.label;
            note: root.setting.restart ? "Applies after a restart" : "";
            tone: NoteTone.restart;
        }
        RowControls {
            if root.setting.changed: ResetButton {
                enter: true;
                clicked => {
                    root.reset(root.setting.key);
                }
            }
            if root.setting.control == SettingControl.toggle: toggle := Toggle {
                size: ToggleSize.sm;
                on: root.setting.on;
                accent: root.accent;
                label: root.setting.label;
                toggled => {
                    root.changed(root.setting.key, root.setting.on ? "0" : "1");
                }
            }
            if root.setting.control == SettingControl.segmented && root.setting.options.length == 0: segmented := Segmented {
                labels: root.setting.labels;
                selected: root.setting.selected;
                label: root.setting.label;
                chosen(i) => {
                    root.changed(root.setting.key, root.setting.words[i]);
                }
            }
            if root.setting.control == SettingControl.segmented && root.setting.options.length > 0: select := Select {
                options: root.setting.options;
                value: root.setting.selected;
                label: root.setting.label;
                accent: root.accent;
                view-top: root.view-top;
                view-bottom: root.view-bottom;
                picked(i) => {
                    root.changed(root.setting.key, root.setting.words[i]);
                }
            }
            if root.setting.control == SettingControl.stepper: stepper := Stepper {
                value: root.setting.number;
                min: root.setting.min;
                max: root.setting.max;
                accent: root.accent;
                set(v) => {
                    root.changed(root.setting.key, Math.round(v));
                }
            }
            // wubble: a one-line text row (a folder path), applied on Enter
            if root.setting.control == SettingControl.text: Field {
                width: Shell.slider-width;
                text: root.setting.value;
                placeholder: "Default";
                accepted(t) => {
                    root.changed(root.setting.key, t);
                }
            }
            if root.setting.control == SettingControl.slider: slider := ElasticSlider {
                compact: true;
                value: root.setting.number;
                min: root.setting.min;
                max: root.setting.max;
                step: SettingsLayout.float-step;
                accent: root.accent;
                label: root.setting.label;
                edited(v) => {
                    root.changed(root.setting.key, v);
                }
            }
        }
    }
    if root.listed: HorizontalLayout {
        padding-left: Shell.row-pad-x;
        padding-right: Shell.row-pad-x;
        entries := EntryList {
            entries: root.setting.entries;
            can-add: root.setting.control == SettingControl.list;
            placeholder: "Add";
            removed(k) => {
                root.entry-removed(root.setting.key, k);
            }
            added(t) => {
                root.entry-added(root.setting.key, t);
            }
        }
    }
}

// One action's shortcut: click the chord to record a new one; Reset when it was changed.
component BindingRow inherits Row {
    in property <BindingItem> item;
    in property <CaptureView> capture;
    callback record(string);
    callback reset(string);
    callback confirm();
    callback cancel();

    property <bool> armed: root.capture.armed && root.capture.action == root.item.action;
    property <bool> asking: root.capture.conflict && root.capture.action == root.item.action;
    RowText {
        title: root.item.label;
        note: root.asking ? root.capture.chord + " runs " + root.capture.other + " now" : "";
        tone: NoteTone.conflict;
    }
    RowControls {
        if root.asking: Button {
            kind: ButtonKind.ghost;
            text: "Replace";
            clicked => {
                root.confirm();
            }
        }
        if root.asking || root.armed: Button {
            kind: ButtonKind.ghost;
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }
        if root.item.changed && !root.armed && !root.asking: ResetButton {
            enter: true;
            clicked => {
                root.reset(root.item.action);
            }
        }
        // the chord's key caps (`.st-combo`); a click records a new one
        chord := Kbd {
            keys: root.armed ? ["Press a shortcut"] : root.item.chord == "" ? ["None"] : root.item.keys;
            accessible-role: AccessibleRole.button;
            accessible-label: root.item.label;
            accessible-action-default => {
                root.record(root.item.action);
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.record(root.item.action);
                }
            }
        }
    }
}

// A section's start on the page: it reports when its top passes the tracking line (the nav's
// current section is the last one past it) and scrolls the page to itself when picked.
component Section inherits Rectangle {
    in property <int> index;
    in property <bool> start: true;
    // the top in the page's content coordinates, and the page's scroll
    in property <length> top;
    in property <length> scroll;
    in property <int> goto-serial;
    in property <int> goto-index;
    in property <length> below;
    callback passed(int, bool);
    callback jump(length);
    property <bool> past: root.start && root.top <= root.scroll + Shell.settings-spy;
    changed past => {
        root.passed(root.index, self.past);
    }
    changed goto-serial => {
        if root.start && root.goto-index == root.index {
            root.jump(root.top);
        }
    }
    VerticalLayout {
        padding-bottom: root.below;
        @children
    }
}

// The frame the other native pages share: the page's colour, one scroller, a centred column
// `Shell.settings-width` wide with the page's title and search capsule on top and the page's
// rows (`@children`) under them. `open` shows it; `query-changed` is the search box.
export component PageFrame inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> placeholder: "Search";
    // Without a search box (the downloads page).
    in property <bool> searchable: true;
    callback query-changed(string);

    public function take-focus() {
        search.take-focus();
    }
    // Back to the top: a new query or a page switch starts there.
    public function scroll-to-top() {
        page.reset();
    }

    visible: root.open;

    page := PageScroller {
        open: root.open;
        HorizontalLayout {
            alignment: center;
            padding-top: Shell.settings-top;
            padding-bottom: Shell.settings-bottom;
            VerticalLayout {
                width: min(Shell.settings-width, root.width - 2 * Shell.settings-pad-max);
                spacing: 0px;

                HorizontalLayout {
                    spacing: SettingsLayout.title-gap;
                    padding-bottom: Shell.settings-title-below;
                    PageTitle {
                        text: root.title;
                        narrow: root.width <= SettingsLayout.narrow;
                    }
                    search := Field {
                        horizontal-stretch: 1;
                        capsule: true;
                        visible: root.searchable;
                        max-width: root.searchable ? Shell.settings-width : 0px;
                        placeholder: root.placeholder;
                        edited(q) => {
                            page.reset();
                            root.query-changed(q);
                        }
                    }
                }
                @children
            }
        }
    }
}

// A section's icon in the list (settings.tsx SECTIONS), by the section's title.
global SectionIcons {
    public pure function of(title: string) -> string {
        if title == "General" { return Glyph.globe; }
        if title == "Privacy" { return Glyph.shield; }
        if title == "Appearance" { return Glyph.palette; }
        if title == "Performance" { return Glyph.gauge; }
        return Glyph.globe;
    }
}

// The settings page: the pinned column beside the sections (.st-grid).
export component SettingsPage inherits Rectangle {
    in property <bool> open;
    // the Space colour: toggles, the slider's fill, the current section's icon
    in property <color> accent: SettingsLayout.accent;
    // the generated rows, flat: each section's first row names it
    in property <[SettingItem]> rows;
    in property <[BindingItem]> bindings;
    in property <CaptureView> capture;
    in property <[SpaceSetting]> spaces;
    // the Sites lists: each line and what removing it names (a host, a decision's index)
    in property <[EntryItem]> site-zoom;
    in property <[EntryItem]> site-permissions;
    // the Filter lists section: every list, and whether one is rebuilding or downloading
    in property <[FilterListItem]> filter-lists;
    in property <bool> filter-busy;
    in property <AboutView> about;
    // the search box has text: only the matching rows show, the other sections are left out
    in property <bool> searching;
    callback query-changed(string);
    callback setting-changed(string, string);
    callback setting-reset(string);
    callback entry-removed(string, string);
    callback entry-added(string, string);
    callback binding-record(string);
    callback binding-reset(string);
    callback capture-confirm();
    callback capture-cancel();
    callback space-renamed(int, string);
    callback space-tinted(int, color);
    callback space-icon-chosen(int, string);
    callback site-zoom-removed(string);
    callback site-permission-removed(string);
    callback filter-list-toggled(string, bool);
    callback filter-lists-update();

    public function take-focus() {
        search.take-focus();
    }
    public function scroll-to-top() {
        page.reset();
        root.tracked = 0;
    }

    visible: root.open;

    // a click on a Space's tile picks the next of the three icons
    pure function next-icon(icon: string) -> string {
        return icon == "personal" ? "work" : icon == "work" ? "study" : "personal";
    }
    property <bool> notices-open: false;

    // .st-grid, centred, at most `settings-max` wide with its padding inside
    property <length> pad-x: max(Shell.settings-pad-min, min(Shell.settings-pad-max, root.width * Shell.settings-pad-share));
    property <length> grid-x: (root.width - min(Shell.settings-max, root.width)) / 2 + root.pad-x;
    property <length> grid-w: min(Shell.settings-max, root.width) - 2 * root.pad-x;
    property <length> main-x: root.grid-x + Shell.settings-side + Shell.settings-gap;
    property <length> main-top: Shell.settings-top + Shell.section-top;

    // The sections: the table's (`section-index` 0..n), then shortcuts, Spaces, sites, about.
    property <int> table: root.rows.length > 0 ? root.rows[root.rows.length - 1].section-index + 1 : 0;
    property <int> shortcuts: root.table;
    property <int> spaces-at: root.table + 1;
    property <int> sites-at: root.table + 2;
    property <int> lists-at: root.table + 3;
    property <int> about-at: root.table + 4;
    property <int> last: root.searching ? (root.bindings.length > 0 ? root.shortcuts : root.table - 1) : root.about-at;
    property <int> matches: root.rows.length + root.bindings.length;
    // the section the reader is in: the last one past the tracking line, the last at the end,
    // or the one picked in the list until the page is scrolled by hand
    property <int> tracked: 0;
    property <int> picked: -1;
    property <int> goto-index: -1;
    property <int> goto-serial: 0;
    property <bool> at-end: page.room > 0px && page.scroll >= page.room - Shell.settings-end-slack;
    out property <int> current: root.picked >= 0 ? root.picked : root.at-end ? root.last : root.tracked;
    property <length> pitch: Shell.nav-row + Shell.nav-row-gap;

    function pick(index: int) {
        root.picked = index;
        root.goto-index = index;
        root.goto-serial += 1;
    }
    function passed(index: int, past: bool) {
        root.tracked = past ? max(root.tracked, index) : max(0, min(root.tracked, index - 1));
    }
    function jump(top: length) {
        page.to(top - Shell.settings-pin);
    }
    function search-for(q: string) {
        page.reset();
        root.tracked = 0;
        root.picked = -1;
        root.query-changed(q);
    }

    page := PageScroller {
        open: root.open;
        wheeled => {
            root.picked = -1;
        }
        HorizontalLayout {
            padding-left: root.main-x;
            padding-right: root.width - root.grid-x - root.grid-w;
            padding-top: root.main-top;
            padding-bottom: Shell.settings-bottom;

            VerticalLayout {
                spacing: 0px;

                // A flat list (rows keep their instance across a re-render); each section's
                // first row carries its heading, each row draws its slice of the section's card.
                // A row with a Select sits over the rows after it, so its menu hangs over them.
                for row in root.rows: setting-row := Section {
                    index: row.section-index;
                    start: row.first;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: row.last ? Shell.section-below : 0px;
                    z: row.options.length > 0 ? 1 : 0;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    if row.first: SectionHead {
                        text: row.section;
                    }
                    CardSlice {
                        first: row.first;
                        last: row.last;
                        SettingRow {
                            setting: row;
                            accent: root.accent;
                            view-top: page.absolute-position.y;
                            view-bottom: page.absolute-position.y + page.height;
                            changed(k, v) => {
                                root.setting-changed(k, v);
                            }
                            reset(k) => {
                                root.setting-reset(k);
                            }
                            entry-removed(k, e) => {
                                root.entry-removed(k, e);
                            }
                            entry-added(k, e) => {
                                root.entry-added(k, e);
                            }
                        }
                    }
                }

                if root.bindings.length > 0: Section {
                    index: root.shortcuts;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Keyboard shortcuts";
                    }
                    Card {
                        for b in root.bindings: BindingRow {
                            item: b;
                            capture: root.capture;
                            record(a) => {
                                root.binding-record(a);
                            }
                            reset(a) => {
                                root.binding-reset(a);
                            }
                            confirm => {
                                root.capture-confirm();
                            }
                            cancel => {
                                root.capture-cancel();
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.spaces-at;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Spaces";
                    }
                    Card {
                        // a Space's row: its icon on a tile (a click picks the next icon), its
                        // name (typed, Enter renames), its colours
                        for space in root.spaces: Row {
                            Lead {
                                icon-path: Glyph.space(space.icon);
                                tint: space.tint;
                                label: space.name + " icon";
                                clicked => {
                                    root.space-icon-chosen(space.id, root.next-icon(space.icon));
                                }
                            }
                            RowNameText {
                                name: space.name;
                                label: "Space name";
                                note: "Its colour tints the window's glass and the backdrop.";
                                renamed(n) => {
                                    root.space-renamed(space.id, n);
                                }
                            }
                            RowControls {
                                Swatches {
                                    colours: SpaceColours.all;
                                    value: space.tint;
                                    label: space.name + " colour";
                                    chosen(c) => {
                                        root.space-tinted(space.id, c);
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.sites-at;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Sites";
                    }
                    Card {
                        Row {
                            RowText {
                                title: "Zoom levels";
                            }
                        }
                        HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            EntryList {
                                entries: root.site-zoom;
                                empty: "No site has its own zoom";
                                removed(k) => {
                                    root.site-zoom-removed(k);
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Permissions";
                            }
                        }
                        HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            EntryList {
                                entries: root.site-permissions;
                                empty: "No site has a remembered permission";
                                removed(k) => {
                                    root.site-permission-removed(k);
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.lists-at;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    below: Shell.section-below;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "Filter lists";
                    }
                    Card {
                        Row {
                            RowText {
                                title: root.filter-busy ? "Working on the filter lists" : "Update the lists";
                                note: "Downloads every list switched on. Lists are only fetched when you ask or when they are kept up to date.";
                            }
                            RowControls {
                                Button {
                                    text: "Update now";
                                    enabled: !root.filter-busy;
                                    clicked => {
                                        root.filter-lists-update();
                                    }
                                }
                            }
                        }
                        for list in root.filter-lists: Row {
                            tap: !list.custom;
                            tapped => {
                                root.filter-list-toggled(list.id, !list.enabled);
                            }
                            RowText {
                                title: list.title;
                                note: list.note;
                            }
                            RowControls {
                                if list.custom: IconButton {
                                    icon-path: Glyph.close;
                                    label: "Remove";
                                    clicked => {
                                        root.entry-removed("blocker.custom_lists", list.key);
                                    }
                                }
                                if !list.custom: Toggle {
                                    size: ToggleSize.sm;
                                    on: list.enabled;
                                    accent: root.accent;
                                    label: list.title;
                                    toggled => {
                                        root.filter-list-toggled(list.id, !list.enabled);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-top: Shell.row-pad-y;
                            padding-bottom: Shell.row-pad-y;
                            Field {
                                placeholder: "Add a list by its https:// address";
                                accepted(t) => {
                                    if t != "" {
                                        root.entry-added("blocker.custom_lists", t);
                                    }
                                    self.text = "";
                                }
                            }
                        }
                    }
                }

                if !root.searching: Section {
                    index: root.about-at;
                    top: self.y + root.main-top;
                    scroll: page.scroll;
                    goto-serial: root.goto-serial;
                    goto-index: root.goto-index;
                    passed(i, p) => {
                        root.passed(i, p);
                    }
                    jump(t) => {
                        root.jump(t);
                    }
                    SectionHead {
                        text: "About";
                    }
                    Card {
                        Row {
                            RowText {
                                title: "wubble " + root.about.version;
                                note: "Chromium " + root.about.chromium + " (CEF " + root.about.cef + ")";
                            }
                            RowControls {
                                Mark {
                                    size: Shell.about-mark;
                                }
                            }
                        }
                        Row {
                            RowText {
                                title: "Licence";
                                note: root.about.licence;
                            }
                            RowControls {
                                Button {
                                    text: root.notices-open ? "Hide notices" : "Third-party notices";
                                    clicked => {
                                        root.notices-open = !root.notices-open;
                                    }
                                }
                            }
                        }
                        if root.notices-open: HorizontalLayout {
                            padding-left: Shell.row-pad-x;
                            padding-right: Shell.row-pad-x;
                            padding-bottom: Shell.row-pad-y;
                            MonoNote {
                                text: root.about.notices;
                            }
                        }
                    }
                }

                // `.st-empty`: the search left nothing
                Fold {
                    open: root.searching && root.matches == 0;
                    content-height: empty.preferred-height;
                    empty := NothingMatches {
                        text: "Nothing matches “" + search.text + "”.";
                        Button {
                            kind: ButtonKind.ghost;
                            text: "Clear search";
                            clicked => {
                                search.text = "";
                                root.search-for("");
                                search.take-focus();
                            }
                        }
                    }
                }
            }
        }
    }

    // .st-pin: the title, the search, the count and the section list, held 24 below the top
    // once the page scrolls; the wheel over it scrolls the page.
    side := TouchArea {
        x: root.grid-x;
        y: max(Shell.settings-pin, Shell.settings-top - page.scroll);
        width: Shell.settings-side;
        height: pin.preferred-height;
        scroll-event(e) => {
            page.wheel(-e.delta-y);
            accept
        }
        pin := VerticalLayout {
            spacing: 0px;
            alignment: start;
            HorizontalLayout {
                padding-left: Shell.settings-title-in;
                padding-bottom: Shell.settings-title-below;
                PageTitle {
                    text: "Settings";
                    narrow: root.width <= SettingsLayout.narrow;
                }
            }
            search := Field {
                capsule: true;
                placeholder: "Search settings";
                edited(q) => {
                    root.search-for(q);
                }
            }
            // .st-count: how many rows the search leaves
            HorizontalLayout {
                padding-top: Shell.count-above;
                padding-bottom: Shell.count-below;
                padding-left: Shell.count-in;
                SearchCount {
                    text: !root.searching ? "" : root.matches == 0 ? "No matches" : root.matches == 1 ? "1 setting" : root.matches + " settings";
                }
            }
            // .st-nav: the table's sections (one per first row), then the page's own
            nav := Rectangle {
                height: (root.about-at + 1) * root.pitch - Shell.nav-row-gap;
                // made as the page opens (its spring's slot needs the wired `Controls`)
                if root.open: NavIndicator {
                    y: 0px;
                    index: root.current;
                }
                VerticalLayout {
                    alignment: start;
                    for row in root.rows: Rectangle {
                        height: row.first ? root.pitch : 0px;
                        visible: row.first;
                        NavRow {
                            y: 0px;
                            title: row.section;
                            icon-path: SectionIcons.of(row.section);
                            on: root.current == row.section-index;
                            accent: root.accent;
                            picked => {
                                root.pick(row.section-index);
                            }
                        }
                    }
                    for extra[i] in [
                        { title: "Keyboard shortcuts", icon: Glyph.keyboard, shown: root.bindings.length > 0 },
                        { title: "Spaces", icon: Glyph.stack, shown: !root.searching },
                        { title: "Sites", icon: Glyph.lock, shown: !root.searching },
                        { title: "Filter lists", icon: Glyph.shield, shown: !root.searching },
                        { title: "About", icon: Glyph.bubble, shown: !root.searching },
                    ]: Rectangle {
                        height: root.pitch;
                        NavRow {
                            y: 0px;
                            title: extra.title;
                            icon-path: extra.icon;
                            enabled: extra.shown;
                            on: root.current == root.table + i;
                            accent: root.accent;
                            picked => {
                                root.pick(root.table + i);
                            }
                        }
                    }
                }
            }
        }
    }
}

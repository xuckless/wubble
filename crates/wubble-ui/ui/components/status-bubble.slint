import { AStatusBubble } from "../kit/overlay/a/a-status-bubble.slint";

// The hovered link's URL at the page pane's bottom-left (Chromium's status bubble), one per
// pane. Derived from the kit (docs/fidelity/wubble-only.md; the design has no status bubble):
// the Status bubble (kit/overlay/a/a-status-bubble.slint), a thin glass capsule with the address
// pill's text and the tooltip's motion. Its timing is Chromium's `status_bubble_views.cc`
// (BSD-3-Clause; numbers only): the host shows it 80 ms after a link is hovered and hides it
// 250 ms after the pointer left the link (`wubble_core::hovercard::STATUS_BUBBLE`). It shows the
// host as the address pill does, the rest already cut in the middle by the host
// (`wubble_core::url::status_parts`). Pointer events pass through to the page.
//
// When the pointer comes near it (Chromium's 20 px `kMousePadding`) it moves to the pane's
// right edge, as Firefox's `statuspanel[mirror]` does (Chromium slides it down instead); the
// parent says so through `mirrored`, from the pointer it already tracks. Its inputs are the
// kit body's: `shown`, `host`, `rest`, `mirrored`, `pane-width`, `pane-height`.
export component StatusBubble inherits AStatusBubble { }

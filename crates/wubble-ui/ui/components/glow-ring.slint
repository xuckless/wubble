// The glowing border: the film ring (GlassPanel's touch rim, the sky-lilac-blush-mint gradient)
// at `strength`, steady: the peeking sidebar's touched rim. Put it over a glass panel; `strength`
// 0 draws nothing. (The address pill's moving beam is BorderBeam.)

import { Palette } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";

export component GlowRing inherits Rectangle {
    in property <length> radius;
    // 0..1: the ring's opacity
    in property <float> strength: 0;

    if root.strength > 0: Rectangle {
        border-radius: root.radius;
        border-width: Shell.glow-width;
        border-color: @linear-gradient(120deg, Palette.sky 0%, Palette.lilac 33%, Palette.blush 66%, Palette.mint 100%);
        opacity: root.strength;
    }
}

// The film rim of a control drawn on content (toggle, slider knob, stretch button): the same
// ring, shown only while touched (hover, press, drag or focus; `wubble_core::controls::rim_on`),
// never at rest, fading in over 200 ms and out over 150 ms as GlassPanel's rim does (the design's
// `.wb-film`). Slint has no conic gradient: the ring is the linear sweep, as in GlassPanel.
export component FilmRim inherits GlowRing {
    in property <bool> touched;
    strength: root.touched ? 0.8 : 0;
    animate strength {
        duration: root.touched ? Shell.film-in : Shell.film-out;
    }
}

// The window controls: close, minimise, full screen. Ported from the design repo's
// src/wubble/browser/chrome.tsx `Lights` and browser.css `.wb-light` (owner's own code,
// xuckless/the-wallpaper-project @ 6c840da): 12 px circles, gap 8 (6 on the rail), 18 % white at
// rest, coral / amber / mint while the group is hovered, pressed squashed .8 x 1.15. The glyph
// shows at rest in ink, as the owner's screenshot of @ 21838b8 has it (notes/ref-settings.png:
// ink glyphs in the 18 % dots), and turns dark over the colour.
// The component only reports intent; wubble_ui::window acts on it.

import { Palette, Motion } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { Icon, IconPaths } from "icon.slint";

component Light inherits Rectangle {
    in property <color> tint;
    in property <string> icon-path;
    in property <bool> group-hover;
    in property <float> icon-weight: 2.4;
    in property <string> label;
    callback clicked();
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    width: Shell.light;
    height: Shell.light;
    border-radius: Shell.light / 2;
    background: root.group-hover ? root.tint : Shell.light-rest;
    animate background {
        duration: Shell.light-fill-ms;
        easing: Motion.easeOut;
    }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: ta.pressed ? Shell.light-press-x : 1;
    transform-scale-y: ta.pressed ? Shell.light-press-y : 1;
    animate transform-scale-x, transform-scale-y {
        duration: ta.pressed ? Motion.pressMs : Motion.pressRelease;
        easing: Motion.easeSpring;
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        path: root.icon-path;
        size: Shell.light-glyph;
        weight: root.icon-weight;
        tint: root.group-hover ? Shell.light-glyph-ink : Palette.ink;
        animate tint {
            duration: Shell.light-glyph-ms;
            easing: Motion.easeOut;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component WindowLights inherits Rectangle {
    in property <bool> compact: false;
    callback close-requested();
    callback minimise-requested();
    callback toggle-fullscreen-requested();

    width: Shell.light * 3 + (root.compact ? Shell.light-gap-rail : Shell.light-gap) * 2;
    height: Shell.light;

    // The group's hover: it stays true while the pointer is over a light.
    group := TouchArea {
        HorizontalLayout {
            spacing: root.compact ? Shell.light-gap-rail : Shell.light-gap;
            Light {
                tint: Palette.coral;
                icon-path: IconPaths.close;
                label: "Close window";
                group-hover: group.has-hover;
                clicked => {
                    root.close-requested();
                }
            }
            Light {
                tint: Palette.amber;
                icon-path: IconPaths.minus;
                label: "Minimise";
                group-hover: group.has-hover;
                clicked => {
                    root.minimise-requested();
                }
            }
            Light {
                tint: Palette.mint;
                icon-path: IconPaths.expand;
                label: "Full screen";
                icon-weight: 2.2;
                group-hover: group.has-hover;
                clicked => {
                    root.toggle-fullscreen-requested();
                }
            }
        }
    }
}

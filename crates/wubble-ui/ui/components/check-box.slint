import { Palette, Motion, Spacing, Fonts, Type, Radius } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";

// A check box and its label, one target. Mint when checked, the tick drawn over it. Its motion
// is the design's checkbox (pages/touch.tsx `Checks`, touch.css `.tp-ck`, the owner's design
// repo): the fill is a circle growing out of the box's centre (240 ms ease-out; out 190 ms
// in-out), the tick lands 70 ms behind it and leaves first, and pressing squeezes the box
// (1.12 × 0.9 over 120 ms, back over 200 ms).
export component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;

    height: Spacing.s4 + Spacing.s2;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
    Rectangle {
        x: 0px;
        width: Spacing.s4;
        height: Spacing.s4;
        border-radius: Radius.xs / 2;
        border-width: Shell.check-rim;
        border-color: root.checked ? Palette.mint : Palette.haze;
        animate border-color {
            duration: Shell.menu-hover-ms;
            easing: Motion.easeOut;
        }
        clip: true;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: ta.pressed ? 1.12 : 1;
        transform-scale-y: ta.pressed ? 0.9 : 1;
        animate transform-scale-x, transform-scale-y {
            duration: ta.pressed ? Motion.pressMs : Motion.pressRelease;
            easing: Motion.easeOut;
        }
        // clip-path: circle(0 → 75%) at the centre
        Rectangle {
            property <length> d: root.checked ? parent.width * 1.5 : 0px;
            animate d {
                duration: root.checked ? Motion.overlapIn : Motion.overlapOut;
                easing: root.checked ? Motion.easeOut : Motion.easeInOut;
            }
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: Palette.mint;
        }
        Path {
            opacity: root.checked ? 1 : 0;
            animate opacity {
                delay: root.checked ? Shell.check-tick-delay : 0ms;
                duration: root.checked ? Motion.overlapIn : Shell.check-tick-out;
                easing: Motion.easeOut;
            }
            width: 100%;
            height: 100%;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M4 8.5l3 3 5-6";
            stroke: Palette.abyss;
            stroke-width: Shell.check-tick;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }
    Text {
        x: Spacing.s4 + Spacing.s2;
        width: parent.width - self.x;
        text: root.text;
        color: Palette.mist;
        font-family: Fonts.ui;
        font-size: Type.label.size;
        font-weight: Type.label.weight;
        vertical-alignment: center;
    }
}

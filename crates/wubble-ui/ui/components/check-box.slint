import { Palette, Motion, Space, Fonts, Type, Radius } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { Keys } from "../kit/motion/keys.slint";
import { Calm } from "../kit/motion/calm.slint";
import { Icon, Glyph } from "../kit/controls/icon.slint";

// A check box and its label, one target. Mint when checked, the tick drawn over it. Its motion
// is the design's checkbox (pages/touch.tsx `Checks`, touch.css `.tp-ck`, the owner's design
// repo): the fill is a circle growing out of the box's centre (240 ms ease-out; out 190 ms
// in-out), the tick lands 70 ms behind it and leaves first, and pressing squeezes the box
// (1.12 × 0.9 over 120 ms, back over 200 ms); the box squashes as it fills (the squash token).
export component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;

    height: Space.s4 + Space.s2;

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
    sq := Keys {}
    changed checked => {
        if root.checked {
            sq.hit = !sq.hit;
        }
    }
    Rectangle {
        x: 0px;
        width: Space.s4;
        height: Space.s4;
        border-radius: Radius.xs / 2;
        border-width: Shell.check-rim;
        border-color: root.checked ? Palette.mint : Palette.haze;
        clip: true;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // pressing squeezes; filling squashes (the squash token, keys.slint)
        property <float> px: ta.pressed ? 1.12 : 1;
        property <float> py: ta.pressed ? 0.9 : 1;
        animate px, py {
            duration: Calm.ms(ta.pressed ? Motion.press-in : Motion.press-out);
            easing: Motion.ease-out;
        }
        transform-scale-x: self.px * sq.sx;
        transform-scale-y: self.py * sq.sy;
        // clip-path: circle(0 → 75%) at the centre
        Rectangle {
            property <length> d: root.checked ? parent.width * 1.5 : 0px;
            animate d {
                duration: Calm.ms(root.checked ? Motion.overlap-in : Motion.overlap-out);
                easing: root.checked ? Motion.ease-out : Motion.ease-in-out;
            }
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: Palette.mint;
        }
        Icon {
            opacity: root.checked ? 1 : 0;
            animate opacity {
                delay: root.checked ? Shell.check-tick-delay : 0ms;
                duration: Calm.ms(root.checked ? Motion.overlap-in : Shell.check-tick-out);
                easing: Motion.ease-out;
            }
            size: parent.width;
            path: Glyph.check;
            weight: Shell.check-tick / self.size * Shell.icon-grid; // the derived px stroke in grid units
            tint: Palette.abyss;
        }
    }
    Text {
        x: Space.s4 + Space.s2;
        width: parent.width - self.x;
        text: root.text;
        color: Palette.mist;
        font-family: Fonts.ui;
        font-size: Type.label.size;
        font-weight: Type.label.weight;
        vertical-alignment: center;
    }
}

import { Shell } from "../kit/derived.slint";
import { GlassKeys, GlassOver } from "model.slint";
import { AToast } from "../kit/overlay/a/a-toast.slint";

// A brief notice: the zoom level after Ctrl +/-/0, "Press Esc to exit full screen". One
// component for both. Derived from the kit (docs/fidelity/wubble-only.md; the design has no
// toast): the Toast (kit/overlay/a/a-toast.slint), a thick glass capsule arriving and leaving by
// Overlap. The host shows it (`shown`) and times it: `wubble_core::overlay::TOAST_SHOWN_MS`, a
// later notice restarting the time. Pointer events pass through to the page.
//
// With an `action` (SponsorBlock's "Skipped sponsor: Undo", its one-time "Turn on" question) the
// notice carries a button, stays a while longer, and takes the pointer over itself only. A
// `sticky` one stays until answered or closed (its close button); the host takes any away.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    in property <string> action;
    in property <bool> sticky;
    callback acted();
    callback closed();
    // Drawn: shown, or leaving (the kit's exit).
    out property <bool> mounted: body.visible;

    // Sized to the text, up to the widest a notice grows (and the room it is given).
    in property <length> widest: Shell.toast-max-width;
    width: body.width;
    height: body.height;

    body := AToast {
        shown: root.shown;
        text: root.text;
        action: root.action;
        sticky: root.sticky;
        widest: root.widest;
        // the scene draws its glass above the page (GlassPanel `over-layer`)
        key: GlassKeys.toast;
        layer: GlassOver.card;
        acted => {
            root.acted();
        }
        closed => {
            root.closed();
        }
    }
}

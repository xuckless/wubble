import { Spacing, Motion } from "../tokens.slint";
import { Shell } from "../kit/derived.slint";
import { GlassPanel } from "../kit/material/glass.slint";
import { GlassTier } from "model.slint";
import { IconButton } from "nav-buttons.slint";
import { IconPaths } from "icon.slint";
import { MoveArea } from "window-frame.slint";

// The picture-in-picture window's controls (wubble_core::pip): a strip at the window's foot while
// the pointer is over the window, with play or pause, back and forward ten seconds, return to the
// tab and close. Written from scratch: the design repo has no picture-in-picture (checked
// src/wubble and src/wubble/slint). Built from the video controls' parts (video-controls.slint:
// the thick glass strip, the sidebar's icon buttons). The rest of the window moves it (the
// window has no frame); a double-click returns to the tab. The buttons answer while the strip is
// faded too: a screen reader has no hover, and a pointer shows the strip before it can click. Intents only: `command(name, value)`
// with name play, seek-by (value: seconds), return, close.
export component PipControls inherits Rectangle {
    // (element ids the tests find: root, strip)
    in property <bool> paused;
    callback command(string, float);
    callback begin-move();

    area := MoveArea {
        begin-move => {
            root.begin-move();
        }
        toggle-maximise => {
            root.command("return", 0);
        }

        // Inside the area, so the area keeps its hover while the pointer is on a button.
        strip := GlassPanel {
            property <bool> open: area.has-hover;
            tier: GlassTier.thick;
            radius: Shell.menu-radius;
            over-content: true;
            width: min(row.preferred-width, root.width - 2 * Spacing.s2);
            height: Shell.icon-button + 2 * Spacing.s1;
            x: (root.width - self.width) / 2;
            y: root.height - self.height - Spacing.s2 + (self.open ? 0px : Shell.toast-rise);
            opacity: self.open ? 1 : 0;
            animate opacity, y {
                duration: self.open ? Motion.overlapIn : Motion.overlapOut;
                easing: self.open ? Motion.easeOut : Motion.easeIn;
            }
            row := HorizontalLayout {
                padding: Spacing.s1;
                spacing: Spacing.s1;
                IconButton {
                    icon-path: IconPaths.back;
                    label: "Back 10 seconds";
                    clicked => {
                        root.command("seek-by", -10);
                    }
                }
                IconButton {
                    icon-path: root.paused ? IconPaths.play : IconPaths.pause;
                    label: root.paused ? "Play" : "Pause";
                    clicked => {
                        root.command("play", 0);
                    }
                }
                IconButton {
                    icon-path: IconPaths.forward;
                    label: "Forward 10 seconds";
                    clicked => {
                        root.command("seek-by", 10);
                    }
                }
                IconButton {
                    icon-path: IconPaths.pip-return;
                    label: "Back to tab";
                    clicked => {
                        root.command("return", 0);
                    }
                }
                IconButton {
                    icon-path: IconPaths.close;
                    label: "Close picture-in-picture";
                    clicked => {
                        root.command("close", 0);
                    }
                }
            }
        }
    }
}

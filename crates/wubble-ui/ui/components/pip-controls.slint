import { Space } from "../kit/gen/tokens.slint";
import { GlassKeys, GlassOver } from "model.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { MoveArea } from "window-frame.slint";
import { BDock } from "../kit/overlay/b/b-dock.slint";

// The picture-in-picture window's controls (wubble_core::pip): a strip at the window's foot while
// the pointer is over the window, with play or pause, back and forward ten seconds, return to the
// tab and close. The design has no picture-in-picture (wubble-only.md §28): the strip is the
// video strip's Dock (kit/overlay/b/b-dock.slint). The rest of the window moves it (the window
// has no frame); a double-click returns to the tab. The buttons answer while the strip is faded
// too: a screen reader has no hover, and a pointer shows the strip before it can click. Intents
// only: `command(name, value)` with name play, seek-by (value: seconds), return, close.
export component PipControls inherits Rectangle {
    // (element ids the tests find: root, strip)
    in property <bool> paused;
    callback command(string, float);
    callback begin-move();

    area := MoveArea {
        begin-move => {
            root.begin-move();
        }
        toggle-maximise => {
            root.command("return", 0);
        }

        // Inside the area, so the area keeps its hover while the pointer is on a button.
        strip := BDock {
            key: GlassKeys.pip-strip;
            layer: GlassOver.card;
            shown: area.has-hover;
            reachable-hidden: true;
            width: min(self.row-width, root.width - 2 * Space.s2);
            x: (root.width - self.width) / 2;
            y: root.height - self.height - Space.s2;
            IconButton {
                icon-path: Glyph.back;
                label: "Back 10 seconds";
                clicked => {
                    root.command("seek-by", -10);
                }
            }
            IconButton {
                icon-path: root.paused ? Glyph.play : Glyph.pause;
                label: root.paused ? "Play" : "Pause";
                clicked => {
                    root.command("play", 0);
                }
            }
            IconButton {
                icon-path: Glyph.forward;
                label: "Forward 10 seconds";
                clicked => {
                    root.command("seek-by", 10);
                }
            }
            IconButton {
                icon-path: Glyph.pip-return;
                label: "Back to tab";
                clicked => {
                    root.command("return", 0);
                }
            }
            IconButton {
                icon-path: Glyph.close;
                label: "Close picture-in-picture";
                clicked => {
                    root.command("close", 0);
                }
            }
        }
    }
}

import { BSwipeChip } from "../kit/overlay/b/b-swipe-chip.slint";

// The touchpad history swipe's indicator: the back (left edge) or forward (right edge) arrow on
// the start page's round tile, pulled in from the edge as the fingers travel (`shift`,
// rubber-banded by the host with the design's band, motion.rs); its film rim lights once a
// release goes there. The design has no swipe indicator (wubble-only.md §22):
// kit/overlay/b/b-swipe-chip.slint.
export component SwipeChip inherits Rectangle {
    // -1..1: forward (negative) or back; 0: hidden.
    in property <float> progress;
    in property <length> shift;

    property <bool> back: root.progress > 0;

    chip := BSwipeChip {
        back: root.back;
        ready: abs(root.progress) >= 1;
        shown: min(1, abs(root.progress) * 2);
        x: root.back ? root.shift - self.width : root.width - root.shift;
        y: (root.height - self.height) / 2;
    }
}

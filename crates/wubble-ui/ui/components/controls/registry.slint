// The component sheet's physics lives in Rust (`wubble_core::controls`, stepped by
// `wubble-ui/src/controls.rs`): Slint `animate` has no springs. Each control instance takes a
// slot on `init` and draws `Controls.views[slot]`; its pointer events go back as intents. Slint
// has no "destroyed" callback, so live instances answer every `generation` bump with `alive`
// and the registry frees the slots nobody answered for (the GlassLayer sweep, glass.rs).
// The kit menu (kit/controls/menu.slint) keeps its lifecycle, highlight and keys here too
// (`wubble_core::controls::menu`): its events return the owner's intents as a `MenuEffect`.

import { MenuEntry } from "../model.slint";

// What a menu event asks of the menu's owner (`wubble_core::controls::menu::Effect`).
export struct MenuEffect {
    // the row chosen plus one, 0 for none: the zero value (an unhandled `menu-event` returns
    // it) chooses nothing
    pick: int,
    // close the menu; `refocus`: give the keyboard back to the trigger
    dismiss: bool,
    refocus: bool,
}

export struct ControlView {
    // Along the travel, px of the design's control (the Rust machine's units). The segmented
    // control's indicator: its left.
    x: float,
    // The segmented control's indicator width, px (0 for the others).
    w: float,
    scale-x: float,
    scale-y: float,
    // Transform origin across the knob, 0 (left) .. 1 (right).
    origin: float,
    // The toggle's accent bloom, 0..1.
    fill: float,
    // The slider's value shown, 0..100; the segment chosen; the hold button's fill, 0..1.
    value: float,
    held: bool,
    // The menu (kind 3): the lit row (-1 none), whether the highlight appears in place, the
    // focused row and the row the trigger confirms (`done`, -1 none). The highlight's row (the
    // lit one, else the first, `max(0, i)` of the TS) has `hl-rows` rows and `hl-rules`
    // separators above it.
    hl: int,
    hl-rows: int,
    hl-rules: int,
    jump: bool,
    focus: int,
    // The toggle's wall squash (its second transform, about its own origin: 0 left .. 1 right
    // of the knob); 1, 1 and 0.5 for the others.
    squash-x: float,
    squash-y: float,
    origin2: float,
    // The phase, by kind. Menu: 0 closed, 1 open, 2 closing. Hold button: 0 idle, 1 held,
    // 2 done. Confirm button: 0 idle, 1 busy, 2 done.
    phase: int,
    // Counts the pulses (hold: done; confirm: done), so a control replays it on each change.
    hit: int,
    // Counts the hold button's completions (`Effect::Done`): it runs `done` on each change.
    dones: int,
    // The menu: the row the trigger confirms (-1 none).
    done: int,
}

export global Controls {
    in property <[ControlView]> views;
    in property <int> generation;
    // kind: 0 toggle (value 0/1), 1 slider (value 0..100), 2 segmented (value the segment),
    // 3 menu, 4 hold button (value 1: disabled), 5 confirm button (value: its busy time, ms).
    // Returns the slot.
    callback acquire(int, float) -> int;
    // The setting changed from outside: the control springs to it (hold: disabled 1/0).
    callback set-value(int, float);
    // The slider's and the toggle's travel, px.
    callback resize(int, length);
    // The segmented control's segment `i` laid out at (left, width), px.
    callback segment(int, int, length, length);
    // Pointer along the travel, px; `t` the time base the toggle measures its fling with.
    // Hold: press starts, release ends the hold. Confirm: press is the click. Returns whether
    // the control runs its action now (confirm: the machine's `Effect::Run`; the others: false).
    callback press(int, length) -> bool;
    callback drag(int, length);
    // The value it lands on (toggle 0/1, slider 0..100, segment index), or -1 when it was not
    // held (or, segmented, landed on no segment).
    callback release(int) -> float;
    callback alive(int);
    // A menu event: (slot, kind, arg, row count, rows). Kinds: 0 opened by pointer, 1 opened by
    // key (arg: the row to focus, -1 the first), 2 closed, 3 pointer on row arg, 4 pointer left,
    // 5 key arg (0 up, 1 down, 2 escape, 3 tab, 4 enter or space), 6 row arg chosen, 7 pointer
    // pressed outside. Rows past the given entries are plain items.
    callback menu-event(int, int, int, int, [MenuEntry]) -> MenuEffect;

    public pure function view(slot: int) -> ControlView {
        return slot >= 0 && slot < root.views.length ? root.views[slot] : { scale-x: 1, scale-y: 1, origin: 0.5, hl: -1, jump: true, focus: -1, done: -1, squash-x: 1, squash-y: 1, origin2: 0.5 };
    }
}

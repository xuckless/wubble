// The component sheet's physics lives in Rust (`wubble_core::controls`, stepped by
// `wubble-ui/src/controls.rs`): Slint `animate` has no springs. Each control instance takes a
// slot on `init` and draws `Controls.views[slot]`; its pointer events go back as intents. Slint
// has no "destroyed" callback, so live instances answer every `generation` bump with `alive`
// and the registry frees the slots nobody answered for (the GlassLayer sweep, glass.rs).

export struct ControlView {
    // Along the travel, px of the design's control (the Rust machine's units). The segmented
    // control's indicator: its left.
    x: float,
    // The segmented control's indicator width, px (0 for the others).
    w: float,
    scale-x: float,
    scale-y: float,
    // Transform origin across the knob, 0 (left) .. 1 (right).
    origin: float,
    // The toggle's accent bloom, 0..1.
    fill: float,
    // The slider's value shown, 0..100; the segment chosen; the hold button's fill, 0..1.
    value: float,
    held: bool,
    // The toggle's wall squash (its second transform, about its own origin: 0 left .. 1 right
    // of the knob); 1, 1 and 0.5 for the others.
    squash-x: float,
    squash-y: float,
    origin2: float,
    // The hold button: 0 idle, 1 held, 2 done; the confirm button: 0 idle, 1 busy, 2 done.
    phase: int,
    // Counts the pulses (hold: done; confirm: done), so a control replays it on each change.
    hit: int,
}

export global Controls {
    in property <[ControlView]> views;
    in property <int> generation;
    // kind: 0 toggle (value 0/1), 1 slider (value 0..100), 2 segmented (value the segment),
    // 3 hold button (value 1: disabled), 4 confirm button (value: its busy time, ms). Returns the
    // slot.
    callback acquire(int, float) -> int;
    // The setting changed from outside: the control springs to it (hold: disabled 1/0).
    callback set-value(int, float);
    // The slider's and the toggle's travel, px.
    callback resize(int, length);
    // The segmented control's segment `i` laid out at (left, width), px.
    callback segment(int, int, length, length);
    // Pointer along the travel, px; `t` the time base the toggle measures its fling with.
    // Hold: press starts, release ends the hold. Confirm: press is the click.
    callback press(int, length);
    callback drag(int, length);
    // The value it lands on (toggle 0/1, slider 0..100, segment index), or -1 when it was not
    // held (or, segmented, landed on no segment).
    callback release(int) -> float;
    callback alive(int);

    public pure function view(slot: int) -> ControlView {
        return slot >= 0 && slot < root.views.length ? root.views[slot] : { scale-x: 1, scale-y: 1, origin: 0.5, squash-x: 1, squash-y: 1, origin2: 0.5 };
    }
}

// The settings row's slider (`.st-slider`): the kit's ElasticSlider (kit/controls/slider.slint)
// with the API its callers bind (`value` in `min`..`max`, `accent`, `set`). Every new value is
// `set` while held (the design's live `onChange`), at a hundredth of the range per step, as
// before.

import { ElasticSlider } from "../../kit/controls/slider.slint";

export component Slider inherits ElasticSlider {
    callback set(float);
    compact: true;
    max: 1;
    step: (root.max - root.min) / 100;
    edited(v) => {
        root.set(v);
    }
}

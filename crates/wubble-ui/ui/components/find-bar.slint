import { Shell } from "../kit/derived.slint";
import { FindView, GlassKeys, GlassOver } from "model.slint";
import { ACapsuleBar } from "../kit/overlay/a/a-capsule-bar.slint";

// Find in page: a capsule at the content's top right, as Chromium places its find bar. Derived
// from the kit (notes/fidelity/wubble-only.md): the Capsule bar (kit/overlay/a/a-capsule-bar.slint),
// the search capsule's thin glass and ring, the count in the number role, kit IconButtons.
// Enter steps to the next match, Shift+Enter to the previous, Escape closes (Chromium
// find_bar_view.cc, Firefox findbar.js behaviour).
export component FindBar inherits Rectangle {
    in property <FindView> find;
    callback edited(string);
    // true: next, false: previous.
    callback step(bool);
    callback closed();

    public function take-focus() {
        bar.take-focus();
    }

    // The exit is seen (Overlap: the old state shares the screen while it leaves).
    visible: bar.mounted;
    width: Shell.find-width;
    height: bar.height;

    bar := ACapsuleBar {
        open: root.find.open;
        // the scene draws its glass above the page (GlassPanel `over-layer`)
        key: GlassKeys.find;
        layer: GlassOver.card;
        query: root.find.query;
        counter: root.find.counter;
        // the host's counter for a query with no match (`surface.rs`)
        none: root.find.counter == "0 of 0";
        placeholder: "Find in page";
        edited(q) => {
            root.edited(q);
        }
        step(forward) => {
            root.step(forward);
        }
        closed => {
            root.closed();
        }
    }
}

import { Radius, Sizes, Type } from "../tokens.slint";
import { TabItem } from "model.slint";
import { RowBase } from "row-base.slint";
import { GlyphTile } from "glyph-tile.slint";

export component PinnedTile inherits RowBase {
    in property <TabItem> item;

    width: Sizes.pinned-tile;
    height: Sizes.pinned-tile;
    border-radius: Radius.md;

    GlyphTile {
        width: Sizes.pinned-glyph;
        height: Sizes.pinned-glyph;
        radius: Radius.sm;
        glyph-size: Type.body-lg;
        glyph: root.item.glyph;
        tint: root.item.tint;
    }
}

import { Space } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { VideoView, GlassKeys, GlassOver } from "model.slint";
import { IconButton } from "../kit/controls/icon-button.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { BDock, BDockTab, BDockText } from "../kit/overlay/b/b-dock.slint";
import { BScrubber } from "../kit/overlay/b/b-scrubber.slint";
import { BMenuPanel } from "../kit/overlay/b/b-popover.slint";
import { BChoiceList, BChoiceRow } from "../kit/overlay/b/b-sheet-parts.slint";

// Video controls over the page's main video (wubble_core::video): play, a scrubber with the
// SponsorBlock segments on it, speed, loop, picture-in-picture, a frame screenshot, mute and the
// media downloader's save. The design has no media controls (wubble-only.md §27): the strip is
// the touch Dock (kit/overlay/b/b-dock.slint: thin glass, kit IconButtons, `on` for loop and
// mute), the scrubber the kit ElasticSlider (b-scrubber.slint), the speed a value button whose
// menu is the kit Menu's body with the Select's checked rows (b-popover.slint).
// Only the strip and the speed menu take the pointer; the rest of the video stays the page's.
// The strip is a compact one in the video's top right corner, never across the bottom, where
// pages keep their own controls (YouTube's bar, `<video controls>`).
// Intents only: `command(name, value)` with name play, speeds, rate, loop, mute, seek, pip,
// frame, save, collapse, expand, peek, dismiss, hide-site (`value`: the rate, or the seek
// fraction). The strip's right end has a collapse chevron, which tucks the strip into a tab on
// the page's right edge (a click or a hover on the tab opens it again), and a close button
// (a click hides the strip until the next navigation, a right-click hides it on this site).
export component VideoControls inherits Rectangle {
    // (element ids the tests and `--smoke video` find: root, strip, tab, close, play, bar,
    // rate-button, loop, frame, mute, speed)
    in property <VideoView> video;
    // The speed menu's rows, slowest first (`wubble_core::video::RATES`).
    in property <[string]> rates;
    callback command(string, float);
    // The pointer is over the controls (they stay while it is).
    callback hovered(bool);
    // The pointer is on the strip, the tab or the speed menu: one answer for all three, so one
    // going away as another appears under the pointer does not read as leaving.
    property <bool> any-hover: dock.hovered || tab.hovered || speeds.hovered;
    // the strip's controls are built while it shows, and kept while it leaves
    property <bool> built: root.video.open || dock.progress > 0;
    changed any-hover => {
        root.hovered(self.any-hover);
    }

    x: root.video.x;
    y: root.video.y;
    width: root.video.w;
    height: root.video.h;
    visible: root.video.w > 0;

    // (the dock in a plain element: an element id on a component with children is not found)
    strip := Rectangle {
        width: max(0px, min(dock.row-width, root.width - 2 * Space.s2));
        height: dock.height;
        x: root.width - self.width - Space.s2;
        y: Space.s2;
        dock := BDock {
            width: parent.width;
            key: GlassKeys.video-strip;
            layer: GlassOver.card;
            shown: root.video.open && root.video.w > 0;
            interactive: root.video.open;
            // The strip's controls inside its touch area: a pointer on a button is still on the
            // strip (a sibling under the buttons lost its hover to each of them, and the strip went
            // while the pointer was on it).
            if root.built: play := IconButton {
                icon-path: root.video.paused ? Glyph.play : Glyph.pause;
                label: root.video.paused ? "Play" : "Pause";
                clicked => {
                    root.command("play", 0);
                }
            }
            if root.built: bar := BScrubber {
                progress: root.video.progress;
                marks: root.video.marks;
                horizontal-stretch: 1;
                seek(f) => {
                    root.command("seek", clamp(f, 0, 1));
                }
            }
            if root.built: rate-button := BDockText {
                value: root.video.rate;
                label: "Speed";
                clicked => {
                    root.command("speeds", 0);
                }
            }
            if root.built: loop := IconButton {
                icon-path: Glyph.loop;
                label: "Loop";
                on: root.video.looped;
                clicked => {
                    root.command("loop", 0);
                }
            }
            if root.built && root.video.can-pip: IconButton {
                icon-path: Glyph.pip;
                label: "Picture in picture";
                clicked => {
                    root.command("pip", 0);
                }
            }
            if root.built: frame := IconButton {
                icon-path: Glyph.camera;
                label: "Save frame";
                clicked => {
                    root.command("frame", 0);
                }
            }
            if root.built: mute := IconButton {
                icon-path: root.video.muted ? Glyph.speaker-muted : Glyph.speaker;
                label: root.video.muted ? "Unmute" : "Mute";
                on: root.video.muted;
                clicked => {
                    root.command("mute", 0);
                }
            }
            if root.built && root.video.can-save: IconButton {
                icon-path: Glyph.download;
                label: "Save video";
                clicked => {
                    root.command("save", 0);
                }
            }
            if root.built: IconButton {
                icon-path: Glyph.chevron-right;
                label: "Collapse";
                clicked => {
                    root.command("collapse", 0);
                }
            }
            if root.built: close := IconButton {
                icon-path: Glyph.close;
                label: "Close";
                clicked => {
                    root.command("dismiss", 0);
                }
                secondary-clicked => {
                    root.command("hide-site", 0);
                }
            }
        }
    }

    // The collapsed strip: a tab docked to the page pane's right edge, where the strip was.
    tab := BDockTab {
        key: GlassKeys.video-tab;
        layer: GlassOver.card;
        shown: root.video.collapsed && root.video.w > 0;
        width: Shell.video-tab-width;
        height: strip.height;
        x: root.video.pane-right - root.x - self.width;
        y: Space.s2;
        clicked => {
            root.command("expand", 0);
        }
        entered => {
            root.command("peek", 0);
        }
    }

    // The speed menu, under the strip's right end, grown from the speed button; it may reach
    // below a short video, down to the pane's bottom (cut to the video, a small one's fastest
    // rows were out of reach).
    speeds := BMenuPanel {
        key: GlassKeys.video-speeds;
        layer: GlassOver.card;
        shown: root.video.open && root.video.speeds;
        x: strip.x + strip.width - self.width;
        y: strip.y + strip.height + Space.s1;
        height: max(0px, min(list.preferred-height, root.video.pane-bottom - root.y - self.y - Space.s1));
        origin-x: self.width;
        origin-y: 0px;
        list := BChoiceList {
            card: false;
            for rate[i] in root.rates: speed := BChoiceRow {
                label: rate;
                checked: i == root.video.rate-index;
                hovered(on) => {
                    list.hover(i, on);
                }
                picked => {
                    root.command("rate", i);
                }
            }
        }
    }
}

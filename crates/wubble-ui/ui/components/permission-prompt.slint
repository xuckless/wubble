import { Shell } from "../kit/derived.slint";
import { PermissionView, GlassKeys } from "model.slint";
import { APrompt } from "../kit/overlay/a/a-prompt.slint";

// A site asks for a permission: "<site> wants to", one line per kind, a "Remember for this site"
// toggle, Block and Allow; or a link wants another app: "Open mailto link?", the link, "Always
// for <site> and mailto links", Cancel and Open (the host's words, `prompt::permission_text`).
// Placed by the parent under the address pill, where Chromium puts its bubble; not modal (the
// page stays usable, as Chromium's bubble is), and it never takes the keyboard, so no keystroke
// meant for the page answers it (keyjacking). Derived from the kit: the Prompt
// (kit/overlay/a/a-prompt.slint), Block a ghost button, Allow the primary. Only its buttons
// answer. `answered` is the intent; the host answers the engine (and stores a remembered
// decision).
export component PermissionPrompt inherits Rectangle {
    in property <PermissionView> prompt;
    // What the panel shows: the open request's, kept while it leaves.
    property <PermissionView> shown;
    changed open => {
        if root.open {
            root.remember = false;
            root.shown = root.prompt;
        }
    }
    // (allow, remember)
    callback answered(bool, bool);

    property <bool> open: root.prompt.open;
    property <bool> remember: false;

    // A new request starts with the toggle off.
    property <int> serial: root.prompt.serial;
    changed serial => {
        root.remember = false;
        if root.open {
            root.shown = root.prompt;
        }
    }

    width: Shell.prompt-width;
    height: body.height;
    visible: body.mounted;

    body := APrompt {
        open: root.open;
        key: GlassKeys.permission;
        title: root.shown.title;
        lines: root.shown.lines;
        // No toggle where nothing could be remembered (the host leaves it empty).
        remember: root.shown.remember;
        checked <=> root.remember;
        ghost-a: root.shown.block;
        primary: root.shown.allow;
        answered(i) => {
            root.answered(i == 2, root.remember);
        }
    }
}

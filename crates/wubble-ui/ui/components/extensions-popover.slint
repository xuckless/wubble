import { Space } from "../kit/gen/tokens.slint";
import { TouchCss } from "../kit/gen/css.slint";
import { Shell } from "../kit/derived.slint";
import { OverlapLayer } from "../kit/motion/overlap.slint";
import { ExtensionAction, GlassKeys } from "model.slint";
import { APopover } from "../kit/overlay/a/a-popover.slint";
import { Scrim } from "../kit/controls/menu.slint";
import { Thumb } from "../kit/controls/scroller.slint";
import { Glyph } from "../kit/controls/icon.slint";
import { AExtensionRow } from "../kit/overlay/a/a-extension-row.slint";

// The extensions popover, opened from the sidebar footer's puzzle button: one row per enabled
// extension (its action's icon, title and badge), then "Manage extensions", which opens the
// Settings section. Fills its parent (the window) so a click outside the panel closes it, like
// the downloads popover. Derived from the kit (docs/fidelity/wubble-only.md, derived-review.md
// "Extensions popover"): the Popover (kit/overlay/a/a-popover.slint) growing from its anchor,
// rows (kit/overlay/a/a-extension-row.slint) entering on the Overlap stagger. `pressed(id)`,
// `manage()` and `dismissed()` are intents; the host acts and closes it.
export component ExtensionsPopover inherits Rectangle {
    in property <bool> open;
    // The panel's top left, in this element's coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <[ExtensionAction]> items;
    callback pressed(string);
    callback manage();
    callback dismissed();

    visible: panel.mounted;

    Scrim {
        on: root.open;
        outside => {
            root.dismissed();
        }
        scroll-event(e) => {
            accept
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    public function take-focus() {
        keys.focus();
    }

    property <length> line-h: TouchCss.wb-tp-mrow--height;
    // every extension's row, then Manage
    property <int> lines: root.items.length + 1;
    property <length> list-height: min(root.lines, Shell.download-max-rows + 1) * root.line-h;

    panel := APopover {
        open: root.open;
        // the scene draws its glass above the page (GlassPanel `over-layer`)
        key: GlassKeys.extensions;
        width: Shell.prompt-width;
        height: root.list-height + 2 * Shell.menu-pad;
        x: max(Space.s2, min(root.anchor-x, root.width - self.width - Space.s2));
        y: max(Space.s2, min(root.anchor-y, root.height - self.height - Space.s2));
        // it grows from the anchor, wherever the fit above put the panel
        origin-x: max(0px, min(root.anchor-x - self.x, self.width));
        origin-y: max(0px, min(root.anchor-y - self.y, self.height));

        hover := TouchArea {
            enabled: root.open;
            flick := Flickable {
                x: Shell.menu-pad;
                y: Shell.menu-pad;
                width: parent.width - 2 * Shell.menu-pad;
                height: root.list-height;
                content-height: root.lines * root.line-h;
                interactive: root.lines * root.line-h > root.list-height;

                for item[i] in root.items: OverlapLayer {
                    shown: root.open;
                    index: i;
                    y: i * root.line-h;
                    height: root.line-h;
                    AExtensionRow {
                        item: item;
                        pressed(id) => {
                            root.pressed(id);
                        }
                    }
                }
                OverlapLayer {
                    shown: root.open;
                    index: root.items.length;
                    y: root.items.length * root.line-h;
                    height: root.line-h;
                    AExtensionRow {
                        item: { id: "manage", title: "Manage extensions", has-icon: false, badge: "", usable: true };
                        leading-icon: Glyph.settings;
                        pressed(id) => {
                            root.manage();
                        }
                    }
                }
            }
            Thumb {
                y: Shell.menu-pad;
                height: root.list-height;
                shown: hover.has-hover && flick.content-height > flick.height;
                top: flick.content-height > 0 ? -flick.content-y * flick.height / flick.content-height : 0px;
                length: flick.content-height > 0 ? flick.height * min(1, flick.height / flick.content-height) : 0px;
            }
        }
    }
}

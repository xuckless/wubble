// One command bar result. Styled after the design repo's web command bar
// (src/wubble/browser/browser.css `.wb-cmd-row`, `.wb-cmd-icon`, `.wb-cmd-hint`,
// xuckless/the-wallpaper-project @ 6c840da): 44 high, radius 12, a drawn icon in Mist, the
// label, the hint in Haze. The selection fill is the bar's one sliding highlight; the row only tints its icon. Rows enter through the
// port's OverlapLayer, 30 ms apart.

import { Palette, Space, Fonts, Type, Motion } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { OverlapLayer } from "../kit/motion/overlap.slint";
import { CommandKind, CommandResult } from "model.slint";
import { Icon, IconPaths } from "icon.slint";
import { Calm } from "../kit/motion/calm.slint";

export component CommandRow inherits Rectangle {
    in property <CommandResult> item;
    // Position in the list; drives the staggered entrance.
    in property <int> index;
    // True while the overlay is open; rows fade and shift in.
    in property <bool> shown;
    in property <bool> active: false;
    callback activated();

    height: Shell.command-row-height;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.item.title;
    accessible-description: root.item.subtitle;
    accessible-item-index: root.index;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.activated();
    }

    pure function icon(kind: CommandKind) -> string {
        if (kind == CommandKind.open-tab) {
            return IconPaths.globe;
        }
        if (kind == CommandKind.history) {
            return IconPaths.reload;
        }
        if (kind == CommandKind.bookmark) {
            return IconPaths.arrow;
        }
        if (kind == CommandKind.search) {
            return IconPaths.search;
        }
        return IconPaths.code;
    }

    OverlapLayer {
        shown: root.shown;
        index: root.index;
        width: root.width;
        height: root.height;

        Rectangle {
            width: root.width;
            height: root.height;
            border-radius: Shell.control-radius;

            ta := TouchArea {
                clicked => {
                    root.activated();
                }
            }

            HorizontalLayout {
                padding-left: Space.s3;
                padding-right: Space.s3;
                spacing: Space.s3;

                Rectangle {
                    width: Shell.command-icon;
                    if root.item.icon.width > 0: Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.item.icon;
                        width: Shell.icon;
                        height: Shell.icon;
                    }
                    if root.item.icon.width == 0: Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        path: root.icon(root.item.kind);
                        tint: root.active ? Palette.ink : Palette.mist;
                    }
                }

                Text {
                    text: root.item.title;
                    horizontal-stretch: 1;
                    color: Palette.ink;
                    font-family: Fonts.ui;
                    font-size: Type.body.size;
                    font-weight: Type.body.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.item.subtitle;
                    color: Palette.haze;
                    font-family: Fonts.ui;
                    font-size: Type.label.size;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.item.shortcut != "": Text {
                    width: Shell.shortcut-hint-width;
                    text: root.item.shortcut;
                    color: Palette.haze;
                    font-family: Fonts.mono;
                    font-size: Type.label.size;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The Overlap entrance (core/wubble.css `wb-in`, the owner's design repo: from 7 px below at
// 0.98 and clear, into place over 240 ms on the ease-out curve) for things whose arrival a Rust
// driver times: `e` is the eased progress, 0..1 (wubble_core::motion::overlap_in). The 4 px blur
// is left out (Slint cannot blur an item). For flips of a bool, OverlapLayer animates instead.

import { Motion } from "../tokens.slint";

export component Entering inherits Rectangle {
    in property <float> e: 1;
    opacity: root.e;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale: 0.98 + 0.02 * root.e;
    Rectangle {
        y: Motion.overlapShift * (1 - root.e);
        @children
    }
}

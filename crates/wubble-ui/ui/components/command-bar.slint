import { Palette, Motion, Radius, Spacing, Fonts } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel } from "../components.slint";
import { CommandBarEvent, CommandBarState, CommandResult, GlassTier } from "model.slint";
import { CommandRow } from "command-row.slint";
import { ScrollView } from "std-widgets.slint";

// Command bar overlay; fills its parent (the content area).
// `state` has one writer, `dispatch`; everything else reads it.
// Look and motion from the design repo's web command bar (src/wubble/browser/browser.css
// `.wb-cmd*`, `.wb-scrim`, xuckless/the-wallpaper-project @ 6c840da): thick glass over the page,
// radius 20, 72 from the top; it drops in 7 px over the overlap timings.
export component CommandBar inherits Rectangle {
    in property <[CommandResult]> results;
    in-out property <string> query <=> input.text;
    out property <CommandBarState> state: CommandBarState.closed;

    callback query-changed(string);
    callback result-chosen(int);
    callback dismissed();
    // Fired once the bar has fully closed; the host restores focus.
    callback closed();

    // Keyboard selection; `current` is what the UI uses, clamped to the model.
    property <int> selected: 0;
    property <int> count: root.results.length;
    property <int> current: max(0, min(root.selected, root.count - 1));
    property <length> row-pitch: Shell.command-row-height;
    property <int> visible-rows: min(root.count, Shell.command-max-rows);

    pure function next(s: CommandBarState, e: CommandBarEvent) -> CommandBarState {
        if (e == CommandBarEvent.open) {
            return CommandBarState.open;
        }
        if (e == CommandBarEvent.close && s == CommandBarState.open) {
            return CommandBarState.closing;
        }
        if (e == CommandBarEvent.settle && s == CommandBarState.closing) {
            return CommandBarState.closed;
        }
        return s;
    }

    public function dispatch(e: CommandBarEvent) {
        root.state = root.next(root.state, e);
    }

    function choose(i: int) {
        if (root.state == CommandBarState.open && i >= 0 && i < root.count) {
            root.result-chosen(i);
            root.dispatch(CommandBarEvent.close);
        }
    }

    function dismiss() {
        if (root.state == CommandBarState.open) {
            root.dismissed();
            root.dispatch(CommandBarEvent.close);
        }
    }

    // Port of listview.slint bring-into-view (see THIRD_PARTY_NOTICES.md).
    function bring-into-view(i: int) {
        if (i * root.row-pitch < -list.content-y) {
            list.content-y = -i * root.row-pitch;
        } else if ((i + 1) * root.row-pitch > -list.content-y + list.visible-height) {
            list.content-y = -((i + 1) * root.row-pitch - list.visible-height);
        }
    }

    function move(delta: int) {
        if (root.count > 0) {
            root.selected = mod(root.current + delta + root.count, root.count);
            root.bring-into-view(root.selected);
        }
    }

    visible: root.state != CommandBarState.closed;

    states [
        shown when root.state == CommandBarState.open: {
            opacity: 1;
            panel.y: Shell.command-bar-top;
            in {
                animate opacity, panel.y {
                    duration: Motion.overlapIn;
                    easing: Motion.easeOut;
                }
            }
            out {
                animate opacity, panel.y {
                    duration: Motion.overlapOut;
                    easing: Motion.easeInOut;
                }
            }
        }
        hidden when root.state != CommandBarState.open: {
            opacity: 0;
            panel.y: Shell.command-bar-top - Motion.overlapShift;
        }
    ]

    changed state => {
        if (self.state == CommandBarState.open) {
            input.focus();
            input.select-all();
        } else if (self.state == CommandBarState.closed) {
            input.clear-focus();
            root.selected = 0;
            list.content-y = 0px;
            root.closed();
        }
    }

    Timer {
        interval: Motion.overlapOut;
        running: root.state == CommandBarState.closing;
        triggered => {
            root.dispatch(CommandBarEvent.settle);
        }
    }

    // Scrim; a click outside the panel dismisses.
    TouchArea {
        enabled: root.state == CommandBarState.open;
        clicked => {
            root.dismiss();
        }
    }
    Rectangle {
        background: Shell.scrim;
    }

    panel := GlassPanel {
        width: min(Shell.command-bar-width, root.width - Spacing.s4 * 2);
        x: (root.width - self.width) / 2;
        height: Shell.side-pad + Shell.command-input-height + (root.count > 0 ? Spacing.s1 + root.visible-rows * root.row-pitch : 0px) + Spacing.s2;
        tier: GlassTier.thick;
        radius: Radius.lg;
        over-content: true;
        // Swallow clicks so they do not reach the scrim.
        TouchArea { }

        VerticalLayout {
            padding-top: Shell.side-pad;
            padding-left: Spacing.s2;
            padding-right: Spacing.s2;
            padding-bottom: Spacing.s2;
            spacing: root.count > 0 ? Spacing.s1 : 0px;

            Rectangle {
                height: Shell.command-input-height;
                input := TextInput {
                    x: Spacing.s3;
                    width: parent.width - Spacing.s3 - Spacing.s1;
                    font-family: Fonts.ui;
                    font-size: Shell.command-input-font;
                    color: Palette.ink;
                    selection-background-color: Palette.rim;
                    single-line: true;
                    edited => {
                        root.selected = 0;
                        list.content-y = 0px;
                        root.query-changed(self.text);
                    }
                    accepted => {
                        root.choose(root.current);
                    }
                    // Adapted from combobox-base.slint popup-key-handler.
                    key-pressed(event) => {
                        if (event.text == Key.UpArrow) {
                            root.move(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.move(1);
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.dismiss();
                            return accept;
                        }
                        return reject;
                    }
                }
                Text {
                    x: Spacing.s3;
                    text: "Search or enter address";
                    color: Palette.haze;
                    font-family: Fonts.ui;
                    font-size: Shell.command-input-font;
                    vertical-alignment: center;
                    visible: input.text == "";
                }
            }

            list := ScrollView {
                height: root.visible-rows * root.row-pitch;
                visible: root.count > 0;
                VerticalLayout {
                    alignment: start;
                    for r[i] in root.results: CommandRow {
                        item: r;
                        index: i;
                        shown: root.state == CommandBarState.open;
                        active: i == root.current;
                        activated => {
                            root.choose(i);
                        }
                    }
                }
            }
        }
    }
}

// The stroke icon family: 24 grid, 1.7 stroke, round caps and joins. Path data from the design
// repo's `src/wubble/browser/icons.tsx` (`P` table, xuckless/the-wallpaper-project @ 6c840da);
// the Slint port has only the Space icons, so this mirrors its `SpaceIcon` for the rest.

import { Palette } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";

export global IconPaths {
    out property <string> globe: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> close: "M6.5 6.5l11 11M17.5 6.5l-11 11";
    out property <string> minus: "M6 12h12";
    out property <string> expand: "M8 16 16 8M10 8h6v6";
    out property <string> search: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4";
    out property <string> code: "M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15";
    out property <string> arrow: "M5 12h14m-6-6 6 6-6 6";
    out property <string> reload: "M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4.5H15";
    out property <string> bubble: "M12 3.5c4.7 0 8.5 3.8 8.5 8.5s-3.8 8.5-8.5 8.5S3.5 16.7 3.5 12 7.3 3.5 12 3.5zM8 7.6a3.6 2 -35 0 1 2.6-1.9";
}

// One icon at `size`. `weight` is the stroke in grid units, as the SVG's stroke-width; Slint strokes in
// logical px, so it is scaled by size / 24 here.
export component Icon inherits Path {
    in property <string> path: IconPaths.globe;
    in property <length> size: Shell.icon;
    in property <float> weight: Shell.icon-stroke;
    in property <color> tint: Palette.mist;
    width: root.size;
    height: root.size;
    viewbox-width: Shell.icon-grid;
    viewbox-height: Shell.icon-grid;
    commands: root.path;
    fill: transparent;
    stroke: root.tint;
    stroke-width: root.size * root.weight / Shell.icon-grid;
    stroke-line-cap: round;
    stroke-line-join: round;
}

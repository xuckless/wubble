// The stroke icon family: 24 grid, 1.7 stroke, round caps and joins. Path data from the design
// repo's `src/wubble/browser/icons.tsx` (`P` table, xuckless/the-wallpaper-project @ 6c840da);
// the Slint port has only the Space icons, so this mirrors its `SpaceIcon` for the rest.

import { Palette } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";

export global IconPaths {
    out property <string> globe: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> close: "M6.5 6.5l11 11M17.5 6.5l-11 11";
    out property <string> minus: "M6 12h12";
    out property <string> expand: "M8 16 16 8M10 8h6v6";
    out property <string> search: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4";
    out property <string> code: "M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15";
    out property <string> arrow: "M5 12h14m-6-6 6 6-6 6";
    out property <string> sidebar: "M4 5h16v14H4zM9.5 5v14";
    out property <string> back: "M15 5l-7 7 7 7";
    out property <string> forward: "M9 5l7 7-7 7";
    out property <string> reload: "M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4.5v4.5H15";
    out property <string> lock: "M6.5 11h11v9h-11zM9 11V8a3 3 0 0 1 6 0v3";
    out property <string> download: "M12 4v11m-5-5 5 5 5-5M5 20h14";
    out property <string> split: "M4 5h16v14H4zM12 5v14";
    // wubble: not in icons.tsx. Hand drawn on the same grid: a speaker with two waves, the
    // same speaker struck through (muted), and the find bar's chevrons.
    out property <string> speaker: "M4.5 9.5h3l4.5-4v13l-4.5-4h-3zM15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11";
    out property <string> speaker-muted: "M4.5 9.5h3l4.5-4v13l-4.5-4h-3zM16 9.5l5 5M21 9.5l-5 5";
    out property <string> chevron-up: "M6 15l6-6 6 6";
    out property <string> chevron-down: "M6 9l6 6 6-6";
    out property <string> chevron-left: "M15 6l-6 6 6 6";
    // the settings entry: two sliders (icons.tsx `settings`, @ 21838b8)
    out property <string> settings: "M4 7h7M17 7h3M14 4.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4 17h3M13 17h7M10 14.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z";
    // the pages' glyphs, also hand drawn on the 24 grid: the bookmark star, the blocker shield, a
    // folder, a bin, an eye (show a password) and two sheets (copy)
    out property <string> star: "M12 3.8l2.5 5.2 5.7.8-4.1 4 1 5.7L12 16.8 6.9 19.5l1-5.7-4.1-4 5.7-.8z";
    out property <string> shield: "M12 3.5 5 6v5.5c0 4.2 2.9 7.4 7 9 4.1-1.6 7-4.8 7-9V6z";
    out property <string> folder: "M3.5 7a1.5 1.5 0 0 1 1.5-1.5h4l2 2.5h8a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5z";
    out property <string> trash: "M5 7h14M10 7V5h4v2M7 7l.8 12h8.4L17 7M10.5 11v5M13.5 11v5";
    out property <string> eye: "M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12zM12 14.8a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6z";
    out property <string> copy: "M8.5 8.5h10v11h-10zM5.5 15.5v-11h10";
    // video controls and Boosts, hand drawn on the 24 grid (the design repo has no media icons)
    out property <string> play: "M8 5.5v13l10.5-6.5z";
    out property <string> pause: "M8.5 5.5v13M15.5 5.5v13";
    out property <string> loop: "M16.5 4.5l3 3-3 3M19.5 7.5H8a4 4 0 0 0-4 4M7.5 19.5l-3-3 3-3M4.5 16.5H16a4 4 0 0 0 4-4";
    out property <string> pip: "M3.5 5.5h17v13h-17zM12 11.5h6.5v5H12z";
    out property <string> camera: "M4 8h3.5L9 6h6l1.5 2H20v11H4zM12 16.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z";
    out property <string> zap: "M13 3 5 13.5h6L10 21l8-10.5h-6z";
    // reader mode: an open book, hand drawn on the 24 grid (icons.tsx has none)
    out property <string> book: "M3.5 5.5c3-1 5.8-.9 8.5 1 2.7-1.9 5.5-2 8.5-1v13c-3-1-5.8-.9-8.5 1-2.7-1.9-5.5-2-8.5-1zM12 6.5v13";
    out property <string> bubble: "M12 3.5c4.7 0 8.5 3.8 8.5 8.5s-3.8 8.5-8.5 8.5S3.5 16.7 3.5 12 7.3 3.5 12 3.5zM8 7.6a3.6 2 -35 0 1 2.6-1.9";
    // the settings sections (settings.tsx SECTIONS, @ 21838b8): appearance's palette, spaces'
    // stacked cards, the keyboard; wubble's performance gauge is hand drawn on the grid
    out property <string> palette: "M12 3.5a8.5 8.5 0 1 0 0 17c1.3 0 1.9-.9 1.9-1.8 0-1.3-1.1-1.6-1.1-2.6 0-.8.7-1.4 1.6-1.4h1.9a4.2 4.2 0 0 0 4.2-4.2C20.5 6.6 16.7 3.5 12 3.5zM7.6 12.2h.01M9.6 8h.01M14.4 8h.01";
    out property <string> stack: "M7 4.5h10M5.5 8h13M4 11.5h16v8H4z";
    out property <string> keyboard: "M3.5 6.5h17v11h-17zM7 10h.01M10.3 10h.01M13.7 10h.01M17 10h.01M8 14h8";
    out property <string> gauge: "M4.5 17a7.5 7.5 0 1 1 15 0M12 17l3.5-4.5";
    // wubble: the history page's clock, hand drawn on the grid (icons.tsx has none)
    out property <string> clock: "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM12 7.5V12l3 2";

    // A tab's glyph when it has no favicon: a wubble:// page's own (icons.tsx PAGE_ICON,
    // @ 21838b8: the page's stroke icon, never a letter), else the globe. The URLs are
    // wubble_core's `InternalPage::url`.
    public pure function page(url: string) -> string {
        if url == "wubble://settings" { return self.settings; }
        if url == "wubble://history" { return self.clock; }
        if url == "wubble://bookmarks" { return self.star; }
        if url == "wubble://downloads" { return self.download; }
        if url == "wubble://passwords" { return self.lock; }
        return self.globe;
    }
    // The component sheet's glyphs, from the design repo's `pages/touch-kit.tsx` `PATH`
    // (duplicate, move, link, check, chevron-right) and `pages/touch.tsx` `PIN.rest` (the pin
    // ribbon at rest). `awake` is hand drawn: a sun (never sleep).
    out property <string> duplicate: "M9 8h11v13H9zM4 16V3h11";
    out property <string> move: "M4 12h12m-4-4 4 4-4 4M20 5v14";
    out property <string> link: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1";
    out property <string> check: "M5 12l4 4L19 6";
    out property <string> chevron-right: "M9 6l6 6-6 6";
    out property <string> pin: "M6 3h12v18l-6-4-6 4z";
    out property <string> awake: "M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zM12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4";

    // A glyph by name, for rows that carry their icon as data (MenuEntry.icon); "" for none.
    public pure function named(name: string) -> string {
        if name == "pin" { return root.pin; }
        if name == "duplicate" { return root.duplicate; }
        if name == "move" { return root.move; }
        if name == "split" { return root.split; }
        if name == "mute" { return root.speaker-muted; }
        if name == "speaker" { return root.speaker; }
        if name == "awake" { return root.awake; }
        if name == "close" { return root.close; }
        if name == "link" { return root.link; }
        if name == "shield" { return root.shield; }
        if name == "copy" { return root.copy; }
        if name == "check" { return root.check; }
        if name == "download" { return root.download; }
        return "";
    }
}

// One icon at `size`. `weight` is the stroke in grid units, as the SVG's stroke-width; Slint strokes in
// logical px, so it is scaled by size / 24 here.
export component Icon inherits Path {
    in property <string> path: IconPaths.globe;
    in property <length> size: Shell.icon;
    in property <float> weight: Shell.icon-stroke;
    in property <color> tint: Palette.mist;
    width: root.size;
    height: root.size;
    viewbox-width: Shell.icon-grid;
    viewbox-height: Shell.icon-grid;
    commands: root.path;
    fill: transparent;
    stroke: root.tint;
    stroke-width: root.size * root.weight / Shell.icon-grid;
    stroke-line-cap: round;
    stroke-line-join: round;
}

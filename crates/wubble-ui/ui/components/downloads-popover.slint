import { Palette, Motion, Spacing, Fonts, Type, Chrome } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel, PressableButton, OverlapLayer } from "../components.slint";
import { GlassTier, DownloadItem, DownloadAction, DownloadStatus } from "model.slint";
import { DownloadRow } from "download-row.slint";

// The downloads list, opened from the sidebar's download button: one row per download, newest
// first, with its progress and the buttons its state allows (pause, resume, cancel, retry, show
// in folder, remove). Fills its parent (the window) so a click outside the panel closes it, like
// the context menu. Written from scratch: the design repo has no downloads list. Looks and
// timings are the context menu's (Ultra Reactivate `.ur-o-surface`, overlays.css): thick glass
// over content, padding 6, radius 14, rows entering on the Overlap stagger; the download glyph is
// the design's (icons.tsx). `action` and `dismissed` are intents; the host acts and closes it.
export component DownloadsPopover inherits Rectangle {
    in property <bool> open;
    // The panel's top left, in this element's coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <[DownloadItem]> items;
    callback action(int, DownloadAction);
    callback dismissed();

    // The exit is seen (Overlap: the old state shares the screen while it leaves): drawn until
    // the panel has faded; only the open popover takes the pointer.
    visible: root.open || panel.opacity > 0;

    TouchArea {
        enabled: root.open;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        scroll-event(e) => {
            accept
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    public function take-focus() {
        keys.focus();
    }

    property <length> list-height: min(root.items.length, Shell.download-max-rows) * Shell.download-row;

    panel := GlassPanel {
        width: Shell.downloads-width;
        height: root.list-height + 2 * Shell.menu-pad;
        x: max(Spacing.s2, min(root.anchor-x, root.width - self.width - Spacing.s2));
        y: max(Spacing.s2, min(root.anchor-y, root.height - self.height - Spacing.s2));
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.open ? 1 : Motion.dropdownFrom;
        opacity: root.open ? 1 : 0;
        animate transform-scale, opacity {
            duration: root.open ? Motion.dropdownIn : Motion.dropdownOut;
            easing: root.open ? Motion.easeOut : Motion.easeInOut;
        }
        TouchArea { }

        Flickable {
            x: Shell.menu-pad;
            y: Shell.menu-pad;
            width: parent.width - 2 * Shell.menu-pad;
            height: root.list-height;
            content-height: root.items.length * Shell.download-row;
            interactive: root.items.length > Shell.download-max-rows;

            for item[i] in root.items: OverlapLayer {
                shown: root.open;
                index: i;
                y: i * Shell.download-row;
                height: Shell.download-row;
                DownloadRow {
                    item: item;
                    action(id, a) => {
                        root.action(id, a);
                    }
                }
            }
        }
    }
}

import { Palette, Motion, Spacing, Fonts, Type, Chrome } from "../tokens.slint";
import { Shell } from "../app-tokens.slint";
import { GlassPanel, PressableButton, OverlapLayer } from "../components.slint";
import { GlassTier, DownloadItem, DownloadAction } from "model.slint";
import { Icon, IconPaths } from "icon.slint";

// The downloads list, opened from the sidebar's download button: one row per download, newest
// first, with its progress and the buttons its state allows (pause, resume, cancel, retry, show
// in folder, remove). Fills its parent (the window) so a click outside the panel closes it, like
// the context menu. Written from scratch: the design repo has no downloads list. Looks and
// timings are the context menu's (Ultra Reactivate `.ur-o-surface`, overlays.css): thick glass
// over content, padding 6, radius 14, rows entering on the Overlap stagger; the download glyph is
// the design's (icons.tsx). `action` and `dismissed` are intents; the host acts and closes it.
export component DownloadsPopover inherits Rectangle {
    in property <bool> open;
    // The panel's top left, in this element's coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <[DownloadItem]> items;
    callback action(int, DownloadAction);
    callback dismissed();

    visible: root.open;

    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dismissed();
            }
        }
        scroll-event(e) => {
            accept
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    public function take-focus() {
        keys.focus();
    }

    property <length> list-height: min(root.items.length, Shell.download-max-rows) * Shell.download-row;

    panel := GlassPanel {
        width: Shell.downloads-width;
        height: root.list-height + 2 * Shell.menu-pad;
        x: max(Spacing.s2, min(root.anchor-x, root.width - self.width - Spacing.s2));
        y: max(Spacing.s2, min(root.anchor-y, root.height - self.height - Spacing.s2));
        tier: GlassTier.thick;
        radius: Shell.menu-radius;
        over-content: true;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.open ? 1 : Motion.dropdownFrom;
        opacity: root.open ? 1 : 0;
        animate transform-scale, opacity {
            duration: root.open ? Shell.menu-in : Shell.menu-out;
            easing: root.open ? Motion.easeOut : Motion.easeIn;
        }
        TouchArea { }

        Flickable {
            x: Shell.menu-pad;
            y: Shell.menu-pad;
            width: parent.width - 2 * Shell.menu-pad;
            height: root.list-height;
            content-height: root.items.length * Shell.download-row;
            interactive: root.items.length > Shell.download-max-rows;

            for item[i] in root.items: OverlapLayer {
                shown: root.open;
                index: i;
                y: i * Shell.download-row;
                height: Shell.download-row;
                Rectangle {
                    border-radius: Shell.menu-row-radius;
                    background: row-touch.has-hover ? Shell.command-selected : transparent;
                    animate background {
                        duration: Shell.menu-hover-ms;
                        easing: Motion.easeOut;
                    }
                    row-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: Shell.menu-row-pad;
                        padding-right: Spacing.s1;
                        spacing: Spacing.s3;
                        Rectangle {
                            width: Shell.icon;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: IconPaths.download;
                                tint: item.done ? Palette.mint : item.active ? Palette.ink : Palette.haze;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Spacing.s1;
                            Text {
                                text: item.name;
                                color: Palette.ink;
                                font-family: Fonts.ui;
                                font-size: Type.body.size;
                                overflow: elide;
                            }
                            Text {
                                text: item.detail;
                                color: Palette.mist;
                                font-family: Fonts.ui;
                                font-size: Type.label.size;
                                overflow: elide;
                            }
                            // The progress track, while there are bytes to come.
                            Rectangle {
                                visible: item.active;
                                height: item.active ? Shell.download-track : 0px;
                                border-radius: Shell.download-track / 2;
                                background: Palette.rim;
                                Rectangle {
                                    x: 0px;
                                    width: item.progress < 0 ? parent.width : parent.width * item.progress;
                                    border-radius: parent.border-radius;
                                    background: Palette.sky;
                                    opacity: item.progress < 0 ? 0.35 : 1;
                                    animate width {
                                        duration: Shell.menu-in;
                                        easing: Motion.easeOut;
                                    }
                                }
                            }
                        }
                        if item.can-pause: PressableButton {
                            text: "Pause";
                            clicked => {
                                root.action(item.id, DownloadAction.pause);
                            }
                        }
                        if item.can-resume: PressableButton {
                            text: "Resume";
                            clicked => {
                                root.action(item.id, DownloadAction.resume);
                            }
                        }
                        if item.active: PressableButton {
                            text: "Cancel";
                            clicked => {
                                root.action(item.id, DownloadAction.cancel);
                            }
                        }
                        if item.can-retry: PressableButton {
                            text: "Retry";
                            clicked => {
                                root.action(item.id, DownloadAction.retry);
                            }
                        }
                        if item.done: PressableButton {
                            text: "Show";
                            clicked => {
                                root.action(item.id, DownloadAction.reveal);
                            }
                        }
                        if !item.active: PressableButton {
                            width: Chrome.controls;
                            padding-x: (Chrome.controls - Shell.icon) / 2;
                            clicked => {
                                root.action(item.id, DownloadAction.remove);
                            }
                            Icon {
                                path: IconPaths.close;
                            }
                        }
                    }
                }
            }
        }
    }
}

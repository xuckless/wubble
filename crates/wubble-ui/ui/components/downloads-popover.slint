import { Space } from "../kit/gen/tokens.slint";
import { Shell } from "../kit/derived.slint";
import { OverlapLayer } from "../kit/motion/overlap.slint";
import { DownloadItem, DownloadAction, GlassKeys } from "model.slint";
import { APopover } from "../kit/overlay/a/a-popover.slint";
import { Scrim } from "../kit/controls/menu.slint";
import { Thumb } from "../kit/controls/scroller.slint";
import { ADownloadRow } from "../kit/overlay/a/a-download-row.slint";

// The downloads list, opened from the sidebar's download button: one row per download, newest
// first, with its progress and the buttons its state allows (pause, resume, cancel, retry, show
// in folder, remove). Fills its parent (the window) so a click outside the panel closes it, like
// the context menu. Derived from the kit (docs/fidelity/wubble-only.md): the Popover
// (kit/overlay/a/a-popover.slint) growing from its anchor, rows (kit/overlay/a/a-download-row.slint)
// entering on the Overlap stagger. `action` and `dismissed` are intents; the host acts and closes
// it.
export component DownloadsPopover inherits Rectangle {
    in property <bool> open;
    // The panel's top left, in this element's coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <[DownloadItem]> items;
    callback action(int, DownloadAction);
    callback dismissed();

    // The exit is seen (Overlap: the old state shares the screen while it leaves): drawn until
    // the panel has faded; only the open popover takes the pointer.
    visible: panel.mounted;

    Scrim {
        on: root.open;
        outside => {
            root.dismissed();
        }
        scroll-event(e) => {
            accept
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }

    public function take-focus() {
        keys.focus();
    }

    property <length> list-height: min(root.items.length, Shell.download-max-rows) * Shell.download-row;

    panel := APopover {
        open: root.open;
        // the scene draws its glass above the page (GlassPanel `over-layer`)
        key: GlassKeys.downloads;
        width: Shell.downloads-width;
        height: root.list-height + 2 * Shell.menu-pad;
        x: max(Space.s2, min(root.anchor-x, root.width - self.width - Space.s2));
        y: max(Space.s2, min(root.anchor-y, root.height - self.height - Space.s2));
        // it grows from the anchor, wherever the fit above put the panel
        origin-x: max(0px, min(root.anchor-x - self.x, self.width));
        origin-y: max(0px, min(root.anchor-y - self.y, self.height));

        hover := TouchArea {
            enabled: root.open;
            flick := Flickable {
                x: Shell.menu-pad;
                y: Shell.menu-pad;
                width: parent.width - 2 * Shell.menu-pad;
                height: root.list-height;
                content-height: root.items.length * Shell.download-row;
                interactive: root.items.length > Shell.download-max-rows;

                for item[i] in root.items: OverlapLayer {
                    shown: root.open;
                    index: i;
                    y: i * Shell.download-row;
                    height: Shell.download-row;
                    ADownloadRow {
                        item: item;
                        action(id, a) => {
                            root.action(id, a);
                        }
                    }
                }
            }
            Thumb {
                y: Shell.menu-pad;
                height: root.list-height;
                shown: hover.has-hover && flick.content-height > flick.height;
                top: flick.content-height > 0 ? -flick.content-y * flick.height / flick.content-height : 0px;
                length: flick.content-height > 0 ? flick.height * min(1, flick.height / flick.content-height) : 0px;
            }
        }
    }
}

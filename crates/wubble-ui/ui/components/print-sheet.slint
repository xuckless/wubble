import { SheetFrame } from "sheet-frame.slint";
import { PrintSheetView } from "model.slint";
import { Segmented } from "../kit/controls/segmented.slint";
import { ElasticSlider } from "../kit/controls/slider.slint";
import { CheckBox } from "../kit/controls/check-box.slint";
import { BField, BGroup } from "../kit/overlay/b/b-field.slint";
import { BCard, BRow, BStackRow, BNote, BChoiceList, BChoiceRow } from "../kit/overlay/b/b-sheet-parts.slint";

// The print sheet (Ctrl+P, the menu's Print): where to (Save as PDF, then the printers CUPS
// lists), the pages, orientation, paper, margins, scale, background graphics and copies. The
// sheet shows `wubble_core::print::Sheet`; every change goes back through `edited` (the
// destination index, pages, landscape, paper, margins and scale indices or numbers, background,
// copies) and the host answers with the next view. `answered(true)` prints. The design has no
// print sheet (wubble-only.md §15): a command-bar modal body holding a settings card, on the
// SheetFrame chrome: the destinations as the flat chooser, then `.st-row`s of kit controls
// (Segmented, ElasticSlider for scale and copies, CheckBox), the error a coral note.
export component PrintSheet inherits SheetFrame {
    in property <PrintSheetView> sheet;
    callback edited(int, string, bool, int, int, int, bool, int);
    callback answered(bool);

    property <string> pages;

    open: root.sheet.open;
    title: root.sheet.busy ? "Printing…" : "Print";
    accept-text: root.sheet.destination == 0 ? "Save" : "Print";
    cancel-text: "Cancel";
    accepted => {
        // A bad range is refused by the host, which keeps the reason shown; a failure's
        // message does not block a retry.
        if !root.sheet.busy {
            root.answered(true);
        }
    }
    cancelled => {
        root.answered(false);
    }

    function edit(destination: int, pages: string, landscape: bool, paper: int, margins: int,
            scale: int, background: bool, copies: int) {
        root.edited(destination, pages, landscape, paper, margins, scale, background, copies);
    }

    public function focus-sheet() {
        root.take-focus();
    }

    // Each opening restarts the pages field from the sheet's own text.
    property <int> serial: root.sheet.serial;
    changed serial => {
        root.pages = root.sheet.pages;
        if root.sheet.open {
            root.focus-sheet();
        }
    }

    // Destinations: Save as PDF first, then each printer.
    destinations := BChoiceList {
        for name[i] in root.sheet.destinations: BChoiceRow {
            label: name;
            checked: i == root.sheet.destination;
            hovered(on) => {
                destinations.hover(i, on);
            }
            picked => {
                root.edit(i, root.pages, root.sheet.landscape, root.sheet.paper,
                    root.sheet.margins, root.sheet.scale, root.sheet.background, root.sheet.copies);
            }
        }
    }
    // Built at the first opening: its controls take their slots in the controls registry, which
    // the host wires after the window is built.
    if root.sheet.serial > 0: BCard {
        BRow {
            title: "Pages";
            wide: true;
            BField {
                text <=> root.pages;
                placeholder: "All, or like 1-3, 5";
                label: "Pages";
                edited(t) => {
                    root.edit(root.sheet.destination, t, root.sheet.landscape, root.sheet.paper,
                        root.sheet.margins, root.sheet.scale, root.sheet.background, root.sheet.copies);
                }
                accepted => {
                    root.accepted();
                }
                escaped => {
                    root.cancelled();
                }
            }
        }
        BRow {
            title: "Layout";
            Segmented {
                compact: true;
                label: "Layout";
                labels: ["Portrait", "Landscape"];
                selected: root.sheet.landscape ? 1 : 0;
                chosen(i) => {
                    root.edit(root.sheet.destination, root.pages, i == 1, root.sheet.paper,
                        root.sheet.margins, root.sheet.scale, root.sheet.background, root.sheet.copies);
                }
            }
        }
        BRow {
            title: "Paper";
            Segmented {
                compact: true;
                label: "Paper";
                labels: ["Letter", "A4", "Legal"];
                selected: root.sheet.paper;
                chosen(i) => {
                    root.edit(root.sheet.destination, root.pages, root.sheet.landscape, i,
                        root.sheet.margins, root.sheet.scale, root.sheet.background, root.sheet.copies);
                }
            }
        }
        BRow {
            title: "Margins";
            Segmented {
                compact: true;
                label: "Margins";
                labels: ["Default", "None", "Minimum"];
                selected: root.sheet.margins;
                chosen(i) => {
                    root.edit(root.sheet.destination, root.pages, root.sheet.landscape, root.sheet.paper,
                        i, root.sheet.scale, root.sheet.background, root.sheet.copies);
                }
            }
        }
        scale-row := BStackRow {
            title: "Scale";
            ElasticSlider {
                compact: true;
                label: "Scale";
                unit: "%";
                min: 10;
                max: 200;
                step: 10;
                value: root.sheet.scale;
                width: scale-row.control-width;
                                edited(v) => {
                    root.edit(root.sheet.destination, root.pages, root.sheet.landscape, root.sheet.paper,
                        root.sheet.margins, Math.round(v), root.sheet.background, root.sheet.copies);
                }
            }
        }
        if root.sheet.destination > 0: copies-row := BStackRow {
            title: "Copies";
            ElasticSlider {
                compact: true;
                label: "Copies";
                min: 1;
                max: 99;
                value: root.sheet.copies;
                width: copies-row.control-width;
                                edited(v) => {
                    root.edit(root.sheet.destination, root.pages, root.sheet.landscape, root.sheet.paper,
                        root.sheet.margins, root.sheet.scale, root.sheet.background, Math.round(v));
                }
            }
        }
        CheckBox {
            text: "Background graphics";
            checked: root.sheet.background;
            toggled(on) => {
                if on != root.sheet.background {
                    root.edit(root.sheet.destination, root.pages, root.sheet.landscape, root.sheet.paper,
                        root.sheet.margins, root.sheet.scale, on, root.sheet.copies);
                }
            }
        }
    }
    if root.sheet.error != "": BNote {
        danger: true;
        text: root.sheet.error;
    }
}

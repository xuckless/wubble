// The resize zones of the frameless window: edge strips 7 px and corner squares 16 px, as in the
// design repo's desktop.tsx (`WIN.edge`, `WIN.corner`; owner's own code, xuckless/the-wallpaper-project
// @ 6c840da). A press reports the edge and the host hands the grab to the compositor
// (xdg_toplevel.resize on Wayland). The corners come last, so they win over the strips.

import { Shell } from "../app-tokens.slint";
import { WindowEdge } from "model.slint";

component Zone inherits TouchArea {
    in property <WindowEdge> edge;
    callback begin(WindowEdge);
    // Only the press matters: the compositor swallows the release.
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            root.begin(root.edge);
        }
    }
}

export component WindowEdges inherits Rectangle {
    in property <bool> resizable: true;
    callback begin(WindowEdge);

    property <length> e: Shell.edge-width;
    property <length> c: Shell.edge-corner;

    Zone {
        edge: WindowEdge.n;
        mouse-cursor: ns-resize;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.e;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.s;
        mouse-cursor: ns-resize;
        x: 0px;
        y: parent.height - root.e;
        width: parent.width;
        height: root.e;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.w;
        mouse-cursor: ew-resize;
        x: 0px;
        y: 0px;
        width: root.e;
        height: parent.height;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.e;
        mouse-cursor: ew-resize;
        x: parent.width - root.e;
        y: 0px;
        width: root.e;
        height: parent.height;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.nw;
        mouse-cursor: nwse-resize;
        x: 0px;
        y: 0px;
        width: root.c;
        height: root.c;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.ne;
        mouse-cursor: nesw-resize;
        x: parent.width - root.c;
        y: 0px;
        width: root.c;
        height: root.c;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.sw;
        mouse-cursor: nesw-resize;
        x: 0px;
        y: parent.height - root.c;
        width: root.c;
        height: root.c;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
    Zone {
        edge: WindowEdge.se;
        mouse-cursor: nwse-resize;
        x: parent.width - root.c;
        y: parent.height - root.c;
        width: root.c;
        height: root.c;
        enabled: root.resizable;
        begin(which) => {
            root.begin(which);
        }
    }
}

import { GlassKeys, GlassOver } from "model.slint";
import { APreviewCard } from "../kit/overlay/a/a-preview-card.slint";

// The tab hover preview: title, address and the page's last frame, on thick glass beside the
// sidebar at the hovered row. Derived from the kit (docs/fidelity/wubble-only.md; the design
// has no hover card): the Preview card (kit/overlay/a/a-preview-card.slint) with the tooltip's
// motion. When it shows is `wubble_core::hovercard` (Firefox's delays); the host drives `shown`.
// Pointer events pass through, as the Toast's do. Its inputs are the kit body's: `shown`,
// `title`, `address`, `thumb`.
export component PreviewCard inherits APreviewCard {
    // the scene draws its glass above the page (GlassPanel `over-layer`)
    key: GlassKeys.preview;
    layer: GlassOver.card;
}

// Values wubble's own components need that tokens.slint (the design repo's port) has no token
// for. Each comes from the design repo's web chrome, `src/wubble/browser/browser.css` and
// `icons.tsx` (xuckless/the-wallpaper-project @ 6c840da), named by its CSS rule. Nothing here
// repeats a value tokens.slint already has.

export global Shell {
    // One logical pixel: divide a length by it to get a plain number.
    out property <length> px: 1px;
    // demo.slint preferred size
    // browser.css .wb-edge: strips 10 and corners 20, centred on the border (the inside half)
    out property <length> edge-width: 5px;
    out property <length> edge-corner: 10px;
    // .wb-nav: gap 2, pulled 4 right; .wb-ib: 30 square, radius 9, white 7 % on hover, 35 % disabled
    out property <length> nav-gap: 2px;
    out property <length> nav-pull: 4px;
    out property <length> icon-button: 30px;
    out property <length> icon-button-radius: 9px;
    out property <color> icon-button-hover: rgba(255, 255, 255, 0.07);
    out property <float> icon-button-disabled: 0.35;
    out property <duration> icon-button-ms: 150ms;   // .wb-ib transition: color .15s
    // wubble.css wb-wob: the icon wobble on a hit
    out property <duration> wobble-ms: 550ms;
    // how far a press on bare chrome travels before it moves the window
    out property <length> move-threshold: 4px;
    // .wb-side-top 30 high, lights 12 with gap 8 (6 on the rail), .wb-light glyph 8
    out property <length> side-top: 30px;
    out property <length> command-origin-dx: 40px;   // chrome.tsx openCommand: r.left + 40
    out property <duration> light-fill-ms: 200ms;
    out property <duration> light-glyph-ms: 150ms;
    out property <color> beam-sheen: rgba(255, 255, 255, 0.35);
    out property <length> light: 12px;
    out property <length> light-gap: 8px;
    out property <length> light-gap-rail: 6px;
    out property <length> light-glyph: 8px;
    out property <color> light-rest: rgba(255, 255, 255, 0.18);
    out property <color> light-glyph-ink: rgba(8, 9, 13, 0.7);
    out property <float> light-press-x: 0.8;
    out property <float> light-press-y: 1.15;
    // chrome.tsx Address border beam: 1500 ms, brightens in 120 ms
    out property <duration> beam-ms: 1500ms;
    out property <duration> beam-in: 120ms;
    // the ring's width: GlassPanel's film rim (1.5)
    out property <length> glow-width: 1.5px;
    // browser.css .wb-side-peek: padding 10 8 10 10 (the extended sidebar's is side-pad, 6)
    out property <length> peek-pad-start: 10px;
    out property <length> peek-pad-end: 8px;
    out property <length> peek-pad-y: 10px;
    // Stand-in for the backdrop blur (.wb-thick: blur 44) while the wgpu pass is not under the
    // panel: thick glass over the page at .94, so the page cannot be read through the text.
    out property <color> thick-unblurred-fill: rgba(28, 31, 40, 0.94);
    out property <length> window-width: 1280px;
    out property <length> window-height: 800px;

    // .wb-side: padding 6; the content edge is 14 px from the window (inset 8 + 6), and every
    // icon and label starts 10 px further in, at 24.
    out property <length> side-pad: 6px;
    out property <length> side-grid: 10px;
    // controls inside the sidebar: 12 (the web view's 14 minus the 2 px they sit inside)
    out property <length> control-radius: 12px;
    // .wb-tabs-rail .wb-tab, .wb-rail-addr, .wb-favs-rail: 40 wide, favourites 6 apart
    out property <length> rail-item: 40px;
    out property <length> rail-gap: 6px;

    // icons.tsx: 24 grid, 1.7 stroke, round caps
    out property <length> icon: 16px;
    out property <float> icon-stroke: 1.7;
    out property <float> icon-grid: 24;
    // .wb-tab-icon box (the favicon inside it is `icon`)
    out property <length> tab-icon: 18px;
    // .wb-address: icon 13 at stroke 1.9, pressed to .985 over .2 s
    out property <length> address-icon: 13px;
    out property <float> address-icon-stroke: 1.9;
    out property <float> address-press: 0.985;
    out property <duration> address-press-ms: 200ms;
    // .wb-favs: 4 columns; .wb-fav > .wb-icon 18, scale 1.1 on hover over .36 s (spring ease)
    out property <int> fav-columns: 4;
    out property <length> fav-icon: 18px;
    out property <float> fav-hover-scale: 1.1;
    out property <duration> fav-hover-ms: 360ms;
    // .wb-tab-ind: white 12 %, the selected favourite's fill
    out property <color> selected-fill: rgba(255, 255, 255, 0.12);
    // .wb-newtab: plus 15 at stroke 2
    out property <length> new-tab-icon: 15px;
    out property <float> new-tab-stroke: 2;
    // .wb-space-name: 18 high, 2 px top padding
    out property <length> space-name-height: 18px;
    out property <length> space-name-top: 2px;
    // .wb-spaces: 36 tiles 2 apart (pitch 38 = SpaceSwitcher::PITCH), drawn at 17;
    // .wb-spaces-ind: accent at 20 %, colour change over .4 s
    out property <length> space-tile: 36px;
    // A tab dragged out of the list (wubble's own, the design has none): the ghost row that
    // follows the pointer and the content edge it would split into.
    out property <length> drag-ghost-max: 280px;
    out property <length> drag-ghost-blur: 12px;
    out property <color> drag-ghost-shadow: rgba(0, 0, 0, 0.25);
    out property <length> drag-zone-border: 2px;
    out property <length> space-gap: 2px;
    out property <length> space-glyph: 17px;
    // .wb-side-bottom > .wb-ib: 36 square (radius control-radius); .wb-side-bottom-rail: gap 10
    out property <length> side-bottom-button: 36px;
    out property <length> side-bottom-gap-rail: 10px;
    out property <float> capsule-alpha: 0.2;
    out property <duration> capsule-colour-ms: 400ms;

    // chrome.tsx: the sidebar takes room beside the web view once wider than this
    out property <length> sidebar-open: 0.5px;

    // browser.css .wb-split-grab: a split seam's hit strip, centred on the seam (chrome.tsx
    // `sm.x - 10`); the Slint port's 12 px left 2 px of page each side of the 8 px gap
    out property <length> split-grab: 20px;

    // A glass panel's clip range when nothing clips it (GlassPanel `clip-start`/`clip-end`)
    out property <length> no-clip: 100000px;

    // chrome.tsx: a hidden sidebar peeks 60 ms after the pointer reaches the edge strip and
    // hides 260 ms after it leaves; .wb-side-peek slides in over .34 s from 20 % opacity,
    // 16 px past its own width.
    out property <duration> peek-in: 60ms;
    out property <duration> peek-out: 260ms;
    out property <duration> peek-slide: 340ms;
    out property <float> peek-from: 0.2;
    out property <length> peek-travel: 16px;

    // .wb-cmd: 600 wide, 72 from the top, padding 6 8 8, radius 20; .wb-cmd-in 52 high at 17;
    // .wb-cmd-head padding 0 4 0 12; .wb-cmd-row 44 high, padding 0 12, gap 12;
    // .wb-cmd-sel white 8 %; .wb-scrim black-blue 32 %; .wb-cmd-icon 18
    out property <length> command-bar-width: 600px;
    out property <length> command-bar-top: 72px;
    out property <length> command-input-height: 52px;
    out property <length> command-input-font: 17px;
    out property <length> command-row-height: 44px;
    out property <length> command-icon: 18px;
    out property <int> command-max-rows: 7;   // command.tsx CMD.rows
    out property <duration> scrim-in: 200ms;
    out property <duration> scrim-out: 160ms;
    out property <duration> command-sel-ms: 180ms;
    out property <duration> command-sel-fade: 150ms;
    out property <length> shortcut-hint-width: 72px;
    out property <color> command-selected: rgba(255, 255, 255, 0.08);
    out property <color> scrim: rgba(5, 6, 9, 0.32);

    // ── The page's own UI. The design repo has no menu, sheet, toast or find bar; their looks
    // and timings are Ultra Reactivate's (the owner's library, src/ultra-reactivate/overlays.css
    // in the same repo), named by rule.
    // .ur-o-surface: 220 wide, padding 6, radius 14; enters at .95 over 200 ms ease-out, leaves
    // over 160 ms ease-in; rows 40 high, radius 9, padding 0 12; rows stagger 30 ms after 40.
    out property <length> menu-width: 220px;
    out property <length> menu-pad: 6px;
    out property <length> menu-radius: 14px;
    out property <length> menu-row: 40px;
    out property <length> menu-row-radius: 9px;
    out property <length> menu-row-pad: 12px;
    out property <length> menu-separator: 9px;   // a hairline rule with 4 px either side
    out property <length> menu-rule: 1px;
    out property <duration> menu-hover-ms: 150ms;   // button background .15s
    out property <duration> menu-in: 200ms;
    out property <duration> menu-out: 160ms;
    // .ur-o-dialog: min(380, 100vw - 32) wide, padding 26, radius 20; h3 19 / 560; p 14.5 muted,
    // 8 above and 22 below; actions right-aligned 8 apart; buttons 42 high, padding 0 16,
    // radius 11, 14 / 540; enters over 300 ms (.22,1,.36,1), leaves over 210 ms.
    out property <length> sheet-width: 380px;
    out property <length> sheet-margin: 16px;
    out property <length> sheet-pad: 26px;
    out property <length> sheet-radius: 20px;
    out property <length> sheet-title: 19px;
    out property <int> sheet-title-weight: 560;
    out property <length> sheet-body: 14.5px;
    out property <length> sheet-button: 42px;
    out property <length> sheet-button-radius: 11px;
    out property <length> sheet-button-pad: 16px;
    out property <length> sheet-input: 40px;
    out property <duration> sheet-in: 300ms;
    out property <float> sheet-from: 0.95;
    // .ur-o-toast: 46 high, padding 0 12, radius 14, 14 / 540; rises 14 px from .95 over a
    // 400 ms spring. Shown for 1.5 s (Chromium's zoom bubble closes after 1.5 s).
    out property <length> toast-height: 46px;
    out property <length> toast-pad: 16px;
    out property <length> toast-font: 14px;
    out property <int> toast-weight: 540;
    out property <length> toast-radius: 14px;
    out property <length> toast-rise: 14px;
    out property <duration> toast-in: 400ms;
    out property <duration> toast-out: 190ms;
    out property <duration> toast-shown: 1500ms;
    // The tab preview card (ur-o-tip numbers: scale .95 and a 3 px rise, .18 s in, .13 s out).
    out property <length> preview-width: 240px;
    out property <length> preview-pad: 10px;
    out property <length> preview-gap: 6px;
    out property <length> preview-radius: 12px;
    out property <length> preview-thumb-radius: 8px;
    out property <length> preview-rise: 3px;
    out property <length> preview-title: 13px;
    out property <length> preview-address: 11.5px;
    out property <duration> preview-in: 180ms;
    out property <duration> preview-out: 130ms;
    // The find bar: an .ur-o-surface strip at the content's top right (Chromium's place), the
    // command bar's input metrics.
    out property <length> find-width: 360px;
    out property <length> find-height: 44px;
    // The speaker glyph in a tab row (hand drawn on the 24 grid: the bucket has none).
    out property <length> speaker: 22px;
    // The permission prompt: an .ur-o-surface under the address pill (Chromium's bubble place),
    // 8 below it, 320 wide; the downloads popover: the same surface, 360 wide, rows 60 high with
    // a 3 px progress track; the error panel's column is 440 wide.
    out property <length> prompt-width: 320px;
    out property <length> prompt-gap: 8px;
    out property <length> downloads-width: 360px;
    out property <length> download-row: 60px;
    out property <length> download-track: 3px;
    out property <int> download-max-rows: 6;
    out property <length> error-width: 440px;
    out property <length> error-icon: 40px;
    // The prompt's "remember" check box: a 1 px rim, a 1.6 px tick.
    out property <length> check-rim: 1px;
    out property <length> check-tick: 1.6px;

    // The settings page (wubble://settings). Controls from the design repo's touch kit,
    // `src/wubble/pages/touch.css`: .tp-seg (padding 4, radius 14; segment 38 high, radius 10,
    // label 14 / 500), .tp-sl (track 44 high, rail 8 radius 4 at white 12 %, knob 26), and
    // .tp-tg (92 x 52, knob 42, inset 5), the toggle at half that size to sit in a row. The page
    // column and row metrics are wubble's: the design repo has no settings page.
    out property <length> settings-width: 720px;
    out property <length> settings-row: 52px;
    out property <length> settings-gap: 28px;
    out property <length> seg-pad: 4px;
    out property <length> seg-radius: 14px;
    out property <length> seg-height: 38px;
    out property <length> seg-inner-radius: 10px;
    out property <length> seg-width: 104px;
    out property <length> seg-label: 14px;
    out property <length> toggle-width: 46px;
    out property <length> toggle-height: 26px;
    out property <length> toggle-knob: 21px;
    out property <length> toggle-inset: 2.5px;
    out property <color> track: rgba(255, 255, 255, 0.12);
    out property <length> slider-height: 44px;
    out property <length> slider-rail: 8px;
    out property <length> slider-knob: 26px;
    out property <length> slider-width: 220px;
    out property <length> field-height: 36px;
    out property <length> stepper-field: 88px;
    out property <length> swatch: 22px;
    out property <duration> control-ms: 240ms;   // .tp-seg-ind background .24s
    out property <duration> seg-label-ms: 200ms; // .tp-seg-btn color .2s
    // .tp-tg-knob box-shadow 0 3px 8px / .4; .tp-seg-ind 0 4px 12px / .35; .tp-sl-knob 0 6px 14px / .5
    out property <length> toggle-shadow-blur: 8px;
    out property <length> toggle-shadow-y: 3px;
    out property <color> toggle-shadow: rgba(0, 0, 0, 0.4);
    out property <length> seg-shadow-blur: 12px;
    out property <length> seg-shadow-y: 4px;
    out property <color> seg-shadow: rgba(0, 0, 0, 0.35);
    out property <length> slider-shadow-blur: 14px;
    out property <length> slider-shadow-y: 6px;
    out property <color> slider-shadow: rgba(0, 0, 0, 0.5);
    // a section's card on the page's glass, and the ring round the chosen Space colour
    out property <color> settings-card: rgba(255, 255, 255, 0.04);
    out property <length> swatch-ring: 2px;
    // the history, bookmarks and passwords rows (wubble's: the design repo has no list page)
    out property <length> page-row: 44px;
    out property <length> page-indent: 20px;
    out property <length> page-favicon: 16px;
}

import { Colors, Radius, Sizes, Spacing, Type } from "tokens.slint";
import { TabItem, SpaceItem, CommandResult, CommandKind, CommandBarState, CommandBarEvent } from "components/model.slint";
import { CommandBar } from "components/command-bar.slint";
import { Sidebar } from "components/sidebar.slint";

export { TabItem, SpaceItem, Colors, CommandResult, CommandKind, CommandBarState }

export component AppWindow inherits Window {
    title: "wubble";
    preferred-width: Sizes.window-width;
    preferred-height: Sizes.window-height;
    background: Colors.abyss;
    default-font-family: Type.ui;
    default-font-size: Type.body;

    // The active tab's frame, supplied by wubble-gfx as a wgpu-backed image.
    in property <image> web-frame;
    // The part of web-frame to show, in image pixels from the top left. CEF
    // can paint a pixel more than the rectangle at fractional scales; that
    // pixel is cropped rather than the whole frame resampled.
    in property <int> web-frame-clip-width;
    in property <int> web-frame-clip-height;
    // The rectangle the web frame fills, in logical pixels. The host sizes
    // the browser from these and the window's scale factor.
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;

    // Input over the web content, in view-relative logical pixels. The host
    // forwards it to the page; nothing here interprets it.
    // The page's pointer shape: an index into `cursors`.
    in property <int> web-cursor;
    // The web content has keyboard focus (the host sends it keys only then).
    out property <bool> web-focused: web-focus.has-focus;
    callback web-pointer-moved(x: length, y: length);
    callback web-pointer-left(x: length, y: length);
    callback web-pointer-pressed(button: PointerEventButton, x: length, y: length);
    callback web-pointer-released(button: PointerEventButton, x: length, y: length);
    // The pointer grab ended without a release.
    callback web-pointer-cancelled();
    callback web-scrolled(x: length, y: length, delta-x: length, delta-y: length);
    callback web-focus-changed(focused: bool);

    in property <string> address-host <=> sidebar.address-host;
    in property <string> address-path <=> sidebar.address-path;
    in property <[TabItem]> pinned-tabs <=> sidebar.pinned-tabs;
    in property <[TabItem]> tabs <=> sidebar.tabs;
    in property <[SpaceItem]> spaces <=> sidebar.spaces;
    in property <int> active-tab-id <=> sidebar.active-tab-id;
    in property <int> active-space-id <=> sidebar.active-space-id;

    callback tab-activated <=> sidebar.tab-activated;
    callback tab-closed <=> sidebar.tab-closed;
    out property <CommandBarState> command-bar-state <=> bar.state;
    in property <[CommandResult]> command-results <=> bar.results;
    in-out property <string> command-query <=> bar.query;
    callback command-query-changed <=> bar.query-changed;
    callback command-result-chosen <=> bar.result-chosen;
    callback command-dismissed <=> bar.dismissed;
    // Intents: the bar opens itself; Rust may prefill the query.
    callback new-tab-requested();
    callback space-switched <=> sidebar.space-switched;
    callback address-focus-requested();
    // Ctrl+W: close the visible tab.
    callback close-tab-requested();

    public function request-new-tab() {
        bar.dispatch(CommandBarEvent.open);
        root.new-tab-requested();
    }

    public function request-address-focus() {
        bar.dispatch(CommandBarEvent.open);
        root.address-focus-requested();
    }

    // The engine's `Cursor` (wubble-engine nav.rs), in its order; anything
    // out of range shows the default.
    property <[MouseCursor]> cursors: [
        MouseCursor.default,
        MouseCursor.none,
        MouseCursor.pointer,
        MouseCursor.text,
        MouseCursor.wait,
        MouseCursor.progress,
        MouseCursor.crosshair,
        MouseCursor.move,
        MouseCursor.not-allowed,
        MouseCursor.help,
        MouseCursor.grab,
        MouseCursor.grabbing,
        MouseCursor.ns-resize,
        MouseCursor.ew-resize,
        MouseCursor.nesw-resize,
        MouseCursor.nwse-resize,
    ];

    root-keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + T);
            activated => {
                root.request-new-tab();
            }
        }
        KeyBinding {
            keys: @keys(Control + L);
            activated => {
                root.request-address-focus();
            }
        }
        KeyBinding {
            keys: @keys(Control + W);
            activated => {
                root.close-tab-requested();
            }
        }

        HorizontalLayout {
            padding: Spacing.s2;
            spacing: Spacing.s2;

            sidebar := Sidebar {
                width: Sizes.sidebar-width;
                new-tab-requested => {
                    root.request-new-tab();
                }
                address-activated => {
                    root.request-address-focus();
                }
            }

            content := Rectangle {
                border-radius: Radius.md;
                clip: true;
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.web-frame;
                    source-clip-width: root.web-frame-clip-width;
                    source-clip-height: root.web-frame-clip-height;
                    image-fit: fill;
                }
                // Over the frame and under the command bar, so the bar takes
                // its own pointer events and the page only gets the rest.
                web-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    changed has-focus => {
                        root.web-focus-changed(self.has-focus);
                    }
                    TouchArea {
                        mouse-cursor: root.cursors[root.web-cursor];
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                web-focus.focus();
                                root.web-pointer-pressed(event.button, self.mouse-x, self.mouse-y);
                            } else if event.kind == PointerEventKind.up {
                                root.web-pointer-released(event.button, self.mouse-x, self.mouse-y);
                            } else if event.kind == PointerEventKind.move {
                                root.web-pointer-moved(self.mouse-x, self.mouse-y);
                            } else {
                                root.web-pointer-cancelled();
                            }
                        }
                        scroll-event(event) => {
                            root.web-scrolled(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y);
                            accept
                        }
                        changed has-hover => {
                            if !self.has-hover {
                                root.web-pointer-left(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                }
                bar := CommandBar {
                    closed => {
                        web-focus.focus();
                    }
                }
            }
        }
    }

    init => {
        web-focus.focus();
    }
}

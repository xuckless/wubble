// Placeholder shell. Real layout comes from the UX pack (see /ux).

export component AppWindow inherits Window {
    title: "wubble";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #111114;

    // The active tab's frame, supplied by wubble-gfx as a wgpu-backed image.
    in property <image> web-frame;

    HorizontalLayout {
        sidebar := Rectangle {
            width: 240px;
            background: #18181c;
        }
        content := Rectangle {
            Image {
                width: 100%;
                height: 100%;
                source: root.web-frame;
            }
        }
    }
}

// The browser window. Laid out like the design repo's port (src/wubble/slint/demo.slint,
// xuckless/the-wallpaper-project @ 6c840da): the sidebar at the inset, the web view beside it
// once the sidebar has width, the seam over both. Peek is from chrome.tsx (the port has none).

import { Palette, Radius, Chrome, Fonts, Type, Motion, Spacing } from "tokens.slint";
import { Shell } from "app-tokens.slint";
import { Seam, GlassPanel, SplitView, SplitPane, SplitSeam } from "components.slint";
import { TabItem, SpaceItem, WindowEdge, Origin, CommandResult, CommandKind, CommandBarState, CommandBarEvent, SidebarMode, GlassTier, SideEdges, GlassItem, GlassLayer, GlassKeys, MenuEntry, MenuView, DialogView, FindView, PopupView, PermissionView, ErrorView, DownloadItem, DownloadAction, DownloadStatus } from "components/model.slint";
import { CommandBar } from "components/command-bar.slint";
import { ContextMenu } from "components/context-menu.slint";
import { DialogSheet } from "components/dialog-sheet.slint";
import { PermissionPrompt } from "components/permission-prompt.slint";
import { ErrorPanel } from "components/error-panel.slint";
import { DownloadsPopover } from "components/downloads-popover.slint";
import { FindBar } from "components/find-bar.slint";
import { Toast } from "components/toast.slint";
import { PopupLayer } from "components/popup-layer.slint";
import { Sidebar } from "components/sidebar.slint";
import { GlowRing } from "components/glow-ring.slint";
import { WindowEdges, MoveArea } from "components/window-frame.slint";

import "fonts/Fredoka-Variable.ttf";
import "fonts/Geist-Variable.ttf";
import "fonts/GeistMono-Variable.ttf";

export { SplitPane, SplitSeam, TabItem, SpaceItem, CommandResult, CommandKind, CommandBarState, SidebarMode, GlassTier, SideEdges, GlassItem, GlassLayer, GlassKeys, WindowEdge, Chrome, Radius, MenuEntry, MenuView, DialogView, FindView, PopupView, PermissionView, ErrorView, DownloadItem, DownloadAction, DownloadStatus }

export component AppWindow inherits Window {
    title: "wubble";
    preferred-width: Shell.window-width;
    preferred-height: Shell.window-height;
    min-width: Chrome.windowMinW;
    min-height: Chrome.windowMinH;
    // wubble draws its own window (TODO Decided: frameless). The ground below is the window's
    // colour, rounded where the platform can show transparent corners.
    no-frame: true;
    background: transparent;
    default-font-family: Fonts.ui;
    default-font-size: Type.body.size;

    // The living backdrop and the glass (wubble_gfx::scene), rendered by the host each frame
    // into one opaque wgpu texture; shown at the very back while GlassLayer.scene-active.
    in property <image> scene;
    // The pages on screen, left to right (one, or the panes of a split): each one's frame,
    // supplied by wubble-gfx as a wgpu-backed image, and where it sits in the content area. The
    // host writes them; a pane's id is its tab's.
    in property <[SplitPane]> panes;
    // The split's seams and the focused pane's ring (wubble_core::split), "" for one page.
    in property <[SplitSeam]> seams;
    in property <string> focus-ring;
    // The rectangle the panes share, in logical pixels. The host sizes the
    // pages from these and the window's scale factor.
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;
    // Its top left in the window (its layout fills the window from 0,0); the
    // frames smoke samples the snapshot there.
    out property <length> content-x: content.x;
    out property <length> content-y: content.y;

    // Input over the web content: the pane's id, then pane-relative logical
    // pixels. The host forwards it to that pane's page; nothing here interprets it.
    // The page's pointer shape: an index into `cursors`.
    in property <int> web-cursor;
    // The web content has keyboard focus (the host sends it keys only then).
    out property <bool> web-focused: web-focus.has-focus;
    callback web-pointer-moved(pane: int, x: length, y: length);
    callback web-pointer-left(pane: int, x: length, y: length);
    callback web-pointer-pressed(pane: int, button: PointerEventButton, x: length, y: length);
    callback web-pointer-released(pane: int, button: PointerEventButton, x: length, y: length);
    // The pointer grab ended without a release.
    callback web-pointer-cancelled(pane: int);
    callback web-scrolled(pane: int, x: length, y: length, delta-x: length, delta-y: length);
    callback web-focus-changed(focused: bool);
    // The split's seams (index, pointer in content px) and a pane's close button.
    callback split-grab(int, length, length);
    callback split-drag(length, length);
    callback split-release();
    callback split-even();
    callback pane-close(int);

    // Window frame. Intents only; wubble_ui::window acts on them.
    callback window-close-requested <=> sidebar.window-close-requested;
    callback window-minimise-requested <=> sidebar.window-minimise-requested;
    callback window-toggle-fullscreen-requested <=> sidebar.window-toggle-fullscreen-requested;
    callback window-begin-resize(WindowEdge);
    // A drag on bare chrome (the gutters, the sidebar's glass) moves the window; a double-click
    // there maximises it or restores it.
    callback window-begin-move();
    callback window-toggle-maximise-requested();
    // The visible page's history, for the sidebar's back and forward buttons.
    in property <bool> can-go-back <=> sidebar.can-go-back;
    in property <bool> can-go-forward <=> sidebar.can-go-forward;
    // A shell button asks for a wubble `Action`, by its id (wubble-core action.rs).
    callback shell-action <=> sidebar.action;
    // The platform can show a transparent window background (window.rs `Platform`).
    in property <bool> rounded-corners: false;
    // Square when full screen or maximised, or when the platform cannot show the corners.
    out property <length> window-radius: root.rounded-corners && !root.full-screen && !root.maximized ? Radius.window : 0px;
    out property <bool> window-resizable: !root.full-screen && !root.maximized;
    in property <bool> address-loading <=> sidebar.address-loading;
    // The loading sheen's opacity (0 at rest).
    out property <float> address-sheen <=> sidebar.address-sheen;
    out property <int> command-shown-rows <=> bar.shown-rows;

    in property <string> address-host <=> sidebar.address-host;
    in property <string> address-path <=> sidebar.address-path;
    in property <[TabItem]> pinned-tabs <=> sidebar.pinned-tabs;
    in property <[TabItem]> tabs <=> sidebar.tabs;
    in property <[SpaceItem]> spaces <=> sidebar.spaces;
    in property <int> active-tab-id <=> sidebar.active-tab-id;
    in property <int> active-space-id <=> sidebar.active-space-id;

    // ── driven by wubble_ui::driver once per rendered frame ──
    // tabs.rs: rows, the indicator (its row, -1 for none), the Space capsule
    in property <[length]> row-y <=> sidebar.row-y;
    in property <[float]> row-scale <=> sidebar.row-scale;
    in property <int> selected-row <=> sidebar.selected;
    in property <length> indicator-y <=> sidebar.indicator-y;
    in property <float> indicator-stretch <=> sidebar.indicator-stretch;
    in property <float> indicator-origin <=> sidebar.indicator-origin;
    in property <int> space-index <=> sidebar.space-index;
    in property <length> capsule-offset <=> sidebar.capsule-offset;
    in property <float> capsule-stretch <=> sidebar.capsule-stretch;
    in property <float> capsule-origin <=> sidebar.capsule-origin;
    // seam.rs: the mode (Seam owns it), the width spring, contents a beat behind, the string
    in property <SidebarMode> sidebar-mode: SidebarMode.extended;
    in property <length> sidebar-width: Chrome.sidebarDefault;
    in property <length> sidebar-contents: Chrome.sidebarDefault; // max(Seam.contents, w > 100 ? min : rail)
    in property <float> sidebar-opacity: 1;                       // min(1, w / rail)²
    in property <bool> sidebar-rail: false;
    in property <length> sidebar-saved: Chrome.sidebarDefault;    // Seam.saved: the peek's width
    in property <string> seam-path;
    in property <bool> seam-bowed: false;
    // scroller.rs: the tab list
    in property <length> scroll-y <=> sidebar.scroll-y;
    in property <length> thumb-top <=> sidebar.thumb-top;
    in property <length> thumb-height <=> sidebar.thumb-height;
    in property <bool> thumb-visible <=> sidebar.thumb-visible;
    out property <length> row-pitch: sidebar.pitch;
    out property <length> scroll-viewport: sidebar.scroll-viewport;
    out property <length> scroll-content: sidebar.scroll-content;

    // Pointer reports for the driver, in window coordinates.
    callback tab-press <=> sidebar.tab-press;
    callback tab-drag <=> sidebar.tab-drag;
    callback tab-release <=> sidebar.tab-release;
    callback seam-grab(length, length);
    callback seam-drag(length, length);
    callback seam-release();
    callback seam-double-clicked();
    callback scroll-wheel <=> sidebar.scroll-wheel;
    callback scroll-touch-down <=> sidebar.scroll-touch-down;
    callback scroll-touch-move <=> sidebar.scroll-touch-move;
    callback scroll-touch-up <=> sidebar.scroll-touch-up;
    callback scroll-thumb-down <=> sidebar.scroll-thumb-down;
    callback scroll-thumb-move <=> sidebar.scroll-thumb-move;
    callback scroll-thumb-up <=> sidebar.scroll-thumb-up;
    callback sidebar-toggle-requested();
    // The models or the active ids changed: the driver re-reads them.
    callback shell-model-changed();
    changed tabs => {
        root.shell-model-changed();
    }
    changed active-tab-id => {
        root.shell-model-changed();
    }
    changed spaces => {
        root.shell-model-changed();
    }
    changed active-space-id => {
        root.shell-model-changed();
    }
    changed pinned-tabs => {
        root.shell-model-changed();
    }

    callback tab-activated <=> sidebar.tab-activated;
    callback tab-closed <=> sidebar.tab-closed;
    callback tab-mute-toggled <=> sidebar.tab-mute-toggled;
    // A tab row's right click: (tab id, pointer in window px).
    callback tab-context <=> sidebar.tab-context;
    // A row was dragged to a new slot: (tab id, its new index in `tabs`).
    callback tab-moved(int, int);
    out property <CommandBarState> command-bar-state <=> bar.state;
    // Where the bar grows from (window coordinates); set when it opens.
    in-out property <Origin> command-origin <=> bar.origin;
    in property <[CommandResult]> command-results <=> bar.results;
    in-out property <string> command-query <=> bar.query;
    callback command-query-changed <=> bar.query-changed;
    callback command-result-chosen <=> bar.result-chosen;
    callback command-dismissed <=> bar.dismissed;
    // Intents: the bar opens itself; Rust may prefill the query.
    callback new-tab-requested();
    callback space-switched <=> sidebar.space-switched;
    callback address-focus-requested();
    // The bar opens to choose a page to put beside the focused one (split view).
    callback beside-requested();

    public function request-new-tab() {
        root.command-origin = sidebar.new-tab-origin;
        bar.dispatch(CommandBarEvent.open);
        root.new-tab-requested();
    }

    // Hidden opens the extended sidebar; extended or rail hide it (chrome.tsx `cycleSidebar`).
    public function toggle-sidebar() {
        root.sidebar-toggle-requested();
    }

    public function request-address-focus() {
        root.command-origin = sidebar.address-origin;
        bar.dispatch(CommandBarEvent.open);
        root.address-focus-requested();
    }

    public function request-beside() {
        root.command-origin = sidebar.address-origin;
        bar.dispatch(CommandBarEvent.open);
        root.beside-requested();
    }

    // ── The page's own UI (wubble surface.rs, menu.rs, screen.rs): the visible tab's surfaces,
    // written by the host; the components report intents through these callbacks.
    // The page is full screen: the content fills the window, the sidebar and frame hide.
    in property <bool> page-fullscreen: false;
    in property <MenuView> menu;
    callback menu-chosen(int);
    callback menu-dismissed();
    out property <length> menu-panel-x: menu-ui.panel-x;
    in property <DialogView> dialog;
    // (accept, a prompt's text or the sign-in's user name, the sign-in's password)
    callback dialog-answered(bool, string, string);
    in property <PermissionView> permission;
    // (allow, remember for this site)
    callback permission-answered(bool, bool);
    in property <ErrorView> page-error;
    // The error panel's default button (Reload, or Go back) and its second (Proceed).
    callback error-primary();
    callback error-secondary();
    // The downloads list (newest first) and its buttons: (entry id, what).
    in property <[DownloadItem]> downloads;
    callback download-action(int, DownloadAction);
    // The popover is open (presentation only; the list is the host's).
    in-out property <bool> downloads-open: false;
    changed downloads => {
        if root.downloads.length == 0 {
            root.downloads-open = false;
        }
    }
    in property <FindView> find;
    callback find-edited(string);
    // true: next match, false: previous.
    callback find-step(bool);
    callback find-closed();
    // A brief notice (zoom level, "Esc to exit"); bump the serial to show it.
    in property <string> toast-text;
    in property <int> toast-serial;
    in property <PopupView> popup;
    in property <image> popup-frame;

    // Puts `text` on the clipboard through Slint's own (no clipboard crate): a hidden field
    // selects it and copies.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // One overlay holds the keyboard at a time: the menu, else the downloads popover, else the
    // dialog (or sign-in), else the error panel, else the page. The permission prompt never takes
    // it: a key meant for the page must not answer it (keyjacking), as Chromium's bubble. The
    // find bar takes it only when asked (Mod+F), and gives it back to the page when it closes.
    property <bool> menu-open: root.menu.open;
    property <bool> dialog-open: root.dialog.open;
    property <bool> error-open: root.page-error.open;
    property <bool> find-open: root.find.open;
    property <int> find-focus: root.find.focus-serial;
    property <bool> overlay-open: root.menu.open || root.downloads-open || root.dialog.open || root.page-error.open;
    function settle-focus() {
        if root.menu.open {
            menu-ui.take-focus();
        } else if root.downloads-open {
            downloads-ui.take-focus();
        } else if root.dialog.open {
            sheet.take-focus();
        } else if root.page-error.open {
            error-ui.take-focus();
        } else {
            web-focus.focus();
        }
    }
    changed menu-open => {
        root.settle-focus();
    }
    changed dialog-open => {
        root.settle-focus();
    }
    changed error-open => {
        root.settle-focus();
    }
    changed downloads-open => {
        root.settle-focus();
    }
    changed find-focus => {
        if root.find.open && !root.overlay-open {
            find-ui.take-focus();
        }
    }
    changed find-open => {
        if !root.find-open && !root.overlay-open && bar.state == CommandBarState.closed {
            web-focus.focus();
        }
    }

    // Peek (chrome.tsx): a hidden sidebar slides in over the page, on thick glass at its saved
    // width, once the pointer has rested in the edge strip; it leaves once the pointer has been
    // off it for a while. Presentation only: `peek` never outlives the hidden mode.
    in-out property <bool> peek: false;
    out property <bool> peeking: root.peek && root.sidebar-mode == SidebarMode.hidden;
    // The peek panel's glowing border (GlowRing, as the address pill's): steady while peeking.
    out property <float> peek-glow: root.peeking ? 1 : 0;
    animate peek-glow {
        duration: Shell.peek-slide;
        easing: Motion.easeOut;
    }
    out property <SideEdges> side-edges <=> sidebar.edges;
    changed sidebar-mode => {
        if (root.sidebar-mode != SidebarMode.hidden) {
            root.peek = false;
        }
    }
    // The pointer is in the strip a hidden sidebar peeks from.
    property <bool> at-edge: !root.page-fullscreen && (edge.has-hover || edges.west-hovered);
    // Hidden and closed, or peeking (chrome.tsx: the peek panel shows at once, even mid-close).
    property <bool> hidden-at-rest: root.sidebar-mode == SidebarMode.hidden && (root.peek || root.sidebar-width <= Shell.sidebar-open);
    property <length> peek-offset: root.peeking ? 0px : -(root.sidebar-saved + Shell.peek-travel + Chrome.inset);
    property <float> peek-alpha: root.peeking ? 1 : Shell.peek-from;
    animate peek-offset, peek-alpha {
        duration: Shell.peek-slide;
        easing: Motion.easeOut;
    }

    // The engine's `Cursor` (wubble-engine nav.rs), in its order; anything
    // out of range shows the default.
    property <[MouseCursor]> cursors: [
        MouseCursor.default,
        MouseCursor.none,
        MouseCursor.pointer,
        MouseCursor.text,
        MouseCursor.wait,
        MouseCursor.progress,
        MouseCursor.crosshair,
        MouseCursor.move,
        MouseCursor.not-allowed,
        MouseCursor.help,
        MouseCursor.grab,
        MouseCursor.grabbing,
        MouseCursor.ns-resize,
        MouseCursor.ew-resize,
        MouseCursor.nesw-resize,
        MouseCursor.nwse-resize,
    ];

    // The bottom layer: the scene (the design's demo.slint `Image { source: root.scene }`, first
    // child), rounded with the window; without the scene the plain ground.
    if GlassLayer.scene-active: Rectangle {
        clip: true;
        border-radius: root.window-radius;
        Image {
            width: 100%;
            height: 100%;
            source: root.scene;
            image-fit: fill;
        }
    }
    ground := Rectangle {
        visible: !GlassLayer.scene-active;
        background: Palette.abyss;
        border-radius: root.window-radius;
    }
    // The design's `wb-frame-drag`: the gutters and any glass without a control move the window.
    MoveArea {
        enabled: !root.full-screen;
        begin-move => {
            root.window-begin-move();
        }
        toggle-maximise => {
            root.window-toggle-maximise-requested();
        }
    }
    clip := TextInput {
        width: 0px;
        height: 0px;
        opacity: 0;
        read-only: true;
    }

    // Shortcuts are routed in Rust (wubble `input::key_route`, the
    // `wubble_core::keys` table), not here.
    root-keys := FocusScope {
        // It fills the window: taking focus on a click would swallow every press on bare
        // chrome (the gutters), so the move area under it would never see one.
        focus-on-click: false;
        // In page fullscreen the page fills the window, square.
        property <length> gap: root.page-fullscreen ? 0px : Chrome.inset;
        content := Rectangle {
            // On whole physical pixels, so the page's frame is shown 1:1: the seam's spring and
            // a dragged width are fractional, and a fractional rectangle resamples the page.
            x: root.page-fullscreen ? 0px : round((Chrome.inset + (root.sidebar-width > Shell.sidebar-open ? root.sidebar-width + Chrome.inset : 0px)) / 1phx) * 1phx;
            y: parent.gap;
            width: round((parent.width - self.x - parent.gap) / 1phx) * 1phx;
            height: parent.height - 2 * parent.gap;
            border-radius: root.page-fullscreen ? 0px : Radius.md;
            clip: true;
            // Between split panes the window's glass shows (the design's `.wb-split` web view).
            background: root.panes.length > 1 ? transparent : Palette.web;
            // Over the frames and under the command bar, so the bar takes
            // its own pointer events and the pages only get the rest.
            web-focus := FocusScope {
                width: 100%;
                height: 100%;
                changed has-focus => {
                    root.web-focus-changed(self.has-focus);
                }
                SplitView {
                    panes: root.panes;
                    seams: root.seams;
                    ring: root.focus-ring;
                    accent: root.space-index >= 0 && root.space-index < root.spaces.length ? root.spaces[root.space-index].tint : Palette.sky;
                    radius: root.page-fullscreen ? 0px : Radius.md;
                    cursor: root.cursors[root.web-cursor];
                    pointer-pressed(pane, button, x, y) => {
                        web-focus.focus();
                        root.web-pointer-pressed(pane, button, x, y);
                    }
                    pointer-released(pane, button, x, y) => {
                        root.web-pointer-released(pane, button, x, y);
                    }
                    pointer-moved(pane, x, y) => {
                        root.web-pointer-moved(pane, x, y);
                    }
                    pointer-left(pane, x, y) => {
                        root.web-pointer-left(pane, x, y);
                    }
                    pointer-cancelled(pane) => {
                        root.web-pointer-cancelled(pane);
                    }
                    scrolled(pane, x, y, dx, dy) => {
                        root.web-scrolled(pane, x, y, dx, dy);
                    }
                    seam-grab(j, x, y) => {
                        root.split-grab(j, x, y);
                    }
                    seam-drag(x, y) => {
                        root.split-drag(x, y);
                    }
                    seam-release => {
                        root.split-release();
                    }
                    seam-even => {
                        root.split-even();
                    }
                    pane-close(id) => {
                        root.pane-close(id);
                    }
                }
            }
            find-ui := FindBar {
                x: parent.width - self.width - Spacing.s3;
                y: Spacing.s3;
                find: root.find;
                edited(q) => {
                    root.find-edited(q);
                }
                step(forward) => {
                    root.find-step(forward);
                }
                closed => {
                    root.find-closed();
                }
            }
            Toast {
                x: (parent.width - self.width) / 2;
                y: Spacing.s4;
                text: root.toast-text;
                serial: root.toast-serial;
            }
            // Over the page and its find bar, under the dialog: the page's error.
            error-ui := ErrorPanel {
                error: root.page-error;
                primary => {
                    root.error-primary();
                }
                secondary => {
                    root.error-secondary();
                }
            }
            // Tab-modal: over the page and its find bar, under the command bar.
            sheet := DialogSheet {
                dialog: root.dialog;
                answered(accept, text, secret) => {
                    root.dialog-answered(accept, text, secret);
                }
            }
            bar := CommandBar {
                closed => {
                    web-focus.focus();
                }
            }
        }

        // The strip a hidden sidebar peeks from (.wb-peek-edge, 18 wide from the left edge). The
        // west resize strip lies over its first pixels and counts as the strip too, so a pointer
        // pushed against the screen's edge peeks, whether or not the window can be resized.
        edge := TouchArea {
            x: 0px;
            width: Chrome.peekEdge + Chrome.inset;
            height: parent.height;
            enabled: root.sidebar-mode == SidebarMode.hidden && !root.page-fullscreen;
        }
        Timer {
            interval: Shell.peek-in;
            running: root.at-edge && root.sidebar-mode == SidebarMode.hidden && !root.peek;
            triggered => {
                root.peek = true;
            }
        }
        Timer {
            interval: Shell.peek-out;
            running: root.peeking && !zone.has-hover && !root.at-edge;
            triggered => {
                root.peek = false;
            }
        }

        // The sidebar sits inside its hover zone, so the zone keeps has-hover
        // while the pointer is over a child row.
        zone := TouchArea {
            visible: !root.page-fullscreen;
            x: root.hidden-at-rest ? root.peek-offset : 0px;
            y: 0px;
            width: Chrome.inset + sidebar.width;
            height: parent.height;

            // The sidebar's Regular glass, drawn by the scene up to the seam. Slint-only glass has
            // no sidebar panel (the plain ground shows), as before the scene.
            GlassPanel {
                key: GlassKeys.sidebar;
                x: sidebar.x;
                y: sidebar.y;
                width: root.sidebar-width;
                height: sidebar.height;
                tier: GlassTier.regular;
                radius: Radius.lg;
                over-wgpu: true;
                visible: GlassLayer.scene-active;
                present: !root.hidden-at-rest && root.sidebar-width > Shell.sidebar-open && !root.page-fullscreen;
            }

            // the peek's own glass (.wb-side-peek: thick, radius 20)
            GlassPanel {
                x: sidebar.x;
                y: sidebar.y;
                width: sidebar.width;
                height: sidebar.height;
                tier: GlassTier.thick;
                radius: Radius.lg;
                over-content: true;
                visible: root.hidden-at-rest;
                opacity: root.peek-alpha;
                GlowRing {
                    radius: Radius.lg;
                    strength: root.peek-glow;
                    sweep: false;
                }
            }

            sidebar := Sidebar {
                x: Chrome.inset;
                y: Chrome.inset;
                width: root.hidden-at-rest ? root.sidebar-saved : root.sidebar-width;
                content-width: root.hidden-at-rest ? root.sidebar-saved : root.sidebar-contents;
                height: parent.height - 2 * Chrome.inset;
                opacity: root.hidden-at-rest ? root.peek-alpha : root.sidebar-opacity;
                compact: root.hidden-at-rest ? false : root.sidebar-rail;
                // Over the peek's Slint glass (and the page) the scene cannot show: Slint draws.
                glass-over-wgpu: GlassLayer.scene-active && !root.hidden-at-rest && root.sidebar-width > Shell.sidebar-open;
                floating: root.hidden-at-rest;
                window-movable: !root.full-screen;
                window-move-requested => {
                    root.window-begin-move();
                }
                window-maximise-requested => {
                    root.window-toggle-maximise-requested();
                }
                new-tab-requested => {
                    root.request-new-tab();
                }
                address-activated => {
                    root.request-address-focus();
                }
                has-downloads: root.downloads.length > 0;
                downloads-requested => {
                    root.downloads-open = !root.downloads-open;
                }
            }
        }

        // Over everything, so the bowed string draws on top of the web view. Its frame is the
        // web view's frame (inset on every side), which is what Seam::clip draws in.
        Seam {
            x: Chrome.inset;
            y: Chrome.inset;
            width: parent.width - Chrome.inset * 2;
            height: parent.height - Chrome.inset * 2;
            visible: root.sidebar-mode != SidebarMode.hidden && !root.page-fullscreen;
            seam-x: root.sidebar-width + Chrome.inset / 2;
            seam-path: root.seam-path;
            bowed: root.seam-bowed;
            grab(x, y) => {
                root.seam-grab(x, y);
            }
            drag(x, y) => {
                root.seam-drag(x, y);
            }
            release => {
                root.seam-release();
            }
            double-clicked => {
                root.seam-double-clicked();
            }
        }
    }

    // The page's popup widget may leave the page's rectangle (not the window's). It belongs to
    // the focused page, whose pane id is the active tab's.
    PopupLayer {
        popup: root.popup;
        frame: root.popup-frame;
        pointer-moved(x, y) => {
            root.web-pointer-moved(root.active-tab-id, x, y);
        }
        pointer-pressed(button, x, y) => {
            root.web-pointer-pressed(root.active-tab-id, button, x, y);
        }
        pointer-released(button, x, y) => {
            root.web-pointer-released(root.active-tab-id, button, x, y);
        }
        scrolled(x, y, dx, dy) => {
            root.web-scrolled(root.active-tab-id, x, y, dx, dy);
        }
    }

    // Above everything: the resize zones of the frameless window.
    edges := WindowEdges {
        resizable: root.window-resizable && !root.page-fullscreen;
        begin(edge) => {
            root.window-begin-resize(edge);
        }
    }

    // The permission prompt hangs under the address pill where the sidebar shows it, else at the
    // page's top left. Not modal: no scrim.
    property <bool> pill-shown: !root.page-fullscreen && (root.peeking || (!root.hidden-at-rest && root.sidebar-width > Shell.sidebar-open));
    permission-ui := PermissionPrompt {
        x: root.pill-shown ? sidebar.address-below.x : content.x + Spacing.s3;
        y: root.pill-shown ? sidebar.address-below.y + Shell.prompt-gap : content.y + Spacing.s3;
        prompt: root.permission;
        answered(allow, remember) => {
            root.permission-answered(allow, remember);
        }
    }

    downloads-ui := DownloadsPopover {
        open: root.downloads-open;
        anchor-x: sidebar.downloads-anchor.x;
        anchor-y: sidebar.downloads-anchor.y + Shell.prompt-gap;
        items: root.downloads;
        action(id, what) => {
            root.download-action(id, what);
        }
        dismissed => {
            root.downloads-open = false;
        }
    }

    // The context menu, over the whole window: a click anywhere else dismisses it.
    menu-ui := ContextMenu {
        open: root.menu.open;
        anchor-x: root.menu.x;
        anchor-y: root.menu.y;
        entries: root.menu.entries;
        chosen(i) => {
            root.menu-chosen(i);
        }
        dismissed => {
            root.menu-dismissed();
        }
    }

    init => {
        web-focus.focus();
    }
}

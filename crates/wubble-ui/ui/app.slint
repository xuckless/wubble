// The browser window. Laid out like the design repo's port (src/wubble/slint/demo.slint,
// xuckless/the-wallpaper-project @ 6c840da): the sidebar at the inset, the web view beside it
// once the sidebar has width, the seam over both. Peek is from chrome.tsx (the port has none).

import { Palette, Radius, Chrome, Fonts, Type, Motion, Space } from "kit/gen/tokens.slint";
import { Calm } from "kit/motion/calm.slint";
import { Shell } from "kit/derived.slint";
import { SidePeek, SideMode, PeekCue } from "kit/chrome/sidebar.slint";
import { Seam } from "kit/controls/seam.slint";
import { GlassPanel } from "kit/material/glass.slint";
import { SplitView, SplitPane, SplitSeam } from "kit/chrome/split-view.slint";
// The generated kit (tools/fidelity/extract.mjs), imported so every build compiles it; the
// lanes move call sites onto it.
import { Palette as GenPalette } from "kit/gen/tokens.slint";
import { BrowserCss as GenBrowserCss } from "kit/gen/css.slint";
import { BrowserIcons as GenBrowserIcons } from "kit/gen/icons.slint";
import { TabItem, SpaceItem, WindowEdge, Origin, CommandResult, CommandKind, CommandBarState, CommandMode, CommandPlacement, FocusRegion, SidebarMode, GlassTier, SideEdges, BeamShape, LeavingRow, GlassItem, GlassLayer, GlassKeys, GlassOver, MenuEntry, MenuView, DialogView, FindView, PopupView, PermissionView, PreviewView, TipView, ErrorView, DownloadItem, DownloadAction, DownloadStatus, SettingItem, SettingControl, BindingItem, CaptureView, SpaceSetting, AboutView, UpdatesView, EntryItem, FilterListItem, InternalPageKind, HistoryLineItem, BookmarkLineItem, FolderChoiceItem, BookmarkSheetView, PrintSheetView, LoginItem, PasswordsView, VaultState, TaskItem, TaskAction, VideoMark, VideoView, BoostView, AxItemView, AxKind, ExtensionItem, ExtensionAction, ExtensionPrompt, ExtensionPopup } from "components/model.slint";
// start page (L7): the new-tab page's front and its bridge to the host (host/start.rs)
import { StartPage, StartBridge, StartSite } from "kit/pages/start.slint";
export { StartBridge, StartSite }
import { CommandBar } from "kit/chrome/command-bar.slint";
import { GlanceCard } from "components/glance-card.slint";
import { GlanceView, SpacesMenuRow, SpacesMenuGeometry, PageLinkItem } from "components/model.slint";
import { ContextMenu } from "components/context-menu.slint";
import { DialogSheet } from "components/dialog-sheet.slint";
import { PermissionPrompt } from "components/permission-prompt.slint";
import { AutofillAnswer, AutofillMenu, AutofillView } from "components/autofill-menu.slint";
import { ErrorPanel } from "components/error-panel.slint";
import { SettingsPage } from "components/settings.slint";
import { HistoryPage, BookmarksPage, DownloadsPage, PasswordsPage, TasksPage } from "components/pages.slint";
import { BookmarkSheet } from "components/bookmark-sheet.slint";
import { PrintSheet } from "components/print-sheet.slint";
import { SwipeChip } from "components/swipe-chip.slint";
import { DownloadsPopover } from "components/downloads-popover.slint";
import { ExtensionsPopover } from "components/extensions-popover.slint";
import { ExtensionPopupCard } from "components/extension-popup.slint";
import { ExtensionSheet } from "components/extension-sheet.slint";
import { SpacesMenu } from "kit/chrome/spaces-menu.slint";
import { FindBar } from "components/find-bar.slint";
import { Toast } from "components/toast.slint";
import { PreviewCard } from "components/preview-card.slint";
import { Tooltip, Tips } from "components/tooltip.slint";
import { ShotOverlay } from "components/shot-overlay.slint";
import { ReaderControls } from "components/reader-controls.slint";
import { VideoControls } from "components/video-controls.slint";
import { BoostPanel } from "components/boost-panel.slint";
import { PopupLayer } from "components/popup-layer.slint";
import { PipControls } from "components/pip-controls.slint";
import { PipCard } from "components/pip-card.slint";
import { PageAx } from "components/page-ax.slint";
import { Sidebar } from "components/sidebar.slint";
import { AutoscrollCursor } from "components/autoscroll-cursor.slint";
import { WindowEdges, MoveArea } from "components/window-frame.slint";
import { Entering } from "kit/motion/overlap.slint";
import { PageScroll } from "components/page-scroll.slint";

import "fonts/Fredoka-Variable.ttf";
import "fonts/Geist-Variable.ttf";
import "fonts/GeistMono-Variable.ttf";

export { AutofillAnswer, AutofillView, PageScroll, Tips, TipView, Calm, Shell, GlanceView }
export { Controls, ControlView } from "components/controls/registry.slint";
export { PeekCue, CommandMode, Palette, SplitPane, SplitSeam, TabItem, SpaceItem, CommandResult, CommandKind, CommandBarState, CommandPlacement, FocusRegion, SidebarMode, GlassTier, SideEdges, BeamShape, LeavingRow, GlassItem, GlassLayer, GlassKeys, GlassOver, WindowEdge, Chrome, Radius, MenuEntry, MenuView, DialogView, FindView, PopupView, PermissionView, PreviewView, ErrorView, DownloadItem, DownloadAction, DownloadStatus, SettingItem, SettingControl, BindingItem, CaptureView, SpaceSetting, AboutView, UpdatesView, EntryItem, FilterListItem, InternalPageKind, HistoryLineItem, BookmarkLineItem, FolderChoiceItem, BookmarkSheetView, PrintSheetView, LoginItem, PasswordsView, VaultState, Fonts, VideoMark, VideoView, BoostView, AxItemView, AxKind, ExtensionItem, ExtensionAction, ExtensionPrompt, ExtensionPopup, SpacesMenuRow, SpacesMenuGeometry, PageLinkItem }

export component AppWindow inherits Window {
    title: "wubble";
    icon: @image-url("../../../assets/icons/linux/hicolor/128x128/apps/wubble.png");
    preferred-width: root.pip ? Shell.pip-width : Shell.window-width;
    preferred-height: root.pip ? Shell.pip-height : Shell.window-height;
    min-width: root.pip ? Shell.pip-min-width : Chrome.windowMin-w;
    min-height: root.pip ? Shell.pip-min-height : Chrome.windowMin-h;
    // wubble draws its own window (TODO Decided: frameless). The ground below is the window's
    // colour, rounded where the platform can show transparent corners. macOS keeps AppKit's frame
    // under a hidden title bar for native resize and corners (window.rs `NATIVE_FRAME`).
    in property <bool> native-frame: false;
    // What the window is (wubble_core::window::WindowKind::index): 0 Main, 1 Little, 2 Popup,
    // 3 Pip.
    in property <int> window-kind: 0;
    // Picture-in-picture: the page alone, edge to edge, over other windows (a hint Wayland
    // ignores), with its own controls on hover.
    out property <bool> pip: root.window-kind == 3;
    always-on-top: root.pip;
    no-frame: !root.native-frame;
    // A Main window's tab plays in the picture-in-picture window: a card stands in for it.
    in property <bool> pip-card;
    in property <string> pip-title;
    // The Pip window's controls and the card's button (host `pip_command`).
    callback pip-command(string, float);
    // The visible page for screen readers (empty unless pages' accessibility is on: `a11y.web`),
    // and what one asked of an item (host `ax.rs`).
    in property <[AxItemView]> ax-items;
    callback ax-action(int, string, string);
    background: transparent;
    default-font-family: Fonts.ui;
    default-font-size: Type.body.size;

    // The living backdrop and the glass (wubble_gfx::scene), rendered by the host each frame
    // into one opaque wgpu texture; shown at the very back while GlassLayer.scene-active.
    in property <image> scene;
    // The scene's overlay glass, above the page (wubble_gfx::scene::OverLayer, GlassOver): one
    // window-sized image per layer, empty while the layer has no glass.
    in property <image> over-card;
    in property <image> over-peek;
    in property <image> over-top;
    // The scene draws the overlays' glass (GlassLayer.over-on): not over a fullscreen page,
    // where the scene does not render.
    property <bool> over-on: GlassLayer.scene-active && !root.page-fullscreen;
    changed over-on => {
        GlassLayer.over-on = self.over-on;
    }
    // The pages on screen, left to right (one, or the panes of a split): each one's frame,
    // supplied by wubble-gfx as a wgpu-backed image, and where it sits in the content area. The
    // host writes them; a pane's id is its tab's.
    in property <[SplitPane]> panes;
    // The split's seams and the focused pane's ring (wubble_core::split), "" for one page.
    in property <[SplitSeam]> seams;
    in property <string> focus-ring;
    // The rectangle the panes share, in logical pixels. The host sizes the
    // pages from these and the window's scale factor.
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;
    // Its top left in the window (its layout fills the window from 0,0); the
    // frames smoke samples the snapshot there.
    out property <length> content-x: content.x;
    out property <length> content-y: content.y;

    // Input over the web content: the pane's id, then pane-relative logical
    // pixels. The host forwards it to that pane's page; nothing here interprets it.
    // The page's pointer shape: an index into `cursors`.
    in property <int> web-cursor;
    // Middle-click autoscroll's own pointer (wubble_core::autoscroll), window px.
    in property <bool> autoscroll-on;
    in property <bool> autoscroll-moving;
    in property <length> autoscroll-anchor-x;
    in property <length> autoscroll-anchor-y;
    in property <length> autoscroll-x;
    in property <length> autoscroll-y;
    in property <angle> autoscroll-heading;
    in property <float> autoscroll-stretch: 1;
    in property <float> autoscroll-squash: 1;
    // The web content has keyboard focus (the host sends it keys only then).
    out property <bool> web-focused: web-focus.has-focus;
    // F6 put the keys in the sidebar and nothing has taken them since (the page, the bar's
    // return to it, an internal page or overlay settling focus): the host's region for F6.
    out property <bool> sidebar-focused: false;
    callback web-pointer-moved(pane: int, x: length, y: length);
    callback web-pointer-left(pane: int, x: length, y: length);
    callback web-pointer-pressed(pane: int, button: PointerEventButton, x: length, y: length);
    callback web-pointer-released(pane: int, button: PointerEventButton, x: length, y: length);
    // The pointer grab ended without a release.
    callback web-pointer-cancelled(pane: int);
    callback web-scrolled(pane: int, x: length, y: length, delta-x: length, delta-y: length);
    callback web-focus-changed(focused: bool);
    // The split's seams (index, pointer in content px) and a pane's close button.
    callback split-grab(int, length, length);
    callback split-drag(length, length);
    callback split-release();
    callback split-even();
    callback pane-close(int);

    // Window frame. Intents only; wubble_ui::window acts on them.
    callback window-close-requested <=> sidebar.window-close-requested;
    callback window-minimise-requested <=> sidebar.window-minimise-requested;
    callback window-toggle-fullscreen-requested <=> sidebar.window-toggle-fullscreen-requested;
    callback window-begin-resize(WindowEdge);
    // A drag on bare chrome (the gutters, the sidebar's glass) moves the window; a double-click
    // there maximises it or restores it.
    callback window-begin-move();
    callback window-toggle-maximise-requested();
    // The visible page's history, for the sidebar's back and forward buttons.
    in property <bool> can-go-back <=> sidebar.can-go-back;
    in property <bool> can-go-forward <=> sidebar.can-go-forward;
    // A shell button asks for a wubble `Action`, by its id (wubble-core action.rs).
    callback shell-action <=> sidebar.action;
    // The platform can show a transparent window background (window.rs `Platform`).
    in property <bool> rounded-corners: false;
    // Square when full screen or maximised, or when the platform cannot show the corners.
    out property <length> window-radius: root.rounded-corners && !root.full-screen && !root.maximized ? Radius.window : 0px;
    out property <bool> window-resizable: !root.full-screen && !root.maximized;
    // The visible page is loading (the host); the driver turns it and the active tab into the
    // address pill's border beam (wubble_core::beam), drawn by the scene or, without it, by Slint.
    in property <bool> address-loading;
    in property <BeamShape> address-beam <=> sidebar.address-beam;
    // The Slint beam's strength (0 at rest, and wherever the scene draws the beam).
    out property <float> address-sheen <=> sidebar.address-sheen;
    out property <int> command-shown-rows <=> bar.shown-rows;

    in property <string> address-host <=> sidebar.address-host;
    in property <string> address-path <=> sidebar.address-path;
    in property <bool> address-secure <=> sidebar.address-secure;
    // A favourite is under the pointer: a press waves its glass (chrome.tsx `Fav` onPointerDown).
    out property <bool> fav-hovered: sidebar.fav-hover >= 0;
    in property <bool> address-bookmarkable <=> sidebar.address-bookmarkable;
    in property <bool> address-bookmarked <=> sidebar.address-bookmarked;
    in property <bool> address-blocker-visible <=> sidebar.address-blocker-visible;
    in property <bool> address-blocker-allowed <=> sidebar.address-blocker-allowed;
    in property <int> address-blocked <=> sidebar.address-blocked;
    callback address-bookmark-requested <=> sidebar.address-bookmark-requested;
    callback address-blocker-requested <=> sidebar.address-blocker-requested;
    in property <int> address-popups-blocked <=> sidebar.address-popups-blocked;
    callback address-popups-requested <=> sidebar.address-popups-requested;
    in property <bool> address-media-visible <=> sidebar.address-media-visible;
    callback address-media-requested <=> sidebar.address-media-requested;
    // Reader mode: the pill's book (an article), the reader on, its typography (the settings'
    // values; indexes of their words), and its controls' intents.
    in property <bool> reader-available <=> sidebar.address-reader-available;
    in property <bool> reader-on <=> sidebar.address-reader-on;
    callback reader-toggled <=> sidebar.address-reader-requested;
    in property <int> reader-size;
    in property <int> reader-width;
    in property <int> reader-font;
    in property <int> reader-theme;
    callback reader-setting(string, int);
    // The screenshot region picker over the visible page's pane (content-area px).
    in property <bool> shot-picking;
    in property <length> shot-pane-x;
    in property <length> shot-pane-width;
    callback shot-picked(length, length, length, length);
    callback shot-capture(bool);
    callback shot-cancelled();
    in property <[TabItem]> pinned-tabs <=> sidebar.pinned-tabs;
    in property <[TabItem]> tabs <=> sidebar.tabs;
    in property <[SpaceItem]> spaces <=> sidebar.spaces;
    in property <int> active-tab-id <=> sidebar.active-tab-id;
    in property <int> active-space-id <=> sidebar.active-space-id;

    // ── driven by wubble_ui::driver once per rendered frame ──
    // tabs.rs: rows, the indicator (its row, -1 for none), the window's Space's row
    in property <[length]> row-y <=> sidebar.row-y;
    in property <[float]> row-scale <=> sidebar.row-scale;
    in property <int> dragged-row <=> sidebar.dragged-row;
    pure callback tab-step <=> sidebar.tab-step;
    in property <[float]> row-enter <=> sidebar.row-enter;
    in property <float> list-enter <=> sidebar.list-enter;
    in property <[LeavingRow]> leaving-rows <=> sidebar.leaving-rows;
    in property <float> space-enter <=> sidebar.space-enter;
    // The shown page's entrance after a tab switch, 0..1 (the driver; 1 at rest).
    in property <float> page-enter: 1;
    // The page a tab switch hid, leaving under the shown one (the design's `wb-out`, webview.tsx:
    // 190 ms in-out, clearing and rising 5 px): the host's copy of its last frame, and the
    // driver's progress, 0..1 (1 at rest).
    in property <image> exit-page;
    in property <float> exit-t: 1;
    // The window's peek (Shift+click): the host's card view; its buttons are intents.
    in property <GlanceView> glance;
    callback glance-closed();
    callback glance-to-tab();
    callback glance-to-split();
    in property <int> selected-row <=> sidebar.selected;
    in property <length> indicator-y <=> sidebar.indicator-y;
    in property <float> indicator-stretch <=> sidebar.indicator-stretch;
    in property <float> indicator-origin <=> sidebar.indicator-origin;
    in property <int> space-index <=> sidebar.space-index;
    // seam.rs: the mode (Seam owns it), the width spring, contents a beat behind, the string
    in property <SidebarMode> sidebar-mode: SidebarMode.extended;
    in property <length> sidebar-width: Chrome.sidebarDefault;
    in property <length> sidebar-contents: Chrome.sidebarDefault; // max(Seam.contents, w > 100 ? min : rail)
    in property <float> sidebar-opacity: 1;                       // min(1, w / rail)²
    in property <bool> sidebar-rail: false;
    in property <length> sidebar-saved: Chrome.sidebarDefault;    // Seam.saved: the peek's width
    in property <string> seam-path;
    in property <bool> seam-bowed: false;
    // How far the bowed string is displaced at each height of the window (wubble_core::bow
    // EdgeTable), one sample per `seam-edge-step` from the top; empty while it is straight. The
    // sidebar's sections ride it (design browser/chrome.tsx `[data-ride]`), and the sidebar's
    // glass edge and the page's edge follow it.
    in property <[length]> seam-edge;
    in property <length> seam-edge-step;
    // A pane shows its frame cut along a bowed string (SplitPane.edge): the content area neither
    // clips nor fills, so the bulge shows. The host sets it with the panes.
    in property <bool> edge-bowed: false;
    // scroller.rs: the tab list
    in property <length> scroll-y <=> sidebar.scroll-y;
    in property <length> thumb-top <=> sidebar.thumb-top;
    in property <length> thumb-height <=> sidebar.thumb-height;
    in property <bool> thumb-visible <=> sidebar.thumb-visible;
    out property <length> row-pitch: sidebar.pitch;
    out property <length> scroll-viewport: sidebar.scroll-viewport;
    out property <length> scroll-content: sidebar.scroll-content;

    // Pointer reports for the driver, in window coordinates.
    callback tab-press <=> sidebar.tab-press;
    callback tab-track <=> sidebar.tab-track;
    // A tab dragged out of the list (wubble_core::tabdrag), written by the host: its title
    // follows the pointer, and the content edge it would split into is lit (0 none, 1 left,
    // 2 right). Written for wubble: the design repo has no drag out of the list.
    in property <string> drag-ghost;
    in property <length> drag-x;
    in property <length> drag-y;
    in property <int> drag-zone: 0;
    // The host took the drag from the row physics: the driver drops it.
    callback tab-rows-cancel();
    callback tab-drag <=> sidebar.tab-drag;
    callback tab-release <=> sidebar.tab-release;
    callback seam-grab(length, length);
    callback seam-drag(length, length);
    callback seam-release();
    callback seam-double-clicked();
    callback scroll-wheel <=> sidebar.scroll-wheel;
    callback space-swipe <=> sidebar.space-swipe;
    callback scroll-touch-down <=> sidebar.scroll-touch-down;
    callback scroll-touch-move <=> sidebar.scroll-touch-move;
    callback scroll-touch-up <=> sidebar.scroll-touch-up;
    callback scroll-thumb-down <=> sidebar.scroll-thumb-down;
    callback scroll-thumb-move <=> sidebar.scroll-thumb-move;
    callback scroll-thumb-up <=> sidebar.scroll-thumb-up;
    callback sidebar-toggle-requested();
    // The models or the active ids changed: the driver re-reads them.
    callback shell-model-changed();
    changed tabs => {
        root.shell-model-changed();
    }
    changed active-tab-id => {
        root.shell-model-changed();
        // another start tab: its capsule takes the keys as a new start page's does
        if root.page == InternalPageKind.start {
            root.settle-focus();
        }
    }
    changed spaces => {
        root.shell-model-changed();
    }
    changed active-space-id => {
        root.shell-model-changed();
    }
    changed pinned-tabs => {
        root.shell-model-changed();
    }

    callback tab-activated <=> sidebar.tab-activated;
    callback tab-closed <=> sidebar.tab-closed;
    callback tab-mute-toggled <=> sidebar.tab-mute-toggled;
    // A tab row's right click: (tab id, pointer in window px).
    callback tab-context <=> sidebar.tab-context;
    callback sidebar-context <=> sidebar.empty-context;
    callback tab-hovered <=> sidebar.tab-hovered;
    // The tab hover preview (`PreviewCard`); the host is its one writer.
    in property <PreviewView> preview;
    // The tooltip (`Tooltip`); the host is its one writer.
    in property <TipView> tip;
    // A row was dragged to a new slot: (tab id, its new index in `tabs`).
    callback tab-moved(int, int);
    // The command bar's life: wubble_core::chrome::CommandBar, run by the driver from the cues
    // below; its state, mode, origin and placement are written back here. In the page
    // (`command-placement`), the start page's capsule is its field and the overlay stays shut.
    in property <CommandBarState> command-bar-state;
    in property <CommandPlacement> command-placement;
    // The OS window has the keyboard (the host, from winit, before Slint sees the change): a
    // text field loses its focus while the window is inactive, which is not leaving it.
    in property <bool> window-active: true;
    property <CommandBarState> overlay-state: root.command-placement == CommandPlacement.overlay ? root.command-bar-state : CommandBarState.closed;
    property <CommandBarState> in-page-state: root.command-placement == CommandPlacement.in-page ? root.command-bar-state : CommandBarState.closed;
    in property <CommandMode> command-mode <=> bar.mode;
    // Where the bar grows from (window coordinates).
    in property <Origin> command-origin <=> bar.origin;
    callback command-open(CommandMode, Origin);
    // how long the exit runs (`wb-pop-out`): the driver's timer settles the machine after it
    out property <duration> command-exit: bar.exit;
    callback command-close();
    callback command-pick();
    // the driver's effects (CommandEffect::FocusInput, RestoreFocus), to the field in use
    public function command-focus-input() {
        if root.command-placement == CommandPlacement.in-page {
            StartBridge.focus-serial += 1;
        } else {
            bar.focus-input();
        }
    }
    public function command-release-keys() {
        if root.command-placement == CommandPlacement.in-page {
            StartBridge.release-serial += 1;
        } else {
            bar.release-keys();
        }
    }
    in property <[CommandResult]> command-results <=> bar.results;
    in-out property <string> command-query <=> bar.query;
    // The command bar's beam while you type (the driver; wubble_core::beam::Thinking).
    in property <BeamShape> command-beam <=> bar.beam;
    callback command-query-changed <=> bar.query-changed;
    callback command-result-chosen(int);
    callback command-dismissed();
    // Intents: the bar opens itself; Rust may prefill the query.
    callback new-tab-requested();
    // space id: a row of the Spaces popup (and the host's own switches)
    callback space-switched(int);
    callback address-focus-requested();
    // The bar opens to choose a page to put beside the focused one (split view).
    callback beside-requested();

    public function request-new-tab() {
        root.command-open(CommandMode.new, sidebar.new-tab-origin);
        root.new-tab-requested();
    }

    // Hidden opens the extended sidebar; extended or rail hide it (chrome.tsx `cycleSidebar`).
    public function toggle-sidebar() {
        root.sidebar-toggle-requested();
    }
    // The settings page chose a mode: the shell driver moves the seam to it.
    callback sidebar-mode-requested(SidebarMode);

    public function request-address-focus() {
        root.command-open(CommandMode.here, sidebar.address-origin);
        root.address-focus-requested();
    }

    public function request-beside() {
        root.command-open(CommandMode.split, sidebar.address-origin);
        root.beside-requested();
    }

    // F6 and Shift+F6 (wubble_core::region, run by the host): keyboard focus to a region. The
    // address is the command bar on the page's URL; leaving it closes the bar.
    public function focus-region(region: FocusRegion) {
        root.sidebar-focused = region == FocusRegion.sidebar;
        if region == FocusRegion.address {
            root.request-address-focus();
            return;
        }
        if root.command-bar-state != CommandBarState.closed {
            root.command-close();
        }
        if region == FocusRegion.sidebar {
            sidebar.take-focus();
        } else {
            root.settle-focus();
        }
    }

    // Closes the bar as Esc does (`--smoke windows`, before it reads the page's pixels).
    public function dismiss-command-bar() {
        root.command-close();
    }

    // ── The page's own UI (wubble surface.rs, menu.rs, screen.rs): the visible tab's surfaces,
    // written by the host; the components report intents through these callbacks.
    // The page is full screen: the content fills the window, the sidebar and frame hide.
    in property <bool> page-fullscreen: false;
    in property <MenuView> menu;
    callback menu-chosen(int);
    callback menu-dismissed();
    out property <length> menu-panel-x: menu-ui.panel-x;
    in property <DialogView> dialog;
    // (accept, a prompt's text or the sign-in's user name, the sign-in's password)
    callback dialog-answered(bool, string, string);
    in property <PermissionView> permission;
    // (allow, remember for this site)
    callback permission-answered(bool, bool);
    // Password autofill: the key chip, its menu and the save prompt (host/autofill.rs).
    in property <AutofillView> autofill;
    callback autofill-menu(int);
    callback autofill-answer(AutofillAnswer);
    in property <ErrorView> page-error;
    // The settings page (wubble://settings), shown while the visible tab is on it; the host fills
    // it from the settings table and takes every change through these callbacks.
    // Which native page shows (the visible tab's internal page; none for a web page).
    in property <InternalPageKind> page: InternalPageKind.none;
    out property <bool> settings-open: root.page == InternalPageKind.settings;
    in property <[SettingItem]> settings-rows <=> settings-ui.rows;
    in property <bool> settings-searching <=> settings-ui.searching;
    in property <[BindingItem]> settings-bindings <=> settings-ui.bindings;
    in property <CaptureView> settings-capture <=> settings-ui.capture;
    in property <[SpaceSetting]> settings-spaces <=> settings-ui.spaces;
    in property <[EntryItem]> settings-site-zoom <=> settings-ui.site-zoom;
    in property <[EntryItem]> settings-site-permissions <=> settings-ui.site-permissions;
    in property <[FilterListItem]> settings-filter-lists <=> settings-ui.filter-lists;
    in property <bool> settings-filter-busy <=> settings-ui.filter-busy;
    in property <[ExtensionItem]> settings-extensions <=> settings-ui.extensions;
    in property <bool> settings-extensions-restart <=> settings-ui.extensions-restart;
    in property <AboutView> settings-about <=> settings-ui.about;
    in property <UpdatesView> settings-updates <=> settings-ui.updates;
    in property <[PageLinkItem]> settings-pages <=> settings-ui.pages;
    in property <[PageLinkItem]> settings-page-matches <=> settings-ui.page-matches;
    // The history page: the lines (day headers and visits), the search state, "Show more".
    in property <[HistoryLineItem]> history-lines;
    in property <bool> history-searching;
    in property <bool> history-has-more;
    callback history-query-changed(string);
    callback history-deleted(string);
    callback history-more();
    // The archive page: the same lines, restored or deleted by id.
    in property <[HistoryLineItem]> archive-lines;
    in property <bool> archive-searching;
    in property <bool> archive-has-more;
    callback archive-query-changed(string);
    callback archive-restored(int);
    callback archive-deleted(int);
    callback archive-more();
    // (the clear range's index: last hour, last 24 hours, all)
    callback history-cleared(int);
    // A row of the history or bookmarks page opened (here, or in a new tab).
    callback page-opened(string);
    callback page-opened-new-tab(string);
    // The bookmarks page and its sheet.
    in property <[BookmarkLineItem]> bookmark-lines;
    in property <bool> bookmarks-searching;
    in property <BookmarkSheetView> bookmark-sheet-view;
    // The print sheet (Ctrl+P): what it shows; its edits and its answer.
    in property <PrintSheetView> print-sheet-view;
    callback print-sheet-edited(int, string, bool, int, int, int, bool, int);
    callback print-sheet-answered(bool);
    // A touchpad history swipe: -1..1 of the way to forward (negative) or back; 0 hides the
    // chip. `swipe-shift` is its rubber-banded travel from the edge (host side, motion.rs band).
    in property <float> swipe-progress;
    in property <length> swipe-shift;
    in property <[FolderChoiceItem]> bookmark-folders;
    callback bookmarks-query-changed(string);
    callback bookmark-toggled(int);
    callback bookmark-rename-requested(int);
    callback bookmark-move-requested(int);
    callback bookmark-deleted(int);
    callback bookmark-folder-requested();
    // (accept, remove, name, folder id; -1 is the top level)
    callback bookmark-sheet-answered(bool, bool, string, int);
    // The downloads page reads `downloads` (the popover's model) and takes `download-action`.
    callback downloads-cleared();
    // The passwords page: nothing is listed until unlocked.
    in property <PasswordsView> passwords-view;
    in property <[LoginItem]> logins;
    callback passwords-query-changed(string);
    callback passwords-unlock();
    callback login-reveal(string);
    callback login-hide();
    callback login-copy(string);
    callback login-deleted(string);
    callback login-added(string, string, string);
    callback passwords-import-requested();
    callback settings-requested();
    callback settings-query-changed <=> settings-ui.query-changed;
    callback setting-changed <=> settings-ui.setting-changed;
    callback setting-reset <=> settings-ui.setting-reset;
    callback setting-entry-removed <=> settings-ui.entry-removed;
    callback setting-entry-added <=> settings-ui.entry-added;
    callback binding-record <=> settings-ui.binding-record;
    callback binding-reset <=> settings-ui.binding-reset;
    callback capture-confirm <=> settings-ui.capture-confirm;
    callback capture-cancel <=> settings-ui.capture-cancel;
    callback space-renamed <=> settings-ui.space-renamed;
    callback space-tinted <=> settings-ui.space-tinted;
    callback space-icon-chosen <=> settings-ui.space-icon-chosen;
    callback site-zoom-removed <=> settings-ui.site-zoom-removed;
    callback site-permission-removed <=> settings-ui.site-permission-removed;
    callback filter-list-toggled <=> settings-ui.filter-list-toggled;
    callback filter-lists-update <=> settings-ui.filter-lists-update;
    callback extension-install-file <=> settings-ui.extension-install-file;
    callback extension-install-folder <=> settings-ui.extension-install-folder;
    callback extension-toggled <=> settings-ui.extension-toggled;
    callback extension-removed <=> settings-ui.extension-removed;
    callback extension-options <=> settings-ui.extension-options;
    callback updates-toggled <=> settings-ui.updates-toggled;
    callback updates-check <=> settings-ui.updates-check;
    callback updates-restart <=> settings-ui.updates-restart;
    // The error panel's default button (Reload, or Go back) and its second (Proceed).
    callback error-primary();
    callback error-secondary();
    // The Task manager's rows and totals, and its buttons: (tab id or -1, pid, what).
    in property <[TaskItem]> tasks;
    in property <string> tasks-total;
    callback task-action(int, int, TaskAction);
    // The downloads list (newest first) and its buttons: (entry id, what).
    in property <[DownloadItem]> downloads;
    callback download-action(int, DownloadAction);
    // The popover is open (presentation only; the list is the host's).
    in-out property <bool> downloads-open: false;
    // The sidebar footer's extensions button (shown once an extension is installed), its popover
    // (the enabled extensions' actions) and the open action's popup, which replaces the list;
    // the host owns which is open (`wubble_core::extensions::shell::Panel`): `extensions-open`
    // is the list, `extension-popup.open` the popup (once its page has a size).
    in property <bool> has-extensions: false;
    in property <[ExtensionAction]> extension-actions;
    in-out property <bool> extensions-open: false;
    in property <ExtensionPopup> extension-popup;
    in property <ExtensionPrompt> extension-prompt;
    callback extensions-requested();
    callback extension-pressed(string);
    callback extensions-manage();
    callback extensions-dismissed();
    callback extension-prompt-answered(bool);
    // The sidebar footer's Spaces popup (wubble_core::spacemenu, bound by the host): its lines
    // and the keys' rows (the lines, a separator, New Space). The "^" asks the host
    // (`spaces-menu-requested`), which opens it through the overlay stack; it closes itself.
    in property <[SpacesMenuRow]> spaces-menu-rows;
    in property <[MenuEntry]> spaces-menu-entries;
    in-out property <bool> spaces-open: false;
    callback spaces-menu-requested();
    // a dragged tab over the popup: the line it would drop on (-1 none), its top in the list,
    // or the sticky New Space row (the host's, from wubble_core::tabdrag)
    in property <int> spaces-drop-line: -1;
    in property <length> spaces-drop-top;
    in property <bool> spaces-drop-sticky;
    out property <SpacesMenuGeometry> spaces-menu-geometry: {
        shown: root.spaces-open,
        switcher-x: sidebar.spaces-anchor-x,
        switcher-y: sidebar.spaces-anchor-y,
        switcher-w: sidebar.spaces-switcher-w,
        switcher-h: sidebar.spaces-switcher-h,
        panel-x: spaces-ui.panel-x,
        panel-y: spaces-ui.panel-y,
        panel-w: spaces-ui.panel-w,
        panel-h: spaces-ui.panel-h,
        rows-x: spaces-ui.rows-x,
        rows-w: spaces-ui.rows-width,
        list-top: spaces-ui.list-top,
        list-h: spaces-ui.list-h,
        scroll: spaces-ui.list-scroll,
        line: spaces-ui.line-height,
        rule: spaces-ui.rule-height,
        sticky-top: spaces-ui.sticky-top,
    };
    changed downloads => {
        if root.downloads.length == 0 {
            root.downloads-open = false;
        }
    }
    in property <FindView> find;
    callback find-edited(string);
    // true: next match, false: previous.
    callback find-step(bool);
    callback find-closed();
    // A brief notice (zoom level, "Esc to exit"); bump the serial to show it.
    in property <string> toast-text;
    in property <int> toast-serial;
    // A notice with a button (`Toast`): its label, whether it waits for an answer, and a serial
    // that takes any notice away.
    in property <string> toast-action;
    in property <bool> toast-sticky;
    in property <int> toast-hide-serial;
    in property <duration> toast-action-shown;
    callback toast-acted();
    callback toast-closed();
    // The visible page's video controls (wubble_core::video) and the speed menu's rows.
    in property <VideoView> video;
    in property <[string]> video-rates;
    // Where the pointer is in the window (window px; `pointer-in` false once it left), from the
    // host's raw pointer events: the video strip's hover by place (VideoControls).
    in property <bool> pointer-in;
    in property <length> pointer-x;
    in property <length> pointer-y;
    callback video-command(string, float);
    // the strip's save button, its bottom left (window px): the media downloader's entry
    callback video-save(length, length);
    callback video-hovered(bool);
    // The Boost editor (wubble_core::boost).
    in property <BoostView> boost;
    callback boost-text(string, string);
    callback boost-number(string, float);
    callback boost-tint(color);
    callback boost-act(string);
    in property <PopupView> popup;
    in property <image> popup-frame;

    // `q` typed into the settings page's search (the gallery)
    public function settings-type-query(q: string) {
        settings-ui.type-query(q);
    }

    // Puts `text` on the clipboard through Slint's own (no clipboard crate): a hidden field
    // selects it and copies.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // One overlay holds the keyboard at a time: the menu, else the downloads popover, else the
    // dialog (or sign-in), else the error panel, else the page. The permission prompt never takes
    // it: a key meant for the page must not answer it (keyjacking), as Chromium's bubble. The
    // find bar takes it only when asked (Mod+F), and gives it back to the page when it closes.
    property <bool> menu-open: root.menu.open;
    property <bool> dialog-open: root.dialog.open;
    property <bool> error-open: root.page-error.open;
    property <bool> bookmark-open: root.bookmark-sheet-view.open;
    property <bool> print-open: root.print-sheet-view.open;
    property <bool> extension-prompt-open: root.extension-prompt.open;
    property <bool> find-open: root.find.open;
    property <int> find-focus: root.find.focus-serial;
    property <bool> overlay-open: root.menu.open || root.downloads-open || root.extensions-open || root.extension-popup.open || root.extension-prompt.open || root.spaces-open || root.dialog.open || root.page-error.open;
    function settle-focus() {
        root.sidebar-focused = false;
        if root.menu.open {
            menu-ui.take-focus();
        } else if root.downloads-open {
            downloads-ui.take-focus();
        } else if root.extensions-open {
            extensions-ui.take-focus();
        } else if root.extension-prompt.open {
            extension-sheet.focus-sheet();
        } else if root.spaces-open {
            spaces-ui.take-focus();
        } else if root.dialog.open {
            sheet.focus-sheet();
        } else if root.page-error.open {
            error-ui.take-focus();
        } else if bookmark-sheet.open {
            bookmark-sheet.focus-sheet();
        } else if print-sheet.open {
            print-sheet.focus-sheet();
        } else if root.page == InternalPageKind.settings {
            settings-ui.take-focus();
        } else if root.page == InternalPageKind.history {
            history-ui.take-focus();
        } else if root.page == InternalPageKind.archive {
            archive-ui.take-focus();
        } else if root.page == InternalPageKind.bookmarks {
            bookmarks-ui.take-focus();
        } else if root.page == InternalPageKind.downloads {
            downloads-page-ui.take-focus();
        } else if root.page == InternalPageKind.passwords {
            passwords-ui.take-focus();
        } else if root.page == InternalPageKind.tasks {
            tasks-ui.take-focus();
        } else if root.page == InternalPageKind.start {
            // the start page's capsule is the address field: it holds the keys
            StartBridge.focus-serial += 1;
        } else {
            web-focus.focus();
        }
    }
    changed menu-open => {
        root.settle-focus();
    }
    changed dialog-open => {
        root.settle-focus();
    }
    changed error-open => {
        root.settle-focus();
    }
    changed page => {
        // the bar in the start page goes with the page
        if root.page != InternalPageKind.start && root.in-page-state == CommandBarState.open {
            root.command-close();
        }
        root.settle-focus();
    }
    changed bookmark-open => {
        root.settle-focus();
    }
    changed print-open => {
        root.settle-focus();
    }
    changed extension-prompt-open => {
        root.settle-focus();
    }
    changed extensions-open => {
        root.settle-focus();
    }
    changed downloads-open => {
        root.settle-focus();
    }
    changed spaces-open => {
        root.settle-focus();
    }
    // The screenshot overlay took the keys; closed, they go back.
    changed shot-picking => {
        if !root.shot-picking {
            root.settle-focus();
        }
    }
    changed find-focus => {
        if root.find.open && !root.overlay-open {
            find-ui.take-focus();
        }
    }
    changed find-open => {
        if !root.find-open && !root.overlay-open && bar.state == CommandBarState.closed {
            web-focus.focus();
        }
    }

    // Peek (chrome.tsx): a hidden sidebar slides in over the page, on thick glass at its saved
    // width, when the pointer reaches the edge strip; it leaves once the pointer has been off it
    // for a while. The machine is wubble_core::chrome::Peek, run by the driver from the cues
    // below; `peek` is its one output (shown or leaving). It never outlives the hidden mode.
    in property <bool> peek: false;
    callback peek-cue(PeekCue);
    callback sidebar-mode-changed(SidebarMode);
    out property <bool> peeking: root.peek && root.sidebar-mode == SidebarMode.hidden;
    out property <SideEdges> side-edges <=> sidebar.edges;
    changed sidebar-mode => {
        root.sidebar-mode-changed(root.sidebar-mode);
    }
    // The pointer is in the strip a hidden sidebar peeks from: `.wb-peek-edge` (shows at once),
    // or the window's west resize strip over its first pixels (the design's `onMove` strip: 60 ms).
    property <bool> at-edge: !root.page-fullscreen && !root.pip && (edge.has-hover || edges.west-hovered);
    property <bool> at-west: !root.page-fullscreen && !root.pip && root.sidebar-mode == SidebarMode.hidden && edges.west-hovered;
    changed at-west => {
        if self.at-west {
            root.peek-cue(PeekCue.strip-moved);
        }
    }
    // over the panel or the strip: leaving both starts the peek's way out
    property <bool> over-side: zone.has-hover || root.at-edge;
    changed over-side => {
        root.peek-cue(self.over-side ? PeekCue.panel-entered : PeekCue.panel-left);
    }
    // Hidden and closed, or peeking (chrome.tsx: the peek panel shows at once, even mid-close).
    property <bool> hidden-at-rest: root.sidebar-mode == SidebarMode.hidden && (root.peek || root.sidebar-width <= Shell.sidebar-open);
    // the look the sidebar takes (chrome.tsx `sideMode`); compact is the driver's (core `compact`)
    property <SideMode> side-mode: root.peeking ? SideMode.peek : root.sidebar-rail ? SideMode.rail
        : root.sidebar-mode == SidebarMode.hidden ? SideMode.hidden : SideMode.extended;

    // The engine's `Cursor` (wubble-engine nav.rs), in its order; anything
    // out of range shows the default.
    property <[MouseCursor]> cursors: [
        MouseCursor.default,
        MouseCursor.none,
        MouseCursor.pointer,
        MouseCursor.text,
        MouseCursor.wait,
        MouseCursor.progress,
        MouseCursor.crosshair,
        MouseCursor.move,
        MouseCursor.not-allowed,
        MouseCursor.help,
        MouseCursor.grab,
        MouseCursor.grabbing,
        MouseCursor.ns-resize,
        MouseCursor.ew-resize,
        MouseCursor.nesw-resize,
        MouseCursor.nwse-resize,
        // Autoscroll's eleven panning cursors: hidden, the shell draws its own.
        MouseCursor.none, MouseCursor.none, MouseCursor.none, MouseCursor.none,
        MouseCursor.none, MouseCursor.none, MouseCursor.none, MouseCursor.none,
        MouseCursor.none, MouseCursor.none, MouseCursor.none,
        // A drag's feedback: copy, alias (link).
        MouseCursor.copy, MouseCursor.alias,
    ];

    // The bottom layer: the scene (the design's demo.slint `Image { source: root.scene }`, first
    // child), rounded with the window; without the scene the plain ground. A fullscreen page
    // covers the window, so it is not drawn then (the host stops rendering it too: run.rs
    // `scene_due`).
    if GlassLayer.scene-active && !root.page-fullscreen: Rectangle {
        clip: true;
        border-radius: root.window-radius;
        Image {
            width: 100%;
            height: 100%;
            source: root.scene;
            image-fit: fill;
        }
    }
    ground := Rectangle {
        visible: !GlassLayer.scene-active || root.page-fullscreen;
        background: Palette.abyss;
        border-radius: root.window-radius;
    }
    // The active Space's colour: the window's glass, the split ring and the settings' controls.
    property <color> space-accent: root.space-index >= 0 && root.space-index < root.spaces.length ? root.spaces[root.space-index].tint : Palette.sky;
    // The window's own glass (design desktop.tsx: one Regular surface the window's size, radius
    // `radius.window`, shadow 1). The sidebar has no panel of its own: it is this glass, and the
    // page card sits on it `Chrome.inset` from the window's top, right and bottom and from the
    // sidebar (browser.css .wb-side / .wb-main: inset 8). Drawn by the scene under GlassKeys.sidebar,
    // the key the scene's sidebar glass had; without the scene the plain ground shows.
    GlassPanel {
        key: GlassKeys.sidebar;
        width: 100%;
        height: 100%;
        tier: GlassTier.regular;
        radius: root.window-radius;
        tint: root.space-accent;
        over-wgpu: GlassLayer.scene-active;
        visible: GlassLayer.scene-active;
        present: !root.page-fullscreen;
    }
    // The design's `wb-frame-drag`: the gutters and any glass without a control move the window.
    MoveArea {
        enabled: !root.full-screen;
        begin-move => {
            root.window-begin-move();
        }
        toggle-maximise => {
            root.window-toggle-maximise-requested();
        }
    }
    clip := TextInput {
        width: 0px;
        height: 0px;
        opacity: 0;
        read-only: true;
    }

    // Shortcuts are routed in Rust (wubble `input::key_route`, the
    // `wubble_core::keys` table), not here.
    root-keys := FocusScope {
        // It fills the window: taking focus on a click would swallow every press on bare
        // chrome (the gutters), so the move area under it would never see one.
        focus-on-click: false;
        // Nor does Tab stop on it: it is the window, not a control.
        focus-on-tab-navigation: false;
        // In page fullscreen the page fills the window, square.
        property <length> gap: root.page-fullscreen || root.pip ? 0px : Chrome.inset;
        content := Rectangle {
            // On whole physical pixels, so the page's frame is shown 1:1: the seam's spring and
            // a dragged width are fractional, and a fractional rectangle resamples the page.
            x: root.page-fullscreen || root.pip ? 0px : round((Chrome.inset + (root.sidebar-width > Shell.sidebar-open ? root.sidebar-width + Chrome.inset : 0px)) / 1phx) * 1phx;
            y: parent.gap;
            width: round((parent.width - self.x - parent.gap) / 1phx) * 1phx;
            height: parent.height - 2 * parent.gap;
            border-radius: root.page-fullscreen || root.pip ? 0px : Radius.md;
            clip: !root.edge-bowed;
            // Between split panes the window's glass shows (the design's `.wb-split` web view).
            // start page (L7): and the start page's living scene under it.
            background: root.panes.length > 1 || root.edge-bowed || root.page == InternalPageKind.start ? transparent : Palette.web;
            // Over the frames and under the command bar, so the bar takes
            // its own pointer events and the pages only get the rest.
            web-focus := FocusScope {
                width: 100%;
                height: 100%;
                changed has-focus => {
                    if self.has-focus {
                        root.sidebar-focused = false;
                    }
                    root.web-focus-changed(self.has-focus);
                }
                if root.exit-t < 1 && root.exit-page.width > 0: Image {
                    y: -Shell.page-exit-shift * root.exit-t;
                    width: 100%;
                    height: 100%;
                    source: root.exit-page;
                    image-fit: fill;
                    opacity: 1 - root.exit-t;
                }
                // A newly shown page arrives with the Overlap entrance (webview.tsx: the shown
                // view gets `wb-in`), timed by the driver on a tab switch.
                Entering {
                    e: root.page-enter;
                    SplitView {
                        panes: root.panes;
                        seams: root.seams;
                        ring: root.focus-ring;
                        accent: root.space-accent;
                        radius: root.page-fullscreen ? 0px : Radius.md;
                        cursor: root.cursors[root.web-cursor];
                        pointer-pressed(pane, button, x, y) => {
                            web-focus.focus();
                            root.web-pointer-pressed(pane, button, x, y);
                        }
                        pointer-released(pane, button, x, y) => {
                            root.web-pointer-released(pane, button, x, y);
                        }
                        pointer-moved(pane, x, y) => {
                            root.web-pointer-moved(pane, x, y);
                        }
                        pointer-left(pane, x, y) => {
                            root.web-pointer-left(pane, x, y);
                        }
                        pointer-cancelled(pane) => {
                            root.web-pointer-cancelled(pane);
                        }
                        scrolled(pane, x, y, dx, dy) => {
                            root.web-scrolled(pane, x, y, dx, dy);
                        }
                        seam-grab(j, x, y) => {
                            root.split-grab(j, x, y);
                        }
                        seam-drag(x, y) => {
                            root.split-drag(x, y);
                        }
                        seam-release => {
                            root.split-release();
                        }
                        seam-even => {
                            root.split-even();
                        }
                        pane-close(id) => {
                            root.pane-close(id);
                        }
                    }
                }
            }
            PageAx {
                items: root.ax-items;
                action(id, name, value) => {
                    root.ax-action(id, name, value);
                }
            }
            // The settings page fills the content area of its tab (no web view under it).
            settings-ui := SettingsPage {
                open: root.settings-open;
                accent: root.space-accent;
                // a built-in page's link: the page's own action
                page-requested(id) => {
                    root.shell-action(id);
                }
            }
            // start page (L7): the new-tab page's front over the scene's living layer
            if root.page == InternalPageKind.start: StartPage {
                sites: StartBridge.sites;
                shortcut: StartBridge.shortcut;
                grabbing: StartBridge.grabbing;
                // the command bar in the page: the capsule is its field (the host gives it the tab)
                state: root.in-page-state;
                query <=> root.command-query;
                results: root.command-results;
                focus-serial: StartBridge.focus-serial;
                release-serial: StartBridge.release-serial;
                query-changed(q) => {
                    root.command-query-changed(q);
                }
                result-chosen(i) => {
                    root.command-result-chosen(i);
                    root.command-pick();
                }
                // the capsule taking the keys opens the bar in it; losing them closes it
                focus-changed(on) => {
                    if on || root.window-active {
                        StartBridge.search-focused = on;
                    }
                    if on && root.in-page-state != CommandBarState.open {
                        root.request-address-focus();
                    } else if !on && root.window-active && root.in-page-state == CommandBarState.open {
                        root.command-dismissed();
                        root.command-close();
                    }
                }
                site-activated(url) => {
                    StartBridge.site-activated(url);
                }
                stage-down(x, y) => {
                    StartBridge.stage-down(x, y);
                }
                stage-move(x, y) => {
                    StartBridge.stage-move(x, y);
                }
                stage-up => {
                    StartBridge.stage-up();
                }
                stage-leave => {
                    StartBridge.stage-leave();
                }
                init => {
                    // a start page shown: its capsule takes the keys
                    StartBridge.focus-serial += 1;
                    StartBridge.search-x = self.search-x;
                    StartBridge.search-y = self.search-y;
                }
                changed search-x => {
                    StartBridge.search-x = self.search-x;
                }
                changed search-y => {
                    StartBridge.search-y = self.search-y;
                }
            }
            history-ui := HistoryPage {
                open: root.page == InternalPageKind.history;
                lines: root.history-lines;
                searching: root.history-searching;
                has-more: root.history-has-more;
                query-changed(q) => {
                    root.history-query-changed(q);
                }
                opened(u, k) => {
                    root.page-opened(u);
                }
                opened-new-tab(u, k) => {
                    root.page-opened-new-tab(u);
                }
                deleted(u, k) => {
                    root.history-deleted(u);
                }
                more => {
                    root.history-more();
                }
                cleared(range) => {
                    root.history-cleared(range);
                }
            }
            // Click restores the tab (and takes it off the list); middle-click opens it and keeps it.
            archive-ui := HistoryPage {
                open: root.page == InternalPageKind.archive;
                title: "Archive";
                placeholder: "Search archived tabs";
                empty-text: "Nothing archived yet. Tabs you have not visited for a while end up here.";
                empty-search-text: "No archived tab matches";
                clearable: false;
                lines: root.archive-lines;
                searching: root.archive-searching;
                has-more: root.archive-has-more;
                query-changed(q) => {
                    root.archive-query-changed(q);
                }
                opened(u, k) => {
                    root.archive-restored(k);
                }
                opened-new-tab(u, k) => {
                    root.page-opened-new-tab(u);
                }
                deleted(u, k) => {
                    root.archive-deleted(k);
                }
                more => {
                    root.archive-more();
                }
            }
            bookmarks-ui := BookmarksPage {
                open: root.page == InternalPageKind.bookmarks;
                lines: root.bookmark-lines;
                searching: root.bookmarks-searching;
                query-changed(q) => {
                    root.bookmarks-query-changed(q);
                }
                opened(u) => {
                    root.page-opened(u);
                }
                opened-new-tab(u) => {
                    root.page-opened-new-tab(u);
                }
                toggled(id) => {
                    root.bookmark-toggled(id);
                }
                rename-requested(id) => {
                    root.bookmark-rename-requested(id);
                }
                move-requested(id) => {
                    root.bookmark-move-requested(id);
                }
                deleted(id) => {
                    root.bookmark-deleted(id);
                }
                folder-requested => {
                    root.bookmark-folder-requested();
                }
            }
            downloads-page-ui := DownloadsPage {
                open: root.page == InternalPageKind.downloads;
                items: root.downloads;
                action(id, a) => {
                    root.download-action(id, a);
                }
                clear-finished => {
                    root.downloads-cleared();
                }
            }
            tasks-ui := TasksPage {
                open: root.page == InternalPageKind.tasks;
                items: root.tasks;
                total: root.tasks-total;
                action(tab, pid, a) => {
                    root.task-action(tab, pid, a);
                }
            }
            passwords-ui := PasswordsPage {
                open: root.page == InternalPageKind.passwords;
                view: root.passwords-view;
                logins: root.logins;
                query-changed(q) => {
                    root.passwords-query-changed(q);
                }
                unlock => {
                    root.passwords-unlock();
                }
                reveal(id) => {
                    root.login-reveal(id);
                }
                hide() => {
                    root.login-hide();
                }
                copy(id) => {
                    root.login-copy(id);
                }
                deleted(id) => {
                    root.login-deleted(id);
                }
                added(site, user, password) => {
                    root.login-added(site, user, password);
                }
                import-requested => {
                    root.passwords-import-requested();
                }
            }
            // The scene's glass of the overlays in the card (GlassOver.card), above the pages and
            // under each overlay's own content: window-sized, so placed back at the window's origin.
            if root.over-on && root.over-card.width > 0: Image {
                x: -content.x;
                y: -content.y;
                width: root.width;
                height: root.height;
                source: root.over-card;
                image-fit: fill;
            }
            if !root.pip: VideoControls {
                video: root.video;
                rates: root.video-rates;
                pointer-in: root.pointer-in;
                pointer-x: root.pointer-x;
                pointer-y: root.pointer-y;
                command(name, value) => {
                    root.video-command(name, value);
                }
                save(x, y) => {
                    root.video-save(x, y);
                }
                hovered(over) => {
                    root.video-hovered(over);
                }
            }
            if root.pip: PipControls {
                paused: root.video.paused;
                command(name, value) => {
                    root.pip-command(name, value);
                }
                begin-move => {
                    root.window-begin-move();
                }
            }
            if root.pip-card: PipCard {
                open: true;
                title: root.pip-title;
                command(name, value) => {
                    root.pip-command(name, value);
                }
            }
            find-ui := FindBar {
                x: parent.width - self.width - Space.s3;
                y: Space.s3;
                find: root.find;
                edited(q) => {
                    root.find-edited(q);
                }
                step(forward) => {
                    root.find-step(forward);
                }
                closed => {
                    root.find-closed();
                }
            }
            // Beside the sidebar at the hovered row, kept inside the content area.
            PreviewCard {
                x: Space.s3;
                y: max(Space.s3, min(root.preview.y - parent.absolute-position.y, parent.height - self.height - Space.s3));
                shown: root.preview.shown;
                title: root.preview.title;
                address: root.preview.address;
                thumb: root.preview.thumb;
            }
            ReaderControls {
                x: root.shot-pane-x + (root.shot-pane-width - self.width) / 2;
                y: parent.height - self.height - Space.s4;
                open: root.reader-on;
                size: root.reader-size;
                column: root.reader-width;
                font: root.reader-font;
                theme: root.reader-theme;
                setting(key, value) => {
                    root.reader-setting(key, value);
                }
                closed => {
                    root.reader-toggled();
                }
            }
            ShotOverlay {
                active: root.shot-picking;
                pane-x: root.shot-pane-x;
                pane-width: root.shot-pane-width;
                picked(ax, ay, bx, by) => {
                    root.shot-picked(ax, ay, bx, by);
                }
                capture(full) => {
                    root.shot-capture(full);
                }
                cancelled => {
                    root.shot-cancelled();
                }
            }
            BoostPanel {
                x: parent.width - self.width - Space.s3;
                y: Space.s3;
                height: parent.height - 2 * Space.s3;
                view: root.boost;
                text-edited(field, text) => {
                    root.boost-text(field, text);
                }
                number(field, value) => {
                    root.boost-number(field, value);
                }
                tint(c) => {
                    root.boost-tint(c);
                }
                act(name) => {
                    root.boost-act(name);
                }
            }
            // A brief notice at the page's top; one that waits for an answer (SponsorBlock's
            // question, its Undo) at its bottom, as the reader's controls: a top one sat on the
            // page's own top bar (a site's search field) for as long as it waited.
            Toast {
                x: (parent.width - self.width) / 2;
                y: root.toast-action == "" ? Space.s4 : parent.height - self.height - Space.s4;
                widest: min(Shell.toast-max-width, parent.width - 2 * Space.s4);
                text: root.toast-text;
                serial: root.toast-serial;
                action: root.toast-action;
                sticky: root.toast-sticky;
                hide-serial: root.toast-hide-serial;
                action-shown: root.toast-action-shown;
                acted => {
                    root.toast-acted();
                }
                closed => {
                    root.toast-closed();
                }
            }
            // Over the page and its find bar, under the dialog: the page's error.
            error-ui := ErrorPanel {
                error: root.page-error;
                primary => {
                    root.error-primary();
                }
                secondary => {
                    root.error-secondary();
                }
            }
            bookmark-sheet := BookmarkSheet {
                glass-key: GlassKeys.bookmark-sheet;
                glass-layer: GlassOver.card;
                sheet: root.bookmark-sheet-view;
                folders: root.bookmark-folders;
                answered(accept, remove, name, folder) => {
                    root.bookmark-sheet-answered(accept, remove, name, folder);
                }
            }
            extension-sheet := ExtensionSheet {
                glass-key: GlassKeys.extension-sheet;
                glass-layer: GlassOver.card;
                prompt: root.extension-prompt;
                answered(accept) => {
                    root.extension-prompt-answered(accept);
                }
            }
            print-sheet := PrintSheet {
                glass-key: GlassKeys.print-sheet;
                glass-layer: GlassOver.card;
                sheet: root.print-sheet-view;
                edited(d, p, l, pa, m, s, b, c) => {
                    root.print-sheet-edited(d, p, l, pa, m, s, b, c);
                }
                answered(accept) => {
                    root.print-sheet-answered(accept);
                }
            }
            // The history swipe's chip at the edge it goes toward.
            if root.swipe-progress != 0: SwipeChip {
                progress: root.swipe-progress;
                shift: root.swipe-shift;
            }
            // The peek: over the page, under the sheets and the command bar.
            GlanceCard {
                glance: root.glance;
                cursor: root.cursors[root.web-cursor];
                closed => {
                    root.glance-closed();
                }
                to-tab => {
                    root.glance-to-tab();
                }
                to-split => {
                    root.glance-to-split();
                }
                pointer-pressed(pane, button, x, y) => {
                    root.web-pointer-pressed(pane, button, x, y);
                }
                pointer-released(pane, button, x, y) => {
                    root.web-pointer-released(pane, button, x, y);
                }
                pointer-moved(pane, x, y) => {
                    root.web-pointer-moved(pane, x, y);
                }
                pointer-left(pane, x, y) => {
                    root.web-pointer-left(pane, x, y);
                }
                pointer-cancelled(pane) => {
                    root.web-pointer-cancelled(pane);
                }
                scrolled(pane, x, y, dx, dy) => {
                    root.web-scrolled(pane, x, y, dx, dy);
                }
            }
            // Tab-modal: over the page and its find bar, under the command bar.
            sheet := DialogSheet {
                glass-key: GlassKeys.dialog;
                glass-layer: GlassOver.card;
                dialog: root.dialog;
                answered(accept, text, secret) => {
                    root.dialog-answered(accept, text, secret);
                }
            }
            bar := CommandBar {
                state: root.overlay-state;
                // `here` shows the open site's host (chrome.tsx: a site, not wubble's own pages)
                here-host: root.address-host == "wubble" || root.address-host == "data" ? "" : root.address-host;
                result-chosen(i) => {
                    root.command-result-chosen(i);
                    root.command-pick();
                }
                dismissed => {
                    root.command-dismissed();
                    root.command-close();
                }
                closed => {
                    web-focus.focus();
                }
            }
        }

        // The strip a hidden sidebar peeks from (.wb-peek-edge, 18 wide from the left edge). The
        // west resize strip lies over its first pixels and counts as the strip too, so a pointer
        // pushed against the screen's edge peeks, whether or not the window can be resized.
        edge := TouchArea {
            x: 0px;
            width: Chrome.peekEdge + Chrome.inset;
            height: parent.height;
            enabled: root.sidebar-mode == SidebarMode.hidden && !root.page-fullscreen && !root.pip;
            changed has-hover => {
                if self.has-hover {
                    root.peek-cue(PeekCue.edge-entered);
                }
            }
        }

        // The sidebar sits inside its hover zone, so the zone keeps has-hover
        // while the pointer is over a child row.
        zone := SidePeek {
            visible: !root.page-fullscreen;
            mode: root.side-mode;
            floating: root.hidden-at-rest;
            width: Chrome.inset + sidebar.width;
            height: parent.height;
            panel-width: sidebar.width;
            panel-height: sidebar.height;
            over-on: root.over-on;
            over-peek: root.over-peek;
            window-width: root.width;
            window-height: root.height;

            sidebar := Sidebar {
                x: Chrome.inset;
                y: Chrome.inset;
                width: root.hidden-at-rest ? root.sidebar-saved : root.sidebar-width;
                content-width: root.hidden-at-rest ? root.sidebar-saved : root.sidebar-contents;
                height: parent.height - 2 * Chrome.inset;
                opacity: root.hidden-at-rest ? zone.alpha : root.sidebar-opacity;
                compact: root.sidebar-rail;
                // Over the peek's Slint glass (and the page) the scene cannot show: Slint draws.
                glass-over-wgpu: GlassLayer.scene-active && !root.hidden-at-rest && root.sidebar-width > Shell.sidebar-open;
                mode: root.side-mode;
                // the peek floats off the seam: its sections hold still
                ride: root.hidden-at-rest ? [] : root.seam-edge;
                ride-step: root.seam-edge-step;
                window-movable: !root.full-screen;
                window-move-requested => {
                    root.window-begin-move();
                }
                window-maximise-requested => {
                    root.window-toggle-maximise-requested();
                }
                address-activated => {
                    root.request-address-focus();
                }
                has-downloads: root.downloads.length > 0;
                has-extensions: root.has-extensions;
                extensions-open: root.extensions-open || root.extension-popup.open;
                extensions-requested => {
                    root.extensions-requested();
                }
                spaces-open: root.spaces-open;
                spaces-requested => {
                    root.spaces-menu-requested();
                }
                downloads-requested => {
                    root.downloads-open = !root.downloads-open;
                }
                settings-requested => {
                    root.settings-requested();
                }
            }
        }

        // Over everything, so the bowed string draws on top of the web view. Its frame is the
        // web view's frame (inset on every side), which is what Seam::clip draws in.
        Seam {
            x: Chrome.inset;
            y: Chrome.inset;
            width: parent.width - Chrome.inset * 2;
            height: parent.height - Chrome.inset * 2;
            visible: root.sidebar-mode != SidebarMode.hidden && !root.page-fullscreen && !root.pip;
            seam-x: root.sidebar-width + Chrome.inset / 2;
            seam-path: root.seam-path;
            bowed: root.seam-bowed;
            grab(x, y) => {
                root.seam-grab(x, y);
            }
            drag(x, y) => {
                root.seam-drag(x, y);
            }
            release => {
                root.seam-release();
            }
            double-clicked => {
                root.seam-double-clicked();
            }
        }
    }

    // The scene's glass of the window-level overlays (GlassOver.top: menus, popovers, prompts),
    // above the page and the sidebar, under their own content.
    if root.over-on && root.over-top.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.over-top;
        image-fit: fill;
    }

    // The page's popup widget may leave the page's rectangle (not the window's). It belongs to
    // the focused page, whose pane id is the active tab's.
    PopupLayer {
        popup: root.popup;
        frame: root.popup-frame;
        pointer-moved(x, y) => {
            root.web-pointer-moved(root.active-tab-id, x, y);
        }
        pointer-pressed(button, x, y) => {
            root.web-pointer-pressed(root.active-tab-id, button, x, y);
        }
        pointer-released(button, x, y) => {
            root.web-pointer-released(root.active-tab-id, button, x, y);
        }
        scrolled(x, y, dx, dy) => {
            root.web-scrolled(root.active-tab-id, x, y, dx, dy);
        }
    }

    if root.autoscroll-on: AutoscrollCursor {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        anchor-x: root.autoscroll-anchor-x;
        anchor-y: root.autoscroll-anchor-y;
        pointer-x: root.autoscroll-x;
        pointer-y: root.autoscroll-y;
        moving: root.autoscroll-moving;
        heading: root.autoscroll-heading;
        stretch: root.autoscroll-stretch;
        squash: root.autoscroll-squash;
    }

    // Above everything: the resize zones of the frameless window.
    edges := WindowEdges {
        resizable: root.window-resizable && !root.page-fullscreen && !root.native-frame;
        begin(edge) => {
            root.window-begin-resize(edge);
        }
    }

    // The permission prompt hangs under the address pill where the sidebar shows it, else at the
    // page's top left. Not modal: no scrim.
    property <bool> pill-shown: !root.page-fullscreen && (root.peeking || (!root.hidden-at-rest && root.sidebar-width > Shell.sidebar-open));
    permission-ui := PermissionPrompt {
        x: root.pill-shown ? sidebar.address-below.x : content.x + Space.s3;
        y: root.pill-shown ? sidebar.address-below.y + Shell.prompt-gap : content.y + Space.s3;
        prompt: root.permission;
        answered(allow, remember) => {
            root.permission-answered(allow, remember);
        }
    }

    AutofillMenu {
        x: permission-ui.x;
        y: permission-ui.y + (root.permission.open ? permission-ui.height + Shell.prompt-gap : 0px);
        view: root.autofill;
        menu(i) => {
            root.autofill-menu(i);
        }
        answer(a) => {
            root.autofill-answer(a);
        }
    }

    downloads-ui := DownloadsPopover {
        open: root.downloads-open;
        anchor-x: sidebar.downloads-anchor.x;
        anchor-y: sidebar.downloads-anchor.y + Shell.prompt-gap;
        items: root.downloads;
        action(id, what) => {
            root.download-action(id, what);
        }
        dismissed => {
            root.downloads-open = false;
        }
    }

    extensions-ui := ExtensionsPopover {
        open: root.extensions-open;
        anchor-x: sidebar.extensions-anchor.x;
        anchor-y: sidebar.extensions-anchor.y + Shell.prompt-gap;
        items: root.extension-actions;
        pressed(id) => {
            root.extension-pressed(id);
        }
        manage => {
            root.extensions-manage();
        }
        dismissed => {
            root.extensions-dismissed();
        }
    }

    extension-popup-ui := ExtensionPopupCard {
        popup: root.extension-popup;
        cursor: root.cursors[root.web-cursor];
        anchor-x: sidebar.extensions-anchor.x;
        anchor-y: sidebar.extensions-anchor.y + Shell.prompt-gap;
        dismissed => {
            root.extensions-dismissed();
        }
        pointer-pressed(pane, button, x, y) => {
            root.web-pointer-pressed(pane, button, x, y);
        }
        pointer-released(pane, button, x, y) => {
            root.web-pointer-released(pane, button, x, y);
        }
        pointer-moved(pane, x, y) => {
            root.web-pointer-moved(pane, x, y);
        }
        pointer-left(pane, x, y) => {
            root.web-pointer-left(pane, x, y);
        }
        pointer-cancelled(pane) => {
            root.web-pointer-cancelled(pane);
        }
        scrolled(pane, x, y, dx, dy) => {
            root.web-scrolled(pane, x, y, dx, dy);
        }
    }

    spaces-ui := SpacesMenu {
        open: root.spaces-open;
        rows: root.spaces-menu-rows;
        entries: root.spaces-menu-entries;
        anchor-x: sidebar.spaces-anchor-x;
        anchor-y: sidebar.spaces-anchor-y;
        trigger-x: sidebar.spaces-trigger-x;
        trigger-y: sidebar.spaces-trigger-y;
        drop-line: root.spaces-drop-line;
        drop-top: root.spaces-drop-top;
        drop-sticky: root.spaces-drop-sticky;
        picked(id) => {
            root.spaces-open = false;
            root.space-switched(id);
        }
        new-space => {
            root.spaces-open = false;
            root.shell-action("new-space");
        }
        dismissed => {
            root.spaces-open = false;
        }
    }

    // The drop zone at the content's edge, then the ghost, over everything but the menu.
    if root.drag-zone > 0: Rectangle {
        x: root.content-x + (root.drag-zone == 2 ? root.content-width * 0.75 : 0px);
        y: root.content-y;
        width: root.content-width * 0.25;
        height: root.content-height;
        border-radius: Radius.md;
        background: Palette.ink.with-alpha(0.12);
        border-width: Shell.drag-zone-border;
        border-color: Palette.ink.with-alpha(0.35);
    }
    if root.drag-ghost != "": Rectangle {
        x: root.drag-x + Space.s3;
        y: root.drag-y + Space.s3;
        width: min(ghost-text.preferred-width + 2 * Space.s3, Shell.drag-ghost-max);
        height: Shell.row;
        border-radius: Radius.sm;
        background: Palette.shell;
        drop-shadow-blur: Shell.drag-ghost-blur;
        drop-shadow-color: Shell.drag-ghost-shadow;
        ghost-text := Text {
            x: Space.s3;
            width: parent.width - 2 * Space.s3;
            text: root.drag-ghost;
            color: Palette.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // The context menu, over the whole window: a click anywhere else dismisses it.
    menu-ui := ContextMenu {
        open: root.menu.open;
        anchor-x: root.menu.x;
        anchor-y: root.menu.y;
        entries: root.menu.entries;
        icon-column: root.menu.icons;
        chosen(i) => {
            root.menu-chosen(i);
        }
        dismissed => {
            root.menu-dismissed();
        }
    }

    // Over everything, pointer events pass through: the one tooltip.
    Tooltip {
        shown: root.tip.shown;
        text: root.tip.text;
        shortcut: root.tip.shortcut;
        anchor-x: root.tip.anchor-x;
        anchor-y: root.tip.anchor-y;
        centered: root.tip.centered;
        jump: root.tip.jump;
        bounds-width: root.width;
        bounds-height: root.height;
        anchor-top: root.tip.anchor-top;
    }

    init => {
        web-focus.focus();
        GlassLayer.over-on = root.over-on;
    }
}

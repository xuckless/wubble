import { Colors, Radius, Sizes, Spacing, Type } from "tokens.slint";
import { TabItem, SpaceItem, CommandResult, CommandKind, CommandBarState, CommandBarEvent, CompactMode } from "components/model.slint";
import { CommandBar } from "components/command-bar.slint";
import { Sidebar } from "components/sidebar.slint";

export { TabItem, SpaceItem, Colors, CommandResult, CommandKind, CommandBarState, CompactMode, Sizes }

export component AppWindow inherits Window {
    title: "wubble";
    preferred-width: Sizes.window-width;
    preferred-height: Sizes.window-height;
    background: Colors.abyss;
    default-font-family: Type.ui;
    default-font-size: Type.body;

    // The active tab's frame, supplied by wubble-gfx as a wgpu-backed image.
    in property <image> web-frame;
    // The part of web-frame to show, in image pixels from the top left. CEF
    // can paint a pixel more than the rectangle at fractional scales; that
    // pixel is cropped rather than the whole frame resampled.
    in property <int> web-frame-clip-width;
    in property <int> web-frame-clip-height;
    // The rectangle the web frame fills, in logical pixels. The host sizes
    // the browser from these and the window's scale factor.
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;

    in property <string> address-host <=> sidebar.address-host;
    in property <string> address-path <=> sidebar.address-path;
    in property <[TabItem]> pinned-tabs <=> sidebar.pinned-tabs;
    in property <[TabItem]> tabs <=> sidebar.tabs;
    in property <[SpaceItem]> spaces <=> sidebar.spaces;
    in property <int> active-tab-id <=> sidebar.active-tab-id;
    in property <int> active-space-id <=> sidebar.active-space-id;

    // Shell animation. The wubble-ui driver owns these: springs write the
    // numbers, its pure transition writes compact-mode.
    in-out property <length> sidebar-width: Sizes.sidebar-width;
    in property <float> sidebar-slide: 1;
    in property <float> content-inset: 1;
    in property <float> space-indicator <=> sidebar.space-indicator;
    in property <CompactMode> compact-mode: CompactMode.expanded;
    // Pointer reports for the driver; x is in window coordinates.
    callback seam-pressed(length);
    callback seam-dragged(length);
    callback seam-released();
    callback zone-hover-changed(bool);
    callback compact-toggle-requested();
    callback space-changed(int);
    changed active-space-id => {
        root.space-changed(root.active-space-id);
    }

    callback tab-activated <=> sidebar.tab-activated;
    callback tab-closed <=> sidebar.tab-closed;
    out property <CommandBarState> command-bar-state <=> bar.state;
    in property <[CommandResult]> command-results <=> bar.results;
    in-out property <string> command-query <=> bar.query;
    callback command-query-changed <=> bar.query-changed;
    callback command-result-chosen <=> bar.result-chosen;
    callback command-dismissed <=> bar.dismissed;
    // Intents: the bar opens itself; Rust may prefill the query.
    callback new-tab-requested();
    callback space-switched <=> sidebar.space-switched;
    callback address-focus-requested();

    public function request-new-tab() {
        bar.dispatch(CommandBarEvent.open);
        root.new-tab-requested();
    }

    public function toggle-compact() {
        root.compact-toggle-requested();
    }

    public function request-address-focus() {
        bar.dispatch(CommandBarEvent.open);
        root.address-focus-requested();
    }

    root-keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + T);
            activated => {
                root.request-new-tab();
            }
        }
        KeyBinding {
            keys: @keys(Control + L);
            activated => {
                root.request-address-focus();
            }
        }

        content := Rectangle {
            x: Spacing.s2 + root.content-inset * (root.sidebar-width + Spacing.s2);
            y: Spacing.s2;
            width: parent.width - self.x - Spacing.s2;
            height: parent.height - 2 * Spacing.s2;
            border-radius: Radius.md;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.web-frame;
                source-clip-width: root.web-frame-clip-width;
                source-clip-height: root.web-frame-clip-height;
                image-fit: fill;
            }
            bar := CommandBar {
                closed => {
                    root-keys.focus();
                }
            }
        }

        // The sidebar sits inside its hover zone, so the zone keeps has-hover
        // while the pointer is over a child row.
        zone := TouchArea {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: Spacing.s2 + root.sidebar-width + Spacing.s2;
            changed has-hover => {
                root.zone-hover-changed(self.has-hover);
            }

            sidebar := Sidebar {
                x: Spacing.s2 + (root.sidebar-slide - 1) * (root.sidebar-width + Spacing.s2);
                y: Spacing.s2;
                width: root.sidebar-width;
                height: parent.height - 2 * Spacing.s2;
                new-tab-requested => {
                    root.request-new-tab();
                }
                address-activated => {
                    root.request-address-focus();
                }
            }
        }

        seam := TouchArea {
            enabled: false;
            mouse-cursor: MouseCursor.col-resize;
            x: Spacing.s2 + root.sidebar-width + Spacing.s1 - Sizes.seam-grab / 2;
            y: Spacing.s2;
            width: Sizes.seam-grab;
            height: parent.height - 2 * Spacing.s2;
            pointer-event(event) => {
                if (event.button != PointerEventButton.left) {
                    return;
                }
                if (event.kind == PointerEventKind.down) {
                    root.seam-pressed(self.absolute-position.x + self.mouse-x);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.seam-released();
                }
            }
            moved => {
                root.seam-dragged(self.absolute-position.x + self.mouse-x);
            }
        }
    }

    // Mode-dependent presentation only; the spring-driven numbers come from Rust.
    states [
        expanded when root.compact-mode == CompactMode.expanded: {
            seam.enabled: true;
        }
        hidden when root.compact-mode == CompactMode.hidden: {
            zone.width: Sizes.edge-zone;
        }
        peeking when root.compact-mode == CompactMode.peeking: {
            sidebar.drop-shadow-blur: Sizes.peek-shadow;
            sidebar.drop-shadow-color: Colors.scrim;
        }
    ]

    init => {
        root-keys.focus();
    }
}
